# =============================================================================
# NISE COMPORT environment file.
# Copy to .env.local (local) or set these in cPanel's Node.js app (live site).
# NEVER commit real values. Lines starting with # are optional or examples.
# "REQUIRED" = the site needs it. Anything else switches a feature on when filled.
# =============================================================================

# ----------------------------------------------------------------------------
# 1. Database and site address (REQUIRED)
# ----------------------------------------------------------------------------
# APP_ENV=prod  -> encrypted API calls stay on 127.0.0.1:3020 (MilesWeb)
# APP_ENV=local -> encrypted API calls stay on 127.0.0.1:3000 (local Next dev)
# Defaults to prod for production Next.js, local for development.
# This setting NEVER switches DATABASE_URL automatically. Use a separate local DB
# config if you do not want local development to touch production customer data.
APP_ENV=prod
# Optional override when Node listens on a different port:
# INTERNAL_API_PORT=3020
# NEXT_PUBLIC_SITE_URL must separately match this environment; it is baked into
# the frontend during build. For local work, use http://localhost:3000.
# PostgreSQL. URL-encode special characters in the password (@ -> %40, * -> %2A, ( -> %28, ) -> %29).
# Same server as the site: use localhost. From your laptop: the hosting server's public host or an SSH tunnel.
DATABASE_URL="postgresql://DB_USER:URL_ENCODED_PASSWORD@HOST:5432/DB_NAME"
DATABASE_SSL=false
# The ONE address of the site. The other host (www / non-www) redirects here.
NEXT_PUBLIC_SITE_URL=https://nisecomport.aitapri.com
# true = redirect to the address above. Use false locally, on Netlify previews, or if your host already redirects.
CANONICAL_HOST_REDIRECT=true

# ----------------------------------------------------------------------------
# 2. Secrets (REQUIRED). Make each with: openssl rand -base64 48   Keep them stable.
# ----------------------------------------------------------------------------
# At least 32 characters. Email and SMS codes are disabled without it.
OTP_SECRET=
# At least 16 characters. The scheduler sends "Authorization: Bearer <CRON_SECRET>" to
# /api/cron/cleanup (every 10-15 min), /api/cron/offers (daily) and /api/cron/whatsapp (every 5 min).
CRON_SECRET=
# 32+ random characters, server only. Never expose as NEXT_PUBLIC_*.
INTERNAL_API_TOKEN=
# Encrypts the browser <-> server API. Make a fresh pair per environment with: npm run api:keygen
API_ENVELOPE_PRIVATE_JWK=
NEXT_PUBLIC_API_ENVELOPE_PUBLIC_JWK=
# 32 random bytes as base64 (openssl rand -base64 32). Used by PAN import.
PAN_ENCRYPTION_KEY=
# Encrypts imported customer registers (Admin -> Records). openssl rand -base64 32.
# BACK THIS UP: without it the imported records cannot be read.
RECORDS_ENCRYPTION_KEY=

# ----------------------------------------------------------------------------
# 3. Email (SMTP). Sign-in codes, payment receipts and staff alerts.
# ----------------------------------------------------------------------------
# Use the NISE COMPORT mailbox here (not another project's).
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_USER=info@nisecomport.com
# The mailbox password exactly as it is. Do NOT URL-encode it here.
SMTP_PASSWORD=
SMTP_FROM="NISE COMPORT <info@nisecomport.com>"
SMTP_REPLY_TO=info@nisecomport.com
# Only if the server's certificate name differs from SMTP_HOST.
SMTP_TLS_SERVERNAME=
# Test it with: npm run smtp:check
# Where new-request and cancellation alerts go (default: NEXT_PUBLIC_CONTACT_EMAIL).
# Several addresses are fine, separated by commas: info@nisecomport.com,nweb.hub@gmail.com,sristyirani@gmail.com
STAFF_ALERT_EMAIL=info@nisecomport.com
# Where "payment received / failed / refund" alerts go (default: STAFF_ALERT_EMAIL).
# PAYMENT_ALERT_EMAIL=
# Local development only: with no SMTP set, emails and sign-in codes print in the terminal.
# MAIL_DEV_CONSOLE=

# ----------------------------------------------------------------------------
# 4. File uploads
# ----------------------------------------------------------------------------
# Folder for customers' private files. Locally: .private-uploads. Live: a folder OUTSIDE the website folder.
PRIVATE_UPLOAD_DIR=.private-uploads
# Converts Word / Excel files to PDF for printing. Leave as is if LibreOffice is installed, otherwise ignore.
LIBREOFFICE_BIN=soffice

# ----------------------------------------------------------------------------
# 5. Business details. Must match your Google Business Profile. Empty = not shown.
# ----------------------------------------------------------------------------
NEXT_PUBLIC_CONTACT_EMAIL=info@nisecomport.com
NEXT_PUBLIC_WHATSAPP_PRIMARY=919771219893
NEXT_PUBLIC_WHATSAPP_SECONDARY=919835552756
# schema.org format, India time. Example: "Mo-Sa 10:00-19:00" or "Mo-Fr 10:00-19:00; Sa 10:00-14:00"
NEXT_PUBLIC_OPENING_HOURS=
# Exact map pin (right-click the pin in Google Maps and copy the two numbers).
NEXT_PUBLIC_GEO_LAT=
NEXT_PUBLIC_GEO_LNG=
# Google Business Profile: share link, and the "Ask for reviews" link.
NEXT_PUBLIC_GOOGLE_MAPS_URL=
NEXT_PUBLIC_GOOGLE_REVIEW_URL=
# Official profile links, comma separated: Google, Facebook, Instagram, YouTube, Justdial...
NEXT_PUBLIC_SAME_AS=
NEXT_PUBLIC_FOUNDING_YEAR=

# ----------------------------------------------------------------------------
# 6. Google
# ----------------------------------------------------------------------------
# Server-side key. Enable "Places API (New)" and "Geocoding API", restrict the key to those two.
# Powers address search, "use my location", the Google photo gallery and the rating chip.
GOOGLE_MAPS_API_KEY=
# Your Business Profile place ID (Google's Place ID Finder).
GOOGLE_PLACE_ID=
# Optional: reads your Business Profile reviews automatically (Google Business Profile API access needed).
# GOOGLE_BUSINESS_CLIENT_ID=
# GOOGLE_BUSINESS_CLIENT_SECRET=
# GOOGLE_BUSINESS_REFRESH_TOKEN=
# GOOGLE_BUSINESS_ACCOUNT_ID=
# GOOGLE_BUSINESS_LOCATION_ID=

# ----------------------------------------------------------------------------
# 7. Search engines
# ----------------------------------------------------------------------------
# Search Console "HTML tag" verification: only the content="..." value.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=
# 8-128 letters, digits or dashes. Served at /indexnow-key.txt. Run `npm run seo:indexnow` after deploys.
INDEXNOW_KEY=

# ----------------------------------------------------------------------------
# 8. Payments (docs/payments-setup.md). Each option switches on when its values are filled;
#    until then customers see "coming soon" and can ask for a payment link on WhatsApp.
# ----------------------------------------------------------------------------
# Free UPI QR: no commission, staff confirm each payment. Your business UPI ID and the name shown on it.
UPI_ID=
# Up to two more UPI IDs. Add a label after a bar if you like: UPI_ID_2=shop@okaxis|Axis account
UPI_ID_2=
UPI_ID_3=
# The payment QR and UPI ID show only to the signed-in customer who owns the bill, and hide again after this many seconds (60 to 600).
UPI_QR_SECONDS=180
UPI_PAYEE_NAME=NISE COMPORT
# Fee added only for instant online payments (percent of the amount). UPI QR and cash never carry it.
PAYMENT_ONLINE_FEE_PERCENT=2.4
# Razorpay: Dashboard -> Account & Settings -> API keys, and Webhooks.
# Webhook URL: https://YOUR-SITE/api/webhooks/razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Cashfree: Developers -> API keys. Use sandbox while testing, production when live.
# Webhook URL: https://YOUR-SITE/api/webhooks/cashfree
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2026-01-01

# ----------------------------------------------------------------------------
# 9. WhatsApp Business Cloud API (docs/whatsapp-setup.md): auto replies and automatic sending.
#    Leave empty to keep one-tap sending from /admin.
# ----------------------------------------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# App secret of the Meta app (checks webhook signatures).
WHATSAPP_APP_SECRET=
# Any long word you make up; paste the same one in Meta's webhook setup.
# Webhook URL: https://YOUR-SITE/api/whatsapp/webhook
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
# The shop's own WhatsApp number that receives new-request alerts: digits only with country code.
WHATSAPP_STAFF_NUMBER=
# Optional message templates (each must be approved in Meta first). Leave empty to skip that message.
# Customer copy body: {{1}} name, {{2}} reference, {{3}} service.
WHATSAPP_CONFIRM_TEMPLATE=
# Shop alert body: {{1}} reference, {{2}} service, {{3}} customer, {{4}} details.
WHATSAPP_STAFF_TEMPLATE=
# WHATSAPP_STATUS_TEMPLATE=
# WHATSAPP_OFFICIAL_REF_TEMPLATE=
# WHATSAPP_REVIEW_TEMPLATE=

# ----------------------------------------------------------------------------
# 10. SMS codes for mobile-number sign-in (docs/sms-setup.md). Fill ONE provider; empty = SMS off.
# ----------------------------------------------------------------------------
# RECOMMENDED SETUP (copy these lines, fill the values, delete the unused provider lines below):
#   OTP_CHANNEL=whatsapp,sms        WhatsApp first (cheap), SMS as backup. Use OTP_CHANNEL=sms until Meta approves your template.
#   WHATSAPP_PROVIDER=meta
#   META_WA_TOKEN=...
#   META_WA_PHONE_ID=...
#   META_WA_TEMPLATE=...
#   SMS_PROVIDER=fast2sms
#   FAST2SMS_API_KEY=...
# msg91 or fast2sms (optional: whichever has keys is used).
# SMS_PROVIDER=msg91
# MSG91: needs a DLT-approved OTP template.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# MSG91_OTP_EXPIRY_MINUTES=10
# Fast2SMS: the key alone uses their OTP route.
FAST2SMS_API_KEY=
# WhatsApp codes (optional). OTP_CHANNEL=whatsapp,sms tries WhatsApp first, then SMS. Default: sms only.
# OTP_CHANNEL=whatsapp,sms
# Who sends WhatsApp codes: meta (Meta's own Cloud API, cheapest), msg91 or fast2sms. Empty = first one with keys.
# WHATSAPP_PROVIDER=meta
# Meta WhatsApp Cloud API: token (permanent system-user token), phone number id, approved AUTHENTICATION template.
# META_WA_TOKEN=
# META_WA_PHONE_ID=
# META_WA_TEMPLATE=
# META_WA_LANG=en
# META_WA_BUTTON=off   (only if your template has no copy-code button)
# MSG91 WhatsApp: approved AUTHENTICATION template with the code as body variable 1.
# MSG91_WHATSAPP_NUMBER=
# MSG91_WHATSAPP_TEMPLATE=
# MSG91_WHATSAPP_NAMESPACE=
# MSG91_WHATSAPP_LANG=en
# Fast2SMS WhatsApp: message id of your approved template.
# FAST2SMS_WHATSAPP_MESSAGE_ID=
# Only for the DLT route with your own approved template.
FAST2SMS_SENDER_ID=
FAST2SMS_TEMPLATE_ID=

# ----------------------------------------------------------------------------
# 11. Local development only
# ----------------------------------------------------------------------------
# Local test login (demo@nisecomport.test). Works only in `npm run dev`; set false to hide it.
# DEMO_AUTH_ENABLED=false

# ---------------------------------------------------------------------------
# 12. Message centre (tickets) — see docs/mailbox-setup.md
# ---------------------------------------------------------------------------
# Customers write on the website at the private address in src/lib/mail-route.ts (not linked from the menu).
# To ALSO receive emails sent to your support address as tickets, give the server read access to that mailbox
# (cPanel -> Email Accounts -> Connect Devices shows the incoming server name):
# MAIL_IMAP_HOST=mail.nisecomport.com
# MAIL_IMAP_PORT=993
# MAIL_IMAP_USER=support@nisecomport.com
# MAIL_IMAP_PASSWORD=
# MAIL_IMAP_FOLDER=INBOX
# Only if the certificate is issued to another name than MAIL_IMAP_HOST:
# MAIL_IMAP_TLS_SERVERNAME=
# Address customers see and reply to (defaults to MAIL_IMAP_USER). Replies are sent through the SMTP_* settings above.
# MAIL_SUPPORT_ADDRESS=support@nisecomport.com
# Full "From" line for support replies (defaults to "NISE COMPORT Support" <MAIL_SUPPORT_ADDRESS>).
# MAIL_SUPPORT_FROM=
# Set to "false" only if your IMAP server uses a plain (non-SSL) connection; by default port 993 is SSL.
# MAIL_IMAP_SECURE=
# Space for message attachments: all customers together, and per customer (in MB).
# MAIL_STORAGE_LIMIT_MB=2048
# MAIL_USER_QUOTA_MB=200
# A scheduler must call POST /api/cron/mail with "Authorization: Bearer <CRON_SECRET>" every 5 minutes (reads new email,
# closes tickets after 48 hours without a customer reply, retries failed emails).

# ----------------------------------------------------------------------------
# Optional site features (off unless set to "true"; these are read when the site is built, so rebuild after changing)
# ----------------------------------------------------------------------------
# Bills and recharge pages
# NEXT_PUBLIC_FEATURE_BILLS=false
# Travel tickets pages
# NEXT_PUBLIC_FEATURE_TRAVEL=false
# Customer file uploads for printing
# NEXT_PUBLIC_FEATURE_PRINT_UPLOADS=false

# ----------------------------------------------------------------------------
# Birthday wishes, insurance reminders and the birthday gift coupon
# ----------------------------------------------------------------------------
# No extra settings. They use RECORDS_ENCRYPTION_KEY, CRON_SECRET, the SMTP_* mailbox and the WhatsApp settings above.
# Switch them on in Admin -> Birthdays & renewals -> "Cards, wording & automatic" (percent and days of the gift are there too).
# The /api/cron/whatsapp call (every 5 minutes) sends the automatic wishes between 9 am and 8 pm India time.


ssh -p 22 aitapri_1@45.199.139.25