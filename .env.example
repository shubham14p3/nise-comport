# ---------------------------------------------------------------------------
# Database and site
# ---------------------------------------------------------------------------
# Local development -> point at the hosting server's public PostgreSQL host.
# URL-encode reserved characters in PASSWORD (for example: @ -> %40, ( -> %28).
DATABASE_URL="postgresql://DB_USER:URL_ENCODED_PASSWORD@PUBLIC_POSTGRES_HOST:5432/DB_NAME"
DATABASE_SSL=false
# When Next.js runs on the SAME hosting server as PostgreSQL, you can switch only
# the host portion to localhost and keep the same DB/user/password:
# DATABASE_URL="postgresql://DB_USER:URL_ENCODED_PASSWORD@localhost:5432/DB_NAME"
# The ONE canonical address of the site. The other host (www / non-www) is redirected here.
# The live site currently redirects to www, so keeping www avoids a host migration:
NEXT_PUBLIC_SITE_URL=https://www.nisecomport.com
# Set to "false" if your host (Vercel, Cloudflare, nginx) already does the www redirect.
CANONICAL_HOST_REDIRECT=true

# ---------------------------------------------------------------------------
# Email (SMTP) and security secrets
# ---------------------------------------------------------------------------
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_USER=hello@example.com
SMTP_PASSWORD=replace-with-mailbox-password
SMTP_FROM="NISE COMPORT <hello@example.com>"
# Optional: where customer replies go
SMTP_REPLY_TO=info@nisecomport.com
# Where new-request and cancellation alerts go (defaults to NEXT_PUBLIC_CONTACT_EMAIL)
STAFF_ALERT_EMAIL=info@nisecomport.com
# REQUIRED in production, at least 32 random characters (openssl rand -base64 48). Email codes are disabled without it.
OTP_SECRET=replace-with-a-long-random-secret-that-stays-stable
# At least 16 characters. The scheduler sends "Authorization: Bearer <CRON_SECRET>" to /api/cron/cleanup every 10–15 minutes.
CRON_SECRET=replace-with-a-long-random-secret

PRIVATE_UPLOAD_DIR=/var/lib/nise-comport/uploads
LIBREOFFICE_BIN=soffice
# 32 random bytes encoded as base64; used by PAN import if enabled.
PAN_ENCRYPTION_KEY=base64-encoded-32-byte-key

# ---------------------------------------------------------------------------
# Opaque browser <-> server API transport
# ---------------------------------------------------------------------------
# Generate a fresh ECDH P-256 pair per environment with: npm run api:keygen
API_ENVELOPE_PRIVATE_JWK='{"kty":"EC","crv":"P-256","x":"...","y":"...","d":"...","key_ops":["deriveBits"],"ext":true}'
NEXT_PUBLIC_API_ENVELOPE_PUBLIC_JWK='{"kty":"EC","crv":"P-256","x":"...","y":"...","key_ops":[],"ext":true}'
# 32+ random bytes, server-only. Never expose this as NEXT_PUBLIC_*.
INTERNAL_API_TOKEN=replace-with-a-long-random-server-only-token

# ---------------------------------------------------------------------------
# Business details (must match your Google Business Profile exactly)
# Leave a value empty rather than guessing; empty values are simply not shown.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_PRIMARY=919771219893
NEXT_PUBLIC_WHATSAPP_SECONDARY=919835552756
NEXT_PUBLIC_CONTACT_EMAIL=info@nisecomport.com
# Opening hours in schema.org format, India time. Examples: "Mo-Sa 10:00-19:00" or "Mo-Fr 10:00-19:00; Sa 10:00-14:00"
NEXT_PUBLIC_OPENING_HOURS=
# Exact map pin of the shop (right-click the pin in Google Maps to copy the numbers)
NEXT_PUBLIC_GEO_LAT=
NEXT_PUBLIC_GEO_LNG=
# Share link of your Google Business Profile (Maps → Share), and its "Ask for reviews" link
NEXT_PUBLIC_GOOGLE_MAPS_URL=
NEXT_PUBLIC_GOOGLE_REVIEW_URL=
# Comma-separated official profile URLs: Google Business Profile, Facebook, Instagram, YouTube, Justdial…
NEXT_PUBLIC_SAME_AS=
NEXT_PUBLIC_FOUNDING_YEAR=

# ---------------------------------------------------------------------------
# Search engines
# ---------------------------------------------------------------------------
# Google Search Console "HTML tag" verification code (only the content="..." value)
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools meta tag value (msvalidate.01)
BING_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=
# IndexNow key (8–128 letters/digits/dashes). Served at /indexnow-key.txt; run `npm run seo:indexnow` after deploys.
INDEXNOW_KEY=
