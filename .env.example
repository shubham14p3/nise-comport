DATABASE_URL=postgres://postgres:postgres@localhost:5432/nise_comport
DATABASE_SSL=false
NEXT_PUBLIC_SITE_URL=https://nisecomport.com

SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_USER=hello@example.com
SMTP_PASSWORD=replace-with-mailbox-password
SMTP_FROM="NISE COMPORT <hello@example.com>"
OTP_SECRET=replace-with-a-long-random-secret-that-stays-stable

PRIVATE_UPLOAD_DIR=/var/lib/nise-comport/uploads
LIBREOFFICE_BIN=soffice
CRON_SECRET=replace-with-a-long-random-secret

# 32 random bytes encoded as base64; used by PAN import if enabled.
PAN_ENCRYPTION_KEY=base64-encoded-32-byte-key
