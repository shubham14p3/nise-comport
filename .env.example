NODE_ENV=production
PORT=3000
APP_ORIGIN=https://nisecomport.com
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=false
JWT_SECRET=replace-with-a-long-random-secret

# Private uploads on the Node host. Keep this outside the public web root when possible.
PRIVATE_UPLOAD_DIR=./private_uploads
MAX_UPLOAD_MB=25
FILE_RETENTION_DAYS=7

# Optional LibreOffice executable for DOC/DOCX -> PDF conversion.
# Example Linux: /usr/bin/libreoffice
LIBREOFFICE_BIN=

# Optional Razorpay online payments. If omitted, pay-at-shop remains available.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional official WhatsApp Cloud API utility notifications.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_STATUS_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en

# Seed owner account used by npm run db:init. Change immediately after first login.
SEED_OWNER_NAME=NISE COMPORT Owner
SEED_OWNER_EMAIL=
SEED_OWNER_MOBILE=
SEED_OWNER_PASSWORD=
