{
  "name": "nise-comport",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack",
    "release": "node scripts/release-build.mjs",
    "init": "npm ci --no-audit --no-fund --include=dev && npm run db:migrate && node scripts/check-build.mjs && npm start",
    "start": "node node_modules/next/dist/bin/next start -H 0.0.0.0 -p 3002",
    "lint": "eslint src --max-warnings=0",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/*.test.mts",
    "seo:indexnow": "node scripts/indexnow.mjs",
    "seo:check": "node scripts/seo-check.mjs",
    "db:check": "node scripts/db-check.mjs",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore": "node scripts/db-restore.mjs",
    "data:check": "node scripts/data-check.mjs",
    "testimonials:seed": "node scripts/seed-testimonials.mjs",
    "avatars:generate": "node scripts/generate-avatars.mjs",
    "avatars:import-real": "node scripts/import-real-avatars.mjs",
    "photos": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --experimental-strip-types scripts/photos.mjs",
    "db:setup": "npm run db:check && npm run db:migrate && npm run db:check && npm run offers:sync",
    "smtp:check": "node scripts/smtp-check.mjs",
    "records:update": "node scripts/update-records.mjs",
    "records:import": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/import-records.mts",
    "records:scan": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/scan-records.mts",
    "offers:sync": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/sync-offers.mts",
    "loyalty:backfill": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/loyalty-backfill.mts",
    "campaign:preview": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/campaign-preview.mts",
    "api:keygen": "node scripts/generate-api-transport-key.mjs",
    "security:check": "node scripts/security-check.mjs",
    "verify": "npm run security:check && npm test && npm run lint && npm run build"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "imapflow": "^1.0.164",
    "mailparser": "^3.7.1",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "nodemailer": "^10.0.11",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.7",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.3.6",
    "tailwindcss": "^4.1.17",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "esbuild": ">=0.25.0",
    "uuid": ">=11.1.1"
  }
}
