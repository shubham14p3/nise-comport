{
  "name": "nise-comport",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack",
    "release": "node scripts/release-build.mjs",
    "init": "node scripts/check-build.mjs && npm start",
    "start": "next start -H 0.0.0.0 -p 3020",
    "lint": "eslint src --max-warnings=0",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "team:migrate": "node scripts/apply-team-migrations.mjs",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/*.test.mts",
    "seo:check": "node scripts/seo-check.mjs",
    "db:check": "node scripts/db-check.mjs",
    "db:schema:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/schema-compat.mjs",
    "db:schema:apply": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/schema-compat.mjs --apply",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore": "node scripts/db-restore.mjs",
    "data:check": "node scripts/data-check.mjs",
    "smtp:check": "node scripts/smtp-check.mjs",
    "api:smoke": "node scripts/api-smoke-check.mjs",
    "records:update": "node scripts/update-records.mjs",
    "records:import": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/import-records.mts",
    "offers:sync": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/sync-offers.mts",
    "security:check": "node scripts/security-check.mjs",
    "verify": "npm run security:check && npm test && npm run lint && npm run build"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "imapflow": "^1.0.164",
    "mailparser": "^3.7.1",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "nodemailer": "^10.0.11",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.7",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.3.6",
    "tailwindcss": "^4.1.17",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "esbuild": ">=0.25.0",
    "uuid": ">=11.1.1"
  }
}
