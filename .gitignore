*.njsproj
*.sln
*.sw?

# Next.js build artifacts are generated locally and deployed separately.
.next/
out/
.private-uploads/
coverage/
*.tsbuildinfo
# Keep curated legacy brand and gallery assets available to Next.js.
/public/csc/
/public/nise-logo.png

# Photo inbox: originals stay on your computer (npm run photos)
/photo-inbox/*
!/photo-inbox/README.md
!/photo-inbox/*/
/photo-inbox/*/*
!/photo-inbox/*/.gitkeep
/photo-inbox/_done/
# myexcel
# photo-index

# Local and server secrets. These patterns do NOT untrack already committed files.
.env
.env.local
.env.*.local
.env.production
.env.development
!.env.example
*.pem
*.key
# SSH-transfer build archives
*.tar.gz
*.tgz

# Database backups hold customer data: ignore future exports (tracked history is unchanged).
/backups/

# Remembered Excel location for npm run records:update
# .records-source.json

# Upload archive made by "git archive" and customer Excel registers: never commit
*.zip
myexcel/
.records-source.json
