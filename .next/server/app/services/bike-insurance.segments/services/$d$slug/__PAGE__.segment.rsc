3a:T600,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Is an insurance quote the final premium?","acceptedAnswer":{"@type":"Answer","text":"No. The insurer calculates the final premium and determines eligibility, coverage and issuance."}},{"@type":"Question","name":"Is third-party insurance compulsory for bikes?","acceptedAnswer":{"@type":"Answer","text":"Yes. Riding without at least third-party cover is an offence under the Motor Vehicles Act (₹2,000 fine and/or up to 3 months for a first offence)."}},{"@type":"Question","name":"Can you guarantee a premium or claim?","acceptedAnswer":{"@type":"Answer","text":"No. The insurer decides eligibility, premium, coverage, exclusions and claim outcomes. We help with the paperwork and follow-up all the way."}},{"@type":"Question","name":"What should I compare before renewing?","acceptedAnswer":{"@type":"Answer","text":"Premium, IDV, NCB applied, add-ons (zero depreciation, roadside help), cashless garages nearby and the insurer's claim record."}},{"@type":"Question","name":"My bike policy expired. Can I still renew?","acceptedAnswer":{"@type":"Answer","text":"Yes. Don't ride until it's renewed. The insurer may ask for an inspection. Renew within 90 days of expiry to keep your NCB."}},{"@type":"Question","name":"Which insurers can you quote?","acceptedAnswer":{"@type":"Answer","text":"We compare from the insurers we're tied up with at the time, which can include public and private general insurers. Ask us for the current list."}}]}20:["$","section",null,{"className":"section faq-block","id":"faq","children":[["$","div",null,{"className":"container faq-block__inner","children":[["$","div",null,{"className":"section-head section-head--left","children":[["$","span",null,{"className":"eyebrow","children":"QUESTIONS CUSTOMERS ASK"}],["$","h2",null,{"children":"Frequently asked questions"}]]}],["$","div",null,{"className":"faq-list","children":[["$","details","Is an insurance quote the 