39:T6a2,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Does NISE COMPORT underwrite policies?","acceptedAnswer":{"@type":"Answer","text":"No. We facilitate enquiries. The insurer decides eligibility, coverage, premium and issuance."}},{"@type":"Question","name":"Comprehensive or third-party only?","acceptedAnswer":{"@type":"Answer","text":"Third-party is the legal minimum and pays for damage to others only. Comprehensive also covers your own car against accidents, theft, fire and floods. For most cars under 10 years old, comprehensive is worth it."}},{"@type":"Question","name":"Does an online quote guarantee the final premium?","acceptedAnswer":{"@type":"Answer","text":"No. The insurer confirms eligibility, vehicle details, coverage and final premium before issuing a policy."}},{"@type":"Question","name":"Who decides whether a claim is paid?","acceptedAnswer":{"@type":"Answer","text":"The insurance company that issued your policy applies its terms and decides claims. NISE COMPORT does not underwrite policies or decide claims, and isn't liable for the insurer's decision, but we help you register, document and follow up the claim to the end."}},{"@type":"Question","name":"What is a cashless claim?","acceptedAnswer":{"@type":"Answer","text":"At the insurer's network garage, the insurer pays the garage directly. You pay only the deductible, depreciation (unless you have zero dep) and anything not covered."}},{"@type":"Question","name":"Can I keep my NCB if I sell the car?","acceptedAnswer":{"@type":"Answer","text":"Yes. Ask for an NCB certificate or retention letter; you can use it on your next car's policy, usually within 3 years."}}]}1f:["$","section",null,{"className":"section faq-block","id":"faq","children":[["$","div",null,{"className":"container faq-block__inner","children":[["$","div",null,{"className":"section-head section-head--left","children":[["$","span",null,{"className":"eyebrow","children":"QUESTIONS CUSTOMER