8:[["children",{"s":"__PAGE__","h":160,"d":{"r":["$","$2","c",{"children":[["$","main",null,{"className":"content-page","lang":"en-IN","children":[["$","$Lf",null,{}],["$","section",null,{"className":"content-hero","children":["$","div",null,{"className":"container","children":[[["$","nav",null,{"className":"breadcrumbs","aria-label":"Breadcrumb","children":["$","ol",null,{"children":[["$","li","/",{"children":[["$","$L10",null,{"href":"/","children":"Home"}],["$","$L11",null,{"icon":{"name":"chevron-right","size":24,"node":[["path",{"d":"m9 18 6-6-6-6","key":"mthhwq"}]]},"size":12,"aria-hidden":"true"}]]}],["$","li","/faq",{"children":["$","span",null,{"aria-current":"page","children":"FAQs"}]}]]}]}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.nisecomport.com\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"FAQs\",\"item\":\"https://www.nisecomport.com/faq\"}]}"}}]],["$","$L10",null,{"href":"/","className":"back-small","children":[["$","$L11",null,{"icon":{"name":"arrow-left","size":24,"node":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]]},"size":14}]," ","Home"]}],["$","span",null,{"className":"eyebrow eyebrow-muted","children":"GOOD QUESTIONS, CLEAR ANSWERS"}],["$","h1",null,{"children":["Frequently asked",["$","br",null,{}],["$","em",null,{"children":"questions."}]]}],["$","p",null,{"children":["Search any question, or pick a topic or service. Can’t find yours? ",["$","$L10",null,{"href":"/contact","children":"Ask the service desk"}],"."]}]]}]}],["$","section",null,{"className":"container","children":["$","$L12",null,{"faqs":[{"id":"g-0","topic":"About us","question":"Is NISE COMPORT a government office?","answer":"No. NISE COMPORT is an independent CSC / Pragya Kendra service centre that helps customers use government and digital services. The relevant department, bank or provider makes the final decision."},{"id":"g-1","topic":"About us","question":"What is a CSC / Pragya Kendra?","answer":"A Common Service Centre (CSC) or Pragya Kendra is a local service point that helps citizens apply for government and digital services close to home, so they do not have to travel to several offices."},{"id":"g-2","topic":"About us","question":"Since when have you been serving Jamshedpur?","answer":"We began as NISE in 1995 and grew into NISE COMPORT. Many of our customers have been coming to us for years."},{"id":"g-3","topic":"About us","question":"What services do you offer?","answer":"PAN and Aadhaar help, Jharkhand certificates, voter ID, banking and AEPS, insurance, scholarship and exam forms, ITR and business forms, website creation, photo studio, printing and photocopy, and computer repair and hardware. See the full list on the Services page."},{"id":"g-4","topic":"About us","question":"Can I talk to someone in Hindi?","answer":"Yes. Our team speaks Hindi and English, and key pages are available in Hindi at /hi and Bengali at /bn."},{"id":"g-5","topic":"About us","question":"Are the logos and services on your site yours?","answer":"No. Names such as CSC, Digital India, PAN, Aadhaar and Voter ID belong to their owners. We are an independent local helper that guides you through applying, submitting and tracking."},{"id":"g-6","topic":"About us","question":"Who is on your team?","answer":"Meet the people at the service desk on the Team page. Staff help with your application but never decide approvals."},{"id":"g-7","topic":"Visiting us","question":"Where are you located?","answer":"Ground Floor, Singh Building, Shop No-3, Hanuman Mandir Road, Kharangajhar, Telco Colony, Jamshedpur, Jharkhand 831004. Open Google Maps from the Contact page for directions."},{"id":"g-8","topic":"Visiting us","question":"Which areas do you serve?","answer":"Walk-in customers come from Kharangajhar, Telco, Govindpur, Birsanagar, Golmuri, Sakchi, Mango and across Jamshedpur. Online requests can be sent from anywhere. See the Areas we serve page."},{"id":"g-9","topic":"Visiting us","question":"What are your opening hours?","answer":"Our hours are shown on the Contact page and change on public holidays. For urgent or portal-dependent work, call +91 97712 19893 before you visit."},{"id":"g-10","topic":"Visiting us","question":"Do I need an appointment?","answer":"No. You can walk in during opening hours. For a long or document-heavy job, send a request first or message us on WhatsApp so we can tell you exactly what to bring."},{"id":"g-11","topic":"Visiting us","question":"What should I bring when I visit?","answer":"Bring the original documents for your service, a photocopy where we ask for one, and your mobile phone for OTPs (never share OTPs with anyone). Each service page lists the documents."},{"id":"g-12","topic":"Visiting us","question":"Can someone else come on my behalf?","answer":"For many services yes, if they bring your documents. For services that need your OTP, biometrics or photo (such as Aadhaar updates and some PAN steps), you may need to be present. Ask us first."},{"id":"g-13","topic":"Visiting us","question":"Can I contact you on WhatsApp?","answer":"Yes. WhatsApp us on +91 97712 19893 or +91 98355 52756. You can send a question or a document photo and we will tell you the next step."},{"id":"g-14","topic":"Fees & payments","question":"Are government fees included in your service charge?","answer":"No. We show our service charge separately from any government, portal, bank or insurer fee. The receipt identifies the charges collected."},{"id":"g-15","topic":"Fees & payments","question":"How much will it cost?","answer":"We tell you our service charge before we start. Printing rates are listed on the Pricing page; other services are confirmed on WhatsApp or at the desk."},{"id":"g-16","topic":"Fees & payments","question":"Can you guarantee application approval?","answer":"No. Approval, processing time and decisions are controlled by the relevant government department, company or service provider."},{"id":"g-17","topic":"Fees & payments","question":"How can I pay?","answer":"You can pay at the desk in cash or UPI. Online payment is being added; when it is live your payment is confirmed on your request and a receipt is issued."},{"id":"g-18","topic":"Fees & payments","question":"Will I get a receipt?","answer":"Yes. We give a receipt or confirmation for every payment, along with the portal acknowledgement where there is one. Keep both."},{"id":"g-19","topic":"Fees & payments","question":"Can I get a refund?","answer":"If you cancel before work starts, or we cannot carry out the service, the service charge is refunded. Completed service charges are generally non-refundable. See the Refund & cancellation policy for details."},{"id":"g-20","topic":"Fees & payments","question":"How do offers and promo codes work?","answer":"Promo codes and the welcome coupon reduce our service charge only, never government fees. Enter the code on your request, or see the Offers page for what is live today."},{"id":"g-21","topic":"Fees & payments","question":"Do you charge extra for corrections?","answer":"If a correction is needed because the details or documents given were wrong or incomplete, re-filing may involve a new service charge. If the mistake was ours, we fix it at no charge."},{"id":"g-22","topic":"Requests & tracking","question":"How can I track a request?","answer":"Use the Track a request page. It shows how to follow your NISE COMPORT request in your profile, and where to track PAN, certificates and voter ID on the official portals. We also email you when the status changes."},{"id":"g-23","topic":"Requests & tracking","question":"Can I cancel a request?","answer":"Yes, while it is submitted, being reviewed or waiting for you. Open the request in your profile and choose “Cancel this request”. After that stage, call or WhatsApp the desk."},{"id":"g-24","topic":"Requests & tracking","question":"How do I start a request online?","answer":"Choose your service, upload your documents and send the request. You can sign in with an email code, and your details are saved so you do not retype them next time."},{"id":"g-25","topic":"Requests & tracking","question":"How long will my request take?","answer":"It depends on the service and on the government or provider. We tell you the usual time when we confirm the request. Delays on official portals are outside our control."},{"id":"g-26","topic":"Requests & tracking","question":"I lost my reference number. What now?","answer":"Sign in to your profile to see all your request references, or message us your name and approximate date and we will find it."},{"id":"g-27","topic":"Requests & tracking","question":"My application shows ‘under process’. Is that normal?","answer":"Usually yes. It means the department has received it. Check again after a few days. If it stays unchanged for much longer, contact us and we will help you follow up."},{"id":"g-28","topic":"Requests & tracking","question":"Will you tell me when my work is ready?","answer":"Yes. We update your request status, email you, and message you on WhatsApp where possible. You can also check your profile at any time."},{"id":"g-29","topic":"Account & privacy","question":"Do I need an account?","answer":"You can call, WhatsApp or visit without one. An account lets you send requests online, save your details, track progress and see your history."},{"id":"g-30","topic":"Account & privacy","question":"I didn’t get the email code. What should I do?","answer":"Check spam or promotions, wait a minute and use “Resend code”. Only the newest code works, and each code expires after 10 minutes."},{"id":"g-31","topic":"Account & privacy","question":"I forgot my password.","answer":"Use “Forgot password?” on the sign-in page. We email a 6-digit code; after you set a new password, every device is signed out for safety."},{"id":"g-32","topic":"Account & privacy","question":"How does NISE COMPORT use my documents?","answer":"Only to carry out your request. Files are stored privately, visible to you and authorised staff, and deleted after the retention period. See the Privacy policy."},{"id":"g-33","topic":"Account & privacy","question":"How long are uploaded documents kept?","answer":"Files are scheduled for deletion after the retention period (30 days by default, longer only while a request is still open). Avoid uploading documents that are not needed for your request."},{"id":"g-34","topic":"Account & privacy","question":"Should I share OTPs or PINs with staff?","answer":"Never. Enter OTPs, PINs and passwords yourself, only in the official process you started. Our staff will never ask for them."},{"id":"g-35","topic":"Account & privacy","question":"Can I delete my account?","answer":"Yes. Go to Profile → Sign-in & privacy → Delete account. Open requests must be completed or cancelled first."},{"id":"g-36","topic":"Account & privacy","question":"Is my payment information safe?","answer":"We never see or store your card number, UPI PIN or net-banking password. Online payments, when enabled, are handled by a payment partner and your bank."},{"id":"g-37","topic":"Printing & documents","question":"How does online printing work?","answer":"Upload your document, select pages and print preferences, review the estimate, and choose pickup or delivery. We confirm the file and availability before printing."},{"id":"g-38","topic":"Printing & documents","question":"What are your printing rates?","answer":"Black & white is ₹5 per page up to 10 pages, ₹3 for 11–50 and ₹2 above 50; colour is ₹10 per page. See the Pricing page for details."},{"id":"g-39","topic":"Printing & documents","question":"Which file types can I print?","answer":"PDF, Word and common image files work best. If your file will not open, send it on WhatsApp and we will sort it out."},{"id":"g-40","topic":"Printing & documents","question":"Do you scan, photocopy and laminate?","answer":"Yes. We scan, photocopy, print, laminate and spiral-bind at the desk. Ask for today’s rate."},{"id":"g-41","topic":"Printing & documents","question":"Can I get passport-size photos?","answer":"Yes, at the desk. Tell us the size and number you need (for example for PAN, Aadhaar, exams or forms)."},{"id":"s-pan-card-0","topic":"Govt. services","question":"Can NISE COMPORT guarantee PAN approval?","answer":"No. We facilitate the application. PAN issuance and processing are controlled by the authorised provider and tax authorities.","serviceTitle":"PAN Card Application & Correction","serviceHref":"/services/pan-card"},{"id":"s-pan-card-1","topic":"Govt. services","question":"Can I request a correction?","answer":"We can guide you through eligible correction requests after checking the provider's current process and supporting documents.","serviceTitle":"PAN Card Application & Correction","serviceHref":"/services/pan-card"},{"id":"s-pan-card-2","topic":"Govt. services","question":"Can I apply for a new PAN and a correction on the same page?","answer":"The correct route depends on whether a PAN has already been allotted. Tell us which situation applies; the authorised PAN provider's current instructions determine the application type.","serviceTitle":"PAN Card Application & Correction","serviceHref":"/services/pan-card"},{"id":"s-pan-card-3","topic":"Govt. services","question":"Will you guarantee that my PAN is issued?","answer":"No. NISE COMPORT can help prepare and submit an eligible application. The authorised provider and tax authority control verification, processing and issuance.","serviceTitle":"PAN Card Application & Correction","serviceHref":"/services/pan-card"},{"id":"pan-application-0","topic":"Govt. services","question":"Can I apply for a child?","answer":"Use the minor route and include the parent or guardian contact. The official provider determines the representative and evidence requirements.","serviceTitle":"PAN guide: New PAN application","serviceHref":"/pan/application"},{"id":"pan-application-1","topic":"Govt. services","question":"Is there a guaranteed completion date?","answer":"No. Document checks, discrepancies, provider processing and dispatch affect completion. Ask for an update using the acknowledgement from the provider.","serviceTitle":"PAN guide: New PAN application","serviceHref":"/pan/application"},{"id":"pan-application-2","topic":"Govt. services","question":"Will I pay on this website?","answer":"This request does not take payment. The team confirms the assistance charge and any separate provider fee before proceeding.","serviceTitle":"PAN guide: New PAN application","serviceHref":"/pan/application"},{"id":"pan-correction-0","topic":"Govt. services","question":"Can I change the PAN number itself?","answer":"A correction concerns the details associated with an existing PAN. If you believe duplicate PANs were allotted, ask for surrender guidance rather than selecting a new PAN.","serviceTitle":"PAN guide: PAN correction and personal changes","serviceHref":"/pan/correction"},{"id":"pan-correction-1","topic":"Govt. services","question":"Can a correction be edited after submission?","answer":"It depends on the stage and provider. Contact the team promptly with the acknowledgement and correction needed; do not assume a submitted record can be edited.","serviceTitle":"PAN guide: PAN correction and personal changes","serviceHref":"/pan/correction"},{"id":"pan-aadhaar-linking-0","topic":"Govt. services","question":"Does NISE COMPORT validate linking here?","answer":"The official Income Tax portal confirms linking status. Our guide opens that portal; we do not claim to query its records.","serviceTitle":"PAN guide: PAN–Aadhaar linking","serviceHref":"/pan/aadhaar-linking"},{"id":"pan-aadhaar-linking-1","topic":"Govt. services","question":"Is PAN application status the same as linking status?","answer":"No. Application processing, PAN validity and PAN–Aadhaar linkage are different checks.","serviceTitle":"PAN guide: PAN–Aadhaar linking","serviceHref":"/pan/aadhaar-linking"},{"id":"pan-status-0","topic":"Govt. services","question":"Will this site display the live provider status?","answer":"No direct status integration is configured. The tool checks reference formatting and opens the official provider page, where verification is completed and live results appear.","serviceTitle":"PAN guide: Track a PAN application","serviceHref":"/pan/status"},{"id":"pan-status-1","topic":"Govt. services","question":"Is a correctly formatted reference proof of acceptance?","answer":"No. A format check cannot prove that a reference exists or that the application was approved.","serviceTitle":"PAN guide: Track a PAN application","serviceHref":"/pan/status"},{"id":"pan-epan-0","topic":"Govt. services","question":"Are all e-PAN downloads free?","answer":"No universal free-download promise applies. The eligible Instant e-PAN facility and provider downloads are separate services; check the selected portal's terms.","serviceTitle":"PAN guide: Instant e-PAN and e-PAN downloads","serviceHref":"/pan/epan"},{"id":"pan-epan-1","topic":"Govt. services","question":"Can I request a physical card after Instant e-PAN?","answer":"UTIITSL lists a reprint route for eligible Instant e-PAN holders. Check its current instructions rather than applying for another PAN.","serviceTitle":"PAN guide: Instant e-PAN and e-PAN downloads","serviceHref":"/pan/epan"},{"id":"pan-forms-0","topic":"Govt. services","question":"Can I keep using a saved Form 49A?","answer":"Use the current official form downloads. The official providers announced replacement forms from April 2026.","serviceTitle":"PAN guide: PAN forms and document preparation","serviceHref":"/pan/forms"},{"id":"pan-forms-1","topic":"Govt. services","question":"What is an AO code?","answer":"It identifies an assessing-officer jurisdiction for the relevant application. Confirm it using the provider's official lookup or staff guidance; do not guess from a PIN code alone.","serviceTitle":"PAN guide: PAN forms and document preparation","serviceHref":"/pan/forms"},{"id":"pan-reprint-0","topic":"Govt. services","question":"Does a reprint create a different PAN?","answer":"A reprint provides a card for an existing PAN; it is not a new allotment request.","serviceTitle":"PAN guide: Lost or damaged PAN card","serviceHref":"/pan/reprint"},{"id":"pan-reprint-1","topic":"Govt. services","question":"Can I request a plastic or smart card here?","answer":"Confirm the official provider's card format and delivery options. We do not advertise an unofficial format as a distinct government PAN product.","serviceTitle":"PAN guide: Lost or damaged PAN card","serviceHref":"/pan/reprint"},{"id":"pan-issues-0","topic":"Govt. services","question":"Can you promise a refund or approval?","answer":"No. Review the provider's terms and the agreed assistance scope. We can help identify the next step, but cannot guarantee a provider decision.","serviceTitle":"PAN guide: PAN problems and next steps","serviceHref":"/pan/issues"},{"id":"s-aadhaar-0","topic":"Govt. services","question":"Can every Aadhaar update be completed at this desk?","answer":"No. Some updates require an authorised Aadhaar centre or official portal. We will explain the route before collecting any service charge.","serviceTitle":"Aadhaar Service Guidance","serviceHref":"/services/aadhaar"},{"id":"s-aadhaar-1","topic":"Govt. services","question":"Can every Aadhaar change be completed at NISE COMPORT?","answer":"No. Some updates require an authorised Aadhaar centre or official UIDAI process. We can help identify the route, but only the authorised service can make the record change.","serviceTitle":"Aadhaar Service Guidance","serviceHref":"/services/aadhaar"},{"id":"s-aadhaar-2","topic":"Govt. services","question":"Should I give my Aadhaar OTP to staff?","answer":"No. Keep your OTP private and enter it yourself only in the official flow you initiated.","serviceTitle":"Aadhaar Service Guidance","serviceHref":"/services/aadhaar"},{"id":"s-income-caste-residence-certificate-0","topic":"Govt. services","question":"How long does an income certificate take in Jharkhand?","answer":"The Circle Officer (CO) or Revenue Officer verifies the application, sometimes with a local enquiry. Processing time varies by circle office and season; we cannot guarantee a date.","serviceTitle":"Income Certificate Application Help","serviceHref":"/services/income-caste-residence-certificate"},{"id":"s-income-caste-residence-certificate-1","topic":"Govt. services","question":"Can I use this certificate for a scholarship or caste certificate application?","answer":"Many schemes ask for a current income certificate as supporting proof. Check the specific scheme's validity requirement — some departments want one issued within the last 6–12 months.","serviceTitle":"Income Certificate Application Help","serviceHref":"/services/income-caste-residence-certificate"},{"id":"s-income-caste-residence-certificate-2","topic":"Govt. services","question":"Are income, caste, residence and EWS certificates the same application?","answer":"No. They have different eligibility rules and supporting evidence. Select the exact certificate first and follow the current checklist for that application.","serviceTitle":"Income Certificate Application Help","serviceHref":"/services/income-caste-residence-certificate"},{"id":"s-income-caste-residence-certificate-3","topic":"Govt. services","question":"How long does a certificate take?","answer":"The responsible authority controls verification and processing time. NISE COMPORT cannot promise an approval date.","serviceTitle":"Income Certificate Application Help","serviceHref":"/services/income-caste-residence-certificate"},{"id":"s-local-resident-certificate-0","topic":"Govt. services","question":"How is this different from an Income or Caste Certificate?","answer":"A Local Resident Certificate only confirms where you live and for how long. It does not state income or caste, so schools, housing schemes and some ration-card updates ask for it separately.","serviceTitle":"Local Resident","serviceHref":"/services/local-resident-certificate"},{"id":"s-local-resident-certificate-1","topic":"Govt. services","question":"What if I recently moved to Jamshedpur?","answer":"Some circle offices ask for a minimum period of residence or extra proof for recent movers. We check the current rule for your circle before applying.","serviceTitle":"Local Resident","serviceHref":"/services/local-resident-certificate"},{"id":"s-caste-certificate-ebc1-bc2-0","topic":"Govt. services","question":"What is the difference between EBC-I and BC-II?","answer":"These are two separate Jharkhand backward-class categories, each with its own list of communities. The category is decided by which list the applicant's caste appears in, not by choice — we check the current official list before applying.","serviceTitle":"EBC-I / BC-II","serviceHref":"/services/caste-certificate-ebc1-bc2"},{"id":"s-caste-certificate-ebc1-bc2-1","topic":"Govt. services","question":"Does this certificate expire?","answer":"Non-creamy-layer caste certificates are commonly asked to be renewed periodically (often annually) for admissions and jobs, since they also certify current family income. Check the specific requirement of the scheme you are applying to.","serviceTitle":"EBC-I / BC-II","serviceHref":"/services/caste-certificate-ebc1-bc2"},{"id":"s-caste-certificate-sc-0","topic":"Govt. services","question":"Do I need a new SC certificate if my father already has one?","answer":"Many offices accept the father's certificate as supporting proof, but each applicant (for a job, admission or scholarship) is usually still asked for their own certificate issued in their name.","serviceTitle":"SC","serviceHref":"/services/caste-certificate-sc"},{"id":"s-caste-certificate-sc-1","topic":"Govt. services","question":"What if my caste is listed as SC in one state but I live in Jharkhand?","answer":"SC/ST lists are state-specific under the Constitution (Scheduled Castes) Order. A certificate from another state is often not valid for Jharkhand benefits — check with the issuing authority before applying.","serviceTitle":"SC","serviceHref":"/services/caste-certificate-sc"},{"id":"s-caste-certificate-st-0","topic":"Govt. services","question":"Why does an ST certificate sometimes take longer than SC or OBC?","answer":"ST verification often involves checking ancestral village and community records, and some circle offices require a local enquiry or village-head confirmation. This can add time compared to other categories.","serviceTitle":"ST","serviceHref":"/services/caste-certificate-st"},{"id":"s-caste-certificate-st-1","topic":"Govt. services","question":"My tribe is listed as ST in another state. Is it valid in Jharkhand?","answer":"No. ST lists are state-specific. A certificate from another state is generally not valid for Jharkhand reservation benefits.","serviceTitle":"ST","serviceHref":"/services/caste-certificate-st"},{"id":"s-marriage-registration-certificate-0","topic":"Govt. services","question":"Is marriage registration compulsory in Jharkhand?","answer":"Registration is strongly recommended and often required for passport, visa, bank and legal purposes, regardless of how the marriage ceremony itself was performed.","serviceTitle":"Marriage Registration Certificate Help","serviceHref":"/services/marriage-registration-certificate"},{"id":"s-marriage-registration-certificate-1","topic":"Govt. services","question":"Can we register a marriage that happened years ago?","answer":"Yes, delayed registration is usually possible but may need additional documents or an affidavit explaining the delay. The registering authority decides what is required.","serviceTitle":"Marriage Registration Certificate Help","serviceHref":"/services/marriage-registration-certificate"},{"id":"s-voter-id-0","topic":"Govt. services","question":"Does this desk issue the voter ID card?","answer":"No. We help you fill and submit the correct ECI form. The Booth Level Officer and Electoral Registration Officer carry out verification, and the Election Commission of India approves and issues or updates the EPIC.","serviceTitle":"Voter ID","serviceHref":"/services/voter-id"},{"id":"s-voter-id-1","topic":"Govt. services","question":"How do I track my voter ID application?","answer":"Use the Reference ID shown after you submit the form (in the format starting with your state code, e.g. S27...) on voters.eci.gov.in under \"Track Application Status\", or the ECINET app. We can help you check it at our desk.","serviceTitle":"Voter ID","serviceHref":"/services/voter-id"},{"id":"s-voter-id-2","topic":"Govt. services","question":"Can I register to vote online without visiting an Aadhaar-linked mobile?","answer":"The OTP for Form 6 goes to the mobile number linked to the Aadhaar you enter, so that phone needs to be with the applicant when the form is submitted. If you don't have Aadhaar, you can still apply by declaring that you don't have one.","serviceTitle":"Voter ID","serviceHref":"/services/voter-id"},{"id":"s-voter-id-3","topic":"Govt. services","question":"Does NISE COMPORT issue a Voter ID card?","answer":"No. We can help with form navigation and application preparation. The Election Commission verifies the request and maintains the electoral roll.","serviceTitle":"Voter ID","serviceHref":"/services/voter-id"},{"id":"s-voter-id-4","topic":"Govt. services","question":"Can I apply for a correction and a new registration together?","answer":"The correct form depends on your current electoral-roll status and the change requested. Check the official election-service guidance before submitting.","serviceTitle":"Voter ID","serviceHref":"/services/voter-id"},{"id":"s-passport-driving-licence-0","topic":"Govt. services","question":"Can NISE COMPORT approve my passport or licence?","answer":"No. Verification, appointments, testing, approval and issuance remain with the relevant authority.","serviceTitle":"Passport & Driving Licence Form Assistance","serviceHref":"/services/passport-driving-licence"},{"id":"s-passport-driving-licence-1","topic":"Govt. services","question":"How do I know whether to choose a fresh passport or re-issue?","answer":"Passport Seva separates fresh and re-issue applications. Check the official application guidance against your passport history and the service you need before selecting a category.","serviceTitle":"Passport & Driving Licence Form Assistance","serviceHref":"/services/passport-driving-licence"},{"id":"s-passport-driving-licence-2","topic":"Govt. services","question":"Do I need to attend a Passport Seva appointment in person?","answer":"The official process requires applicants to attend the selected Passport Seva Kendra or Post Office Passport Seva Kendra with the appointment details and original documents. Confirm the instructions for your application on Passport Seva.","serviceTitle":"Passport & Driving Licence Form Assistance","serviceHref":"/services/passport-driving-licence"},{"id":"s-passport-driving-licence-3","topic":"Govt. services","question":"Which passport documents should I bring?","answer":"The accepted documents vary by applicant, application category and circumstances. Use the official Passport Seva Document Advisor for your case; the short list on this page is only a preparation reminder.","serviceTitle":"Passport & Driving Licence Form Assistance","serviceHref":"/services/passport-driving-licence"},{"id":"s-passport-driving-licence-4","topic":"Govt. services","question":"Can NISE COMPORT issue my passport or guarantee an appointment?","answer":"No. We can help with form navigation and preparation. Passport Seva and the relevant authorities control appointments, verification, fees, processing and issuance.","serviceTitle":"Passport & Driving Licence Form Assistance","serviceHref":"/services/passport-driving-licence"},{"id":"s-aeps-money-transfer-0","topic":"Banking & AEPS","question":"Are all bank services available every day?","answer":"Availability depends on partner systems, service hours and transaction limits. Contact us before travelling for a time-sensitive transaction.","serviceTitle":"Assisted Banking, AEPS & Money Transfer","serviceHref":"/services/aeps-money-transfer"},{"id":"s-aeps-money-transfer-1","topic":"Banking & AEPS","question":"Should I share my banking OTP or PIN with staff?","answer":"Never disclose your PIN or OTP. Enter confidential credentials yourself through the authorised partner flow.","serviceTitle":"Assisted Banking, AEPS & Money Transfer","serviceHref":"/services/aeps-money-transfer"},{"id":"s-aeps-money-transfer-2","topic":"Banking & AEPS","question":"Are AEPS or cash services always available?","answer":"Availability depends on the partner network, service hours, account rules and transaction limits. Contact the service desk before travelling for a time-sensitive transaction.","serviceTitle":"Assisted Banking, AEPS & Money Transfer","serviceHref":"/services/aeps-money-transfer"},{"id":"s-aeps-money-transfer-3","topic":"Banking & AEPS","question":"Should I tell staff my banking PIN or OTP?","answer":"No. Never disclose your PIN or OTP. Complete confidential verification yourself in the authorised banking flow.","serviceTitle":"Assisted Banking, AEPS & Money Transfer","serviceHref":"/services/aeps-money-transfer"},{"id":"s-bike-insurance-0","topic":"Insurance","question":"Is an insurance quote the final premium?","answer":"No. The insurer calculates the final premium and determines eligibility, coverage and issuance.","serviceTitle":"Two-Wheeler Insurance Assistance","serviceHref":"/services/bike-insurance"},{"id":"s-bike-insurance-1","topic":"Insurance","question":"Is third-party insurance compulsory for bikes?","answer":"Yes. Riding without at least third-party cover is an offence under the Motor Vehicles Act (₹2,000 fine and/or up to 3 months for a first offence).","serviceTitle":"Two-Wheeler Insurance Assistance","serviceHref":"/services/bike-insurance"},{"id":"s-bike-insurance-2","topic":"Insurance","question":"Can you guarantee a premium or claim?","answer":"No. The insurer decides eligibility, premium, coverage, exclusions and claim outcomes. We help with the paperwork and follow-up all the way.","serviceTitle":"Two-Wheeler Insurance Assistance","serviceHref":"/services/bike-insurance"},{"id":"s-bike-insurance-3","topic":"Insurance","question":"What should I compare before renewing?","answer":"Premium, IDV, NCB applied, add-ons (zero depreciation, roadside help), cashless garages nearby and the insurer's claim record.","serviceTitle":"Two-Wheeler Insurance Assistance","serviceHref":"/services/bike-insurance"},{"id":"s-bike-insurance-4","topic":"Insurance","question":"My bike policy expired. Can I still renew?","answer":"Yes. Don't ride until it's renewed. The insurer may ask for an inspection. Renew within 90 days of expiry to keep your NCB.","serviceTitle":"Two-Wheeler Insurance Assistance","serviceHref":"/services/bike-insurance"},{"id":"s-bike-insurance-5","topic":"Insurance","question":"Which insurers can you quote?","answer":"We compare from the insurers we're tied up with at the time, which can include public and private general insurers. Ask us for the current list.","serviceTitle":"Two-Wheeler Insurance Assistance","serviceHref":"/services/bike-insurance"},{"id":"s-car-insurance-0","topic":"Insurance","question":"Does NISE COMPORT underwrite policies?","answer":"No. We facilitate enquiries. The insurer decides eligibility, coverage, premium and issuance.","serviceTitle":"Car Insurance & Renewal Assistance","serviceHref":"/services/car-insurance"},{"id":"s-car-insurance-1","topic":"Insurance","question":"Comprehensive or third-party only?","answer":"Third-party is the legal minimum and pays for damage to others only. Comprehensive also covers your own car against accidents, theft, fire and floods. For most cars under 10 years old, comprehensive is worth it.","serviceTitle":"Car Insurance & Renewal Assistance","serviceHref":"/services/car-insurance"},{"id":"s-car-insurance-2","topic":"Insurance","question":"Does an online quote guarantee the final premium?","answer":"No. The insurer confirms eligibility, vehicle details, coverage and final premium before issuing a policy.","serviceTitle":"Car Insurance & Renewal Assistance","serviceHref":"/services/car-insurance"},{"id":"s-car-insurance-3","topic":"Insurance","question":"Who decides whether a claim is paid?","answer":"The insurance company that issued your policy applies its terms and decides claims. NISE COMPORT does not underwrite policies or decide claims, and isn't liable for the insurer's decision, but we help you register, document and follow up the claim to the end.","serviceTitle":"Car Insurance & Renewal Assistance","serviceHref":"/services/car-insurance"},{"id":"s-car-insurance-4","topic":"Insurance","question":"What is a cashless claim?","answer":"At the insurer's network garage, the insurer pays the garage directly. You pay only the deductible, depreciation (unless you have zero dep) and anything not covered.","serviceTitle":"Car Insurance & Renewal Assistance","serviceHref":"/services/car-insurance"},{"id":"s-car-insurance-5","topic":"Insurance","question":"Can I keep my NCB if I sell the car?","answer":"Yes. Ask for an NCB certificate or retention letter; you can use it on your next car's policy, usually within 3 years.","serviceTitle":"Car Insurance & Renewal Assistance","serviceHref":"/services/car-insurance"},{"id":"s-health-life-insurance-0","topic":"Insurance","question":"Can you recommend or guarantee a claim outcome?","answer":"We can help with the application process, but policy suitability, underwriting and claim decisions belong to the insurer.","serviceTitle":"Health, Life & Personal Insurance Enquiry Help","serviceHref":"/services/health-life-insurance"},{"id":"s-health-life-insurance-1","topic":"Insurance","question":"Can NISE COMPORT recommend a policy or promise returns?","answer":"We can help with an enquiry or application route where available. Product suitability, advice, underwriting, returns and claims are governed by the insurer or authorised provider.","serviceTitle":"Health, Life & Personal Insurance Enquiry Help","serviceHref":"/services/health-life-insurance"},{"id":"s-health-life-insurance-2","topic":"Insurance","question":"What information might an insurer request?","answer":"The insurer decides what information is needed for the selected product. Provide accurate details directly through its authorised application flow.","serviceTitle":"Health, Life & Personal Insurance Enquiry Help","serviceHref":"/services/health-life-insurance"},{"id":"s-scholarship-forms-0","topic":"Students & exams","question":"Can you confirm scholarship eligibility?","answer":"The relevant institution or department sets eligibility and makes the final decision. We help interpret the published checklist.","serviceTitle":"Student, Scholarship & Admission Form Assistance","serviceHref":"/services/scholarship-forms"},{"id":"s-scholarship-forms-1","topic":"Students & exams","question":"Can NISE COMPORT confirm that a student is eligible?","answer":"No. The scheme or institution sets eligibility and makes the final decision. We can help you understand the published checklist.","serviceTitle":"Student, Scholarship & Admission Form Assistance","serviceHref":"/services/scholarship-forms"},{"id":"s-scholarship-forms-2","topic":"Students & exams","question":"What should I bring for an online form?","answer":"Bring the official link or notification and the identity, education, bank or category documents the current instructions request.","serviceTitle":"Student, Scholarship & Admission Form Assistance","serviceHref":"/services/scholarship-forms"},{"id":"s-exam-forms-0","topic":"Students & exams","question":"Will staff choose answers or certify my information?","answer":"No. The applicant is responsible for the truth and accuracy of all information and must review the form before submission.","serviceTitle":"Exam, Recruitment & Online Form Filling","serviceHref":"/services/exam-forms"},{"id":"s-exam-forms-1","topic":"Students & exams","question":"Will NISE COMPORT choose my answers or certify my details?","answer":"No. You are responsible for the accuracy of your information and must review the completed application before submission.","serviceTitle":"Exam, Recruitment & Online Form Filling","serviceHref":"/services/exam-forms"},{"id":"s-exam-forms-2","topic":"Students & exams","question":"Can you guarantee the form will be accepted?","answer":"No. The recruiting body, examination authority or institution controls eligibility, acceptance and later stages.","serviceTitle":"Exam, Recruitment & Online Form Filling","serviceHref":"/services/exam-forms"},{"id":"s-itr-gst-0","topic":"Forms & business","question":"Is this legal or tax advice?","answer":"Routine portal assistance is not a substitute for advice from a qualified tax professional. Complex tax positions should be reviewed by one.","serviceTitle":"ITR, GST & Business Form Assistance","serviceHref":"/services/itr-gst"},{"id":"s-itr-gst-1","topic":"Forms & business","question":"Does form-filling assistance count as tax advice?","answer":"No. Portal navigation and document preparation do not replace advice from a qualified tax professional. Complex tax positions should be reviewed by one.","serviceTitle":"ITR, GST & Business Form Assistance","serviceHref":"/services/itr-gst"},{"id":"s-itr-gst-2","topic":"Forms & business","question":"Who is responsible for the submitted information?","answer":"The applicant or business owner is responsible for accurate source details and should review the final form before it is submitted.","serviceTitle":"ITR, GST & Business Form Assistance","serviceHref":"/services/itr-gst"},{"id":"s-computer-repair-0","topic":"Hardware & PC","question":"Are all computer brands and parts in stock?","answer":"Availability changes. Contact the team with the model or requirement for a current answer.","serviceTitle":"Computer, Printer & CCTV Assistance","serviceHref":"/services/computer-repair"},{"id":"s-computer-repair-1","topic":"Hardware & PC","question":"Do you have every product or part in stock?","answer":"Availability changes. Contact the team with the model and requirement for a current answer.","serviceTitle":"Computer, Printer & CCTV Assistance","serviceHref":"/services/computer-repair"},{"id":"s-computer-repair-2","topic":"Hardware & PC","question":"Will repair work start before I approve the estimate?","answer":"The team should confirm the scope and estimate with you before proceeding.","serviceTitle":"Computer, Printer & CCTV Assistance","serviceHref":"/services/computer-repair"},{"id":"s-lic-policy-0","topic":"Insurance","question":"Can NISE COMPORT change or approve my LIC policy?","answer":"No. We can help you navigate an available service route. LIC controls policy servicing, underwriting, claims and official records.","serviceTitle":"LIC Policy Information & Service Assistance","serviceHref":"/services/lic-policy"},{"id":"s-lic-policy-1","topic":"Insurance","question":"Can you advise which life policy I should buy?","answer":"This page offers process assistance, not financial advice or a policy recommendation. Review product terms with LIC or an appropriately authorised adviser.","serviceTitle":"LIC Policy Information & Service Assistance","serviceHref":"/services/lic-policy"},{"id":"s-lic-policy-2","topic":"Insurance","question":"Can NISE COMPORT settle a claim or change LIC records?","answer":"No. LIC controls policy records, servicing, underwriting and claim decisions. We can help identify a route or prepare an enquiry.","serviceTitle":"LIC Policy Information & Service Assistance","serviceHref":"/services/lic-policy"},{"id":"s-lic-policy-3","topic":"Insurance","question":"Should I share a policy login password or OTP?","answer":"No. Enter credentials yourself only on the official LIC service you initiated.","serviceTitle":"LIC Policy Information & Service Assistance","serviceHref":"/services/lic-policy"},{"id":"s-mutual-fund-sip-0","topic":"Banking & AEPS","question":"Will NISE COMPORT recommend a fund or promise returns?","answer":"No. This is process assistance only. Investments can go up or down; returns are not guaranteed. Seek advice from an appropriately authorised financial adviser.","serviceTitle":"SIP & Mutual Fund Process Enquiry","serviceHref":"/services/mutual-fund-sip"},{"id":"s-mutual-fund-sip-1","topic":"Banking & AEPS","question":"Can I share my OTP or investment credentials?","answer":"Never share OTPs, passwords or investment account credentials with staff. Enter them yourself only in the authorised provider process.","serviceTitle":"SIP & Mutual Fund Process Enquiry","serviceHref":"/services/mutual-fund-sip"},{"id":"s-mutual-fund-sip-2","topic":"Banking & AEPS","question":"Will this desk choose an SIP or fund for me?","answer":"No. This is administrative process guidance, not financial advice or an investment recommendation.","serviceTitle":"SIP & Mutual Fund Process Enquiry","serviceHref":"/services/mutual-fund-sip"},{"id":"s-mutual-fund-sip-3","topic":"Banking & AEPS","question":"Are SIP returns guaranteed?","answer":"No. Mutual fund investments are subject to market risk and returns are not guaranteed. Read the scheme information and consult an authorised adviser if you need advice.","serviceTitle":"SIP & Mutual Fund Process Enquiry","serviceHref":"/services/mutual-fund-sip"},{"id":"s-rent-agreement-0","topic":"Forms & business","question":"Is a typed agreement or NOC legal advice?","answer":"No. Document typing and process assistance are not legal advice. Parties should obtain legal review when rights, obligations or disputes are involved.","serviceTitle":"Rent Agreement & NOC Form Assistance","serviceHref":"/services/rent-agreement"},{"id":"s-rent-agreement-1","topic":"Forms & business","question":"Can you guarantee that a document will be accepted?","answer":"No. Acceptance depends on the receiving institution and applicable legal or registration requirements.","serviceTitle":"Rent Agreement & NOC Form Assistance","serviceHref":"/services/rent-agreement"},{"id":"s-rent-agreement-2","topic":"Forms & business","question":"Does typing a rent agreement make it legally valid?","answer":"Typing alone does not determine validity. Applicable requirements depend on the document and circumstances; get legal advice and confirm stamp or registration steps.","serviceTitle":"Rent Agreement & NOC Form Assistance","serviceHref":"/services/rent-agreement"},{"id":"s-rent-agreement-3","topic":"Forms & business","question":"Can you decide what terms should be included?","answer":"The parties provide and approve their terms. NISE COMPORT provides document or process assistance, not legal advice.","serviceTitle":"Rent Agreement & NOC Form Assistance","serviceHref":"/services/rent-agreement"},{"id":"s-fssai-license-0","topic":"Forms & business","question":"Can NISE COMPORT issue an FSSAI licence?","answer":"No. We may assist with an eligible application process. FSSAI and the responsible authority determine category, verification, approval and issuance.","serviceTitle":"FSSAI Food Business Registration Assistance","serviceHref":"/services/fssai-license"},{"id":"s-fssai-license-1","topic":"Forms & business","question":"Which FSSAI category do I need?","answer":"The correct category depends on current rules, business activity and scale. Confirm it using official FSSAI guidance before applying.","serviceTitle":"FSSAI Food Business Registration Assistance","serviceHref":"/services/fssai-license"},{"id":"s-fssai-license-2","topic":"Forms & business","question":"Does every food business use the same FSSAI application?","answer":"No. The appropriate route depends on the current rules and the business activity and scale. Confirm the category through official FSSAI guidance.","serviceTitle":"FSSAI Food Business Registration Assistance","serviceHref":"/services/fssai-license"},{"id":"s-fssai-license-3","topic":"Forms & business","question":"Can NISE COMPORT guarantee a licence?","answer":"No. The authority reviews the application and makes the decision. We can assist with preparation and portal navigation where available.","serviceTitle":"FSSAI Food Business Registration Assistance","serviceHref":"/services/fssai-license"},{"id":"s-udyam-registration-0","topic":"Forms & business","question":"Does NISE COMPORT issue an MSME certificate?","answer":"No. Udyam registration is handled through the official government portal. We can assist with navigation and preparation; the portal issues the registration record.","serviceTitle":"Udyam & MSME Registration Assistance","serviceHref":"/services/udyam-registration"},{"id":"s-udyam-registration-1","topic":"Forms & business","question":"Is Udyam registration free on the official portal?","answer":"Check the current official Udyam portal for its latest terms. Any separate assistance charge will be explained before you proceed.","serviceTitle":"Udyam & MSME Registration Assistance","serviceHref":"/services/udyam-registration"},{"id":"s-udyam-registration-2","topic":"Forms & business","question":"Is Udyam registration handled by NISE COMPORT?","answer":"No. Registration is through the official government portal. NISE COMPORT can help with process navigation; the portal handles the record.","serviceTitle":"Udyam & MSME Registration Assistance","serviceHref":"/services/udyam-registration"},{"id":"s-udyam-registration-3","topic":"Forms & business","question":"What assistance charge applies?","answer":"We explain any separate assistance fee before you decide. Check the official portal for its current terms and do not confuse an assistance charge with a government fee.","serviceTitle":"Udyam & MSME Registration Assistance","serviceHref":"/services/udyam-registration"},{"id":"s-jeevan-pramaan-0","topic":"Govt. services","question":"Must the pensioner come in person?","answer":"Yes. Authentication must be done by the pensioner through the official process. A family member cannot authenticate on their behalf.","serviceTitle":"Jeevan Pramaan Digital Life Certificate Help","serviceHref":"/services/jeevan-pramaan"},{"id":"s-jeevan-pramaan-1","topic":"Govt. services","question":"When is the life certificate due?","answer":"Timing depends on your pension scheme and disbursing authority; many pensioners submit it annually. Check with your bank or pension office for your deadline.","serviceTitle":"Jeevan Pramaan Digital Life Certificate Help","serviceHref":"/services/jeevan-pramaan"},{"id":"s-jeevan-pramaan-2","topic":"Govt. services","question":"What if authentication fails?","answer":"Fingerprints can be hard to read, especially for older pensioners. We can retry or explain other routes your pension authority accepts. Final acceptance rests with the pension-disbursing authority.","serviceTitle":"Jeevan Pramaan Digital Life Certificate Help","serviceHref":"/services/jeevan-pramaan"},{"id":"s-birth-death-certificate-0","topic":"Govt. services","question":"Is late registration possible?","answer":"Delayed registration is possible, but it usually needs additional documents or orders, depending on the delay. The registrar decides what is required.","serviceTitle":"Birth & Death Certificate Application Help","serviceHref":"/services/birth-death-certificate"},{"id":"s-birth-death-certificate-1","topic":"Govt. services","question":"Can you issue the certificate?","answer":"No. Certificates are issued by the registrar of births and deaths. We help you prepare and submit the application correctly.","serviceTitle":"Birth & Death Certificate Application Help","serviceHref":"/services/birth-death-certificate"},{"id":"s-land-mutation-0","topic":"Govt. services","question":"How long does mutation take?","answer":"The circle office and revenue authority control verification and timelines. We cannot promise a date.","serviceTitle":"Land Mutation","serviceHref":"/services/land-mutation"},{"id":"s-land-mutation-1","topic":"Govt. services","question":"Is this legal advice?","answer":"No. We help with the online application. For disputes or unclear titles, consult a qualified advocate.","serviceTitle":"Land Mutation","serviceHref":"/services/land-mutation"},{"id":"s-aadhaar-pvc-card-0","topic":"Govt. services","question":"Is a shop-printed PVC card the same?","answer":"No. The official Aadhaar PVC card is printed and posted by UIDAI. Cards printed elsewhere are not the official PVC card.","serviceTitle":"Aadhaar PVC Card Order Help","serviceHref":"/services/aadhaar-pvc-card"},{"id":"s-aadhaar-pvc-card-1","topic":"Govt. services","question":"My address is old. What should I do?","answer":"Update your address first, then order the PVC card, because the card goes to the address on record.","serviceTitle":"Aadhaar PVC Card Order Help","serviceHref":"/services/aadhaar-pvc-card"},{"id":"s-bank-account-opening-0","topic":"Banking & AEPS","question":"Does NISE COMPORT open the account?","answer":"No. The partner bank opens and runs the account. We help with the process as its Business Correspondent point, where available.","serviceTitle":"Bank Account Opening Assistance","serviceHref":"/services/bank-account-opening"},{"id":"s-bank-account-opening-1","topic":"Banking & AEPS","question":"Is there a minimum balance?","answer":"Rules differ by account type and are set by the bank. We explain the bank's current terms before you apply.","serviceTitle":"Bank Account Opening Assistance","serviceHref":"/services/bank-account-opening"},{"id":"s-ayushman-card-0","topic":"Govt. services","question":"Who can get an Ayushman card?","answer":"Families on the eligibility list, and every person aged 70 or more regardless of income. We check the list for you before starting.","serviceTitle":"Ayushman Card","serviceHref":"/services/ayushman-card"},{"id":"s-ayushman-card-1","topic":"Govt. services","question":"Can I get the card the same day?","answer":"If the family is already eligible and verification works, the card is often ready quickly. Some cards need approval, which can take a few days.","serviceTitle":"Ayushman Card","serviceHref":"/services/ayushman-card"},{"id":"s-ration-card-0","topic":"Govt. services","question":"How long does a new ration card take?","answer":"It depends on the department's verification. We give you the acknowledgement number and check the status for you.","serviceTitle":"Ration Card Application & Correction Help","serviceHref":"/services/ration-card"},{"id":"s-ration-card-1","topic":"Govt. services","question":"Can I add my newborn child?","answer":"Yes. Bring the child's birth certificate, Aadhaar if made, and the existing ration card.","serviceTitle":"Ration Card Application & Correction Help","serviceHref":"/services/ration-card"},{"id":"s-abua-awas-yojana-0","topic":"Govt. services","question":"Does NISE COMPORT approve housing applications?","answer":"No. Selection and approval are done by the Jharkhand government. We help you prepare a complete application.","serviceTitle":"Abua Awas Yojana Application Help","serviceHref":"/services/abua-awas-yojana"},{"id":"s-abua-awas-yojana-1","topic":"Govt. services","question":"What if I don't have an income certificate?","answer":"We can apply for the income certificate first. Bring an income affidavit and your identity proof.","serviceTitle":"Abua Awas Yojana Application Help","serviceHref":"/services/abua-awas-yojana"},{"id":"s-laptop-repair-0","topic":"Hardware & PC","question":"Will my data be safe during a laptop repair?","answer":"Please back up your files before handing the laptop over. Many repairs, such as a screen or battery change, do not touch data, but we cannot guarantee that for every fault.","serviceTitle":"Laptop Repair & Service","serviceHref":"/services/laptop-repair"},{"id":"s-laptop-repair-1","topic":"Hardware & PC","question":"Do you start work before I approve the estimate?","answer":"No. We confirm the scope and the estimate with you first.","serviceTitle":"Laptop Repair & Service","serviceHref":"/services/laptop-repair"},{"id":"s-laptop-repair-2","topic":"Hardware & PC","question":"Are genuine parts used?","answer":"It depends on the model and availability. We tell you which part is proposed before it is fitted.","serviceTitle":"Laptop Repair & Service","serviceHref":"/services/laptop-repair"},{"id":"s-desktop-repair-0","topic":"Hardware & PC","question":"Can you build a PC for my needs?","answer":"We can discuss your budget and use (study, office or gaming) and suggest a configuration. Part availability and prices are confirmed at the time of purchase.","serviceTitle":"Desktop & PC Repair","serviceHref":"/services/desktop-repair"},{"id":"s-desktop-repair-1","topic":"Hardware & PC","question":"Is my data safe when you repair the PC?","answer":"Please back up important files before handing the PC over. We cannot guarantee data on a failing drive.","serviceTitle":"Desktop & PC Repair","serviceHref":"/services/desktop-repair"},{"id":"s-website-creation-0","topic":"Print & digital","question":"Who owns the website?","answer":"You do. We confirm domain and hosting ownership with you in writing before work starts.","serviceTitle":"Website Creation for Your Business","serviceHref":"/services/website-creation"},{"id":"s-website-design-0","topic":"Print & digital","question":"Can you guarantee a search ranking?","answer":"No provider can guarantee a specific ranking. Search visibility depends on competition, useful content, technical quality and ongoing business signals.","serviceTitle":"Website & Digital Support for Local Businesses","serviceHref":"/services/website-design"},{"id":"s-website-design-1","topic":"Print & digital","question":"Can a website project guarantee a Google ranking?","answer":"No. Search visibility depends on useful content, site quality, competition and local business information; no ranking position can be guaranteed.","serviceTitle":"Website & Digital Support for Local Businesses","serviceHref":"/services/website-design"},{"id":"s-website-design-2","topic":"Print & digital","question":"What should I prepare before asking for a website estimate?","answer":"Prepare your business summary, service list, approved contact details, available brand assets and examples of what you want the site to help customers do.","serviceTitle":"Website & Digital Support for Local Businesses","serviceHref":"/services/website-design"},{"id":"s-photo-studio-0","topic":"Print & digital","question":"Can you print my photos or a poster in A4, A3 or A2?","answer":"Yes. Bring the photos on your phone, pen drive or memory card, tell us the size and copies, and we confirm the charge before printing. For clear results the file must be large enough for the size.","serviceTitle":"Photo Studio, Photo Prints & A4/A3/A2 Printing","serviceHref":"/services/photo-studio"},{"id":"s-photo-studio-1","topic":"Print & digital","question":"Will my photo be accepted by an application?","answer":"We cannot guarantee acceptance. Check the current photo rules for your form or authority before you visit, and we will help you match them.","serviceTitle":"Photo Studio, Photo Prints & A4/A3/A2 Printing","serviceHref":"/services/photo-studio"},{"id":"s-photo-studio-2","topic":"Print & digital","question":"Can you help with a photo for an online form?","answer":"We can take and size a photo to the rules you share. Confirm the requirements before visiting.","serviceTitle":"Photo Studio, Photo Prints & A4/A3/A2 Printing","serviceHref":"/services/photo-studio"},{"id":"s-printer-repair-0","topic":"Hardware & PC","question":"Can you repair a printer that is under warranty?","answer":"Warranty repairs usually go through the manufacturer's service centre. Tell us the model and we will explain the route before anything is opened.","serviceTitle":"Printer Repair & Service","serviceHref":"/services/printer-repair"},{"id":"s-printer-repair-1","topic":"Hardware & PC","question":"Do you set up a printer on Wi-Fi?","answer":"Yes, network setup is part of our printer enquiries. Tell us the model and your network details when you ask.","serviceTitle":"Printer Repair & Service","serviceHref":"/services/printer-repair"},{"id":"s-data-recovery-0","topic":"Hardware & PC","question":"Can every lost file be recovered?","answer":"No. Results depend on the cause and condition of the device, and we cannot promise recovery.","serviceTitle":"Data Recovery Enquiry","serviceHref":"/services/data-recovery"},{"id":"s-data-recovery-1","topic":"Hardware & PC","question":"Should I keep using the drive?","answer":"No. Continued use can overwrite the lost data. Stop and contact us first.","serviceTitle":"Data Recovery Enquiry","serviceHref":"/services/data-recovery"},{"id":"s-pc-build-0","topic":"Hardware & PC","question":"Will you tell me the price before I buy?","answer":"Yes. We share the latest price for each part and the total before you approve anything.","serviceTitle":"Custom PC Build Quote","serviceHref":"/services/pc-build"},{"id":"s-pc-build-1","topic":"Hardware & PC","question":"Can I build a PC on a small budget?","answer":"Yes. Tell us your budget and we will suggest what gives the best performance within it.","serviceTitle":"Custom PC Build Quote","serviceHref":"/services/pc-build"},{"id":"s-hardware-quote-0","topic":"Hardware & PC","question":"Are prices fixed on this page?","answer":"No. Prices change often, so we confirm the latest price on WhatsApp before you buy.","serviceTitle":"Hardware Parts & Accessories Quote","serviceHref":"/services/hardware-quote"},{"id":"s-hardware-quote-1","topic":"Hardware & PC","question":"Can I buy only one item?","answer":"Yes. A single item is fine; the request is the same.","serviceTitle":"Hardware Parts & Accessories Quote","serviceHref":"/services/hardware-quote"},{"id":"s-software-upgrade-0","topic":"Hardware & PC","question":"Will my files be kept?","answer":"We recommend a backup first. We cannot guarantee data on an older or failing device.","serviceTitle":"Software Upgrade & Installation Help","serviceHref":"/services/software-upgrade"},{"id":"s-hardware-upgrade-0","topic":"Hardware & PC","question":"Will every laptop take an upgrade?","answer":"Not all. Some laptops have soldered memory. We check your model before you buy anything.","serviceTitle":"Hardware Upgrade","serviceHref":"/services/hardware-upgrade"},{"id":"s-coreldraw-design-0","topic":"Print & digital","question":"Can you print the design too?","answer":"Yes. We can print it at our desk or give you print-ready files to print elsewhere.","serviceTitle":"CorelDRAW Design: Logo, UI/UX, Banner & Poster","serviceHref":"/services/coreldraw-design"},{"id":"s-custom-printing-0","topic":"Print & digital","question":"What items can you print?","answer":"Tell us what you have in mind and we will confirm what we can print.","serviceTitle":"Custom Printing for Your Order","serviceHref":"/services/custom-printing"},{"id":"s-printing-scanning-0","topic":"Print & digital","question":"Do I need to upload my file?","answer":"No. Ask for the price first, then bring the file on your phone or a pen drive, or send it on WhatsApp once the price is agreed.","serviceTitle":"Printing, Scanning & Photocopy","serviceHref":"/services/printing-scanning"},{"id":"s-printing-scanning-1","topic":"Print & digital","question":"How do I know the price?","answer":"Send us the pages, size and colour and we reply with the exact price before we print.","serviceTitle":"Printing, Scanning & Photocopy","serviceHref":"/services/printing-scanning"},{"id":"s-printing-scanning-2","topic":"Print & digital","question":"Do I need to upload my file online?","answer":"No. Ask us for the price on WhatsApp or by phone, then bring the file or send it once the price is agreed.","serviceTitle":"Printing, Scanning & Photocopy","serviceHref":"/services/printing-scanning"},{"id":"s-printing-scanning-3","topic":"Print & digital","question":"Can I choose only some pages or make selected pages colour?","answer":"Yes. Tell us the page numbers and colour needs when you ask for the price.","serviceTitle":"Printing, Scanning & Photocopy","serviceHref":"/services/printing-scanning"}],"topics":["About us","Visiting us","Fees & payments","Requests & tracking","Account & privacy","Printing & documents","Govt. services","Banking & AEPS","Insurance","Students & exams","Forms & business","Hardware & PC","Print & digital"],"lang":"en"}]}],"$L13"]}],null,"$L14"]}],"p":"$@15","v":null,"s":"$7"}}]]
