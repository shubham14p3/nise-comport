19:["$","section","how-we-protect-it",{"id":"how-we-protect-it","className":"legal-section","children":[["$","h2",null,{"children":[7,". ","How we protect it"]}],[["$","p","0",{"children":[["$","$2","0",{"children":[false,[["$","$2","0",{"children":"We use reasonable security practices: encrypted connections, passwords stored as one-way hashes, short-lived sign-in codes, limits on repeated failed attempts, private file storage, an encrypted channel between your browser and our servers, signed payment confirmations, and access rules so that staff see only what they need. No system is perfectly secure, and we cannot promise absolute security. You can help by keeping your password private, signing out on shared devices and never sharing OTPs."}]]]}]]}],["$","p","1",{"children":[["$","$2","0",{"children":[false,[["$","$2","0",{"children":"If a breach affects your personal data, we will tell you and the authorities as the law requires."}]]]}]]}]]]}]
