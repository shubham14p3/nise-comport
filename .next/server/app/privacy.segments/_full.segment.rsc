3e:["$","section","how-we-protect-it",{"id":"how-we-protect-it","className":"legal-section","children":[["$","h2",null,{"children":[7,". ","How we protect it"]}],[["$","p","0",{"children":[["$","$1","0",{"children":[false,[["$","$1","0",{"children":"We use reasonable security practices: encrypted connections, passwords stored as one-way hashes, short-lived sign-in codes, limits on repeated failed attempts, private file storage, an encrypted channel between your browser and our servers, signed payment confirmations, and access rules so that staff see only what they need. No system is perfectly secure, and we cannot promise absolute security. You can help by keeping your password private, signing out on shared devices and never sharing OTPs."}]]]}]]}],["$","p","1",{"children":[["$","$1","0",{"children":[false,[["$","$1","0",{"children":"If a breach affects your personal data, we will tell you and the authorities as the law requires."}]]]}]]}]]]}]
3f:["$","section","your-rights-and-choices",{"id":"your-rights-and-choices","className":"legal-section","children":[["$","h2",null,{"children":[8,". ","Your rights and choices"]}],[["$","p","0",{"children":[["$","$1","0",{"children":[false,[["$","$1","0",{"children":"Under Indian law you can ask us to: tell you what personal data we hold and how it is used; correct or complete it; erase it; and nominate someone to act for you if you cannot. You can also withdraw consent to messages and to data use, and make a complaint."}]]]}]]}],["$","ul","1",{"children":[["$","li","0",{"children":["$","span",null,{"children":[["$","$1","0",{"children":"View and correct your details in "}],["$","$1","1",{"children":["$","b",null,{"children":"Profile"}]}],["$","$1","2",{"children":"; change your password or sign-in email; sign out of other devices."}]]}]}],["$","li","1",{"children":["$","span",null,{"children":[["$","$1","0",{"children":"Delete your account under "}],["$","$1","1",{"children":["$","b",null,{"children":"Profile → Sign-in & privacy"}]}],["$","$1","2",{"children":". This removes your name, email, phone and saved addresses."}]]}]}],["$","li","2",{"children":["$","span",null,{"children":[["$","$1","0",{"children":"For anything else, email "}],["$","a","1",{"href":"mailto:info@nisecomport.com","rel":"noopener noreferrer","children":"info@nisecomport.com"}],["$","$1","2",{"children":" or call +91 97712 19893. We may need to confirm who you are first. We reply within 30 days or sooner."}]]}]}]]}],["$","p","2",{"children":[["$","$1","0",{"children":[false,[["$","$1","0",{"children":"Some data must be kept by law even after you ask for deletion; we will tell you what and why."}]]]}]]}]]]}]
40:["$","section","cookies-and-analytics",{"id":"cookies-and-analytics","className":"legal-section","children":[["$","h2",null,{"children":[9,". ","Cookies and analytics"]}],[["$","p","0",{"children":[["$","$1","0",{"children":[false,[["$","$1","0",{"children":"We use cookies and similar storage that keep you signed in, protect forms and the site from attacks, and remember settings such as language. We may use privacy-friendly analytics and search tools to understand how the site is found and used; they are not used to sell your data. You can block cookies in your browser, but sign-in may then not work."}]]]}]]}]]]}]
41:["$","section","links-and-third-party-sites",{"id":"links-and-third-party-sites","className":"legal-section","children":[["$","h2",null,{"children":[10,". ","Links and third-party sites"]}],[["$","p","0",{"children":[["$","$1","0",{"children":[false,[["$","$1","0",{"children":"Our pages link to official portals and other websites. We do not control them and are not responsible for their content or privacy practices. Please read their policies before you enter your details."}]]]}]]}]]]}]
