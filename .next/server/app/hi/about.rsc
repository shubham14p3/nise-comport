26:["$","div",null,{"className":"about-story__body","children":[false,[["$","p",null,{"children":["हमने 1995 में ",["$","b",null,{"children":"NISE"}]," के रूप में शुरुआत की, खरंगाझार, टेल्को में अपने मोहल्ले के लिए एक छोटा कंप्यूटर और डिजिटल सेवा डेस्क। लोग प्रिंट-आउट या फ़ॉर्म के लिए आते थे, और इसलिए रुके क्योंकि कोई धैर्य से समझाता था कि आगे क्या करना है।"]}],["$","p",null,{"children":["सालों में यह ",["$","b",null,{"children":"NISE COMPORT"}]," बन गया: एक CSC / प्रज्ञा केंद्र सेवा केंद्र, जहाँ परिवार, छात्र, दुकानदार और वरिष्ठ नागरिक एक ही जगह पैन और आधार में मदद, झारखंड के प्रमाण पत्र, बैंकिंग और AEPS, बीमा, ऑनलाइन फ़ॉर्म, प्रिंटिंग तथा कंप्यूटर की बिक्री और मरम्मत पाते हैं।"]}]],false,["$","p",null,{"className":"about-story__quote","children":"“आपकी वजह से हम NISE से NISE COMPORT तक पहुँचे हैं। हमने अपना उसूल कभी नहीं भुलाया: हर व्यक्ति की ईमानदारी से सेवा, आज उपलब्ध सबसे अच्छे दाम पर।”"}],["$","p",null,{"children":"हम अपने समुदाय की सेवा जारी रखने और ऐसी और सेवाएँ जोड़ने की आशा रखते हैं जो उसे आगे बढ़ाएँ।"}]]}]
