26:["$","section","हम-इस-क-स-स-रक-ष-त-रखत-ह",{"id":"हम-इस-क-स-स-रक-ष-त-रखत-ह","className":"legal-section","children":[["$","h2",null,{"children":[7,". ","हम इसे कैसे सुरक्षित रखते हैं"]}],[["$","p","0",{"children":[["$","$1","0",{"children":[false,[["$","$1","0",{"children":"हम उचित सुरक्षा उपाय अपनाते हैं: एन्क्रिप्टेड कनेक्शन, एकतरफ़ा हैश के रूप में सहेजे पासवर्ड, अल्पकालिक साइन-इन कोड, बार-बार विफल प्रयासों पर सीमा, निजी फ़ाइल भंडारण, आपके ब्राउज़र और हमारे सर्वरों के बीच एन्क्रिप्टेड चैनल, हस्ताक्षरित भुगतान पुष्टियाँ, और पहुँच के नियम ताकि स्टाफ़ केवल वही देखे जो उसे चाहिए। कोई भी सिस्टम पूरी तरह सुरक्षित नहीं होता, और हम पूर्ण सुरक्षा का वादा नहीं कर सकते। आप अपना पासवर्ड निजी रखकर, साझा डिवाइस पर साइन-आउट करके और OTP कभी साझा न करके मदद कर सकते हैं।"}]]]}]]}],["$","p","1",{"children":[["$","$1","0",{"children":[false,[["$","$1","0",{"children":"यदि किसी उल्लंघन से आपका व्यक्तिगत डेटा प्रभावित होता है, तो हम कानून की माँग के अनुसार आपको और अधिकारियों को बताएँगे।"}]]]}]]}]]]}]
27:["$","section","आपक-अध-क-र-और-व-कल-प",{"id":"आपक-अध-क-र-और-व-कल-प","className":"legal-section","children":[["$","h2",null,{"children":[8,". ","आपके अधिकार और विकल्प"]}],[["$","p","0",{"children":[["$","$1","0",{"children":[false,[["$","$1","0",{"children":"भारतीय कानून के तहत आप हमसे कह सकते हैं कि: हम बताएँ कि हमारे पास आपका कौन-सा व्यक्तिगत डेटा है और वह कैसे उपयोग होता है; उसे सुधारें या पूरा करें; उसे मिटाएँ; और यदि आप स्वयं न कर सकें तो अपनी ओर से काम करने के लिए किसी को नामित करें। आप संदेशों और डेटा उपयोग के लिए सहमति वापस भी ले सकते हैं, और शिकायत कर सकते हैं।"}]]]}]]}],["$","ul","1",{"children":[["$","li","0",{"children":["$","span",null,{"children":[["$","$1","0",{"children":["$","b",null,{"children":"प्रोफ़ाइल"}]}],["$","$1","1",{"children":" में अपनी जानकारी देखिए और सुधारिए; अपना पासवर्ड या साइन-इन ईमेल बदलिए; अन्य डिवाइस से साइन-आउट कीजिए।"}]]}]}],["$","li","1",{"children":["$","span",null,{"children":[["$","$1","0",{"children":["$","b",null,{"children":"प्रोफ़ाइल → साइन-इन और गोपनीयता"}]}],["$","$1","1",{"children":" में अपना खाता हटाइए। इससे आपका नाम, ईमेल, फ़ोन और सहेजे गए पते हट जाते हैं।"}]]}]}],["$","li","2",{"children":["$","span",null,{"children":[["$","$1","0",{"children":"किसी और बात के लिए "}],["$","a","1",{"href":"mailto:info@nisecomport.com","rel":"noopener noreferrer","children":"info@nisecomport.com"}],["$","$1","2",{"children":" पर ईमेल कीजिए या +91 97712 19893 पर कॉल कीजिए। हमें पहले आपकी पहचान की पुष्टि करनी पड़ सकती है। हम 30 दिन के भीतर या उससे पहले जवाब देते हैं।"}]]}]}]]}],["$","p","2",{"children":[["$","$1","0",{"children":[false,[["$","$1","0",{"children":"कुछ डेटा कानून के कारण आपके हटाने के अनुरोध के बाद भी रखना पड़ता है; हम बताएँगे कि क्या और क्यों।"}]]]}]]}]]]}]
