22:["$","section","स-व-क-त-समय-स-म-और-त-सर-पक-ष",{"id":"स-व-क-त-समय-स-म-और-त-सर-पक-ष","className":"legal-section","children":[["$","h2",null,{"children":[7,". ","स्वीकृति, समय-सीमा और तीसरे पक्ष"]}],[["$","p","0",{"children":[["$","$2","0",{"children":[false,[["$","$2","0",{"children":"स्वीकृति, अस्वीकृति, प्रक्रिया का समय, शुल्क और नियम संबंधित विभाग, बैंक, बीमा कंपनी या प्रदाता तय करते हैं, हम नहीं। हम स्वीकृति, किसी विशेष तारीख या किसी तीसरे पक्ष के पोर्टल की उपलब्धता की "}],["$","$2","1",{"children":["$","b",null,{"children":"गारंटी नहीं दे सकते"}]}],["$","$2","2",{"children":", जो धीमा, बदला हुआ या बंद हो सकता है। जहाँ किसी पोर्टल, कूरियर या प्रदाता की वजह से देरी, नुकसान या गलती हो, हम फ़ॉलो-अप में आपकी मदद करेंगे पर उनके कामों के लिए ज़िम्मेदार नहीं हैं।"}]]]}]]}],["$","p","1",{"children":[["$","$2","0",{"children":[false,[["$","$2","0",{"children":"हमारी वेबसाइट, गाइड और चैट की जानकारी केवल सामान्य मार्गदर्शन है और कानूनी, कर, वित्तीय या बीमा सलाह नहीं है। आधिकारिक नियम बदलते रहते हैं; हमेशा आधिकारिक स्रोत देखिए। यदि आप किसी अंतिम तारीख पर निर्भर हैं, तो हमें जल्दी बताइए।"}]]]}]]}]]]}]
23:["$","section","अत-र-क-त-शर-त-व-ल-स-व-ए",{"id":"अत-र-क-त-शर-त-व-ल-स-व-ए","className":"legal-section","children":[["$","h2",null,{"children":[8,". ","अतिरिक्त शर्तों वाली सेवाएँ"]}],[["$","h3","0",{"children":"बैंकिंग, AEPS और बिल भुगतान"}],["$","p","1",{"children":[["$","$2","0",{"children":[false,[["$","$2","0",{"children":"नकद और ट्रांसफ़र सेवाएँ हमारे केंद्र पर लागू बैंकिंग पार्टनरों और नियमों के ज़रिए दी जाती हैं। लेन-देन की सीमाएँ, शुल्क, विफलताएँ और वापसी उन पार्टनरों और बैंकों के नियमों के अनुसार होती हैं। अपनी पर्ची सँभालकर रखिए। जो विफल लेन-देन आपके खाते से कट गया, उसे बैंक सामान्यतः बैंकिंग नियमों में तय अवधि के भीतर लौटा देता है।"}]]]}]]}],["$","h3","2",{"children":"बीमा"}],["$","p","3",{"children":[["$","$2","0",{"children":[false,[["$","$2","0",{"children":"पॉलिसी बीमा कंपनियाँ जारी करती हैं; हम तुलना, फ़ॉर्म, दस्तावेज़ और नवीनीकरण में मदद करते हैं। प्रीमियम, कवर, अपवाद, क्लेम और नवीनीकरण बीमा कंपनी तय करती है। कृपया पॉलिसी की शब्दावली पढ़िए। हर प्रासंगिक तथ्य सच-सच बताइए; गलत जानकारी से क्लेम अस्वीकार हो सकता है।"}]]]}]]}],["$","h3","4",{"children":"प्रिंटिंग, स्कैनिंग और फ़ोटो"}],["$","p","5",{"children":[["$","$2","0",{"children":[false,[["$","$2","0",{"children":"प्रिंट का अनुमान आपकी पसंद पर निर्भर करता है और फ़ाइल जाँचने के बाद बदल सकता है। छापने से पहले प्रूफ़ में वर्तनी और लेआउट जाँच लीजिए। आपकी मंज़ूरी के अनुसार किया गया काम वापस नहीं हो सकता, पर यदि गलती हमारी हो तो हम दोबारा प्रिंट करेंगे या उस ऑर्डर का रिफ़ंड देंगे। आपकी अपलोड की गई फ़ाइलें केवल वैसे रखी जाती हैं जैसा "}],["$","$L12","1",{"href":"/privacy","children":"गोपनीयता नीति"}],["$","$2","2",{"children":" में बताया गया है।"}]]]}]]}],["$","h3","6",{"children":"कंप्यूटर, IT उत्पाद और मरम्मत"}],["$","p","7",{"children":[["$","$2","0",{"children":[false,[["$","$2","0",{"children":"जाँच, पुर्ज़ों और मरम्मत का शुल्क काम से पहले बताया जाता है। उत्पादों पर निर्माता की वारंटी, यदि हो, मिलती है और वह उसकी शर्तों के अधीन है। मरम्मत के लिए डिवाइस देने से पहले कृपया "}],["$","$2","1",{"children":["$","b",null,{"children":"अपने डेटा का बैकअप ले लीजिए"}]}],["$","$2","2",{"children":"; कानून जितना माँगे उसके सिवा डेटा खोने के लिए हम ज़िम्मेदार नहीं हैं। कृपया हमारे “तैयार” संदेश के 30 दिन के भीतर मरम्मत किया डिवाइस ले जाइए; उसके बाद हम उचित भंडारण शुल्क ले सकते हैं और डिवाइस के लिए ज़िम्मेदार नहीं होंगे।"}]]]}]]}]]]}]
24:["$","section","स-व-क-र-य-उपय-ग",{"id":"स-व-क-र-य-उपय-ग","className":"legal-section","children":[["$","h2",null,{"children":[9,". ","स्वीकार्य उपयोग"]}],[["$","p","0",{"children":[["$","$2","0",{"children":[false,[["$","$2","0",{"children":"आप नहीं करेंगे: झूठे या जाली दस्तावेज़ या पहचान देना; हमारी सेवाओं का किसी भी गैरकानूनी काम में उपयोग, जिसमें मनी लॉन्ड्रिंग, किसी और का रूप धरना या सरकारी योजना में धोखा शामिल है; किसी दूसरे व्यक्ति के दस्तावेज़ उसकी अनुमति के बिना अपलोड करना; हमारे स्टाफ़ को परेशान करना या धमकाना; प्रोमो कोड, ऑफ़र या वॉलेट का दुरुपयोग; हमारी वेबसाइट को तोड़ने, स्क्रैप करने, ओवरलोड करने या उसकी सुरक्षा परखने की कोशिश; या हमारे चैनलों से स्पैम भेजना। हम किसी अनुरोध को मना या रोक सकते हैं, और कानून की माँग के अनुसार संदिग्ध गैरकानूनी गतिविधि की सूचना अधिकारियों को दे सकते हैं।"}]]]}]]}]]]}]
25:["$","section","क-ल-whatsapp-और-ईम-ल",{"id":"क-ल-whatsapp-और-ईम-ल","className":"legal-section","children":[["$","h2",null,{"children":[10,". ","कॉल, WhatsApp और ईमेल"]}],[["$","p","0",{"children":[["$","$2","0",{"children":[false,[["$","$2","0",{"children":"अनुरोध भेजकर या हमें अपना नंबर देकर आप सहमत होते हैं कि हम आपके अनुरोध, भुगतान और खाते के बारे में आपसे कॉल, SMS, WhatsApp और ईमेल से संपर्क कर सकते हैं। ऑफ़र और अपडेट के लिए हम आपकी सहमति माँगते हैं; आप WhatsApp पर STOP लिख सकते हैं या किसी भी समय हमें रुकने को कह सकते हैं। हम आम सवालों के जवाब देने के लिए WhatsApp पर एक स्वचालित सहायक इस्तेमाल कर सकते हैं और बाकी संदेश अपनी टीम को देते हैं; चैट सहेजी जाती हैं ताकि हमारा स्टाफ़ फ़ॉलो-अप कर सके।"}]]]}]]}]]]}]
26:["$","section","व-ल-ट-क-र-ड-ट-और-क-पन",{"id":"व-ल-ट-क-र-ड-ट-और-क-पन","className":"legal-section","children":[["$","h2",null,{"children":[11,". ","वॉलेट क्रेडिट और कूपन"]}],[["$","p","0",{"children":[["$","$2","0",{"children":[false,[["$","$2","0",{"children":"वॉलेट क्रेडिट और कूपन का कोई नकद मूल्य नहीं है, उन्हें किसी को सौंपा या बेचा नहीं जा सकता, और उनका उपयोग केवल हमारे सेवा शुल्क या प्रिंट के कुल खर्च में उतना ही हो सकता है जितना ऑफ़र अनुमति दे। रिफ़ंड के रूप में दिया गया क्रेडिट उपयोग होने तक आपके खाते में रहता है। दुरुपयोग या गलती से मिले क्रेडिट या कूपन हम वापस ले सकते हैं।"}]]]}]]}]]]}]
27:["$","section","हम-र-व-बस-इट-और-स-मग-र",{"id":"हम-र-व-बस-इट-और-स-मग-र","className":"legal-section","children":[["$","h2",null,{"children":[12,". ","हमारी वेबसाइट और सामग्री"]}],[["$","p","0",{"children":[["$","$2","0",{"children":[false,[["$","$2","0",{"children":"वेबसाइट, उसका डिज़ाइन, टेक्स्ट, गाइड और लोगो NISE COMPORT के हैं या अनुमति से इस्तेमाल हैं। आप उन्हें अपने निजी उद्देश्यों के लिए देख और उपयोग कर सकते हैं, पर हमारी लिखित अनुमति के बिना उनकी नकल, पुनर्विक्रय या पुनः प्रकाशन नहीं कर सकते। तीसरे पक्ष के नाम और लोगो उनके स्वामियों के ही रहते हैं।"}]]]}]]}]]]}]
28:["$","section","अस-व-करण-और-द-य-त-व-क-स-म-ए",{"id":"अस-व-करण-और-द-य-त-व-क-स-म-ए","className":"legal-section","children":[["$","h2",null,{"children":[13,". ","अस्वीकरण और दायित्व की सीमाएँ"]}],[["$","p","0",{"children":[["$","$2","0",{"children":[false,[["$","$2","0",{"children":"हम अपने काम में सावधानी रखते हैं, पर हमारी सेवाएँ आपकी दी जानकारी और तीसरे पक्षों पर निर्भर करती हैं। कानून जितनी अनुमति देता है उस हद तक: वेबसाइट और हमारा मार्गदर्शन “जैसा है वैसा” दिया जाता है; आपकी दी गई गलत जानकारी या दस्तावेज़ों, तीसरे पक्ष के पोर्टल, बैंक, बीमा कंपनी, कूरियर या नेटवर्क, या हमारे नियंत्रण से बाहर की घटनाओं जैसे बिजली या इंटरनेट की विफलता, हड़ताल, प्राकृतिक घटनाओं या कानून में बदलाव से हुए नुकसान के लिए हम उत्तरदायी नहीं हैं; और अप्रत्यक्ष या परिणामी नुकसान, मुनाफ़े या अवसर के नुकसान के लिए भी हम उत्तरदायी नहीं हैं।"}]]]}]]}],["$","p","1",{"children":[["$","$2","0",{"children":[false,[["$","$2","0",{"children":"जहाँ किसी अनुरोध से जुड़े नुकसान के लिए हमें ज़िम्मेदार पाया जाए, वहाँ उस अनुरोध के लिए हमारा कुल दायित्व उस अनुरोध के लिए आपके द्वारा हमें दिए गए सेवा शुल्क की रकम तक सीमित है, "}],["$","$2","1",{"children":["$","b",null,{"children":"सिवाय"}]}],["$","$2","2",{"children":" वहाँ जहाँ कानून सीमा की अनुमति नहीं देता, जैसे धोखाधड़ी या जानबूझकर किए गलत काम, या मृत्यु या व्यक्तिगत चोट के मामले में। "}],["$","$2","3",{"children":["$","b",null,{"children":"इन शर्तों की कोई बात उपभोक्ता संरक्षण अधिनियम, 2019 या किसी अन्य कानून के तहत उपभोक्ता के रूप में आपके अधिकार नहीं छीनती।"}]}]]]}]]}],["$","p","2",{"children":[["$","$2","0",{"children":[false,[["$","$2","0",{"children":"आप सहमत हैं कि आपकी झूठी जानकारी या दस्तावेज़ देने, या इन शर्तों या कानून को तोड़ने से हुए हमारे नुकसान की आप भरपाई करेंगे।"}]]]}]]}]]]}]
