 वेबसाइट (nisecomport.com), WhatsApp चैट और दुकान नंबर 3, भूतल, सिंह बिल्डिंग, हनुमान मंदिर रोड, खरंगाझार, टेल्को कॉलोनी, जमशेदपुर, झारखंड 831004 पर स्थित हमारे सेवा केंद्र के आपके उपयोग पर लागू होती हैं। खाता बनाकर, अनुरोध भेजकर, हमें भुगतान करके या वेबसाइट का उपयोग करके आप इनसे सहमत होते हैं। यदि आप सहमत नहीं हैं, तो कृपया हमारी सेवाओं का उपयोग न करें। ये शर्तें बताती हैं कि आप हमसे क्या अपेक्षा कर सकते हैं और हम आपसे क्या अपेक्षा करते हैं।"}]]]}]]}]]}],["$","nav",null,{"className":"legal-toc","aria-label":"विषय-सूची","children":[["$","b",null,{"children":"इस नीति में"}],["$","ol",null,{"children":[["$","li","हम-क-न-ह-और-क-य-करत-ह",{"children":["$","a",null,{"href":"#हम-क-न-ह-और-क-य-करत-ह","children":"हम कौन हैं और क्या करते हैं"}]}],["$","li","आपक-ख-त",{"children":["$","a",null,{"href":"#आपक-ख-त","children":"आपका खाता"}]}],["$","li","अन-र-ध-और-हम-क-स-क-म-करत-ह",{"children":["$","a",null,{"href":"#अन-र-ध-और-हम-क-स-क-म-करत-ह","children":"अनुरोध और हम कैसे काम करते हैं"}]}],["$","li","आपक-ज-म-म-द-र-य",{"children":["$","a",null,{"href":"#आपक-ज-म-म-द-र-य","children":"आपकी ज़िम्मेदारियाँ"}]}],["$","li","श-ल-क-और-प-रभ-र",{"children":["$","a",null,{"href":"#श-ल-क-और-प-रभ-र","children":"शुल्क और प्रभार"}]}],["$","li","भ-गत-न",{"children":["$","a",null,{"href":"#भ-गत-न","children":"भुगतान"}]}],["$","li","स-व-क-त-समय-स-म-और-त-सर-पक-ष",{"children":["$","a",null,{"href":"#स-व-क-त-समय-स-म-और-त-सर-पक-ष","children":"स्वीकृति, समय-सीमा और तीसरे पक्ष"}]}],["$","li","अत-र-क-त-शर-त-व-ल-स-व-ए",{"children":["$","a",null,{"href":"#अत-र-क-त-शर-त-व-ल-स-व-ए","children":"अतिरिक्त शर्तों वाली सेवाएँ"}]}],["$","li","स-व-क-र-य-उपय-ग",{"children":["$","a",null,{"href":"#स-व-क-र-य-उपय-ग","children":"स्वीकार्य उपयोग"}]}],"$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b"]}]]}],["$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c"],"$L2d"]}]]}],null,"$L2e"]}],"p":"$@2f","v":null,"s":"$6"}}]]
