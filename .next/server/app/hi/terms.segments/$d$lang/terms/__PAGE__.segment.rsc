1c:["$","section","हम-क-न-ह-और-क-य-करत-ह",{"id":"हम-क-न-ह-और-क-य-करत-ह","className":"legal-section","children":[["$","h2",null,{"children":[1,". ","हम कौन हैं और क्या करते हैं"]}],[["$","p","0",{"children":[["$","$2","0",{"children":[false,[["$","$2","0",{"children":"NISE COMPORT खरंगाझार, टेल्को, जमशेदपुर, झारखंड में एक "}],["$","$2","1",{"children":["$","b",null,{"children":"स्वतंत्र CSC / प्रज्ञा केंद्र सेवा केंद्र"}]}],["$","$2","2",{"children":" है। हम व्यक्तियों और छोटे व्यवसायों को ऑनलाइन फ़ॉर्म और आवेदनों, दस्तावेज़ों, प्रमाण पत्रों, बैंकिंग और भुगतान सहायता (AEPS और बिल भुगतान सहित), बीमा संबंधी कागज़ी काम, प्रिंटिंग, स्कैनिंग और फ़ोटो सेवाओं, तथा कंप्यूटर और IT हार्डवेयर, मरम्मत और एक्सेसरीज़ में मदद करते हैं।"}]]]}]]}],["$","p","1",{"children":[["$","$2","0",{"children":[false,[["$","$2","0",{"children":["$","b",null,{"children":"हम कोई सरकारी विभाग, बैंक, बीमा कंपनी, अदालत, चुनाव कार्यालय या कोई अन्य प्राधिकरण नहीं हैं।"}]}],["$","$2","1",{"children":" CSC, प्रज्ञा केंद्र, डिजिटल इंडिया, आधार, पैन, डिजीलॉकर, वोटर आईडी, उद्यम या पासपोर्ट जैसे नाम उनके स्वामियों के हैं। हम उनका उपयोग केवल उन सेवाओं का वर्णन करने के लिए करते हैं जिनका उपयोग करने में हम ग्राहकों की मदद करते हैं। हम आपके और संबंधित प्राधिकरण, पोर्टल या प्रदाता के बीच एक सहायक के रूप में काम करते हैं।"}]]]}]]}]]]}]
1d:["$","section","आपक-ख-त",{"id":"आपक-ख-त","className":"legal-section","children":[["$","h2",null,{"children":[2,". ","आपका खाता"]}],[["$","p","0",{"children":[["$","$2","0",{"children":[false,[["$","$2","0",{"children":"खाता बनाते समय या अनुरोध भेजते समय आपको सही, पूरी और वर्तमान जानकारी देनी होगी। अपने साइन-इन विवरण को सुरक्षित रखने और अपने खाते से किए गए हर काम की ज़िम्मेदारी आपकी है। यदि आपको लगे कि किसी और ने आपका खाता इस्तेमाल किया है, तो तुरंत हमें बताइए। खाता बनाने के लिए आपकी आयु कम से कम 18 वर्ष होनी चाहिए; माता-पिता या अभिभावक किसी बच्चे की ओर से हमारी सेवाओं का उपयोग कर सकते हैं और दी गई जानकारी की ज़िम्मेदारी लेते हैं।"}]]]}]]}],["$","p","1",{"children":[["$","$2","0",{"children":[false,[["$","$2","0",{"children":"हम ऐसे खाते को निलंबित या बंद कर सकते हैं जो झूठी जानकारी देता हो, गैरकानूनी रूप से इस्तेमाल हो, हमारे स्टाफ़ से बदसलूकी करे या इन शर्तों को तोड़े।"}]]]}]]}]]]}]
1e:["$","section","अन-र-ध-और-हम-क-स-क-म-करत-ह",{"id":"अन-र-ध-और-हम-क-स-क-म-करत-ह","className":"legal-section","children":[["$","h2",null,{"children":[3,". ","अनुरोध और हम कैसे काम करते हैं"]}],[["$","p","0",{"children":[["$","$2","0",{"children":[false,[["$","$2","0",{"children":"अनुरोध भेजना इस बात का वादा नहीं है कि हम उसे स्वीकार करेंगे। पहले हम आपकी जानकारी और दस्तावेज़ जाँचते हैं। जहाँ और जानकारी चाहिए होगी, हम आपसे कॉल, WhatsApp या ईमेल से संपर्क करेंगे। हमारा सेवा शुल्क, कोई भी सरकारी या तीसरे पक्ष का शुल्क, और कोई भी कूरियर या प्रिंटिंग लागत, जहाँ संभव हो, काम शुरू होने से पहले आपको बता दी जाती है। शुल्क तय होने पर और, जहाँ हम माँगें, भुगतान होने पर काम शुरू होता है।"}]]]}]]}],["$","p","1",{"children":[["$","$2","0",{"children":[false,[["$","$2","0",{"children":"आप जो जानकारी और दस्तावेज़ हमें देते हैं, उनसे हम आपका माँगा हुआ काम तैयार करते और जमा करते हैं। आप हमें अधिकृत करते हैं कि हम वह जानकारी संबंधित पोर्टल पर दर्ज करें, जहाँ प्रक्रिया अनुमति दे वहाँ आपकी ओर से प्राधिकरण, बीमा कंपनी या बैंक से बात करें, और केवल आपके अनुरोध के उद्देश्य से दस्तावेज़ इकट्ठा करें।"}]]]}]]}]]]}]
1f:["$","section","आपक-ज-म-म-द-र-य",{"id":"आपक-ज-म-म-द-र-य","className":"legal-section","children":[["$","h2",null,{"children":[4,". ","आपकी ज़िम्मेदारियाँ"]}],[["$","ul","0",{"children":[["$","li","0",{"children":["$","span",null,{"children":[["$","$2","0",{"children":"पूरी और सही जानकारी, तथा वैध, असली दस्तावेज़ दीजिए जो आपके हैं या जिन्हें साझा करने की आपको अनुमति है।"}]]}]}],["$","li","1",{"children":["$","span",null,{"children":[["$","$2","0",{"children":"हमारे जमा करने से पहले हर फ़ॉर्म, ड्राफ़्ट या पूर्वावलोकन की जानकारी जाँच लीजिए। एक बार जमा होने के बाद कई पोर्टल बदलाव की अनुमति नहीं देते, और सुधार में अतिरिक्त समय और खर्च लग सकता है।"}]]}]}],["$","li","2",{"children":["$","span",null,{"children":[["$","$2","0",{"children":"आपको जारी की गई कोई भी पावती, आवेदन संख्या, रसीद या पासवर्ड सँभालकर रखिए।"}]]}]}],["$","li","3",{"children":["$","span",null,{"children":[["$","$2","0",{"children":"जब हम और जानकारी माँगें तो जल्दी जवाब दीजिए। जो अनुरोध लंबे समय तक आपकी प्रतीक्षा में रहता है, उसे बंद किया जा सकता है।"}]]}]}],["$","li","4",{"children":["$","span",null,{"children":[["$","$2","0",{"children":"OTP, UPI PIN, कार्ड की जानकारी या पासवर्ड कभी किसी से साझा न करें। हम आपसे कभी UPI PIN या कार्ड नंबर नहीं माँगेंगे। हम आपसे कहें कि आप स्वयं OTP दर्ज करें, या जो OTP आपको मिला है वह आधिकारिक प्रक्रिया के लिए पढ़कर सुनाएँ, तो वह केवल तभी होगा जब वह प्रक्रिया ऐसा माँगे।"}]]}]}]]}]]]}]
