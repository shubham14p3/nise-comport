23:["$","section","आपक-ख-त",{"id":"आपक-ख-त","className":"legal-section","children":[["$","h2",null,{"children":[2,". ","आपका खाता"]}],[["$","p","0",{"children":[["$","$1","0",{"children":[false,[["$","$1","0",{"children":"खाता बनाते समय या अनुरोध भेजते समय आपको सही, पूरी और वर्तमान जानकारी देनी होगी। अपने साइन-इन विवरण को सुरक्षित रखने और अपने खाते से किए गए हर काम की ज़िम्मेदारी आपकी है। यदि आपको लगे कि किसी और ने आपका खाता इस्तेमाल किया है, तो तुरंत हमें बताइए। खाता बनाने के लिए आपकी आयु कम से कम 18 वर्ष होनी चाहिए; माता-पिता या अभिभावक किसी बच्चे की ओर से हमारी सेवाओं का उपयोग कर सकते हैं और दी गई जानकारी की ज़िम्मेदारी लेते हैं।"}]]]}]]}],["$","p","1",{"children":[["$","$1","0",{"children":[false,[["$","$1","0",{"children":"हम ऐसे खाते को निलंबित या बंद कर सकते हैं जो झूठी जानकारी देता हो, गैरकानूनी रूप से इस्तेमाल हो, हमारे स्टाफ़ से बदसलूकी करे या इन शर्तों को तोड़े।"}]]]}]]}]]]}]
24:["$","section","अन-र-ध-और-हम-क-स-क-म-करत-ह",{"id":"अन-र-ध-और-हम-क-स-क-म-करत-ह","className":"legal-section","children":[["$","h2",null,{"children":[3,". ","अनुरोध और हम कैसे काम करते हैं"]}],[["$","p","0",{"children":[["$","$1","0",{"children":[false,[["$","$1","0",{"children":"अनुरोध भेजना इस बात का वादा नहीं है कि हम उसे स्वीकार करेंगे। पहले हम आपकी जानकारी और दस्तावेज़ जाँचते हैं। जहाँ और जानकारी चाहिए होगी, हम आपसे कॉल, WhatsApp या ईमेल से संपर्क करेंगे। हमारा सेवा शुल्क, कोई भी सरकारी या तीसरे पक्ष का शुल्क, और कोई भी कूरियर या प्रिंटिंग लागत, जहाँ संभव हो, काम शुरू होने से पहले आपको बता दी जाती है। शुल्क तय होने पर और, जहाँ हम माँगें, भुगतान होने पर काम शुरू होता है।"}]]]}]]}],["$","p","1",{"children":[["$","$1","0",{"children":[false,[["$","$1","0",{"children":"आप जो जानकारी और दस्तावेज़ हमें देते हैं, उनसे हम आपका माँगा हुआ काम तैयार करते और जमा करते हैं। आप हमें अधिकृत करते हैं कि हम वह जानकारी संबंधित पोर्टल पर दर्ज करें, जहाँ प्रक्रिया अनुमति दे वहाँ आपकी ओर से प्राधिकरण, बीमा कंपनी या बैंक से बात करें, और केवल आपके अनुरोध के उद्देश्य से दस्तावेज़ इकट्ठा करें।"}]]]}]]}]]]}]
25:["$","section","आपक-ज-म-म-द-र-य",{"id":"आपक-ज-म-म-द-र-य","className":"legal-section","children":[["$","h2",null,{"children":[4,". ","आपकी ज़िम्मेदारियाँ"]}],[["$","ul","0",{"children":[["$","li","0",{"children":["$","span",null,{"children":[["$","$1","0",{"children":"पूरी और सही जानकारी, तथा वैध, असली दस्तावेज़ दीजिए जो आपके हैं या जिन्हें साझा करने की आपको अनुमति है।"}]]}]}],["$","li","1",{"children":["$","span",null,{"children":[["$","$1","0",{"children":"हमारे जमा करने से पहले हर फ़ॉर्म, ड्राफ़्ट या पूर्वावलोकन की जानकारी जाँच लीजिए। एक बार जमा होने के बाद कई पोर्टल बदलाव की अनुमति नहीं देते, और सुधार में अतिरिक्त समय और खर्च लग सकता है।"}]]}]}],["$","li","2",{"children":["$","span",null,{"children":[["$","$1","0",{"children":"आपको जारी की गई कोई भी पावती, आवेदन संख्या, रसीद या पासवर्ड सँभालकर रखिए।"}]]}]}],["$","li","3",{"children":["$","span",null,{"children":[["$","$1","0",{"children":"जब हम और जानकारी माँगें तो जल्दी जवाब दीजिए। जो अनुरोध लंबे समय तक आपकी प्रतीक्षा में रहता है, उसे बंद किया जा सकता है।"}]]}]}],["$","li","4",{"children":["$","span",null,{"children":[["$","$1","0",{"children":"OTP, UPI PIN, कार्ड की जानकारी या पासवर्ड कभी किसी से साझा न करें। हम आपसे कभी UPI PIN या कार्ड नंबर नहीं माँगेंगे। हम आपसे कहें कि आप स्वयं OTP दर्ज करें, या जो OTP आपको मिला है वह आधिकारिक प्रक्रिया के लिए पढ़कर सुनाएँ, तो वह केवल तभी होगा जब वह प्रक्रिया ऐसा माँगे।"}]]}]}]]}]]]}]
26:["$","section","श-ल-क-और-प-रभ-र",{"id":"श-ल-क-और-प-रभ-र","className":"legal-section","children":[["$","h2",null,{"children":[5,". ","शुल्क और प्रभार"]}],[["$","p","0",{"children":[["$","$1","0",{"children":[false,[["$","$1","0",{"children":"हमारा "}],["$","$1","1",{"children":["$","b",null,{"children":"सेवा शुल्क"}]}],["$","$1","2",{"children":" "}],["$","$1","3",{"children":["$","b",null,{"children":"सरकारी, पोर्टल, बैंक, बीमा कंपनी, कूरियर, प्रिंटिंग और अन्य तीसरे पक्ष के शुल्कों"}]}],["$","$1","4",{"children":" से अलग है। जहाँ संभव हो हम उन्हें अलग-अलग दिखाते हैं। हमारे "}],["$","$L1d","5",{"href":"/pricing","children":"मूल्य"}],["$","$1","6",{"children":" पेज पर लिखे शुल्क सामान्य रकम हैं; आपके अनुरोध का सही शुल्क पहले आपको बताया जाता है। यदि हमने किसी सेवा का दाम प्रकाशित नहीं किया है, तो आपका मामला देखने के बाद हम दाम बताएँगे।"}]]]}]]}],["$","p","1",{"children":[["$","$1","0",{"children":[false,[["$","$1","0",{"children":"ऑफ़र, प्रोमो कोड, कूपन और वॉलेट क्रेडिट "}],["$","$1","1",{"children":["$","b",null,{"children":"केवल हमारे सेवा शुल्क"}]}],["$","$1","2",{"children":" को कम करते हैं, सरकारी या तीसरे पक्ष के शुल्क को कभी नहीं, और हर ऑफ़र के साथ दिखाई गई शर्तों के अधीन हैं। हम किसी भी समय ऑफ़र खत्म या बदल सकते हैं, पर उन शर्तों पर पहले ही स्वीकार हो चुके अनुरोध के लिए नहीं।"}]]]}]]}],["$","p","2",{"children":[["$","$1","0",{"children":[false,[["$","$1","0",{"children":"हम GST अलग से नहीं लेते, जब तक हम उसके लिए पंजीकृत न हों और आपको लिखित में न बता दें।"}]]]}]]}]]]}]
27:["$","section","भ-गत-न",{"id":"भ-गत-न","className":"legal-section","children":[["$","h2",null,{"children":[6,". ","भुगतान"]}],[["$","p","0",{"children":[["$","$1","0",{"children":[false,[["$","$1","0",{"children":"आप हमारे डेस्क पर नकद या UPI से, अपने अनुरोध के भुगतान पेज पर मुफ़्त UPI QR से, या जहाँ उपलब्ध हो वहाँ Razorpay या Cashfree जैसे ऑनलाइन भुगतान पार्टनर के ज़रिए भुगतान कर सकते हैं। ये पार्टनर लाइसेंस प्राप्त भुगतान प्रदाता हैं; आपके कार्ड, UPI PIN और बैंक लॉगिन की जानकारी केवल वही और आपका बैंक संभालते हैं, और हम उन्हें कभी नहीं देखते या सहेजते।"}]]]}]]}],["$","ul","1",{"children":[["$","li","0",{"children":["$","span",null,{"children":[["$","$1","0",{"children":["$","b",null,{"children":"UPI QR:"}]}],["$","$1","1",{"children":" कोई अतिरिक्त शुल्क नहीं। क्योंकि हम हर भुगतान को अपने बैंक रिकॉर्ड से हाथ से मिलाकर पक्का करते हैं, इसमें कुछ समय लग सकता है। गलत या दोबारा इस्तेमाल हुआ संदर्भ नंबर डालने से पुष्टि में देरी हो सकती है।"}]]}]}],["$","li","1",{"children":["$","span",null,{"children":[["$","$1","0",{"children":["$","b",null,{"children":"ऑनलाइन भुगतान:"}]}],["$","$1","1",{"children":" गेटवे के शुल्क की भरपाई के लिए भुगतान से पहले दिखाया गया एक भुगतान-प्रोसेसिंग शुल्क जोड़ा जाता है। तुरंत पुष्टि भुगतान पार्टनर देता है, हम नहीं।"}]]}]}],["$","li","2",{"children":["$","span",null,{"children":[["$","$1","0",{"children":"भुगतान की पुष्टि होने के बाद ही अनुरोध अगले चरण में जाता है। आपके अनुरोध पर भुगतान “प्राप्त” दिखने पर वह अंतिम माना जाता है।"}]]}]}],["$","li","3",{"children":["$","span",null,{"children":[["$","$1","0",{"children":"यदि पैसा आपके खाते से कट गया पर आपका भुगतान लंबित या विफल दिख रहा है, तो 24 घंटे रुकिए (बैंक अक्सर विफल भुगतान अपने आप लौटा देते हैं), फिर अपने भुगतान पेज से टिकट खोलिए। हम भुगतान प्रदाता से जाँच करेंगे।"}]]}]}]]}],["$","p","2",{"children":[["$","$1","0",{"children":[false,[["$","$1","0",{"children":"रिफ़ंड और रद्दीकरण हमारी "}],["$","$L1d","1",{"href":"/refund-policy","children":"रिफ़ंड और रद्दीकरण नीति"}],["$","$1","2",{"chil