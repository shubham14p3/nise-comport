28:["$","section","स-व-क-त-समय-स-म-और-त-सर-पक-ष",{"id":"स-व-क-त-समय-स-म-और-त-सर-पक-ष","className":"legal-section","children":[["$","h2",null,{"children":[7,". ","स्वीकृति, समय-सीमा और तीसरे पक्ष"]}],[["$","p","0",{"children":[["$","$1","0",{"children":[false,[["$","$1","0",{"children":"स्वीकृति, अस्वीकृति, प्रक्रिया का समय, शुल्क और नियम संबंधित विभाग, बैंक, बीमा कंपनी या प्रदाता तय करते हैं, हम नहीं। हम स्वीकृति, किसी विशेष तारीख या किसी तीसरे पक्ष के पोर्टल की उपलब्धता की "}],["$","$1","1",{"children":["$","b",null,{"children":"गारंटी नहीं दे सकते"}]}],["$","$1","2",{"children":", जो धीमा, बदला हुआ या बंद हो सकता है। जहाँ किसी पोर्टल, कूरियर या प्रदाता की वजह से देरी, नुकसान या गलती हो, हम फ़ॉलो-अप में आपकी मदद करेंगे पर उनके कामों के लिए ज़िम्मेदार नहीं हैं।"}]]]}]]}],["$","p","1",{"children":[["$","$1","0",{"children":[false,[["$","$1","0",{"children":"हमारी वेबसाइट, गाइड और चैट की जानकारी केवल सामान्य मार्गदर्शन है और कानूनी, कर, वित्तीय या बीमा सलाह नहीं है। आधिकारिक नियम बदलते रहते हैं; हमेशा आधिकारिक स्रोत देखिए। यदि आप किसी अंतिम तारीख पर निर्भर हैं, तो हमें जल्दी बताइए।"}]]]}]]}]]]}]
29:["$","section","अत-र-क-त-शर-त-व-ल-स-व-ए",{"id":"अत-र-क-त-शर-त-व-ल-स-व-ए","className":"legal-section","children":[["$","h2",null,{"children":[8,". ","अतिरिक्त शर्तों वाली सेवाएँ"]}],[["$","h3","0",{"children":"बैंकिंग, AEPS और बिल भुगतान"}],["$","p","1",{"children":[["$","$1","0",{"children":[false,[["$","$1","0",{"children":"नकद और ट्रांसफ़र सेवाएँ हमारे केंद्र पर लागू बैंकिंग पार्टनरों और नियमों के ज़रिए दी जाती हैं। लेन-देन की सीमाएँ, शुल्क, विफलताएँ और वापसी उन पार्टनरों और बैंकों के नियमों के अनुसार होती हैं। अपनी पर्ची सँभालकर रखिए। जो विफल लेन-देन आपके खाते से कट गया, उसे बैंक सामान्यतः बैंकिंग नियमों में तय अवधि के भीतर लौटा देता है।"}]]]}]]}],["$","h3","2",{"children":"बीमा"}],["$","p","3",{"children":[["$","$1","0",{"children":[false,[["$","$1","0",{"children":"पॉलिसी बीमा कंपनियाँ जारी करती हैं; हम तुलना, फ़ॉर्म, दस्तावेज़ और नवीनीकरण में मदद करते हैं। प्रीमियम, कवर, अपवाद, क्लेम और नवीनीकरण बीमा कंपनी तय करती है। कृपया पॉलिसी की शब्दावली पढ़िए। हर प्रासंगिक तथ्य सच-सच बताइए; गलत जानकारी से क्लेम अस्वीकार हो सकता है।"}]]]}]]}],["$","h3","4",{"children":"प्रिंटिंग, स्कैनिंग और फ़ोटो"}],["$","p","5",{"children":[["$","$1","0",{"children":[false,[["$","$1","0",{"children":"प्रिंट का अनुमान आपकी पसंद पर निर्भर करता है और फ़ाइल जाँचने के बाद बदल सकता है। छापने से पहले प्रूफ़ में वर्तनी और लेआउट जाँच लीजिए। आपकी मंज़ूरी के अनुसार किया गया काम वापस नहीं हो सकता, पर यदि गलती हमारी हो तो हम दोबारा प्रिंट करेंगे या उस ऑर्डर का रिफ़ंड देंगे। आपकी अपलोड की गई फ़ाइलें केवल वैसे रखी जाती हैं जैसा "}],["$","$L1d","1",{"href":"/privacy","children":"गोपनीयता नीति"}],["$","$1","2",{"children":" में बताया गया है।"}]]]}]]}],["$","h3","6",{"children":"कंप्यूटर, IT उत्पाद और मरम्मत"}],["$","p","7",{"children":[["$","$1","0",{"children":[false,[["$","$1","0",{"children":"जाँच, पुर्ज़ों और मरम्मत का शुल्क काम से पहले बताया जाता है। उत्पादों पर निर्माता की वारंटी, यदि हो, मिलती है और वह उसकी शर्तों के अधीन है। मरम्मत के लिए डिवाइस देने से पहले कृपया "}],["$","$1","1",{"children