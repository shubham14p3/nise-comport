19:["$","div",null,{"className":"article-layout","children":[["$","div",null,{"children":[[["$","p","0",{"children":"राशन कार्ड खाद्य सुरक्षा योजनाओं के लिए परिवार के सदस्यों को दर्शाता है और अक्सर पते व परिवार के प्रमाण के रूप में भी इस्तेमाल होता है। नियम, फ़ॉर्म और पात्रता झारखंड का खाद्य, सार्वजनिक वितरण एवं उपभोक्ता मामले विभाग तय करता है और ये बदल सकते हैं, इसलिए इस गाइड से तैयारी करें और मौजूदा प्रक्रिया आधिकारिक पोर्टल पर पक्की करें।"}],["$","p","1",{"children":"ज़्यादातर समस्याएँ छोटे-छोटे बेमेल से आती हैं: आधार और अन्य कागज़ों में अलग वर्तनी, छूटा हुआ परिवार का सदस्य, या पुराना पता। आवेदन से पहले इन्हें ठीक कर लेने से हफ़्तों बचते हैं।"}]],[["$","section","क्या तैयार करें",{"children":[["$","h2",null,{"children":"क्या तैयार करें"}],[["$","p","0",{"children":"परिवार के हर सदस्य का आधार, जहाँ माँगा जाए वहाँ हाल की फ़ोटो, पते का प्रमाण, चालू मोबाइल नंबर, और नए सदस्य के लिए जन्म प्रमाण पत्र या स्कूल रिकॉर्ड। मूल दस्तावेज़ लाएँ ताकि हम उन्हें आपस में मिलाकर देख सकें।"}]]]}],["$","section","सदस्य जोड़ना, हटाना या सुधारना",{"children":[["$","h2",null,{"children":"सदस्य जोड़ना, हटाना या सुधारना"}],[["$","p","0",{"children":"हर बदलाव के लिए आधिकारिक पोर्टल पर अलग फ़ॉर्म या विकल्प होता है। मौजूदा कार्ड में ठीक-ठीक क्या गलत है (नाम की वर्तनी, उम्र, छूटा सदस्य, गलत पता) हमें बताएँ, हम सही विकल्प चुनने और मेल खाते दस्तावेज़ तैयार करने में मदद करेंगे।"}]]]}],["$","section","आवेदन के बाद",{"children":[["$","h2",null,{"children":"आवेदन के बाद"}],[["$","p","0",{"children":"आवेदन या पावती संख्या सहेजें। सत्यापन में स्थानीय अधिकारी शामिल हो सकता है, इसलिए अपना फ़ोन चालू रखें। आधिकारिक पोर्टल पर स्थिति देखें, या हमसे जाँचने में मदद लें।"}]]]}]],["$","h2",null,{"children":"शुरू करने से पहले"}],["$","ul",null,{"children":[["$","li","परिवार के हर सदस्य का आधार इकट्ठा करें",{"children":[["$","$L16",null,{"icon":{"name":"check","size":24,"node":[["path",{"d":"M20 6 9 17l-5-5","key":"1gmf2c"}]]},"size":16}],"परिवार के हर सदस्य का आधार इकट्ठा करें"]}],["$","li","जाँचें कि सभी दस्तावेज़ों में नाम मिलते हैं",{"children":[["$","$L16",null,{"icon":"$19:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"जाँचें कि सभी दस्तावेज़ों में नाम मिलते हैं"]}],["$","li","पते का प्रमाण और चालू मोबाइल नंबर तैयार रखें",{"children":[["$","$L16",null,{"icon":"$19:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"पते का प्रमाण और चालू मोबाइल नंबर तैयार रखें"]}],["$","li","आवेदन संख्या सहेजें",{"children":[["$","$L16",null,{"icon":"$19:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"आवेदन संख्या सहेजें"]}],["$","li","आधिकारिक पोर्टल पर फ़ॉलो-अप करें",{"children":[["$","$L16",null,{"icon":"$19:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"आधिकारिक पोर्टल पर फ़ॉलो-अप करें"]}]]}],[["$","h2",null,{"children":"आधिकारिक स्रोत"}],["$","$L2b",null,{"variant":"list","links":[{"label":"Jharkhand Public Distribution (Aahar) portal","href":"https://aahar.jharkhand.gov.in/"}],"service":{"slug":"ration-card","title":"Ration Card Application & Correction","documents":["Aadhaar card of every family member","Voter ID and PAN of earning members","Recent electricity, water or gas bill, or rent agreement","Income certificate","Photo and bank passbook of the head of the family (usually the eldest woman)","Surrender or deletion certificate if you had a card elsewhere"]}}]],["$","p",null,{"className":"article-disclaimer","children":"आवश्यकताएँ बदल सकती हैं। पात्रता, शुल्क, प्रक्रिया और अंतिम नतीजे संबंधित सरकारी विभाग, बीमा कंपनी, संस्थान या सेवा प्रदाता तय करते हैं। NISE COMPORT एक स्वतंत्र CSC / प्रज्ञा केंद्र सेवा केंद्र है, सरकारी कार्यालय नहीं।"}]]}],["$","aside",null,{"children":[["$","strong",null,{"children":"इसमें मदद चाहिए?"}],["$","p",null,{"children":"खरंगाझार, टेल्को, जमशेदपुर में NISE COMPORT टीम से बात करें। कॉल करें +91 97712 19893।"}],["$","$L15",null,{"className":"button button-green","href":"/hi