1a:["$","div",null,{"className":"article-layout","children":[["$","div",null,{"children":[[["$","p","0",{"children":"आधार अपडेट के विकल्प और ज़रूरतें बदलाव के प्रकार पर निर्भर करती हैं। कुछ अनुरोध ऑनलाइन हो सकते हैं, जबकि बायोमेट्रिक या अन्य बदलावों के लिए अधिकृत केंद्र जाना पड़ता है। निकलने से पहले UIDAI की वर्तमान प्रक्रिया देख लें, और अपना OTP या पूरे लॉगिन विवरण किसी को न बताएँ।"}],["$","p","1",{"children":"NISE COMPORT सही आधिकारिक मार्ग पहचानने और चेकलिस्ट बनाने में मदद कर सकता है। हम आधार रिकॉर्ड नहीं बदल सकते और मंज़ूरी की गारंटी नहीं दे सकते; अनुरोध की प्रक्रिया संबंधित प्राधिकरण करता है। पावती पर्ची सँभालकर रखें ताकि आधिकारिक माध्यम से स्थिति देख सकें।"}]],"$undefined",["$","h2",null,{"children":"शुरू करने से पहले"}],["$","ul",null,{"children":[["$","li","पक्का करें कि कौन-सा फ़ील्ड या अपडेट चाहिए",{"children":[["$","$L16",null,{"icon":{"name":"check","size":24,"node":[["path",{"d":"M20 6 9 17l-5-5","key":"1gmf2c"}]]},"size":16}],"पक्का करें कि कौन-सा फ़ील्ड या अपडेट चाहिए"]}],["$","li","UIDAI के वर्तमान आधिकारिक निर्देश देखें",{"children":[["$","$L16",null,{"icon":"$1a:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"UIDAI के वर्तमान आधिकारिक निर्देश देखें"]}],["$","li","जहाँ ज़रूरी हो, सहायक दस्तावेज़ों की मूल प्रतियाँ साथ लाएँ",{"children":[["$","$L16",null,{"icon":"$1a:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"जहाँ ज़रूरी हो, सहायक दस्तावेज़ों की मूल प्रतियाँ साथ लाएँ"]}],["$","li","OTP कभी साझा न करें; आधिकारिक पावती सँभालकर रखें",{"children":[["$","$L16",null,{"icon":"$1a:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"OTP कभी साझा न करें; आधिकारिक पावती सँभालकर रखें"]}]]}],[["$","h2",null,{"children":"आधिकारिक स्रोत"}],["$","$L2b",null,{"variant":"list","links":[{"label":"UIDAI – updating data on Aadhaar","href":"https://uidai.gov.in/en/updating-data-on-aadhaar"},{"label":"UIDAI enrolment & update charges (PDF)"