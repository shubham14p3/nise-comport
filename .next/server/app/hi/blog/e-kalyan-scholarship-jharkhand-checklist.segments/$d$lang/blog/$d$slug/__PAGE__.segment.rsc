19:["$","div",null,{"className":"article-layout","children":[["$","div",null,{"children":[[["$","p","0",{"children":"e-Kalyan झारखंड सरकार का ऑनलाइन पोर्टल है, जिस पर अनुसूचित जनजाति, अनुसूचित जाति, पिछड़ा वर्ग और अल्पसंख्यक समुदायों के पात्र छात्रों की प्री-मैट्रिक और पोस्ट-मैट्रिक छात्रवृत्तियों के आवेदन होते हैं। पात्रता, राशि और अंतिम तिथियाँ विभाग हर साल घोषित करता है।"}],["$","p","1",{"children":"ज़्यादातर आवेदन ऐसी गलतियों से रद्द होते हैं जिनसे बचा जा सकता है: समाप्त या बेमेल प्रमाण पत्र, ऐसा बैंक खाता जो प्रत्यक्ष लाभ अंतरण (DBT) के लिए आधार से सीड न हो, या संस्थान सत्यापन का चरण छूट जाना। आवेदन की खिड़की खुलने से पहले ये तैयार कर लें।"}]],[["$","section","छात्रों से आमतौर पर माँगे जाने वाले दस्तावेज़",{"children":[["$","h2",null,{"children":"छात्रों से आमतौर पर माँगे जाने वाले दस्तावेज़"}],[["$","p","0",{"children":"झारखंड में जारी जाति, आय और निवास प्रमाण पत्र; आधार; छात्र के नाम का ऐसा बैंक खाता जिसमें DBT भुगतान आ सके; पिछले साल की अंकतालिका; दाखिले और फ़ीस की रसीदें; और हाल की फ़ोटो। सही सूची के लिए चालू वर्ष की अधिसूचना देखें।"}]]]}],["$","section","जमा करने के बाद",{"children":[["$","h2",null,{"children":"जमा करने के बाद"}],[["$","p","0",{"children":"जमा किया गया फ़ॉर्म प्रिंट करें या सहेजें। आपके संस्थान को पोर्टल पर आवेदन का सत्यापन करना होता है, इसलिए आवेदन के बाद कॉलेज को बताएँ और e-Kalyan पर स्थिति देखते रहें।"}]]]}]],["$","h2",null,{"children":"शुरू करने से पहले"}],["$","ul",null,{"children":[["$","li","इस साल की अधिसूचना में पात्रता और अंतिम तिथि पढ़ें",{"children":[["$","$L16",null,{"icon":{"name":"check","size":24,"node":[["path",{"d":"M20 6 9 17l-5-5","key":"1gmf2c"}]]},"size":16}],"इस साल की अधिसूचना में पात्रता और अंतिम तिथि पढ़ें"]}],["$","li","जाति, आय और निवास प्रमाण पत्र समय पर नवीनीकृत कराएँ",{"children":[["$","$L16",null,{"icon":"$19:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"जाति, आय और निवास प्रमाण पत्र समय पर नवीनीकृत कराएँ"]}],["$","li","सुनिश्चित करें कि बैंक खाते में DBT आ सकता