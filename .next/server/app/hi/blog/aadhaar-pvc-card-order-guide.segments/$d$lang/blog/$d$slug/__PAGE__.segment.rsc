19:["$","div",null,{"className":"article-layout","children":[["$","div",null,{"children":[[["$","p","0",{"children":"आधार PVC कार्ड आपके आधार का सुरक्षा फ़ीचर वाला, बटुए में रखने लायक प्लास्टिक रूप है। आधिकारिक कार्ड UIDAI से ऑर्डर होता है, UIDAI ही छापता है और आपके आधार रिकॉर्ड में दर्ज पते पर डाक से भेजता है।"}],["$","p","1",{"children":"इसे UIDAI की myAadhaar वेबसाइट से मँगवाएँ। आधार नंबर डालें, OTP से पुष्टि करें, प्रीव्यू देखें, आधिकारिक पेज पर दिखा शुल्क चुकाएँ और ट्रैकिंग के लिए सर्विस रिक्वेस्ट नंबर (SRN) पाएँ।"}]],[["$","section","पहले अपना पता जाँचें",{"children":[["$","h2",null,{"children":"पहले अपना पता जाँचें"}],[["$","p","0",{"children":"कार्ड आपके आधार में दर्ज पते पर भेजा जाता है। अगर आप कहीं और रहने लगे हैं, तो पहले पता अपडेट करें और अपडेट पूरा होने के बाद PVC कार्ड ऑर्डर करें।"}]]]}],["$","section","आधिकारिक कार्ड बनाम दुकान के प्रिंटआउट",{"children":[["$","h2",null,{"children":"आधिकारिक कार्ड बनाम दुकान के प्रिंटआउट"}],[["$","p","0",{"children":"डाउनलोड किए गए ई-आधार से दुकान पर छपे प्लास्टिक कार्ड आधिकारिक PVC कार्ड नहीं होते। UIDAI से डाउनलोड किया ई-आधार PDF अपने आप में मान्य है; आधार इस्तेमाल करने के लिए प्लास्टिक कॉपी ज़रूरी नहीं है।"}]]]}]],["$","h2",null,{"children":"शुरू करने से पहले"}],["$","ul",null,{"children":[["$","li","पक्का करें कि आधार का पता ताज़ा है",{"children":[["$","$L16",null,{"icon":{"name":"check","size":24,"node":[["path",{"d":"M20 6 9 17l-5-5","key":"1gmf2c"}]]},"size":16}],"पक्का करें कि आधार का पता ताज़ा है"]}],["$","li","ऑर्डर सिर्फ़ UIDAI की आधिकारिक वेबसाइट पर करें",{"children":[["$","$L16",null,{"icon":"$19:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"ऑर्डर सिर्फ़ UIDAI की आधिकारिक वेबसाइट पर करें"]}],["$","li","आधिकारिक पेज पर दिखा शुल्क ही दें",{"children":[["$","$L16",null,{"icon":"$19:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"आधिकारिक पेज पर दिखा शुल्क ही दें"]}],["$","li","SRN सहेजें और ऑर्डर व डाक को ट्रैक करें",{