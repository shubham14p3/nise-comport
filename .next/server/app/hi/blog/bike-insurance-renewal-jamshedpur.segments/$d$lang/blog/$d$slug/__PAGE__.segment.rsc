18:["$","div",null,{"className":"article-layout","children":[["$","div",null,{"children":[[["$","p","0",{"children":"दोपहिया पॉलिसी का नवीनीकरण करने से पहले पंजीकरण विवरण, पॉलिसी की मौजूदा समाप्ति तिथि, क्लेम का इतिहास और अपनी ज़रूरत का कवर जाँच लें। बीमा कंपनी का प्रीमियम, अपवाद, ऐड-ऑन और क्लेम प्रक्रिया की तुलना करें; सबसे कम भाव वाले विकल्प में दूसरे विकल्प जैसा कवर न भी हो।"}],["$","p","1",{"children":"जहाँ प्रदाता की सेवाएँ उपलब्ध हैं, वहाँ NISE COMPORT पूछताछ और आवेदन के चरणों में मदद कर सकता है। पात्रता, प्रीमियम, पॉलिसी की शर्तें और क्लेम का फ़ैसला बीमा कंपनी करती है। पॉलिसी की शब्दावली पढ़ें और भुगतान की रसीद तथा जारी दस्तावेज़ सँभालकर रखें।"}]],"$undefined",["$","h2",null,{"children":"शुरू करने से पहले"}],["$","ul",null,{"children":[["$","li","पंजीकरण और मौजूदा पॉलिसी का विवरण तैयार रखें",{"children":[["$","$L16",null,{"icon":{"name":"check","size":24,"node":[["path",{"d":"M20 6 9 17l-5-5","key":"1gmf2c"}]]},"size":16}],"पंजीकरण और मौजूदा पॉलिसी का विवरण तैयार रखें"]}],["$","li","कवर, अपवाद और ऐड-ऑन की तुलना करें",{"children":[["$","$L16",null,{"icon":"$18:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"कवर, अपवाद और ऐड-ऑन की तुलना करें"]}],["$","li","अंतिम प्रीमियम सीधे बीमा कंपनी से पक्का करें",{"children":[["$","$L16",null,{"icon":"$18:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"अंतिम प्रीमियम सीधे बीमा कंपनी से पक्का करें"]}],["$","li","जारी पॉलिसी और भुगतान की रसीद सहेजें",{"children":[["$","$L16",null,{"icon":"$18:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"जारी पॉलिसी और भुगतान की रसीद सहेजें"]}]]}],null,["$","p",null,{"className":"article-disclaimer","children":"आवश्यकताएँ बदल सकती हैं। पात्रता, शुल्क, प्रक्रिया और अंतिम नतीजे संबंधित सरकारी विभाग, बीमा कंपनी, संस्थान या सेवा प्रदाता तय करते हैं। NISE COMPORT एक स्वतंत्र CSC / प्रज्ञा केंद्र सेवा केंद्र है, सरकारी कार्यालय नहीं।"}]]}],["$","aside",null,{"chi