1b:["$","div",null,{"className":"article-layout","children":[["$","div",null,{"children":[[["$","p","0",{"children":"पैन आवेदन तब आसान होता है जब आवेदक का नाम, जन्म तिथि और पहचान के सहायक दस्तावेज़ आपस में मेल खाते हों। खरंगाझार के सेवा केंद्र पर आने से पहले देख लें कि आपको नया पैन चाहिए, मौजूदा रिकॉर्ड में सुधार चाहिए या दोबारा प्रिंट। एक ही काम के दो आवेदन करने से बेवजह देरी हो सकती है।"}],["$","p","1",{"children":"वर्तमान आधिकारिक आवेदन मार्ग का उपयोग करें और उसके दस्तावेज़, फ़ोटो और भुगतान के निर्देश मानें। NISE COMPORT फ़ॉर्म भरने और दस्तावेज़ तैयार करने में मदद कर सकता है; प्रक्रिया और पैन जारी करने का काम आयकर विभाग या अधिकृत पैन सेवा करती है। जमा करने से पहले हर जानकारी जाँच लें और पावती संख्या सँभालकर रखें।"}]],"$undefined",["$","h2",null,{"children":"शुरू करने से पहले"}],["$","ul",null,{"children":[["$","li","पक्का करें कि यह नया आवेदन है, सुधार है या दोबारा प्रिंट",{"children":[["$","$L16",null,{"icon":{"name":"check","size":24,"node":[["path",{"d":"M20 6 9 17l-5-5","key":"1gmf2c"}]]},"size":16}],"पक्का करें कि यह नया आवेदन है, सुधार है या दोबारा प्रिंट"]}],["$","li","नाम और जन्म तिथि को सहायक दस्तावेज़ों से मिलाएँ",{"children":[["$","$L16",null,{"icon":"$1b:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"नाम और जन्म तिथि को सहायक दस्तावेज़ों से मिलाएँ"]}],["$","li","वर्तमान आधिकारिक फ़ॉर्म में माँगे गए प्रमाण साथ लाएँ",{"children":[["$","$L16",null,{"icon":"$1b:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"वर्तमान आधिकारिक फ़ॉर्म में माँगे गए प्रमाण साथ लाएँ"]}],["$","li","पावती और आधिकारिक भुगतान की रसीद सँभालकर रखें",{"children":[["$","$L16",null,{"icon":"$1b:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"पावती और आधिकारिक भुगतान की रसीद सँभालकर रखें"]}]]}],[["$","h2",null,{"children":"आधिकारिक स्रोत"}],["$","$L2c",null,{"variant":"list","links":[{"label":"Protean PAN services","href":"https://onlineservices.proteantech.in/paam/endUserRegisterContact.html"},{"label":"UTIITSL PAN services","href":"https://www.pan.utiitsl.com/PAN/"}],"service":{"slug":"pan-card","title":"PAN Card Application & Correction","documents":["Identity and date-of-birth proof accepted by the relevant PAN provider","Address proof where required","A recent photograph or signature if the selected process requests it"]}}]],["$","p",null,{"className":"article-disclaimer","children":"आवश्यकताएँ बदल सकती हैं। पात्रता, शुल्क, प्रक्रिया और अंतिम नतीजे संबंधित सरकारी विभाग, बीमा कंपनी, संस्थान या सेवा प्रदाता तय करते हैं। NISE COMPORT एक स्वतंत्र CSC / प्रज्ञा केंद्र सेवा केंद्र है, सरकारी कार्यालय नहीं।"}]]}],["$","aside",null,{"children":[["$","strong",null,{"children":"इसमें मदद चाहिए?"}],["$","p",null,{"children":"खरंगाझार, टेल्को, जमशेदपुर में NISE COMPORT टीम से बात करें। कॉल करें +91 97712 19893।"}],["$","$L15",null,{"className":"button button-green","href":"/hi/services/pan-card","children":["पैन कार्ड आवेदन और सुधार"," ",["$","$L16",null,{"icon":{"name":"arrow-up-right","size":24,"node":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]]},"size":15}]]}],["$","a",null,{"href":"https://wa.me/919771219893?text=*NISE%20COMPORT*%20%C2%B7%20Kharangajhar%2C%20Telco%2C%20Jamshedpur%0AHi%20NISE%20COMPORT%2C%20I%20read%20your%20guide%20%22%E0%A4%9C%E0%A4%AE%E0%A4%B6%E0%A5%87%E0%A4%A6%E0%A4%AA%E0%A5%81%E0%A4%B0%20%E0%A4%AE%E0%A5%87%E0%A4%82%20%E0%A4%AA%E0%A5%88%E0%A4%A8%20%E0%A4%95%E0%A4%BE%E0%A4%B0%E0%A5%8D%E0%A4%A1%20%E0%A4%86%E0%A4%B5%E0%A5%87%E0%A4%A6%E0%A4%A8%20%E0%A4%AF%E0%A4%BE%20%E0%A4%B8%E0%A5%81%E0%A4%A7%E0%A4%BE%E0%A4%B0%3A%20%E0%A4%8F%E0%A4%95%20%E0%A4%B5%E0%A5%8D%E0%A4%AF%E0%A4%BE%E0%A4%B5%E0%A4%B9%E0%A4%BE%E0%A4%B0%E0%A4%BF%E0%A4%95%20%E0%A4%9A%E0%A5%87%E0%A4%95%E0%A4%B2%E0%A4%BF%E0%A4%B8%E0%A5%8D%E0%A4%9F%22%20and%20need%20help.","className":"article-whatsapp","target":"_blank","rel":"noopener noreferrer","children":"WhatsApp पर पूछें"}],["$","a",null,{"href":"https