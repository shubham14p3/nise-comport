18:["$","div",null,{"className":"article-layout","children":[["$","div",null,{"children":[[["$","p","0",{"children":"मतदाता सेवाओं में अलग-अलग अनुरोध होते हैं, जैसे नया पंजीकरण, सुधार या पता बदलना। चुनाव आयोग के वर्तमान निर्देशों के अनुसार सही अनुरोध चुनें। गलत फ़ॉर्म चुनने से प्रक्रिया धीमी हो सकती है।"}],["$","p","1",{"children":"आवेदक की आयु, पते और सहायक दस्तावेज़ों को आधिकारिक ज़रूरतों से मिलाकर देखें। सत्यापन और मतदाता सूची का रखरखाव चुनाव प्राधिकरण करता है; NISE COMPORT ऑनलाइन फ़ॉर्म चलाने और पावती में मदद कर सकता है। जमा करने से पहले भरी हुई जानकारी खुद भी जाँच लें।"}]],"$undefined",["$","h2",null,{"children":"शुरू करने से पहले"}],["$","ul",null,{"children":[["$","li","सही पंजीकरण या सुधार का अनुरोध चुनें",{"children":[["$","$L16",null,{"icon":{"name":"check","size":24,"node":[["path",{"d":"M20 6 9 17l-5-5","key":"1gmf2c"}]]},"size":16}],"सही पंजीकरण या सुधार का अनुरोध चुनें"]}],["$","li","पात्रता और पते के प्रमाण की ज़रूरतें देखें",{"children":[["$","$L16",null,{"icon":"$18:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"पात्रता और पते के प्रमाण की ज़रूरतें देखें"]}],["$","li","जमा करने से पहले सारी प्रविष्टियाँ जाँच लें",{"children":[["$","$L16",null,{"icon":"$18:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"जमा करने से पहले सारी प्रविष्टियाँ जाँच लें"]}],["$","li","आधिकारिक फ़ॉलो-अप के लिए संदर्भ संख्या सँभालकर रखें",{"children":[["$","$L16",null,{"icon":"$18:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"आधिकारिक फ़ॉलो-अप के लिए संदर्भ संख्या सँभालकर रखें"]}]]}],[["$","h2",null,{"children":"आधिकारिक स्रोत"}],["$","$L28",null,{"variant":"list","links":[{"label":"Voters’ Service Portal (ECI)","href":"https://voters.eci.gov.in/"}],"service":{"slug":"voter-id","title":"Voter ID (EPIC) Application & Correction","documents":["For new registration (Form 6): Aadhaar number (or a declaration if you don't have one), a recent passport-size colour photo on a white background (4.5cm x 3.5cm), age proof (birth certificate, 10th marksheet or similar), current address proof, mobile number for OTP, and the name/relation of a parent or spouse already on the roll if available","For correction/shifting/replacement (Form 8): existing EPIC number, Aadhaar number, proof of the new detail being corrected (address proof for shifting, age/name proof for a correction), and a recent photo","For overseas electors (Form 6A): valid Indian passport, current visa details, proof of the Indian address last ordinarily resided at, and a recent passport-size photo","Disability marking (optional, Form 8): a disability certificate, if you want it recorded"]}}]],["$","p",null,{"className":"article-disclaimer","children":"आवश्यकताएँ बदल सकती हैं। पात्रता, शुल्क, प्रक्रिया और अंतिम नतीजे संबंधित सरकारी विभाग, बीमा कंपनी, संस्थान या सेवा प्रदाता तय करते हैं। NISE COMPORT एक स्वतंत्र CSC / प्रज्ञा केंद्र सेवा केंद्र है, सरकारी कार्यालय नहीं।"}]]}],["$","aside",null,{"children":[["$","strong",null,{"children":"इसमें मदद चाहिए?"}],["$","p",null,{"children":"खरंगाझार, टेल्को, जमशेदपुर में NISE COMPORT टीम से बात करें। कॉल करें +91 97712 19893।"}],["$","$L15",null,{"className":"button button-green","href":"/hi/services/voter-id","children":["वोटर आईडी सेवाएँ"," ",["$","$L16",null,{"icon":{"name":"arrow-up-right","size":24,"node":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]]},"size":15}]]}],["$","a",null,{"href":"https://wa.me/919771219893?text=*NISE%20COMPORT*%20%C2%B7%20Kharangajhar%2C%20Telco%2C%20Jamshedpur%0AHi%20NISE%20COMPORT%2C%20I%20read%20your%20guide%20%22%E0%A4%9D%E0%A4%BE%E0%A4%B0%E0%A4%96%E0%A4%82%E0%A4%A1%20%E0%A4%AE%E0%A5%87%E0%A4%82%20%E0%A4%AE%E0%A4%A4%E0%A4%A6%E0%A4%BE%E0%A4%A4%E0%A4%BE%20%E0%A4%AA%E0%A4%82%E0%A4%9C%E0%A5%80%E0%A4%95%E0%A4%B0%E0%A4%A3%20%E0%A4%94%E0%A4%B0%20%E0%A4%B8%E0%A5%81%E0%A4%A7%E0%A4%BE%E0%A4%B0%3A%20%E0%A4%B8%E0%A4%AE%E0%A5%80%E0%A4%95%E0%A5%8D