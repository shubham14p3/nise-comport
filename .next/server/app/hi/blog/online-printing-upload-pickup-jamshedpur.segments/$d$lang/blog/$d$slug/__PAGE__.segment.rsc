1a:["$","div",null,{"className":"article-layout","children":[["$","div",null,{"children":[[["$","p","0",{"children":"साइन-इन करने के बाद अपनी PDF या समर्थित फ़ाइल अपलोड करें, पेज की संख्या और प्रीव्यू जाँचें, फिर 1-3, 5 जैसी पेज रेंज लिखें। प्रतियाँ, कागज़ और रंग की सेटिंग चुनें और पिकअप का समय या डिलीवरी माँगें। अनुरोध समीक्षा के लिए सर्विस डेस्क के पास जाता है।"}],["$","p","1",{"children":"प्रिंट का अनुरोध भेजना ऑनलाइन चेकआउट नहीं है। प्रिंट करने से पहले NISE COMPORT उपलब्धता, डिलीवरी शुल्क और अंतिम भाव की पुष्टि करता है। जो दस्तावेज़ साझा करने का आपको अधिकार नहीं है, उन्हें अपलोड न करें; खाते में अपलोड की गई फ़ाइलें निजी रहती हैं और साइट की रिटेंशन नीति के अनुसार रखी जाती हैं।"}]],"$undefined",["$","h2",null,{"children":"शुरू करने से पहले"}],["$","ul",null,{"children":[["$","li","प्रीव्यू और चुनी हुई पेज रेंज जाँच लें",{"children":[["$","$L16",null,{"icon":{"name":"check","size":24,"node":[["path",{"d":"M20 6 9 17l-5-5","key":"1gmf2c"}]]},"size":16}],"प्रीव्यू और चुनी हुई पेज रेंज जाँच लें"]}],["$","li","रंग, प्रतियाँ और पिकअप या डिलीवरी चुनें",{"children":[["$","$L16",null,{"icon":"$1a:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"रंग, प्रतियाँ और पिकअप या डिलीवरी चुनें"]}],["$","li","स्टाफ़ से पुष्ट भाव के लिए अनुरोध जमा करें",{"children":[["$","$L16",null,{"icon":"$1a:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"स्टाफ़ से पुष्ट भाव के लिए अनुरोध जमा करें"]}],["$","li","अंतिम अनुमान मंज़ूर करने के बाद ही आगे बढ़ें",{"children":[["$","$L16",null,{"icon":"$1a:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"अंतिम अनुमान मंज़ूर करने के बाद ही आगे बढ़ें"]}]]}],null,["$","p",null,{"className":"article-disclaimer","children":"आवश्यकताएँ बदल सकती हैं। पात्रता, शुल्क, प्रक्रिया और अंतिम नतीजे संबंधित सरकारी विभाग, बीमा कंपनी, संस्थान या सेवा प्रदाता तय करते हैं। NISE COMPORT एक स्वतंत्र CSC / प्रज्ञा केंद्र सेवा केंद्र है, सरकारी का