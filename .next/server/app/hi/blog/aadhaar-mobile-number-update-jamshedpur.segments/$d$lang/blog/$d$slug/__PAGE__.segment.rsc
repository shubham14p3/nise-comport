19:["$","div",null,{"className":"article-layout","children":[["$","div",null,{"children":[[["$","p","0",{"children":"आपके आधार से जुड़े मोबाइल नंबर पर बैंक KYC, डिजिलॉकर, पैन–आधार लिंकिंग, छात्रवृत्ति पोर्टल और कई अन्य सेवाओं के OTP आते हैं। अगर वह नंबर खो जाए, बंद हो जाए या बदल जाए, तो नंबर अपडेट होने तक ज़्यादातर ऑनलाइन आधार सेवाएँ आपके लिए काम करना बंद कर देती हैं।"}],["$","p","1",{"children":"कई वर्षों तक मोबाइल नंबर बदलने के लिए आधार नामांकन या अपडेट केंद्र जाना पड़ता था, जहाँ बायोमेट्रिक से आपकी पहचान की पुष्टि होती है। UIDAI अपने नए आधार ऐप के ज़रिए ऑनलाइन विकल्प जोड़ रहा है, इसलिए पहले UIDAI की आधिकारिक वेबसाइट या ऐप देखें कि ऑनलाइन रास्ता आपके लिए उपलब्ध है या नहीं। न हो तो अधिकृत आधार केंद्र जाएँ।"}]],[["$","section","आधार केंद्र पर क्या ले जाएँ",{"children":[["$","h2",null,{"children":"आधार केंद्र पर क्या ले जाएँ"}],[["$","p","0",{"children":"अपना आधार कार्ड या नंबर और नया मोबाइल नंबर साथ रखें (फ़ोन भी साथ हो तो अच्छा है, क्योंकि पुष्टि का SMS आ सकता है)। सिर्फ़ मोबाइल नंबर बदलने के लिए आमतौर पर सहायक दस्तावेज़ की ज़रूरत नहीं होती, क्योंकि बायोमेट्रिक से पहचान हो जाती है; नाम, जन्म तिथि या पते में बदलाव के लिए UIDAI की स्वीकृत सूची के मूल प्रमाण साथ रखें।"}]]]}],["$","section","सरकारी शुल्क",{"children":[["$","h2",null,{"children":"सरकारी शुल्क"}],[["$","p","0",{"children":"शुल्क UIDAI तय करता है और उसे केंद्र पर तथा आपकी पावती पर्ची में दिखना चाहिए। लिखते समय UIDAI की प्रकाशित सूची में अलग से किए गए डेमोग्राफ़िक अपडेट (जैसे मोबाइल नंबर) के लिए ₹75 दर्ज है। भुगतान से पहले UIDAI के आधिकारिक पेज पर ताज़ा सूची देखें और ज़्यादा पैसे माँगे जाने पर UIDAI को शिकायत करें।"}]]]}],["$","section","अपडेट के बाद",{"children":[["$","h2",null,{"children":"अपडेट के बाद"}],[["$","p","0",{"children":"अपडेट रिक्वेस्ट नंबर (URN) वाली पावती पर्ची संभालकर रखें। इससे UIDAI की वेबसाइट पर स्थिति देखें। अपडेट पूरा होने पर किसी OTP वाली सेवा (जैसे ई-आधार डाउनलोड) को आज़माकर देखें कि नया नंबर काम कर रहा है।"}]]]}]],["$","h2",null,{"children":"शुरू करने से पहले"}],["$","ul",null,{"ch