19:["$","div",null,{"className":"article-layout","children":[["$","div",null,{"children":[[["$","p","0",{"children":"लिखित रेंट एग्रीमेंट मकान मालिक और किराएदार दोनों की रक्षा करता है। बैंक, गैस कनेक्शन और कई कार्यालय इसे पते के प्रमाण के रूप में भी माँगते हैं। स्टांप शुल्क और पंजीकरण के नियम किराये की राशि और अवधि पर निर्भर करते हैं, इसलिए साइन करने से पहले पुष्टि करें कि आपके एग्रीमेंट पर क्या लागू होता है।"}],["$","p","1",{"children":"हम स्पष्ट मसौदा तैयार करने और उसे प्रिंट करने में मदद करते हैं, पर हम कानूनी फ़र्म नहीं हैं। ज़्यादा कीमत वाले या लंबी अवधि के पट्टे के लिए वकील की सलाह लें।"}]],[["$","section","इसमें क्या होना चाहिए",{"children":[["$","h2",null,{"children":"इसमें क्या होना चाहिए"}],[["$","p","0",{"children":"मकान मालिक और किराएदार के नाम व पते, संपत्ति का पता, किराये और जमानत राशि, अवधि, नोटिस अवधि, रखरखाव और उपयोगिता बिल कौन भरेगा, और एग्रीमेंट समाप्त करने की शर्तें।"}]]]}],["$","section","क्या लाएँ",{"children":[["$","h2",null,{"children":"क्या लाएँ"}],[["$","p","0",{"children":"दोनों पक्षों के पहचान और पते के प्रमाण, पासपोर्ट आकार की फ़ोटो, संपत्ति का विवरण और तय शर्तें। दोनों पक्षों को और कभी-कभी गवाहों को भी हस्ताक्षर करने होते हैं।"}]]]}]],["$","h2",null,{"children":"शुरू करने से पहले"}],["$","ul",null,{"children":[["$","li","किराया, जमानत और अवधि लिखित में तय करें",{"children":[["$","$L16",null,{"icon":{"name":"check","size":24,"node":[["path",{"d":"M20 6 9 17l-5-5","key":"1gmf2c"}]]},"size":16}],"किराया, जमानत और अवधि लिखित में तय करें"]}],["$","li","दोनों पक्षों के पहचान पत्र और फ़ोटो लाएँ",{"children":[["$","$L16",null,{"icon":"$19:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"दोनों पक्षों के पहचान पत्र और फ़ोटो लाएँ"]}],["$","li","अपने मामले के लिए स्टांप शुल्क की पुष्टि करें",{"children":[["$","$L16",null,{"icon":"$19:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"अपने मामले के लिए स्टांप शुल्क की पुष्टि करें"]}],["$","li","साइन करने से पहले हर