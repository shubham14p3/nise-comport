19:["$","div",null,{"className":"article-layout","children":[["$","div",null,{"children":[[["$","p","0",{"children":"आधिकारिक अधिसूचना से शुरू करें। जानकारी भरने से पहले आवेदक की श्रेणी, पात्रता, अंतिम तारीख और दस्तावेज़ों के फ़ॉर्मैट पक्के कर लें। साफ़ चेकलिस्ट से छात्र आख़िरी वक़्त की दिक्कतों से बच सकते हैं, जैसे नाम में फ़र्क, पुराने दस्तावेज़ या हस्ताक्षर की फ़ाइल न होना।"}],["$","p","1",{"children":"जमा की गई जानकारी की सटीकता की ज़िम्मेदारी छात्र या अभिभावक की रहती है। NISE COMPORT जमशेदपुर में फ़ॉर्म चलाने और अपलोड तैयार करने में मदद कर सकता है; पात्रता संस्थान या विभाग तय करता है और अंतिम फ़ैसला भी उसी का होता है।"}]],"$undefined",["$","h2",null,{"children":"शुरू करने से पहले"}],["$","ul",null,{"children":[["$","li","वर्तमान आधिकारिक अधिसूचना और अंतिम तारीख पढ़ें",{"children":[["$","$L16",null,{"icon":{"name":"check","size":24,"node":[["path",{"d":"M20 6 9 17l-5-5","key":"1gmf2c"}]]},"size":16}],"वर्तमान आधिकारिक अधिसूचना और अंतिम तारीख पढ़ें"]}],["$","li","बताए गए फ़ाइल फ़ॉर्मैट में साफ़ स्कैन तैयार करें",{"children":[["$","$L16",null,{"icon":"$19:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"बताए गए फ़ाइल फ़ॉर्मैट में साफ़ स्कैन तैयार करें"]}],["$","li","नाम, स्कूल और बैंक का विवरण ध्यान से जाँचें",{"children":[["$","$L16",null,{"icon":"$19:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"नाम, स्कूल और बैंक का विवरण ध्यान से जाँचें"]}],["$","li","अंतिम फ़ॉर्म और पावती सहेज लें",{"children":[["$","$L16",null,{"icon":"$19:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"अंतिम फ़ॉर्म और पावती सहेज लें"]}]]}],null,["$","p",null,{"className":"article-disclaimer","children":"आवश्यकताएँ बदल सकती हैं। पात्रता, शुल्क, प्रक्रिया और अंतिम नतीजे संबंधित सरकारी विभाग, बीमा कंपनी, संस्थान या सेवा प्रदाता तय करते हैं। NISE COMPORT एक स्वतंत्र CSC / प्रज्ञा केंद्र सेवा केंद्र है, सरकारी कार्यालय नहीं।"}]]}],["$","aside",null,{"children":[