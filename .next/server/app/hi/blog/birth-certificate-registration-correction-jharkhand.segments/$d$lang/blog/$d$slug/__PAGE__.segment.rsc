1a:["$","div",null,{"className":"article-layout","children":[["$","div",null,{"children":[[["$","p","0",{"children":"जन्म और मृत्यु का पंजीकरण जन्म और मृत्यु पंजीकरण अधिनियम के तहत स्थानीय रजिस्ट्रार के पास कराना ज़रूरी है। जहाँ जन्म अस्पताल में होता है, वहाँ अक्सर अस्पताल पंजीकरण शुरू कर देता है; घर पर जन्म होने पर परिवार (सूचक) घटना की सूचना रजिस्ट्रार को देता है।"}],["$","p","1",{"children":"घटना के 21 दिन के भीतर पंजीकरण सबसे आसान रास्ता है। बाद में भी पंजीकरण संभव है, पर देरी कितनी है, इसके अनुसार आमतौर पर अतिरिक्त दस्तावेज़, विलंब शुल्क या निर्धारित प्राधिकारी का आदेश चाहिए होता है।"}]],[["$","section","सुधार",{"children":[["$","h2",null,{"children":"सुधार"}],[["$","p","0",{"children":"प्रमाण पत्र पर नाम या कोई और विवरण गलत हो, तो रजिस्ट्रार उपयुक्त साक्ष्य, जैसे अस्पताल के रिकॉर्ड या स्कूल के दस्तावेज़, के आधार पर उसे सुधार सकता है। मौजूदा प्रमाण पत्र और सही विवरण का प्रमाण साथ ले जाएँ।"}]]]}],["$","section","बाद में बच्चे का नाम जोड़ना",{"children":[["$","h2",null,{"children":"बाद में बच्चे का नाम जोड़ना"}],[["$","p","0",{"children":"अगर पंजीकरण के समय बच्चे का नाम नहीं दिया गया था, तो नियमों में दी गई समय-सीमा के भीतर उसे आमतौर पर बाद में जोड़ा जा सकता है। मौजूदा प्रक्रिया रजिस्ट्रार कार्यालय से पूछें।"}]]]}]],["$","h2",null,{"children":"शुरू करने से पहले"}],["$","ul",null,{"children":[["$","li","जब भी संभव हो 21 दिन के भीतर पंजीकरण कराएँ",{"children":[["$","$L16",null,{"icon":{"name":"check","size":24,"node":[["path",{"d":"M20 6 9 17l-5-5","key":"1gmf2c"}]]},"size":16}],"जब भी संभव हो 21 दिन के भीतर पंजीकरण कराएँ"]}],["$","li","अस्पताल की डिस्चार्ज पर्ची या जन्म का अन्य प्रमाण रखें",{"children":[["$","$L16",null,{"icon":"$1a:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"अस्पताल की डिस्चार्ज पर्ची या जन्म का अन्य प्रमाण रखें"]}],["$","li","सुधार के लिए प्रमाण पत्र और सही प्रमाण लाएँ",{"children":[["$","$L16",null,{"icon":"$1a:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size"