18:["$","div",null,{"className":"article-layout","children":[["$","div",null,{"children":[[["$","p","0",{"children":"हर आधार अपडेट अनुरोध को एक संदर्भ नंबर मिलता है। नामांकन या अपडेट केंद्र पर आपको अपडेट रिक्वेस्ट नंबर (URN) वाली पावती पर्ची मिलती है; ऑनलाइन अनुरोध में स्क्रीन पर सर्विस रिक्वेस्ट नंबर (SRN) दिखता है। अपडेट पूरा होने तक यह नंबर संभालकर रखें।"}],["$","p","1",{"children":"स्थिति देखने के लिए UIDAI की myAadhaar वेबसाइट खोलें और नामांकन व अपडेट की स्थिति जाँचने का विकल्प चुनें। URN या SRN और सुरक्षा कोड डालें। पेज बताएगा कि अनुरोध प्रक्रिया में है, पूरा हो गया है या अस्वीकार हुआ है।"}]],[["$","section","अगर अपडेट अस्वीकार हो जाए",{"children":[["$","h2",null,{"children":"अगर अपडेट अस्वीकार हो जाए"}],[["$","p","0",{"children":"अस्वीकृति का कारण ध्यान से पढ़ें। आम कारण हैं: माँगे गए बदलाव का समर्थन न करने वाला दस्तावेज़, प्रमाण से न मिलती वर्तनी या अस्पष्ट स्कैन। कारण ठीक करके उपयुक्त दस्तावेज़ों के साथ नया अनुरोध दें। जन्म तिथि जैसे कुछ क्षेत्र सीमित बार ही बदले जा सकते हैं, इसलिए पहले UIDAI के नियम देखें।"}]]]}],["$","section","अगर अपडेट पूरा हो जाए",{"children":[["$","h2",null,{"children":"अगर अपडेट पूरा हो जाए"}],[["$","p","0",{"children":"UIDAI से अपडेट किया हुआ ई-आधार डाउनलोड करें या PVC कार्ड मँगवाएँ। जहाँ भी पुराने आधार विवरण इस्तेमाल हुए हैं, जैसे बैंक या छात्रवृत्ति प्रोफ़ाइल, वहाँ नया विवरण अपडेट करें।"}]]]}]],["$","h2",null,{"children":"शुरू करने से पहले"}],["$","ul",null,{"children":[["$","li","पावती पर URN (केंद्र) या SRN (ऑनलाइन) ढूँढें",{"children":[["$","$L16",null,{"icon":{"name":"check","size":24,"node":[["path",{"d":"M20 6 9 17l-5-5","key":"1gmf2c"}]]},"size":16}],"पावती पर URN (केंद्र) या SRN (ऑनलाइन) ढूँढें"]}],["$","li","UIDAI की myAadhaar वेबसाइट पर स्थिति देखें",{"children":[["$","$L16",null,{"icon":"$18:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"UIDAI की myAadhaar वेबसाइट पर स्थिति देखें"]}],["$","li","अस्वीकार हो तो दोबारा आवेदन से पहले कारण पढ़ें",{"children":[["$","$L16",null,{"i