18:["$","$L2b",null,{"className":"article-cover","src":"/images/blog/certificate.png","alt":"झारखंड जाति प्रमाण पत्र आवेदन चेकलिस्ट","width":1200,"height":720,"priority":true,"sizes":"(max-width: 900px) 100vw, 800px"}]
19:["$","div",null,{"className":"article-layout","children":[["$","div",null,{"children":[[["$","p","0",{"children":"झारखंड में जाति प्रमाण पत्र के लिए राज्य के ई-डिस्ट्रिक्ट पोर्टल JharSewa पर ऑनलाइन आवेदन किया जाता है, और आपके अंचल के राजस्व अधिकारी उसका सत्यापन कर उसे जारी करते हैं। यह प्रमाण पत्र शिक्षा, छात्रवृत्ति, नौकरी और कल्याणकारी योजनाओं में बहुत काम आता है।"}],["$","p","1",{"children":"सत्यापन स्थानीय स्तर पर होता है, इसलिए आपकी दी हुई जानकारी आपके रिकॉर्ड से हूबहू मिलनी चाहिए: आवेदक का नाम, पिता का नाम, पता और पारिवारिक दस्तावेज़ों में दर्ज जाति। देरी का सबसे आम कारण यही अंतर होते हैं।"}]],[["$","section","आवेदन में आमतौर पर क्या माँगा जाता है",{"children":[["$","h2",null,{"children":"आवेदन में आमतौर पर क्या माँगा जाता है"}],[["$","p","0",{"children":"ऑनलाइन फ़ॉर्म में आमतौर पर पहचान और पते का विवरण, पारिवारिक जानकारी, स्व-घोषणा और आपके मामले के अनुसार सहायक रिकॉर्ड, जैसे किसी रिश्तेदार का जाति प्रमाण पत्र या भूमि रिकॉर्ड (खतियान) का विवरण माँगा जाता है। शुरू करने से पहले JharSewa पर ताज़ा चेकलिस्ट ज़रूर देखें, क्योंकि आवश्यकताएँ बदल सकती हैं।"}]]]}],["$","section","आवेदन के बाद",{"children":[["$","h2",null,{"children":"आवेदन के बाद"}],[["$","p","0",{"children":"आवेदन संख्या नोट कर लें। JharSewa पर इससे स्थिति देखें और स्वीकृत होने पर प्रमाण पत्र डाउनलोड करें। कार्यालय अतिरिक्त जानकारी माँगे तो जल्दी जवाब दें, वरना आवेदन बंद हो सकता है।"}]]]}]],["$","h2",null,{"children":"शुरू करने से पहले"}],["$","ul",null,{"children":[["$","li","JharSewa पर ताज़ा चेकलिस्ट देखें",{"children":[["$","$L16",null,{"icon":{"name":"check","size":24,"node":[["path",{"d":"M20 6 9 17l-5-5","key":"1gmf2c"}]]},"size":16}],"JharSewa पर ताज़ा चेकलिस्ट देखें"]}],["$","li","सभी दस्तावेज़ों में नाम एक जैसे रखें",{"children":[["$","$L16",null,{"icon":"$19:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"सभी दस्तावेज़ों में नाम एक जैसे रखें"]}],["$","li","सहायक पारिवारिक या भूमि रिकॉर्ड तैयार रखें",{"children":[["$","$L16",null,{"icon":"$19:pr