1a:["$","div",null,{"className":"article-layout","children":[["$","div",null,{"children":[[["$","p","0",{"children":"जीवन प्रमाण पात्र पेंशनभोगियों के लिए डिजिटल जीवन प्रमाणपत्र सेवा है। आने से पहले वर्तमान आधिकारिक निर्देश और समर्थित जमा करने के तरीके देख लें। केवल वही जानकारी और दस्तावेज़ लाएँ जो अधिकृत प्रक्रिया माँगती है, ज़रूरी पहचान सत्यापन खुद पूरा करें और अपने पेंशन प्राधिकरण के लिए पावती सँभालकर रखें। जहाँ उपलब्ध हो, NISE COMPORT मार्गदर्शन में मदद कर सकता है; स्वीकृति और प्रक्रिया के नियम पेंशन देने वाला प्राधिकरण तय करता है।"}]],"$undefined",["$","h2",null,{"children":"शुरू करने से पहले"}],["$","ul",null,{"children":[["$","li","वर्तमान आधिकारिक निर्देश देखें",{"children":[["$","$L16",null,{"icon":{"name":"check","size":24,"node":[["path",{"d":"M20 6 9 17l-5-5","key":"1gmf2c"}]]},"size":16}],"वर्तमान आधिकारिक निर्देश देखें"]}],["$","li","पक्का करें कि कोई अधिकृत बायोमेट्रिक चरण ज़रूरी है या नहीं",{"children":[["$","$L16",null,{"icon":"$1a:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"पक्का करें कि कोई अधिकृत बायोमेट्रिक चरण ज़रूरी है या नहीं"]}],["$","li","फ़ॉलो-अप के लिए पावती सँभालकर रखें",{"children":[["$","$L16",null,{"icon":"$1a:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"फ़ॉलो-अप के लिए पावती सँभालकर रखें"]}]]}],[["$","h2",null,{"children":"आधिकारिक स्रोत"}],["$","$L2a",null,{"variant":"list","links":[{"label":"Jeevan Pramaan (official)","href":"https://jeevanpramaan.gov.in/"}],"service":{"slug":"jeevan-pramaan","title":"Jeevan Pramaan Digital Life Certificate","documents":["Aadhaar number of the pensioner (the pensioner must be present for authentication)","Pension Payment Order (PPO) number","Bank account details where the pension is credited","Mobile number for the acknowledgement SMS"]}}]],["$","p",null,{"className":"article-disclaimer","children":"आवश्यकताएँ बदल सकती हैं। पात्रता, शुल्क, प्रक्रिया और अंतिम नतीजे संबंधित सरकारी विभाग, बीमा कंपनी, संस्थान या सेवा प्रदाता तय करते हैं। NISE COMPORT एक स्वतंत्र CSC / प्रज्ञा केंद्र सेवा केंद्र है, सरकारी कार्यालय नहीं।"}]]}],["$","aside",null,{"children":[["$","strong",null,{"children":"इसमें मदद चाहिए?"}],["$","p",null,{"children":"खरंगाझार, टेल्को, जमशेदपुर में NISE COMPORT टीम से बात करें। कॉल करें +91 97712 19893।"}],["$","$L15",null,{"className":"button button-green","href":"/hi/services/jeevan-pramaan","children":["जीवन प्रमाण (डिजिटल लाइफ़ सर्टिफ़िकेट)"," ",["$","$L16",null,{"icon":{"name":"arrow-up-right","size":24,"node":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]]},"size":15}]]}],["$","a",null,{"href":"https://wa.me/919771219893?text=*NISE%20COMPORT*%20%C2%B7%20Kharangajhar%2C%20Telco%2C%20Jamshedpur%0AHi%20NISE%20COMPORT%2C%20I%20read%20your%20guide%20%22%E0%A4%9C%E0%A5%80%E0%A4%B5%E0%A4%A8%20%E0%A4%AA%E0%A5%8D%E0%A4%B0%E0%A4%AE%E0%A4%BE%E0%A4%A3%20(%E0%A4%A1%E0%A4%BF%E0%A4%9C%E0%A4%BF%E0%A4%9F%E0%A4%B2%20%E0%A4%9C%E0%A5%80%E0%A4%B5%E0%A4%A8%20%E0%A4%AA%E0%A5%8D%E0%A4%B0%E0%A4%AE%E0%A4%BE%E0%A4%A3%E0%A4%AA%E0%A4%A4%E0%A5%8D%E0%A4%B0)%3A%20%E0%A4%9C%E0%A4%AE%E0%A4%BE%20%E0%A4%95%E0%A4%B0%E0%A4%A8%E0%A5%87%20%E0%A4%95%E0%A5%80%20%E0%A4%AF%E0%A5%8B%E0%A4%9C%E0%A4%A8%E0%A4%BE%20%E0%A4%B8%E0%A4%BE%E0%A4%B5%E0%A4%A7%E0%A4%BE%E0%A4%A8%E0%A5%80%20%E0%A4%B8%E0%A5%87%20%E0%A4%AC%E0%A4%A8%E0%A4%BE%E0%A4%8F%E0%A4%81%22%20and%20need%20help.","className":"article-whatsapp","target":"_blank","rel":"noopener noreferrer","children":"WhatsApp पर पूछें"}],["$","a",null,{"href":"https://maps.app.goo.gl/KYRQywDEKoNpU9d56","className":"article-whatsapp","target":"_blank","rel":"noopener noreferrer","children":"रास्ता देखें"}]]}]]}]
