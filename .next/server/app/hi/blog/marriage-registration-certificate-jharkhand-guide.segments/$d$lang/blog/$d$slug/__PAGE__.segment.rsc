18:["$","div",null,{"className":"article-layout","children":[["$","div",null,{"children":[[["$","p","0",{"children":"विवाह प्रमाण पत्र पासपोर्ट, वीज़ा, बैंक व बीमा नामांकन और नाम बदलने के लिए मान्य प्रमाण है। झारखंड अपने नागरिक सेवा पोर्टल के ज़रिए ऑनलाइन पंजीकरण देता है। सटीक दस्तावेज़ और अपॉइंटमेंट के चरण लागू विवाह कानून पर निर्भर करते हैं, इसलिए पोर्टल पर पुष्टि करें।"}],["$","p","1",{"children":"अगर आप जल्द ही पासपोर्ट या वीज़ा के लिए आवेदन करने वाले हैं तो पहले से तैयारी करें, क्योंकि सत्यापन में समय लग सकता है।"}]],[["$","section","आमतौर पर ज़रूरी दस्तावेज़",{"children":[["$","h2",null,{"children":"आमतौर पर ज़रूरी दस्तावेज़"}],[["$","p","0",{"children":"दोनों साथियों के पहचान और पते के प्रमाण, आयु प्रमाण जैसे जन्म प्रमाण पत्र या स्कूल प्रमाण पत्र, पासपोर्ट आकार की फ़ोटो, जहाँ माँगा जाए वहाँ शादी का निमंत्रण पत्र या समारोह का अन्य प्रमाण, और गवाहों का विवरण।"}]]]}],["$","section","प्रक्रिया कैसे चलती है",{"children":[["$","h2",null,{"children":"प्रक्रिया कैसे चलती है"}],[["$","p","0",{"children":"आप ऑनलाइन आवेदन जमा करते हैं, दस्तावेज़ अपलोड करते हैं और दी गई तारीख़ पर गवाहों के साथ उपस्थित होना पड़ सकता है। सत्यापन के बाद प्रमाण पत्र डाउनलोड किया जा सकता है। हम फ़ॉर्म, दस्तावेज़ स्कैन और ट्रैकिंग में मदद करते हैं।"}]]]}]],["$","h2",null,{"children":"शुरू करने से पहले"}],["$","ul",null,{"children":[["$","li","दोनों साथियों के पहचान, पते और आयु प्रमाण जुटाएँ",{"children":[["$","$L16",null,{"icon":{"name":"check","size":24,"node":[["path",{"d":"M20 6 9 17l-5-5","key":"1gmf2c"}]]},"size":16}],"दोनों साथियों के पहचान, पते और आयु प्रमाण जुटाएँ"]}],["$","li","पासपोर्ट आकार की फ़ोटो और गवाहों की व्यवस्था करें",{"children":[["$","$L16",null,{"icon":"$18:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"पासपोर्ट आकार की फ़ोटो और गवाहों की व्यवस्था करें"]}],["$","li","आधिकारिक पोर्टल पर आवेदन जमा करें",{"children":[["$","$L16",null,{"icon":"$18:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","siz