18:["$","div",null,{"className":"article-layout","children":[["$","div",null,{"children":[[["$","p","0",{"children":"e-EPIC निर्वाचक फ़ोटो पहचान पत्र (वोटर आईडी) का डिजिटल, डाउनलोड करने योग्य रूप है। इसे भारत निर्वाचन आयोग वोटर्स सर्विस पोर्टल और उसके ऐप के ज़रिए जारी करता है।"}],["$","p","1",{"children":"इसे डाउनलोड करने के लिए आप पोर्टल पर साइन इन करते हैं, अपना EPIC नंबर या फ़ॉर्म संदर्भ संख्या डालते हैं और अपने वोटर रिकॉर्ड से जुड़े मोबाइल नंबर पर आए OTP से पुष्टि करते हैं। मोबाइल नंबर लिंक न हो तो पोर्टल पहले सत्यापन पूरा करने या आपका विवरण अपडेट करने को कह सकता है।"}]],[["$","section","अगर आपका विवरण गलत हो",{"children":[["$","h2",null,{"children":"अगर आपका विवरण गलत हो"}],[["$","p","0",{"children":"e-EPIC तभी डाउनलोड करें जब आपका विवरण सही हो। गलतियाँ ठीक करने के लिए वोटर्स सर्विस पोर्टल का सुधार फ़ॉर्म इस्तेमाल करें, फिर सुधार स्वीकृत होने के बाद e-EPIC डाउनलोड करें।"}]]]}]],["$","h2",null,{"children":"शुरू करने से पहले"}],["$","ul",null,{"children":[["$","li","अपना EPIC नंबर या फ़ॉर्म संदर्भ संख्या तैयार रखें",{"children":[["$","$L16",null,{"icon":{"name":"check","size":24,"node":[["path",{"d":"M20 6 9 17l-5-5","key":"1gmf2c"}]]},"size":16}],"अपना EPIC नंबर या फ़ॉर्म संदर्भ संख्या तैयार रखें"]}],["$","li","वोटर रिकॉर्ड से जुड़ा मोबाइल नंबर इस्तेमाल करें",{"children":[["$","$L16",null,{"icon":"$18:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"वोटर रिकॉर्ड से जुड़ा मोबाइल नंबर इस्तेमाल करें"]}],["$","li","डाउनलोड से पहले गलतियाँ सुधारें",{"children":[["$","$L16",null,{"icon":"$18:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"डाउनलोड से पहले गलतियाँ सुधारें"]}],["$","li","सिर्फ़ आधिकारिक पोर्टल या ऐप से डाउनलोड करें",{"children":[["$","$L16",null,{"icon":"$18:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"सिर्फ़ आधिकारिक पोर्टल या ऐप से डाउनलोड करें"]}]]}],[["$","h2",null,{"children":"आधिकारिक स्रोत"}],["$","$L29",null,{"variant":"list","links":[{"label":"Voters’ Service Portal (ECI)","href":"https://voters.eci.gov.in/"}],"service":{"slug":"voter-id","title":"Voter ID (EPIC) Application & Correction","documents":["For new registration (Form 6): Aadhaar number (or a declaration if you don't have one), a recent passport-size colour photo on a white background (4.5cm x 3.5cm), age proof (birth certificate, 10th marksheet or similar), current address proof, mobile number for OTP, and the name/relation of a parent or spouse already on the roll if available","For correction/shifting/replacement (Form 8): existing EPIC number, Aadhaar number, proof of the new detail being corrected (address proof for shifting, age/name proof for a correction), and a recent photo","For overseas electors (Form 6A): valid Indian passport, current visa details, proof of the Indian address last ordinarily resided at, and a recent passport-size photo","Disability marking (optional, Form 8): a disability certificate, if you want it recorded"]}}]],["$","p",null,{"className":"article-disclaimer","children":"आवश्यकताएँ बदल सकती हैं। पात्रता, शुल्क, प्रक्रिया और अंतिम नतीजे संबंधित सरकारी विभाग, बीमा कंपनी, संस्थान या सेवा प्रदाता तय करते हैं। NISE COMPORT एक स्वतंत्र CSC / प्रज्ञा केंद्र सेवा केंद्र है, सरकारी कार्यालय नहीं।"}]]}],["$","aside",null,{"children":[["$","strong",null,{"children":"इसमें मदद चाहिए?"}],["$","p",null,{"children":"खरंगाझार, टेल्को, जमशेदपुर में NISE COMPORT टीम से बात करें। कॉल करें +91 97712 19893।"}],["$","$L15",null,{"className":"button button-green","href":"/hi/services/voter-id","children":["वोटर आईडी सेवाएँ"," ",["$","$L16",null,{"icon":{"name":"arrow-up-right","size":24,"node":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]]},"size":15}]]}],["$","a",null,{"href":"https://wa.me/919771219893?text=*NISE%20COMPORT*%20%C2%B7%20Kharangajhar%2C%20Telco%2C%20Jamshedpur%0AHi%20NISE%20COMPORT%2C%20I%20read%20your%20guide%20%22%E0%A4%A1%E0%A4%BF%E0%A4%9C%E0%