18:["$","div",null,{"className":"article-layout","children":[["$","div",null,{"children":[[["$","p","0",{"children":"आवासीय (कभी स्थानीय या डोमिसाइल कहा जाने वाला) प्रमाण पत्र झारखंड में राज्य के दाखिलों, छात्रवृत्तियों और भर्तियों के लिए अक्सर ज़रूरी होता है। आवेदन JharSewa पर ऑनलाइन किए जाते हैं और स्थानीय राजस्व कार्यालय उनका सत्यापन करता है।"}],["$","p","1",{"children":"निवास प्रमाण पत्र की पात्रता के नियम राज्य सरकार तय करती है और समय के साथ बदले हैं, इसलिए पुरानी चेकलिस्ट पर भरोसा करने के बजाय आवेदन से पहले JharSewa पर ताज़ा निर्देश पढ़ें।"}]],[["$","section","ये विवरण तैयार रखें",{"children":[["$","h2",null,{"children":"ये विवरण तैयार रखें"}],[["$","p","0",{"children":"आवेदक की पहचान का विवरण, वर्तमान पता, पारिवारिक विवरण और पोर्टल जो भी सहायक निवास रिकॉर्ड माँगे, जैसे भूमि रिकॉर्ड का विवरण या लंबे समय तक रहने का अन्य प्रमाण, तैयार रखें। सुनिश्चित करें कि सभी दस्तावेज़ों में वर्तनी एक जैसी हो।"}]]]}]],["$","h2",null,{"children":"शुरू करने से पहले"}],["$","ul",null,{"children":[["$","li","JharSewa पर ताज़ा पात्रता नोट पढ़ें",{"children":[["$","$L16",null,{"icon":{"name":"check","size":24,"node":[["path",{"d":"M20 6 9 17l-5-5","key":"1gmf2c"}]]},"size":16}],"JharSewa पर ताज़ा पात्रता नोट पढ़ें"]}],["$","li","पहचान, पता और पारिवारिक विवरण तैयार रखें",{"children":[["$","$L16",null,{"icon":"$18:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"पहचान, पता और पारिवारिक विवरण तैयार रखें"]}],["$","li","पोर्टल में सूचीबद्ध सहायक निवास रिकॉर्ड जुटाएँ",{"children":[["$","$L16",null,{"icon":"$18:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"पोर्टल में सूचीबद्ध सहायक निवास रिकॉर्ड जुटाएँ"]}],["$","li","प्रमाण पत्र जारी होने तक आवेदन संख्या ट्रैक करें",{"children":[["$","$L16",null,{"icon":"$18:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"प्रमाण पत्र जारी होने तक आवेदन संख्या ट्रैक करें"]}]]}],[["$","h2",null,{"children":"आधिकारिक स्रोत"}