19:["$","div",null,{"className":"article-layout","children":[["$","div",null,{"children":[[["$","p","0",{"children":"उद्यम पंजीकरण आपके व्यवसाय को सूक्ष्म, लघु या मध्यम उद्यम के रूप में मान्यता देता है। यह आधिकारिक पोर्टल पर निःशुल्क है और आपके आधार और पैन का उपयोग करता है। व्यवसाय ऋण या सब्सिडी के आवेदन पर कई बैंक और योजनाएँ इसे माँगती हैं।"}],["$","p","1",{"children":"यह GST पंजीकरण या ट्रेड लाइसेंस जैसा नहीं है। आपको वे भी चाहिए या नहीं, यह आपके टर्नओवर, वस्तुओं या सेवाओं और स्थानीय नियमों पर निर्भर करता है।"}]],[["$","section","आपको क्या चाहिए",{"children":[["$","h2",null,{"children":"आपको क्या चाहिए"}],[["$","p","0",{"children":"मालिक का आधार (OTP के लिए जुड़े मोबाइल के साथ), पैन, व्यवसाय का नाम और पता, बैंक खाते का विवरण, व्यवसाय का प्रकार, और निवेश व टर्नओवर का अनुमान।"}]]]}],["$","section","यह कैसे काम करता है",{"children":[["$","h2",null,{"children":"यह कैसे काम करता है"}],[["$","p","0",{"children":"पंजीकरण आधिकारिक उद्यम पोर्टल पर होता है, जो स्थायी नंबर वाला प्रमाण पत्र जारी करता है। कोई सरकारी शुल्क नहीं है। हम उसे सही भरने और प्रमाण पत्र डाउनलोड करने में मदद करते हैं; हमारा सेवा शुल्क पहले बताया जाता है।"}]]]}],["$","section","इसके बाद",{"children":[["$","h2",null,{"children":"इसके बाद"}],[["$","p","0",{"children":"प्रमाण पत्र संभालकर रखें और विवरण या व्यावसायिक गतिविधि बदलने पर पोर्टल अपडेट करें। बैंक योजनाओं के लिए आवेदन करते समय यह नंबर इस्तेमाल करें।"}]]]}]],["$","h2",null,{"children":"शुरू करने से पहले"}],["$","ul",null,{"children":[["$","li","आधार और पैन तैयार रखें",{"children":[["$","$L16",null,{"icon":{"name":"check","size":24,"node":[["path",{"d":"M20 6 9 17l-5-5","key":"1gmf2c"}]]},"size":16}],"आधार और पैन तैयार रखें"]}],["$","li","बैंक खाते का विवरण साथ रखें",{"children":[["$","$L16",null,{"icon":"$19:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"बैंक खाते का विवरण साथ रखें"]}],["$","li","अपनी व्यावसायिक गतिविधि सही बताएँ",{"children":[["$","$L16",null,{"icon":"$19:props:children:0:props:children