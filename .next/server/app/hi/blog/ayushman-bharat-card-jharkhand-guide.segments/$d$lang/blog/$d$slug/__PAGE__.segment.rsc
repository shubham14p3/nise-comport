18:["$","div",null,{"className":"article-layout","children":[["$","div",null,{"children":[[["$","p","0",{"children":"आयुष्मान भारत (PM-JAY) पात्र परिवारों को सूचीबद्ध अस्पतालों में इलाज के लिए स्वास्थ्य कवर देता है। पात्रता सरकारी सूचियों और मानदंडों से तय होती है, किसी निजी केंद्र से नहीं, इसलिए पहला कदम हमेशा यह जाँचना है कि आप कवर हैं या नहीं।"}],["$","p","1",{"children":"आपका परिवार पात्र हो तो आमतौर पर आप आधार से e-KYC पूरा करके अपना आयुष्मान कार्ड डाउनलोड या प्राप्त कर सकते हैं। अगर आप सूची में नहीं हैं, तो आधिकारिक हेल्पलाइन या अपने स्थानीय स्वास्थ्य कार्यालय से पूछें कि आपके लिए क्या लागू होता है।"}]],[["$","section","पात्रता जाँचें",{"children":[["$","h2",null,{"children":"पात्रता जाँचें"}],[["$","p","0",{"children":"आधिकारिक लाभार्थी पोर्टल या हेल्पलाइन पर मोबाइल नंबर या राशन कार्ड विवरण से खोजें। अपना नाम ‘जुड़वाने’ के लिए किसी को पैसे न दें; सूची अधिकारी बनाए रखते हैं।"}]]]}],["$","section","दस्तावेज़ और e-KYC",{"children":[["$","h2",null,{"children":"दस्तावेज़ और e-KYC"}],[["$","p","0",{"children":"व्यक्ति का आधार, राशन कार्ड या पारिवारिक विवरण, और OTP के लिए आधार से जुड़ा मोबाइल नंबर साथ रखें। OTP सिर्फ़ खुद डालें।"}]]]}],["$","section","कार्ड का उपयोग",{"children":[["$","h2",null,{"children":"कार्ड का उपयोग"}],[["$","p","0",{"children":"सूचीबद्ध अस्पताल जाते समय कार्ड या आधार साथ रखें और आयुष्मान हेल्प डेस्क के बारे में पूछें। इलाज और सीमाएँ योजना के नियमों के अनुसार होती हैं।"}]]]}]],["$","h2",null,{"children":"शुरू करने से पहले"}],["$","ul",null,{"children":[["$","li","आधिकारिक पोर्टल पर पात्रता जाँचें",{"children":[["$","$L16",null,{"icon":{"name":"check","size":24,"node":[["path",{"d":"M20 6 9 17l-5-5","key":"1gmf2c"}]]},"size":16}],"आधिकारिक पोर्टल पर पात्रता जाँचें"]}],["$","li","आधार और लिंक्ड मोबाइल साथ रखें",{"children":[["$","$L16",null,{"icon":"$18:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"आधार और लिंक्ड मोबाइल साथ रखें"]}],["$","li","e-KYC खुद पूरा करें और OTP कभी साझा न करें",{"children":