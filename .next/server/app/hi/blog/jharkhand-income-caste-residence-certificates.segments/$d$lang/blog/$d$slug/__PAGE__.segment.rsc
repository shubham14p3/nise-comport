1b:["$","div",null,{"className":"article-layout","children":[["$","div",null,{"children":[[["$","p","0",{"children":"प्रमाण पत्र की ज़रूरतें प्रमाण पत्र के प्रकार, आवेदक की स्थिति और झारखंड पोर्टल के वर्तमान निर्देशों पर निर्भर करती हैं। शुरू करने से पहले तय करें कि कौन-सा प्रमाण पत्र चाहिए और संबंधित विभाग की वर्तमान चेकलिस्ट देख लें। आम आवेदनों में पहचान, पता, परिवार या आय की जानकारी माँगी जा सकती है, पर पुरानी चेकलिस्ट को पक्की गारंटी न मानें।"}],["$","p","1",{"children":"आधिकारिक फ़ॉर्म में माँगे गए मूल दस्तावेज़ साथ रखें और वर्तनी, पते और सहायक जानकारी ध्यान से जाँचें। NISE COMPORT जमशेदपुर में पोर्टल चलाने और जमा करने के चरणों में मदद कर सकता है। प्रमाण पत्र जारी करने वाला प्राधिकरण सबूतों की जाँच करता है, पात्रता तय करता है और समय-सीमा नियंत्रित करता है।"}]],"$undefined",["$","h2",null,{"children":"शुरू करने से पहले"}],["$","ul",null,{"children":[["$","li","प्रमाण पत्र का प्रकार और आवेदक की श्रेणी पक्की करें",{"children":[["$","$L16",null,{"icon":{"name":"check","size":24,"node":[["path",{"d":"M20 6 9 17l-5-5","key":"1gmf2c"}]]},"size":16}],"प्रमाण पत्र का प्रकार और आवेदक की श्रेणी पक्की करें"]}],["$","li","झारखंड की वर्तमान आधिकारिक चेकलिस्ट का उपयोग करें",{"children":[["$","$L16",null,{"icon":"$1b:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"झारखंड की वर्तमान आधिकारिक चेकलिस्ट का उपयोग करें"]}],["$","li","सभी प्रमाणों में नाम और पते एक जैसे हों",{"children":[["$","$L16",null,{"icon":"$1b:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"सभी प्रमाणों में नाम और पते एक जैसे हों"]}],["$","li","स्थिति देखने के लिए आवेदन संदर्भ सहेज लें",{"children":[["$","$L16",null,{"icon":"$1b:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"स्थिति देखने के लिए आवेदन संदर्भ सहेज लें"]}]]}],[["$","h2",null,{"children":"आधिकारिक स्रोत"}],["$","$L2e",null,{"variant":"list","links":[{"label":"JharSewa (Jharkhand e-District)","href":"https://jharsewa.jharkhand.gov.in/"}],"service":{"slug":"income-caste-residence-certificate","title":"Income Certificate Application Help (Jharkhand)","documents":["Applicant's Aadhaar card","Self-declaration / income affidavit stating annual family income and source (salary, business, agriculture, etc.)","Ration card, if available","Residence proof (voter ID, electricity bill or rent agreement)","Salary slip or employer certificate for salaried applicants; land records (khatiyan/rent receipt) for agricultural income","Bank passbook front page","Recent passport-size photograph","Mobile number for OTP and SMS status updates","Parent's/guardian's name and relation, as asked on the form"]}}]],["$","p",null,{"className":"article-disclaimer","children":"आवश्यकताएँ बदल सकती हैं। पात्रता, शुल्क, प्रक्रिया और अंतिम नतीजे संबंधित सरकारी विभाग, बीमा कंपनी, संस्थान या सेवा प्रदाता तय करते हैं। NISE COMPORT एक स्वतंत्र CSC / प्रज्ञा केंद्र सेवा केंद्र है, सरकारी कार्यालय नहीं।"}]]}],["$","aside",null,{"children":[["$","strong",null,{"children":"इसमें मदद चाहिए?"}],["$","p",null,{"children":"खरंगाझार, टेल्को, जमशेदपुर में NISE COMPORT टीम से बात करें। कॉल करें +91 97712 19893।"}],["$","$L15",null,{"className":"button button-green","href":"/hi/services/income-caste-residence-certificate","children":["आय प्रमाण पत्र"," ",["$","$L16",null,{"icon":{"name":"arrow-up-right","size":24,"node":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]]},"size":15}]]}],["$","a",null,{"href":"https://wa.me/919771219893?text=*NISE%20COMPORT*%20%C2%B7%20Kharangajhar%2C%20Telco%2C%20Jamshedpur%0AHi%20NISE%20COMPORT%2C%20I%20read%20your%20guide%20%22%E0%A4%9D%E0%A4%BE%E0%A4%B0%E0%A4%96%E0%A4%82%E0%A4%A1%20%E0%A4%AE%E0%A5%87%E0%A4%82%20%E0%A4%86%E0%A4%AF%2C%20%E0%A4%9C%E0%A4%BE%E0%A4%A4%E0%A4%BF%20%E0%A4%94%E0%A4%B0%20%E0%A4%A8%E0%A4%BF%E0%A4%B5%E0%A4%BE%E0%A4%B8%20%E0%A4%AA%E0%A5%8D%E0%A4%B0%E0%A4%AE%E0%A4%BE%E0%A4%A3%20%E0%A4%AA%E0%A4%A4%E0%A5%8D%E0%A4%B0%3A%20%E0%A4%95%E0%A5%8C