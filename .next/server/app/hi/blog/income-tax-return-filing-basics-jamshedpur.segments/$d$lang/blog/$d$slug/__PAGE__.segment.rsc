19:["$","div",null,{"className":"article-layout","children":[["$","div",null,{"children":[[["$","p","0",{"children":"पहले कागज़ात जुटा लें तो आयकर रिटर्न भरना आसान हो जाता है। फ़ॉर्म और अंतिम तिथियाँ आयकर विभाग हर साल तय करता है, इसलिए फ़ाइल करने से पहले हमेशा आधिकारिक पोर्टल पर मौजूदा नियम देखें।"}],["$","p","1",{"children":"ज़्यादातर नोटिस आपके रिटर्न और विभाग के पास पहले से मौजूद जानकारी, जैसे ब्याज आय या TDS, के बीच अंतर से आते हैं। फ़ाइल करने से पहले अपना वार्षिक विवरण देख लेना मदद करता है।"}]],[["$","section","लाने वाले दस्तावेज़",{"children":[["$","h2",null,{"children":"लाने वाले दस्तावेज़"}],[["$","p","0",{"children":"पैन और आधार (लिंक्ड), वेतनभोगी हों तो फ़ॉर्म 16, बैंक स्टेटमेंट और ब्याज प्रमाण पत्र, निवेश और कटौतियों का विवरण, ज़रूरी हो तो किराये की रसीदें, और व्यावसायिक आय के लिए आपकी बही या आय-व्यय का सारांश।"}]]]}],["$","section","फ़ाइल करने से पहले",{"children":[["$","h2",null,{"children":"फ़ाइल करने से पहले"}],[["$","p","0",{"children":"आय और काटे गए कर के लिए अपना वार्षिक सूचना विवरण और फ़ॉर्म 26AS देखें। सुनिश्चित करें कि आपका बैंक खाता रिफ़ंड के लिए पहले से मान्य (प्री-वैलिडेटेड) है।"}]]]}],["$","section","फ़ाइल करने के बाद",{"children":[["$","h2",null,{"children":"फ़ाइल करने के बाद"}],[["$","p","0",{"children":"अनुमत समय के भीतर रिटर्न का ई-वेरिफ़िकेशन करें (आधार OTP, नेट बैंकिंग या अन्य विकल्प) और पावती सहेजें।"}]]]}]],["$","h2",null,{"children":"शुरू करने से पहले"}],["$","ul",null,{"children":[["$","li","पैन और आधार लिंक करें",{"children":[["$","$L16",null,{"icon":{"name":"check","size":24,"node":[["path",{"d":"M20 6 9 17l-5-5","key":"1gmf2c"}]]},"size":16}],"पैन और आधार लिंक करें"]}],["$","li","फ़ॉर्म 16 और बैंक ब्याज प्रमाण पत्र जुटाएँ",{"children":[["$","$L16",null,{"icon":"$19:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"फ़ॉर्म 16 और बैंक ब्याज प्रमाण पत्र जुटाएँ"]}],["$","li","वार्षिक सूचना विवरण जाँचें",{"children":[["$","$L16",null,{"icon":"$19:props:children:0:props:children:3:props:childr