19:["$","div",null,{"className":"article-layout","children":[["$","div",null,{"children":[[["$","p","0",{"children":"आय प्रमाण पत्र की प्रक्रिया में वे जानकारियाँ और सबूत लगते हैं जो संबंधित झारखंड प्राधिकरण तय करता है। ज़रूरतें बदल सकती हैं, इसलिए आवेदन से पहले वर्तमान सूची देख लें। परिवार और आय की जानकारी ध्यान से व्यवस्थित करें और पक्का करें कि सहायक रिकॉर्ड पढ़ने लायक हों।"}],["$","p","1",{"children":"सेवा केंद्र फ़ॉर्म चलाने और जमा करने में मदद कर सकता है, पर वह पात्रता प्रमाणित नहीं कर सकता और न ही मंज़ूरी की समय-सीमा तय कर सकता है। संदर्भ संख्या सँभालकर रखें और आधिकारिक मार्ग से स्थिति देखें।"}]],"$undefined",["$","h2",null,{"children":"शुरू करने से पहले"}],["$","ul",null,{"children":[["$","li","विभाग के वर्तमान निर्देश पक्के करें",{"children":[["$","$L16",null,{"icon":{"name":"check","size":24,"node":[["path",{"d":"M20 6 9 17l-5-5","key":"1gmf2c"}]]},"size":16}],"विभाग के वर्तमान निर्देश पक्के करें"]}],["$","li","परिवार और आय की जानकारी सही-सही तैयार करें",{"children":[["$","$L16",null,{"icon":"$19:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"परिवार और आय की जानकारी सही-सही तैयार करें"]}],["$","li","ज़रूरी फ़ॉर्मैट में पढ़ने लायक प्रमाण अपलोड करें",{"children":[["$","$L16",null,{"icon":"$19:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"ज़रूरी फ़ॉर्मैट में पढ़ने लायक प्रमाण अपलोड करें"]}],["$","li","पावती से आवेदन की स्थिति देखते रहें",{"children":[["$","$L16",null,{"icon":"$19:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"पावती से आवेदन की स्थिति देखते रहें"]}]]}],[["$","h2",null,{"children":"आधिकारिक स्रोत"}],["$","$L2a",null,{"variant":"list","links":[{"label":"JharSewa (Jharkhand e-District)","href":"https://jharsewa.jharkhand.gov.in/"}],"service":{"slug":"income-caste-residence-certificate","title":"Income Certificate Application Help (Jharkhand)","documents":["Applicant's Aadhaar card","Self-declaration / income a