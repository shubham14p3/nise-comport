1a:["$","div",null,{"className":"article-layout","children":[["$","div",null,{"children":[[["$","p","0",{"children":"म्यूटेशन, जिसे दाखिल-खारिज भी कहते हैं, बिक्री, दान, विरासत या बँटवारे के बाद भू-राजस्व रिकॉर्ड में नया मालिक दर्ज करता है। झारखंड में आवेदन Jharbhoomi पोर्टल से ऑनलाइन किए जा सकते हैं और अंचल कार्यालय उनका सत्यापन करता है।"}],["$","p","1",{"children":"सिर्फ़ पंजीकृत दस्तावेज़ से राजस्व रिकॉर्ड अपडेट नहीं होता। म्यूटेशन के बिना ज़मीन का लगान भरना, कुछ प्रमाण पत्र बनवाना या बाद में ज़मीन बेचना मुश्किल हो सकता है।"}]],[["$","section","आवेदन से पहले ये तैयार रखें",{"children":[["$","h2",null,{"children":"आवेदन से पहले ये तैयार रखें"}],[["$","p","0",{"children":"पंजीकृत दस्तावेज़ या हस्तांतरण का अन्य कागज़, भूखंड का विवरण (मौजा, खाता और प्लॉट नंबर), आवेदक का पहचान प्रमाण और कोई पुरानी लगान रसीद। विरासत के मामले में कार्यालय की माँग के अनुसार वैध उत्तराधिकारियों को दर्शाने वाले दस्तावेज़ रखें।"}]]]}]],["$","h2",null,{"children":"शुरू करने से पहले"}],["$","ul",null,{"children":[["$","li","पंजीकृत दस्तावेज़ और भूखंड का विवरण तैयार रखें",{"children":[["$","$L16",null,{"icon":{"name":"check","size":24,"node":[["path",{"d":"M20 6 9 17l-5-5","key":"1gmf2c"}]]},"size":16}],"पंजीकृत दस्तावेज़ और भूखंड का विवरण तैयार रखें"]}],["$","li","Jharbhoomi पर ऑनलाइन आवेदन करें और केस नंबर नोट करें",{"children":[["$","$L16",null,{"icon":"$1a:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"Jharbhoomi पर ऑनलाइन आवेदन करें और केस नंबर नोट करें"]}],["$","li","अंचल कार्यालय का कोई नोटिस आए तो जवाब दें",{"children":[["$","$L16",null,{"icon":"$1a:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"अंचल कार्यालय का कोई नोटिस आए तो जवाब दें"]}],["$","li","म्यूटेशन स्वीकृत होने पर अपडेट हुआ रिकॉर्ड जाँचें",{"children":[["$","$L16",null,{"icon":"$1a:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"म्यूटेशन स्वीकृत होने पर अपडेट हुआ रिकॉर्ड जाँचें"]}]]}],[["$