19:["$","div",null,{"className":"article-layout","children":[["$","div",null,{"children":[[["$","p","0",{"children":"झारखंड में ड्राइविंग लाइसेंस के आवेदन राष्ट्रीय परिवहन सारथी पोर्टल पर ऑनलाइन होते हैं। आप लर्नर लाइसेंस (LL) से शुरुआत करते हैं, जो नियमों में दी शर्तों के तहत अभ्यास की अनुमति देता है, और बाद में स्थायी ड्राइविंग लाइसेंस (DL) के लिए आवेदन करते हैं।"}],["$","p","1",{"children":"सारथी पर आप झारखंड चुनते हैं, आवेदन भरते हैं, दस्तावेज़ अपलोड करते हैं, शुल्क ऑनलाइन चुकाते हैं और जहाँ पोर्टल सुविधा दे, वहाँ लर्नर परीक्षा ऑनलाइन देते हैं, या अपने ज़िला परिवहन कार्यालय में स्लॉट बुक करते हैं।"}]],[["$","section","लर्नर परीक्षा से पहले",{"children":[["$","h2",null,{"children":"लर्नर परीक्षा से पहले"}],[["$","p","0",{"children":"परीक्षा में यातायात संकेत, सड़क नियम और सुरक्षित ड्राइविंग से सवाल आते हैं। सारथी अभ्यास सामग्री देता है। अपना आवेदन नंबर और रसीदें एक साथ रखें।"}]]]}],["$","section","स्थायी लाइसेंस की ओर",{"children":[["$","h2",null,{"children":"स्थायी लाइसेंस की ओर"}],[["$","p","0",{"children":"स्थायी ड्राइविंग लाइसेंस के लिए आमतौर पर लर्नर लाइसेंस के 30 दिन पूरे होने के बाद और उसकी अवधि समाप्त होने से पहले आवेदन किया जा सकता है। सारथी पर ड्राइविंग टेस्ट बुक करें और परिवहन कार्यालय की ज़रूरत के अनुसार उपयुक्त वाहन लेकर जाएँ।"}]]]}]],["$","h2",null,{"children":"शुरू करने से पहले"}],["$","ul",null,{"children":[["$","li","आधिकारिक सारथी पोर्टल पर आवेदन करें और झारखंड चुनें",{"children":[["$","$L16",null,{"icon":{"name":"check","size":24,"node":[["path",{"d":"M20 6 9 17l-5-5","key":"1gmf2c"}]]},"size":16}],"आधिकारिक सारथी पोर्टल पर आवेदन करें और झारखंड चुनें"]}],["$","li","आयु और पते के प्रमाण तैयार रखें",{"children":[["$","$L16",null,{"icon":"$19:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"आयु और पते के प्रमाण तैयार रखें"]}],["$","li","आवेदन संख्या और भुगतान रसीद सहेजें",{"children":[["$","$L16",null,{"icon":"$19:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}]