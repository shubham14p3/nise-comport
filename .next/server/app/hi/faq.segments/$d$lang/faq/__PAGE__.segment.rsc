24:T8034,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"क्या NISE COMPORT सरकारी कार्यालय है?","acceptedAnswer":{"@type":"Answer","text":"नहीं। NISE COMPORT एक स्वतंत्र CSC / प्रज्ञा केंद्र सेवा केंद्र है जो ग्राहकों को सरकारी और डिजिटल सेवाओं का उपयोग करने में मदद करता है। अंतिम निर्णय संबंधित विभाग, बैंक या प्रदाता का होता है।"}},{"@type":"Question","name":"CSC / प्रज्ञा केंद्र क्या है?","acceptedAnswer":{"@type":"Answer","text":"कॉमन सर्विस सेंटर (CSC) या प्रज्ञा केंद्र एक स्थानीय सेवा बिंदु है जो नागरिकों को घर के पास ही सरकारी और डिजिटल सेवाओं के लिए आवेदन करने में मदद करता है, ताकि उन्हें कई कार्यालयों के चक्कर न लगाने पड़ें।"}},{"@type":"Question","name":"आप जमशेदपुर की सेवा कब से कर रहे हैं?","acceptedAnswer":{"@type":"Answer","text":"हमने 1995 में NISE के रूप में शुरुआत की और बढ़कर NISE COMPORT बने। हमारे कई ग्राहक सालों से हमारे पास आ रहे हैं।"}},{"@type":"Question","name":"आप कौन-सी सेवाएँ देते हैं?","acceptedAnswer":{"@type":"Answer","text":"पैन और आधार में मदद, झारखंड के प्रमाण पत्र, वोटर आईडी, बैंकिंग और AEPS, बीमा, छात्रवृत्ति और परीक्षा फ़ॉर्म, ITR और व्यवसाय फ़ॉर्म, वेबसाइट निर्माण, फ़ोटो स्टूडियो, प्रिंटिंग और फ़ोटोकॉपी, तथा कंप्यूटर मरम्मत और हार्डवेयर। पूरी सूची सेवाएँ पेज पर देखिए।"}},{"@type":"Question","name":"क्या मैं हिन्दी में किसी से बात कर सकता हूँ?","acceptedAnswer":{"@type":"Answer","text":"हाँ। हमारी टीम हिन्दी, बांग्ला और अंग्रेज़ी बोलती है, और मुख्य पेज हिन्दी में /hi और बांग्ला में /bn पर उपलब्ध हैं।"}},{"@type":"Question","name":"क्या आपकी साइट पर दिखे लोगो और सेवाएँ आपकी हैं?","acceptedAnswer":{"@type":"Answer","text":"नहीं। CSC, डिजिटल इंडिया, पैन, आधार और वोटर आईडी जैसे नाम उनके स्वामियों के हैं। हम एक स्वतंत्र स्थानीय सहायक हैं जो आवेदन करने, जमा करने और ट्रैक करने में आपका मार्गदर्शन करते हैं।"}},{"@type":"Question","name":"आपकी टीम में कौन हैं?","acceptedAnswer":{"@type":"Answer","text":"सर्विस डेस्क के लोगों से टीम पेज पर मिलिए। स्टाफ़ आपके आवेदन में मदद करता है, पर स्वीकृति का फ़ैसला कभी नहीं करता।"}},{"@type":"Question","name":"आप कहाँ स्थित हैं?","acceptedAnswer":{"@type":"Answer","text":"दुकान नंबर 3, भूतल, सिंह बिल्डिंग, हनुमान मंदिर रोड, खरंगाझार, टेल्को कॉलोनी, जमशेदपुर, झारखंड 831004। रास्ते के लिए संपर्क पेज से Google Maps खोलिए।"}},{"@type":"Question","name":"आप किन इलाकों में सेवा देते हैं?","acceptedAnswer":{"@type":"Answer","text":"खरंगाझार, टेल्को, गोविंदपुर, बिरसानगर, गोलमुरी, साकची, मानगो और पूरे जमशेदपुर से ग्राहक सीधे आते हैं। ऑनलाइन अनुरोध कहीं से भी भेजे जा सकते हैं। हम जहाँ सेवा देते हैं वह पेज देखिए।"}},{"@type":"Question","name":"आपके खुलने का समय क्या है?","acceptedAnswer":{"@type":"Answer","text":"हमारे समय संपर्क पेज पर दिखाए गए हैं और सार्वजनिक छुट्टियों में बदल जाते हैं। ज़रूरी या पोर्टल पर निर्भर काम के लिए आने से पहले +91 97712 19893 पर कॉल कीजिए।"}},{"@type":"Question","name":"क्या मुझे अपॉइंटमेंट चाहिए?","acceptedAnswer":{"@type":"Answer","text":"नहीं। आप खुलने के समय में सीधे आ सकते हैं। लंबे या ज़्यादा दस्तावेज़ों वाले काम के लिए पहले अनुरोध भेजिए या WhatsApp कीजिए ताकि हम ठीक-ठीक बता सकें कि क्या लाना है।"}},{"@type":"Question","name":"आने पर मुझे क्या साथ लाना चाहिए?","acceptedAnswer":{"@type":"Answer","text":"अपनी सेवा के मूल दस्तावेज़, जहाँ हम माँगें वहाँ फ़ोटोकॉपी, और OTP के लिए अपना मोबाइल फ़ोन (OTP किसी को कभी न बताएँ)। हर सेवा पेज पर दस्तावेज़ों की सूची है।"}},{"@type":"Question","name":"क्या मेरी तरफ़ से कोई और आ सकता है?","acceptedAnswer":{"@type":"Answer","text":"कई सेवाओं के लिए हाँ, यदि वे आपके दस्तावेज़ लाएँ। जिन सेवाओं में आपका OTP, बायोमेट्रिक या फ़ोटो चाहिए (जैसे आधार अपडेट और पैन के कुछ चरण), वहाँ आपको स्वयं आना पड़ सकता है। पहले हमसे पूछ लीजिए।"}},{"@type":"Question","name":"क्या मैं आपसे WhatsApp पर बात कर सकता हूँ?","acceptedAnswer":{"@type":"Answer","text":"हाँ। +91 97712 19893 या +91 98355 52756 पर WhatsApp कीजिए। आप सवाल या दस्तावेज़ की फ़ोटो भेज सकते हैं और हम अगला कदम बता देंगे।"}},{"@type":"Question","name":"क्या सरकारी शुल्क आपके सेवा शुल्क में शामिल हैं?","acceptedAnswer":{"@type":"Answer","text":"नहीं। हम अपना सेवा शुल्क किसी भी सरकारी, पोर्टल, बैंक या बीमा शुल्क से अलग दिखाते हैं। रसीद में वसूले गए शुल्क अलग-अलग लिखे होते हैं।"}},{"@type":"Question","name":"इसमें कितना खर्च आएगा?","acceptedAnswer":{"@type":"Answer","text":"काम शुरू करने से पहले हम अपना सेवा शुल्क बता देते हैं। प्रिंटिंग की दरें मूल्य पेज पर हैं; अन्य सेवाओं का शुल्क WhatsApp पर या डेस्क पर पक्का किया जाता है।"}},{"@type":"Question","name":"क्या आप आवेदन की स्वीकृति की गारंटी दे सकते हैं?","acceptedAnswer":{"@type":"Answer","text":"नहीं। स्वीकृति, प्रक्रिया का समय और फ़ैसले संबंधित सरकारी विभाग, कंपनी या सेवा प्रदाता के नियंत्रण में होते हैं।"}},{"@type":"Question","name":"मैं भुगतान कैसे कर सकता हूँ?","acceptedAnswer":{"@type":"Answer","text":"आप डेस्क पर नकद या UPI से भुगतान कर सकते हैं। ऑनलाइन भुगतान जोड़ा जा रहा है; चालू होने पर आपके अनुरोध पर भुगतान की पुष्टि होगी और रसीद जारी होगी।"}},{"@type":"Question","name":"क्या मुझे रसीद मिलेगी?","acceptedAnswer":{"@type":"Answer","text":"हाँ। हर भुगतान की रसीद या पुष्टि दी जाती है, और जहाँ पोर्टल की पावती हो वह भी। दोनों सँभालकर रखिए।"}},{"@type":"Question","name":"क्या मुझे रिफ़ंड मिल सकता है?","acceptedAnswer":{"@type":"Answer","text":"यदि आप काम शुरू होने से पहले रद्द करते हैं, या हम सेवा नहीं दे पाते, तो सेवा शुल्क वापस किया जाता है। पूरी हो चुकी सेवा का शुल्क आमतौर पर वापस नहीं होता। विवरण के लिए रिफ़ंड और रद्दीकरण नीति देखिए।"}},{"@type":"Question","name":"ऑफ़र और प्रोमो कोड कैसे काम करते हैं?","acceptedAnswer":{"@type":"Answer","text":"प्रोमो कोड और वेलकम कूपन केवल हमारे सेवा शुल्क पर छूट देते हैं, सरकारी शुल्क पर कभी नहीं। अपने अनुरोध पर कोड डालिए, या आज क्या चल रहा है यह जानने के लिए ऑफ़र पेज देखिए।"}},{"@type":"Question","name":"क्या सुधार के लिए आप अतिरिक्त शुल्क लेते हैं?","acceptedAnswer":{"@type":"Answer","text":"यदि दी गई जानकारी या दस्तावेज़ गलत या अधूरे थे और इसलिए सुधार चाहिए, तो दोबारा फ़ाइल करने पर नया सेवा शुल्क लग सकता है। यदि गलती हमारी थी, तो हम उसे बिना शुल्क ठीक करते हैं।"}},{"@type":"Question","name":"मैं अनुरोध को कैसे ट्रैक कर सकता हूँ?","acceptedAnswer":{"@type":"Answer","text":"अनुरोध ट्रैक करें पेज इस्तेमाल कीजिए। यह दिखाता है कि अपनी प्रोफ़ाइल में NISE COMPORT का अनुरोध कैसे देखें, और पैन, प्रमाण पत्र तथा वोटर आईडी आधिकारिक पोर्टल पर कहाँ ट्रैक करें। स्थिति बदलने पर हम ईमेल भी करते हैं।"}},{"@type":"Question","name":"क्या मैं अनुरोध रद्द कर सकता हूँ?","acceptedAnswer":{"@type":"Answer","text":"हाँ, जब तक वह जमा है, समीक्षा में है या आपकी प्रतीक्षा में है। अपनी प्रोफ़ाइल में अनुरोध खोलिए और “यह अनुरोध रद्द करें” चुनिए। उस चरण के बाद डेस्क को कॉल या WhatsApp कीजिए।"}},{"@type":"Question","name":"मैं ऑनलाइन अनुरोध कैसे शुरू करूँ?","acceptedAnswer":{"@type":"Answer","text":"अपनी सेवा चुनिए, दस्तावेज़ अपलोड कीजिए और अनुरोध भेजिए। आप ईमेल कोड से साइन इन कर सकते हैं, और आपकी जानकारी सहेज ली जाती है ताकि अगली बार दोबारा न लिखनी पड़े।"}},{"@type":"Question","name":"मेरे अनुरोध में कितना समय लगेगा?","acceptedAnswer":{"@type":"Answer","text":"यह सेवा और सरकार या प्रदाता पर निर्भर करता है। अनुरोध पक्का करते समय हम सामान्य समय बता देते हैं। आधिकारिक पोर्टलों की देरी हमारे नियंत्रण में नहीं है।"}},{"@type":"Question","name":"मेरा संदर्भ नंबर खो गया। अब क्या करूँ?","acceptedAnswer":{"@type":"Answer","text":"अपनी सभी अनुरोध संदर्भ संख्याएँ देखने के लिए प्रोफ़ाइल में साइन इन कीजिए, या हमें अपना नाम और लगभग तारीख भेजिए, हम ढूँढ देंगे।"}},{"@type":"Question","name":"मेरा आवेदन ‘प्रक्रियाधीन’ दिखा रहा है। क्या यह सामान्य है?","acceptedAnswer":{"@type":"Answer","text":"आमतौर पर हाँ। इसका मतलब है कि विभाग को वह मिल गया है। कुछ दिन बाद फिर देखिए। यदि वह बहुत लंबे समय तक नहीं बदलता, तो हमसे संपर्क कीजिए; हम फ़ॉलो-अप में मदद करेंगे।"}},{"@type":"Question","name":"क्या मेरा काम तैयार होने पर आप बताएँगे?","acceptedAnswer":{"@type":"Answer","text":"हाँ। हम आपके अनुरोध की स्थिति अपडेट करते हैं, ईमेल करते हैं और जहाँ संभव हो WhatsApp पर संदेश भेजते हैं। आप कभी भी अपनी प्रोफ़ाइल भी देख सकते हैं।"}},{"@type":"Question","name":"क्या मुझे खाता चाहिए?","acceptedAnswer":{"@type":"Answer","text":"बिना खाते के भी आप कॉल, WhatsApp या सीधे आ सकते हैं। खाते से आप ऑनलाइन अनुरोध भेज सकते हैं, अपनी जानकारी सहेज सकते हैं, प्रगति ट्रैक कर सकते हैं और अपना इतिहास देख सकते हैं।"}},{"@type":"Question","name":"मुझे ईमेल कोड नहीं मिला। क्या करूँ?","acceptedAnswer":{"@type":"Answer","text":"स्पैम या प्रमोशन फ़ोल्डर देखिए, एक मिनट रुकिए और “कोड दोबारा भेजें” दबाइए। केवल सबसे नया कोड चलता है, और हर कोड 10 मिनट में समाप्त हो जाता है।"}},{"@type":"Question","name":"मैं अपना पासवर्ड भूल गया हूँ।","acceptedAnswer":{"@type":"Answer","text":"साइन-इन पेज पर “पासवर्ड भूल गए?” इस्तेमाल कीजिए। हम 6 अंकों का कोड ईमेल करते हैं; नया पासवर्ड सेट करने के बाद सुरक्षा के लिए सभी डिवाइस से साइन-आउट हो जाता है।"}},{"@type":"Question","name":"NISE COMPORT मेरे दस्तावेज़ों का उपयोग कैसे करता है?","acceptedAnswer":{"@type":"Answer","text":"केवल आपका अनुरोध पूरा करने के लिए। फ़ाइलें निजी तौर पर रखी जाती हैं, आपको और अधिकृत स्टाफ़ को दिखती हैं, और रखने की अवधि के बाद हटा दी जाती हैं। गोपनीयता नीति देखिए।"}},{"@type":"Question","name":"अपलोड किए दस्तावेज़ कितने समय तक रखे जाते हैं?","acceptedAnswer":{"@type":"Answer","text":"रखने की अवधि (डिफ़ॉल्ट रूप से 30 दिन, अनुरोध खुला रहने तक ही ज़्यादा) के बाद फ़ाइलें हटाने के लिए तय कर दी जाती हैं। ऐसे दस्तावेज़ अपलोड करने से बचिए जो आपके अनुरोध के लिए ज़रूरी नहीं हैं।"}},{"@type":"Question","name":"क्या मुझे OTP या PIN स्टाफ़ से साझा करने चाहिए?","acceptedAnswer":{"@type":"Answer","text":"कभी नहीं। OTP, PIN और पासवर्ड स्वयं, केवल उसी आधिकारिक प्रक्रिया में दर्ज कीजिए जो आपने शुरू की है। हमारा स्टाफ़ उन्हें कभी नहीं माँगेगा।"}},{"@type":"Question","name":"क्या मैं अपना खाता हटा सकता हूँ?","acceptedAnswer":{"@type":"Answer","text":"हाँ। प्रोफ़ाइल → साइन-इन और गोपनीयता → खाता हटाएँ पर जाइए। खुले अनुरोध पहले पूरे या रद्द किए जाने चाहिए।"}},{"@type":"Question","name":"क्या मेरी भुगतान जानकारी सुरक्षित है?","acceptedAnswer":{"@type":"Answer","text":"हम आपका कार्ड नंबर, UPI PIN या नेट-बैंकिंग पासवर्ड कभी नहीं देखते या सहेजते। ऑनलाइन भुगतान, चालू होने पर, एक पेमेंट पार्टनर और आपके बैंक द्वारा संभाले जाते हैं।"}},{"@type":"Question","name":"ऑनलाइन प्रिंटिंग कैसे काम करती है?","acceptedAnswer":{"@type":"Answer","text":"अपना दस्तावेज़ अपलोड कीजिए, पेज और प्रिंट की पसंद चुनिए, अनुमान देखिए और पिकअप या डिलीवरी चुनिए। प्रिंट से पहले हम फ़ाइल और उपलब्धता की पुष्टि करते हैं।"}},{"@type":"Question","name":"आपकी प्रिंटिंग दरें क्या हैं?","acceptedAnswer":{"@type":"Answer","text":"ब्लैक एंड व्हाइट 10 पेज तक ₹5 प्रति पेज, 11–50 के लिए ₹3 और 50 से ऊपर ₹2; रंगीन ₹10 प्रति पेज। विवरण के लिए मूल्य पेज देखिए।"}},{"@type":"Question","name":"मैं कौन-से फ़ाइल प्रकार प्रिंट करा सकता हूँ?","acceptedAnswer":{"@type":"Answer","text":"PDF, Word और सामान्य इमेज फ़ाइलें सबसे अच्छी चलती हैं। यदि आपकी फ़ाइल नहीं खुल रही, तो उसे WhatsApp पर भेजिए, हम संभाल लेंगे।"}},{"@type":"Question","name":"क्या आप स्कैन, फ़ोटोकॉपी और लैमिनेशन करते हैं?","acceptedAnswer":{"@type":"Answer","text":"हाँ। हम डेस्क पर स्कैन, फ़ोटोकॉपी, प्रिंट, लैमिनेशन और स्पाइरल बाइंडिंग करते हैं। आज की दर पूछिए।"}},{"@type":"Question","name":"क्या मुझे पासपोर्ट साइज़ फ़ोटो मिल सकती है?","acceptedAnswer":{"@type":"Answer","text":"हाँ, डेस्क पर। साइज़ और संख्या बताइए (जैसे पैन, आधार, परीक्षा या फ़ॉर्म के लिए)।"}},{"@type":"Question","name":"क्या एक व्यक्ति के दो पैन हो सकते हैं?","acceptedAnswer":{"@type":"Answer","text":"नहीं। अगर पैन खो गया है तो नया पैन नहीं, रीप्रिंट का आवेदन करें। दो पैन होने पर एक को सरेंडर करना होता है।"}},{"@type":"Question","name":"क्या आप पैन की गारंटी देते हैं?","acceptedAnswer":{"@type":"Answer","text":"नहीं। हम आवेदन में मदद करते हैं; पैन जारी करने का निर्णय अधिकृत पैन प्रदाता और आयकर विभाग का होता है।"}},{"@type":"Question","name":"आधार अपडेट का शुल्क कितना है?","acceptedAnswer":{"@type":"Answer","text":"शुल्क UIDAI तय करता है और केंद्र पर तथा रसीद पर दिखाया जाता है। वर्तमान सूची UIDAI की वेबसाइट पर देखें; ज़्यादा पैसे माँगे जाएँ तो 1947 पर शिकायत करें।"}},{"@type":"Question","name":"क्या स्टाफ़ को आधार OTP बताना चाहिए?","acceptedAnswer":{"@type":"Answer","text":"नहीं। OTP केवल आप स्वयं आधिकारिक प्रक्रिया में दर्ज करें।"}},{"@type":"Question","name":"प्रमाण पत्र कितने दिन में मिलेगा?","acceptedAnswer":{"@type":"Answer","text":"समय संबंधित अंचल/राजस्व कार्यालय तय करता है। हम किसी निश्चित तारीख़ का वादा नहीं कर सकते।"}},{"@type":"Question","name":"क्या आय और जाति प्रमाण पत्र एक ही आवेदन में बनते हैं?","acceptedAnswer":{"@type":"Answer","text":"नहीं। दोनों अलग प्रमाण पत्र हैं और इनके दस्तावेज़ भी अलग हैं।"}},{"@type":"Question","name":"यह आय या जाति प्रमाण पत्र से कैसे अलग है?","acceptedAnswer":{"@type":"Answer","text":"स्थानीय निवासी प्रमाण पत्र केवल यह बताता है कि आप कहाँ और कितने समय से रहते हैं। इसमें आय या जाति नहीं होती, इसलिए स्कूल, आवास योजनाएँ और राशन कार्ड के कुछ बदलाव इसे अलग से माँगते हैं।"}},{"@type":"Question","name":"अगर मैं हाल ही में जमशेदपुर आया हूँ तो?","acceptedAnswer":{"@type":"Answer","text":"कुछ अंचल कार्यालय हाल में आए लोगों से न्यूनतम निवास अवधि या अतिरिक्त प्रमाण माँगते हैं। आवेदन से पहले हम आपके अंचल का ताज़ा नियम देख लेते हैं।"}},{"@type":"Question","name":"EBC-I और BC-II में क्या अंतर है?","acceptedAnswer":{"@type":"Answer","text":"ये झारखंड की दो अलग पिछड़ा वर्ग श्रेणियाँ हैं, जिनकी अपनी-अपनी समुदाय सूची है। श्रेणी इस बात से तय होती है कि आवेदक की जाति किस सूची में है, पसंद से नहीं। आवेदन से पहले हम ताज़ा आधिकारिक सूची देखते हैं।"}},{"@type":"Question","name":"क्या यह प्रमाण पत्र समाप्त हो जाता है?","acceptedAnswer":{"@type":"Answer","text":"नॉन-क्रीमी-लेयर प्रमाण पत्र में परिवार की वर्तमान आय भी प्रमाणित होती है, इसलिए प्रवेश और नौकरी के लिए अक्सर इसे समय-समय पर (प्रायः हर साल) नवीनीकृत कराने को कहा जाता है। जिस योजना में आवेदन कर रहे हैं उसकी शर्त देखें।"}},{"@type":"Question","name":"पिता के पास SC प्रमाण पत्र है तो क्या मुझे नया चाहिए?","acceptedAnswer":{"@type":"Answer","text":"कई कार्यालय पिता का प्रमाण पत्र सहायक प्रमाण के रूप में मान लेते हैं, पर नौकरी, प्रवेश या छात्रवृत्ति के लिए हर आवेदक से आमतौर पर उसके अपने नाम का प्रमाण पत्र माँगा जाता है।"}},{"@type":"Question","name":"मेरी जाति दूसरे राज्य में SC है, पर मैं झारखंड में रहता हूँ?","acceptedAnswer":{"@type":"Answer","text":"संविधान (अनुसूचित जाति) आदेश के अंतर्गत SC/ST सूचियाँ राज्य-विशेष होती हैं। दूसरे राज्य का प्रमाण पत्र झारखंड के लाभों के लिए अक्सर मान्य नहीं होता; आवेदन से पहले जारी करने वाले प्राधिकरण से पूछ लें।"}},{"@type":"Question","name":"ST प्रमाण पत्र में SC या OBC से ज़्यादा समय क्यों लग सकता है?","acceptedAnswer":{"@type":"Answer","text":"ST सत्यापन में अक्सर पैतृक गाँव और समुदाय के रिकॉर्ड देखे जाते हैं, और कुछ अंचल कार्यालय स्थानीय जाँच या ग्राम प्रधान की पुष्टि माँगते हैं। इससे अन्य श्रेणियों की तुलना में अधिक समय लग सकता है।"}},{"@type":"Question","name":"मेरी जनजाति दूसरे राज्य में ST है। क्या यह झारखंड में मान्य है?","acceptedAnswer":{"@type":"Answer","text":"नहीं। ST सूचियाँ राज्य-विशेष होती हैं। दूसरे राज्य का प्रमाण पत्र आमतौर पर झारखंड के आरक्षण लाभों के लिए मान्य नहीं होता।"}},{"@type":"Question","name":"क्या झारखंड में विवाह पंजीकरण अनिवार्य है?","acceptedAnswer":{"@type":"Answer","text":"पंजीकरण की सख़्त सलाह दी जाती है और पासपोर्ट, वीज़ा, बैंक और कानूनी कामों के लिए अक्सर ज़रूरी होता है, चाहे विवाह किसी भी रीति से हुआ हो।"}},{"@type":"Question","name":"क्या कई साल पहले हुए विवाह का पंजीकरण हो सकता है?","acceptedAnswer":{"@type":"Answer","text":"हाँ, देर से पंजीकरण आमतौर पर संभव है, पर देरी का कारण बताने वाले शपथ पत्र या अतिरिक्त दस्तावेज़ लग सकते हैं। क्या चाहिए, यह पंजीकरण प्राधिकरण तय करता है।"}},{"@type":"Question","name":"क्या आप वोटर कार्ड जारी करते हैं?","acceptedAnswer":{"@type":"Answer","text":"नहीं। सत्यापन और कार्ड जारी करना चुनाव आयोग का काम है। हम आवेदन में मदद करते हैं।"}},{"@type":"Question","name":"क्या आप पासपोर्ट या लाइसेंस जारी करते हैं?","acceptedAnswer":{"@type":"Answer","text":"नहीं। सत्यापन, टेस्ट और जारी करना संबंधित प्राधिकरण का काम है।"}}]}15:["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$24"}}]
