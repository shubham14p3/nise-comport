a:[["children",{"s":"__PAGE__","h":160,"d":{"r":["$","$2","c",{"children":[["$","main",null,{"className":"content-page","lang":"hi-IN","children":[["$","$L11",null,{}],["$","section",null,{"className":"content-hero","children":["$","div",null,{"className":"container","children":[[["$","nav",null,{"className":"breadcrumbs","aria-label":"ब्रेडक्रंब","children":["$","ol",null,{"children":[["$","li","/hi",{"children":[["$","$L12",null,{"href":"/hi","children":"होम"}],["$","$L13",null,{"icon":{"name":"chevron-right","size":24,"node":[["path",{"d":"m9 18 6-6-6-6","key":"mthhwq"}]]},"size":12,"aria-hidden":"true"}]]}],["$","li","/hi/faq",{"children":["$","span",null,{"aria-current":"page","children":"सवाल-जवाब"}]}]]}]}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"होम\",\"item\":\"https://www.nisecomport.com/hi\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"सवाल-जवाब\",\"item\":\"https://www.nisecomport.com/hi/faq\"}]}"}}]],["$","$L12",null,{"href":"/hi","className":"back-small","children":[["$","$L13",null,{"icon":{"name":"arrow-left","size":24,"node":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]]},"size":14}]," ","होम"]}],["$","span",null,{"className":"eyebrow eyebrow-muted","children":"अच्छे सवाल, साफ़ जवाब"}],["$","h1",null,{"children":["अक्सर पूछे जाने वाले",["$","br",null,{}],["$","em",null,{"children":"सवाल।"}]]}],["$","p",null,{"children":["कोई भी सवाल खोजिए, या कोई विषय या सेवा चुनिए। आपका सवाल नहीं मिला? ",["$","$L12",null,{"href":"/hi/contact","children":"सर्विस डेस्क से पूछिए"}],"."]}]]}]}],["$","section",null,{"className":"container","children":["$","$L14",null,{"faqs":[{"id":"g-0","topic":"हमारे बारे में","question":"क्या NISE COMPORT सरकारी कार्यालय है?","answer":"नहीं। NISE COMPORT एक स्वतंत्र CSC / प्रज्ञा केंद्र सेवा केंद्र है जो ग्राहकों को सरकारी और डिजिटल सेवाओं का उपयोग करने में मदद करता है। अंतिम निर्णय संबंधित विभाग, बैंक या प्रदाता का होता है।"},{"id":"g-1","topic":"हमारे बारे में","question":"CSC / प्रज्ञा केंद्र क्या है?","answer":"कॉमन सर्विस सेंटर (CSC) या प्रज्ञा केंद्र एक स्थानीय सेवा बिंदु है जो नागरिकों को घर के पास ही सरकारी और डिजिटल सेवाओं के लिए आवेदन करने में मदद करता है, ताकि उन्हें कई कार्यालयों के चक्कर न लगाने पड़ें।"},{"id":"g-2","topic":"हमारे बारे में","question":"आप जमशेदपुर की सेवा कब से कर रहे हैं?","answer":"हमने 1995 में NISE के रूप में शुरुआत की और बढ़कर NISE COMPORT बने। हमारे कई ग्राहक सालों से हमारे पास आ रहे हैं।"},{"id":"g-3","topic":"हमारे बारे में","question":"आप कौन-सी सेवाएँ देते हैं?","answer":"पैन और आधार में मदद, झारखंड के प्रमाण पत्र, वोटर आईडी, बैंकिंग और AEPS, बीमा, छात्रवृत्ति और परीक्षा फ़ॉर्म, ITR और व्यवसाय फ़ॉर्म, वेबसाइट निर्माण, फ़ोटो स्टूडियो, प्रिंटिंग और फ़ोटोकॉपी, तथा कंप्यूटर मरम्मत और हार्डवेयर। पूरी सूची सेवाएँ पेज पर देखिए।"},{"id":"g-4","topic":"हमारे बारे में","question":"क्या मैं हिन्दी में किसी से बात कर सकता हूँ?","answer":"हाँ। हमारी टीम हिन्दी, बांग्ला और अंग्रेज़ी बोलती है, और मुख्य पेज हिन्दी में /hi और बांग्ला में /bn पर उपलब्ध हैं।"},{"id":"g-5","topic":"हमारे बारे में","question":"क्या आपकी साइट पर दिखे लोगो और सेवाएँ आपकी हैं?","answer":"नहीं। CSC, डिजिटल इंडिया, पैन, आधार और वोटर आईडी जैसे नाम उनके स्वामियों के हैं। हम एक स्वतंत्र स्थानीय सहायक हैं जो आवेदन करने, जमा करने और ट्रैक करने में आपका मार्गदर्शन करते हैं।"},{"id":"g-6","topic":"हमारे बारे में","question":"आपकी टीम में कौन हैं?","answer":"सर्विस डेस्क के लोगों से टीम पेज पर मिलिए। स्टाफ़ आपके आवेदन में मदद करता है, पर स्वीकृति का फ़ैसला कभी नहीं करता।"},{"id":"g-7","topic":"हमसे मिलने आना","question":"आप कहाँ स्थित हैं?","answer":"दुकान नंबर 3, भूतल, सिंह बिल्डिंग, हनुमान मंदिर रोड, खरंगाझार, टेल्को कॉलोनी, जमशेदपुर, झारखंड 831004। रास्ते के लिए संपर्क पेज से Google Maps खोलिए।"},{"id":"g-8","topic":"हमसे मिलने आना","question":"आप किन इलाकों में सेवा देते हैं?","answer":"खरंगाझार, टेल्को, गोविंदपुर, बिरसानगर, गोलमुरी, साकची, मानगो और पूरे जमशेदपुर से ग्राहक सीधे आते हैं। ऑनलाइन अनुरोध कहीं से भी भेजे जा सकते हैं। हम जहाँ सेवा देते हैं वह पेज देखिए।"},{"id":"g-9","topic":"हमसे मिलने आना","question":"आपके खुलने का समय क्या है?","answer":"हमारे समय संपर्क पेज पर दिखाए गए हैं और सार्वजनिक छुट्टियों में बदल जाते हैं। ज़रूरी या पोर्टल पर निर्भर काम के लिए आने से पहले +91 97712 19893 पर कॉल कीजिए।"},{"id":"g-10","topic":"हमसे मिलने आना","question":"क्या मुझे अपॉइंटमेंट चाहिए?","answer":"नहीं। आप खुलने के समय में सीधे आ सकते हैं। लंबे या ज़्यादा दस्तावेज़ों वाले काम के लिए पहले अनुरोध भेजिए या WhatsApp कीजिए ताकि हम ठीक-ठीक बता सकें कि क्या लाना है।"},{"id":"g-11","topic":"हमसे मिलने आना","question":"आने पर मुझे क्या साथ लाना चाहिए?","answer":"अपनी सेवा के मूल दस्तावेज़, जहाँ हम माँगें वहाँ फ़ोटोकॉपी, और OTP के लिए अपना मोबाइल फ़ोन (OTP किसी को कभी न बताएँ)। हर सेवा पेज पर दस्तावेज़ों की सूची है।"},{"id":"g-12","topic":"हमसे मिलने आना","question":"क्या मेरी तरफ़ से कोई और आ सकता है?","answer":"कई सेवाओं के लिए हाँ, यदि वे आपके दस्तावेज़ लाएँ। जिन सेवाओं में आपका OTP, बायोमेट्रिक या फ़ोटो चाहिए (जैसे आधार अपडेट और पैन के कुछ चरण), वहाँ आपको स्वयं आना पड़ सकता है। पहले हमसे पूछ लीजिए।"},{"id":"g-13","topic":"हमसे मिलने आना","question":"क्या मैं आपसे WhatsApp पर बात कर सकता हूँ?","answer":"हाँ। +91 97712 19893 या +91 98355 52756 पर WhatsApp कीजिए। आप सवाल या दस्तावेज़ की फ़ोटो भेज सकते हैं और हम अगला कदम बता देंगे।"},{"id":"g-14","topic":"शुल्क और भुगतान","question":"क्या सरकारी शुल्क आपके सेवा शुल्क में शामिल हैं?","answer":"नहीं। हम अपना सेवा शुल्क किसी भी सरकारी, पोर्टल, बैंक या बीमा शुल्क से अलग दिखाते हैं। रसीद में वसूले गए शुल्क अलग-अलग लिखे होते हैं।"},{"id":"g-15","topic":"शुल्क और भुगतान","question":"इसमें कितना खर्च आएगा?","answer":"काम शुरू करने से पहले हम अपना सेवा शुल्क बता देते हैं। प्रिंटिंग की दरें मूल्य पेज पर हैं; अन्य सेवाओं का शुल्क WhatsApp पर या डेस्क पर पक्का किया जाता है।"},{"id":"g-16","topic":"शुल्क और भुगतान","question":"क्या आप आवेदन की स्वीकृति की गारंटी दे सकते हैं?","answer":"नहीं। स्वीकृति, प्रक्रिया का समय और फ़ैसले संबंधित सरकारी विभाग, कंपनी या सेवा प्रदाता के नियंत्रण में होते हैं।"},{"id":"g-17","topic":"शुल्क और भुगतान","question":"मैं भुगतान कैसे कर सकता हूँ?","answer":"आप डेस्क पर नकद या UPI से भुगतान कर सकते हैं। ऑनलाइन भुगतान जोड़ा जा रहा है; चालू होने पर आपके अनुरोध पर भुगतान की पुष्टि होगी और रसीद जारी होगी।"},{"id":"g-18","topic":"शुल्क और भुगतान","question":"क्या मुझे रसीद मिलेगी?","answer":"हाँ। हर भुगतान की रसीद या पुष्टि दी जाती है, और जहाँ पोर्टल की पावती हो वह भी। दोनों सँभालकर रखिए।"},{"id":"g-19","topic":"शुल्क और भुगतान","question":"क्या मुझे रिफ़ंड मिल सकता है?","answer":"यदि आप काम शुरू होने से पहले रद्द करते हैं, या हम सेवा नहीं दे पाते, तो सेवा शुल्क वापस किया जाता है। पूरी हो चुकी सेवा का शुल्क आमतौर पर वापस नहीं होता। विवरण के लिए रिफ़ंड और रद्दीकरण नीति देखिए।"},{"id":"g-20","topic":"शुल्क और भुगतान","question":"ऑफ़र और प्रोमो कोड कैसे काम करते हैं?","answer":"प्रोमो कोड और वेलकम कूपन केवल हमारे सेवा शुल्क पर छूट देते हैं, सरकारी शुल्क पर कभी नहीं। अपने अनुरोध पर कोड डालिए, या आज क्या चल रहा है यह जानने के लिए ऑफ़र पेज देखिए।"},{"id":"g-21","topic":"शुल्क और भुगतान","question":"क्या सुधार के लिए आप अतिरिक्त शुल्क लेते हैं?","answer":"यदि दी गई जानकारी या दस्तावेज़ गलत या अधूरे थे और इसलिए सुधार चाहिए, तो दोबारा फ़ाइल करने पर नया सेवा शुल्क लग सकता है। यदि गलती हमारी थी, तो हम उसे बिना शुल्क ठीक करते हैं।"},{"id":"g-22","topic":"अनुरोध और ट्रैकिंग","question":"मैं अनुरोध को कैसे ट्रैक कर सकता हूँ?","answer":"अनुरोध ट्रैक करें पेज इस्तेमाल कीजिए। यह दिखाता है कि अपनी प्रोफ़ाइल में NISE COMPORT का अनुरोध कैसे देखें, और पैन, प्रमाण पत्र तथा वोटर आईडी आधिकारिक पोर्टल पर कहाँ ट्रैक करें। स्थिति बदलने पर हम ईमेल भी करते हैं।"},{"id":"g-23","topic":"अनुरोध और ट्रैकिंग","question":"क्या मैं अनुरोध रद्द कर सकता हूँ?","answer":"हाँ, जब तक वह जमा है, समीक्षा में है या आपकी प्रतीक्षा में है। अपनी प्रोफ़ाइल में अनुरोध खोलिए और “यह अनुरोध रद्द करें” चुनिए। उस चरण के बाद डेस्क को कॉल या WhatsApp कीजिए।"},{"id":"g-24","topic":"अनुरोध और ट्रैकिंग","question":"मैं ऑनलाइन अनुरोध कैसे शुरू करूँ?","answer":"अपनी सेवा चुनिए, दस्तावेज़ अपलोड कीजिए और अनुरोध भेजिए। आप ईमेल कोड से साइन इन कर सकते हैं, और आपकी जानकारी सहेज ली जाती है ताकि अगली बार दोबारा न लिखनी पड़े।"},{"id":"g-25","topic":"अनुरोध और ट्रैकिंग","question":"मेरे अनुरोध में कितना समय लगेगा?","answer":"यह सेवा और सरकार या प्रदाता पर निर्भर करता है। अनुरोध पक्का करते समय हम सामान्य समय बता देते हैं। आधिकारिक पोर्टलों की देरी हमारे नियंत्रण में नहीं है।"},{"id":"g-26","topic":"अनुरोध और ट्रैकिंग","question":"मेरा संदर्भ नंबर खो गया। अब क्या करूँ?","answer":"अपनी सभी अनुरोध संदर्भ संख्याएँ देखने के लिए प्रोफ़ाइल में साइन इन कीजिए, या हमें अपना नाम और लगभग तारीख भेजिए, हम ढूँढ देंगे।"},{"id":"g-27","topic":"अनुरोध और ट्रैकिंग","question":"मेरा आवेदन ‘प्रक्रियाधीन’ दिखा रहा है। क्या यह सामान्य है?","answer":"आमतौर पर हाँ। इसका मतलब है कि विभाग को वह मिल गया है। कुछ दिन बाद फिर देखिए। यदि वह बहुत लंबे समय तक नहीं बदलता, तो हमसे संपर्क कीजिए; हम फ़ॉलो-अप में मदद करेंगे।"},{"id":"g-28","topic":"अनुरोध और ट्रैकिंग","question":"क्या मेरा काम तैयार होने पर आप बताएँगे?","answer":"हाँ। हम आपके अनुरोध की स्थिति अपडेट करते हैं, ईमेल करते हैं और जहाँ संभव हो WhatsApp पर संदेश भेजते हैं। आप कभी भी अपनी प्रोफ़ाइल भी देख सकते हैं।"},{"id":"g-29","topic":"खाता और गोपनीयता","question":"क्या मुझे खाता चाहिए?","answer":"बिना खाते के भी आप कॉल, WhatsApp या सीधे आ सकते हैं। खाते से आप ऑनलाइन अनुरोध भेज सकते हैं, अपनी जानकारी सहेज सकते हैं, प्रगति ट्रैक कर सकते हैं और अपना इतिहास देख सकते हैं।"},{"id":"g-30","topic":"खाता और गोपनीयता","question":"मुझे ईमेल कोड नहीं मिला। क्या करूँ?","answer":"स्पैम या प्रमोशन फ़ोल्डर देखिए, एक मिनट रुकिए और “कोड दोबारा भेजें” दबाइए। केवल सबसे नया कोड चलता है, और हर कोड 10 मिनट में समाप्त हो जाता है।"},{"id":"g-31","topic":"खाता और गोपनीयता","question":"मैं अपना पासवर्ड भूल गया हूँ।","answer":"साइन-इन पेज पर “पासवर्ड भूल गए?” इस्तेमाल कीजिए। हम 6 अंकों का कोड ईमेल करते हैं; नया पासवर्ड सेट करने के बाद सुरक्षा के लिए सभी डिवाइस से साइन-आउट हो जाता है।"},{"id":"g-32","topic":"खाता और गोपनीयता","question":"NISE COMPORT मेरे दस्तावेज़ों का उपयोग कैसे करता है?","answer":"केवल आपका अनुरोध पूरा करने के लिए। फ़ाइलें निजी तौर पर रखी जाती हैं, आपको और अधिकृत स्टाफ़ को दिखती हैं, और रखने की अवधि के बाद हटा दी जाती हैं। गोपनीयता नीति देखिए।"},{"id":"g-33","topic":"खाता और गोपनीयता","question":"अपलोड किए दस्तावेज़ कितने समय तक रखे जाते हैं?","answer":"रखने की अवधि (डिफ़ॉल्ट रूप से 30 दिन, अनुरोध खुला रहने तक ही ज़्यादा) के बाद फ़ाइलें हटाने के लिए तय कर दी जाती हैं। ऐसे दस्तावेज़ अपलोड करने से बचिए जो आपके अनुरोध के लिए ज़रूरी नहीं हैं।"},{"id":"g-34","topic":"खाता और गोपनीयता","question":"क्या मुझे OTP या PIN स्टाफ़ से साझा करने चाहिए?","answer":"कभी नहीं। OTP, PIN और पासवर्ड स्वयं, केवल उसी आधिकारिक प्रक्रिया में दर्ज कीजिए जो आपने शुरू की है। हमारा स्टाफ़ उन्हें कभी नहीं माँगेगा।"},{"id":"g-35","topic":"खाता और गोपनीयता","question":"क्या मैं अपना खाता हटा सकता हूँ?","answer":"हाँ। प्रोफ़ाइल → साइन-इन और गोपनीयता → खाता हटाएँ पर जाइए। खुले अनुरोध पहले पूरे या रद्द किए जाने चाहिए।"},{"id":"g-36","topic":"खाता और गोपनीयता","question":"क्या मेरी भुगतान जानकारी सुरक्षित है?","answer":"हम आपका कार्ड नंबर, UPI PIN या नेट-बैंकिंग पासवर्ड कभी नहीं देखते या सहेजते। ऑनलाइन भुगतान, चालू होने पर, एक पेमेंट पार्टनर और आपके बैंक द्वारा संभाले जाते हैं।"},{"id":"g-37","topic":"प्रिंटिंग और दस्तावेज़","question":"ऑनलाइन प्रिंटिंग कैसे काम करती है?","answer":"अपना दस्तावेज़ अपलोड कीजिए, पेज और प्रिंट की पसंद चुनिए, अनुमान देखिए और पिकअप या डिलीवरी चुनिए। प्रिंट से पहले हम फ़ाइल और उपलब्धता की पुष्टि करते हैं।"},{"id":"g-38","topic":"प्रिंटिंग और दस्तावेज़","question":"आपकी प्रिंटिंग दरें क्या हैं?","answer":"ब्लैक एंड व्हाइट 10 पेज तक ₹5 प्रति पेज, 11–50 के लिए ₹3 और 50 से ऊपर ₹2; रंगीन ₹10 प्रति पेज। विवरण के लिए मूल्य पेज देखिए।"},{"id":"g-39","topic":"प्रिंटिंग और दस्तावेज़","question":"मैं कौन-से फ़ाइल प्रकार प्रिंट करा सकता हूँ?","answer":"PDF, Word और सामान्य इमेज फ़ाइलें सबसे अच्छी चलती हैं। यदि आपकी फ़ाइल नहीं खुल रही, तो उसे WhatsApp पर भेजिए, हम संभाल लेंगे।"},{"id":"g-40","topic":"प्रिंटिंग और दस्तावेज़","question":"क्या आप स्कैन, फ़ोटोकॉपी और लैमिनेशन करते हैं?","answer":"हाँ। हम डेस्क पर स्कैन, फ़ोटोकॉपी, प्रिंट, लैमिनेशन और स्पाइरल बाइंडिंग करते हैं। आज की दर पूछिए।"},{"id":"g-41","topic":"प्रिंटिंग और दस्तावेज़","question":"क्या मुझे पासपोर्ट साइज़ फ़ोटो मिल सकती है?","answer":"हाँ, डेस्क पर। साइज़ और संख्या बताइए (जैसे पैन, आधार, परीक्षा या फ़ॉर्म के लिए)।"},{"id":"s-pan-card-0","topic":"सरकारी सेवाएँ","question":"क्या एक व्यक्ति के दो पैन हो सकते हैं?","answer":"नहीं। अगर पैन खो गया है तो नया पैन नहीं, रीप्रिंट का आवेदन करें। दो पैन होने पर एक को सरेंडर करना होता है।","serviceTitle":"पैन कार्ड आवेदन और सुधार","serviceHref":"/hi/services/pan-card"},{"id":"s-pan-card-1","topic":"सरकारी सेवाएँ","question":"क्या आप पैन की गारंटी देते हैं?","answer":"नहीं। हम आवेदन में मदद करते हैं; पैन जारी करने का निर्णय अधिकृत पैन प्रदाता और आयकर विभाग का होता है।","serviceTitle":"पैन कार्ड आवेदन और सुधार","serviceHref":"/hi/services/pan-card"},{"id":"s-aadhaar-0","topic":"सरकारी सेवाएँ","question":"आधार अपडेट का शुल्क कितना है?","answer":"शुल्क UIDAI तय करता है और केंद्र पर तथा रसीद पर दिखाया जाता है। वर्तमान सूची UIDAI की वेबसाइट पर देखें; ज़्यादा पैसे माँगे जाएँ तो 1947 पर शिकायत करें।","serviceTitle":"आधार सेवा मार्गदर्शन","serviceHref":"/hi/services/aadhaar"},{"id":"s-aadhaar-1","topic":"सरकारी सेवाएँ","question":"क्या स्टाफ़ को आधार OTP बताना चाहिए?","answer":"नहीं। OTP केवल आप स्वयं आधिकारिक प्रक्रिया में दर्ज करें।","serviceTitle":"आधार सेवा मार्गदर्शन","serviceHref":"/hi/services/aadhaar"},{"id":"s-income-caste-residence-certificate-0","topic":"सरकारी सेवाएँ","question":"प्रमाण पत्र कितने दिन में मिलेगा?","answer":"समय संबंधित अंचल/राजस्व कार्यालय तय करता है। हम किसी निश्चित तारीख़ का वादा नहीं कर सकते।","serviceTitle":"आय प्रमाण पत्र","serviceHref":"/hi/services/income-caste-residence-certificate"},{"id":"s-income-caste-residence-certificate-1","topic":"सरकारी सेवाएँ","question":"क्या आय और जाति प्रमाण पत्र एक ही आवेदन में बनते हैं?","answer":"नहीं। दोनों अलग प्रमाण पत्र हैं और इनके दस्तावेज़ भी अलग हैं।","serviceTitle":"आय प्रमाण पत्र","serviceHref":"/hi/services/income-caste-residence-certificate"},{"id":"s-local-resident-certificate-0","topic":"सरकारी सेवाएँ","question":"यह आय या जाति प्रमाण पत्र से कैसे अलग है?","answer":"स्थानीय निवासी प्रमाण पत्र केवल यह बताता है कि आप कहाँ और कितने समय से रहते हैं। इसमें आय या जाति नहीं होती, इसलिए स्कूल, आवास योजनाएँ और राशन कार्ड के कुछ बदलाव इसे अलग से माँगते हैं।","serviceTitle":"स्थानीय निवास प्रमाण पत्र","serviceHref":"/hi/services/local-resident-certificate"},{"id":"s-local-resident-certificate-1","topic":"सरकारी सेवाएँ","question":"अगर मैं हाल ही में जमशेदपुर आया हूँ तो?","answer":"कुछ अंचल कार्यालय हाल में आए लोगों से न्यूनतम निवास अवधि या अतिरिक्त प्रमाण माँगते हैं। आवेदन से पहले हम आपके अंचल का ताज़ा नियम देख लेते हैं।","serviceTitle":"स्थानीय निवास प्रमाण पत्र","serviceHref":"/hi/services/local-resident-certificate"},{"id":"s-caste-certificate-ebc1-bc2-0","topic":"सरकारी सेवाएँ","question":"EBC-I और BC-II में क्या अंतर है?","answer":"ये झारखंड की दो अलग पिछड़ा वर्ग श्रेणियाँ हैं, जिनकी अपनी-अपनी समुदाय सूची है। श्रेणी इस बात से तय होती है कि आवेदक की जाति किस सूची में है, पसंद से नहीं। आवेदन से पहले हम ताज़ा आधिकारिक सूची देखते हैं।","serviceTitle":"EBC-I / BC-II (OBC) जाति प्रमाण पत्र","serviceHref":"/hi/services/caste-certificate-ebc1-bc2"},{"id":"s-caste-certificate-ebc1-bc2-1","topic":"सरकारी सेवाएँ","question":"क्या यह प्रमाण पत्र समाप्त हो जाता है?","answer":"नॉन-क्रीमी-लेयर प्रमाण पत्र में परिवार की वर्तमान आय भी प्रमाणित होती है, इसलिए प्रवेश और नौकरी के लिए अक्सर इसे समय-समय पर (प्रायः हर साल) नवीनीकृत कराने को कहा जाता है। जिस योजना में आवेदन कर रहे हैं उसकी शर्त देखें।","serviceTitle":"EBC-I / BC-II (OBC) जाति प्रमाण पत्र","serviceHref":"/hi/services/caste-certificate-ebc1-bc2"},{"id":"s-caste-certificate-sc-0","topic":"सरकारी सेवाएँ","question":"पिता के पास SC प्रमाण पत्र है तो क्या मुझे नया चाहिए?","answer":"कई कार्यालय पिता का प्रमाण पत्र सहायक प्रमाण के रूप में मान लेते हैं, पर नौकरी, प्रवेश या छात्रवृत्ति के लिए हर आवेदक से आमतौर पर उसके अपने नाम का प्रमाण पत्र माँगा जाता है।","serviceTitle":"SC जाति प्रमाण पत्र","serviceHref":"/hi/services/caste-certificate-sc"},{"id":"s-caste-certificate-sc-1","topic":"सरकारी सेवाएँ","question":"मेरी जाति दूसरे राज्य में SC है, पर मैं झारखंड में रहता हूँ?","answer":"संविधान (अनुसूचित जाति) आदेश के अंतर्गत SC/ST सूचियाँ राज्य-विशेष होती हैं। दूसरे राज्य का प्रमाण पत्र झारखंड के लाभों के लिए अक्सर मान्य नहीं होता; आवेदन से पहले जारी करने वाले प्राधिकरण से पूछ लें।","serviceTitle":"SC जाति प्रमाण पत्र","serviceHref":"/hi/services/caste-certificate-sc"},{"id":"s-caste-certificate-st-0","topic":"सरकारी सेवाएँ","question":"ST प्रमाण पत्र में SC या OBC से ज़्यादा समय क्यों लग सकता है?","answer":"ST सत्यापन में अक्सर पैतृक गाँव और समुदाय के रिकॉर्ड देखे जाते हैं, और कुछ अंचल कार्यालय स्थानीय जाँच या ग्राम प्रधान की पुष्टि माँगते हैं। इससे अन्य श्रेणियों की तुलना में अधिक समय लग सकता है।","serviceTitle":"ST जाति प्रमाण पत्र","serviceHref":"/hi/services/caste-certificate-st"},{"id":"s-caste-certificate-st-1","topic":"सरकारी सेवाएँ","question":"मेरी जनजाति दूसरे राज्य में ST है। क्या यह झारखंड में मान्य है?","answer":"नहीं। ST सूचियाँ राज्य-विशेष होती हैं। दूसरे राज्य का प्रमाण पत्र आमतौर पर झारखंड के आरक्षण लाभों के लिए मान्य नहीं होता।","serviceTitle":"ST जाति प्रमाण पत्र","serviceHref":"/hi/services/caste-certificate-st"},{"id":"s-marriage-registration-certificate-0","topic":"सरकारी सेवाएँ","question":"क्या झारखंड में विवाह पंजीकरण अनिवार्य है?","answer":"पंजीकरण की सख़्त सलाह दी जाती है और पासपोर्ट, वीज़ा, बैंक और कानूनी कामों के लिए अक्सर ज़रूरी होता है, चाहे विवाह किसी भी रीति से हुआ हो।","serviceTitle":"विवाह पंजीकरण प्रमाण पत्र","serviceHref":"/hi/services/marriage-registration-certificate"},{"id":"s-marriage-registration-certificate-1","topic":"सरकारी सेवाएँ","question":"क्या कई साल पहले हुए विवाह का पंजीकरण हो सकता है?","answer":"हाँ, देर से पंजीकरण आमतौर पर संभव है, पर देरी का कारण बताने वाले शपथ पत्र या अतिरिक्त दस्तावेज़ लग सकते हैं। क्या चाहिए, यह पंजीकरण प्राधिकरण तय करता है।","serviceTitle":"विवाह पंजीकरण प्रमाण पत्र","serviceHref":"/hi/services/marriage-registration-certificate"},{"id":"s-voter-id-0","topic":"सरकारी सेवाएँ","question":"क्या आप वोटर कार्ड जारी करते हैं?","answer":"नहीं। सत्यापन और कार्ड जारी करना चुनाव आयोग का काम है। हम आवेदन में मदद करते हैं।","serviceTitle":"वोटर आईडी सेवाएँ","serviceHref":"/hi/services/voter-id"},{"id":"s-passport-driving-licence-0","topic":"सरकारी सेवाएँ","question":"क्या आप पासपोर्ट या लाइसेंस जारी करते हैं?","answer":"नहीं। सत्यापन, टेस्ट और जारी करना संबंधित प्राधिकरण का काम है।","serviceTitle":"पासपोर्ट और ड्राइविंग लाइसेंस फ़ॉर्म","serviceHref":"/hi/services/passport-driving-licence"},{"id":"s-aeps-money-transfer-0","topic":"बैंकिंग व AEPS","question":"धोखाधड़ी हो तो क्या करें?","answer":"तुरंत अपने बैंक से संपर्क करें। साइबर धोखाधड़ी के लिए 1930 पर कॉल करें या cybercrime.gov.in पर शिकायत करें।","serviceTitle":"AEPS बैंकिंग और मनी ट्रांसफ़र","serviceHref":"/hi/services/aeps-money-transfer"},{"id":"s-bike-insurance-0","topic":"बीमा","question":"क्या बीमा कोटेशन ही अंतिम प्रीमियम होता है?","answer":"नहीं। अंतिम प्रीमियम, पात्रता, कवरेज और पॉलिसी जारी करना बीमा कंपनी तय करती है।","serviceTitle":"बाइक / स्कूटर बीमा","serviceHref":"/hi/services/bike-insurance"},{"id":"s-bike-insurance-1","topic":"बीमा","question":"क्या बाइक के लिए थर्ड-पार्टी बीमा अनिवार्य है?","answer":"हाँ। कम से कम थर्ड-पार्टी कवर के बिना चलाना मोटर वाहन अधिनियम के तहत अपराध है (पहली बार ₹2,000 जुर्माना और/या 3 महीने तक की सज़ा)।","serviceTitle":"बाइक / स्कूटर बीमा","serviceHref":"/hi/services/bike-insurance"},{"id":"s-car-insurance-0","topic":"बीमा","question":"क्या NISE COMPORT पॉलिसी खुद जारी करता है?","answer":"नहीं। हम केवल पूछताछ में सहायता करते हैं। पात्रता, कवरेज, प्रीमियम और पॉलिसी जारी करना बीमा कंपनी तय करती है।","serviceTitle":"कार बीमा और रिन्यूअल","serviceHref":"/hi/services/car-insurance"},{"id":"s-car-insurance-1","topic":"बीमा","question":"कंप्रिहेंसिव लें या केवल थर्ड-पार्टी?","answer":"थर्ड-पार्टी कानूनी न्यूनतम है और केवल दूसरों के नुकसान को भरती है। कंप्रिहेंसिव आपकी अपनी कार को दुर्घटना, चोरी, आग और बाढ़ से भी बचाती है। 10 साल से कम पुरानी ज़्यादातर कारों के लिए कंप्रिहेंसिव लेना ठीक रहता है।","serviceTitle":"कार बीमा और रिन्यूअल","serviceHref":"/hi/services/car-insurance"},{"id":"s-health-life-insurance-0","topic":"बीमा","question":"क्या आप सिफ़ारिश कर सकते हैं या क्लेम की गारंटी दे सकते हैं?","answer":"हम आवेदन की प्रक्रिया में मदद कर सकते हैं, पर पॉलिसी की उपयुक्तता, अंडरराइटिंग और क्लेम का फ़ैसला बीमा कंपनी का होता है।","serviceTitle":"स्वास्थ्य, जीवन और व्यक्तिगत बीमा","serviceHref":"/hi/services/health-life-insurance"},{"id":"s-scholarship-forms-0","topic":"छात्र व परीक्षा","question":"क्या आप पात्रता तय करते हैं?","answer":"नहीं। पात्रता संबंधित विभाग या संस्थान तय करता है। हम सूचना समझने और फ़ॉर्म भरने में मदद करते हैं।","serviceTitle":"छात्र, छात्रवृत्ति और प्रवेश फ़ॉर्म","serviceHref":"/hi/services/scholarship-forms"},{"id":"s-exam-forms-0","topic":"छात्र व परीक्षा","question":"क्या फ़ॉर्म की जानकारी की ज़िम्मेदारी आपकी है?","answer":"जानकारी सही होने की ज़िम्मेदारी आवेदक की है, इसलिए जमा करने से पहले आप हर प्रविष्टि जाँचते हैं।","serviceTitle":"परीक्षा, भर्ती और ऑनलाइन फ़ॉर्म","serviceHref":"/hi/services/exam-forms"},{"id":"s-itr-gst-0","topic":"फ़ॉर्म व व्यवसाय","question":"क्या यह कानूनी या कर सलाह है?","answer":"नियमित पोर्टल सहायता किसी योग्य कर पेशेवर की सलाह का विकल्प नहीं है। जटिल कर मामलों की समीक्षा पेशेवर से करवाएँ।","serviceTitle":"ITR, GST और व्यवसाय फ़ॉर्म","serviceHref":"/hi/services/itr-gst"},{"id":"s-computer-repair-0","topic":"हार्डवेयर व PC","question":"क्या सभी कंप्यूटर ब्रांड और पुर्ज़े स्टॉक में रहते हैं?","answer":"उपलब्धता बदलती रहती है। ताज़ा जवाब के लिए मॉडल या ज़रूरत बताकर टीम से संपर्क कीजिए।","serviceTitle":"कंप्यूटर, प्रिंटर और CCTV","serviceHref":"/hi/services/computer-repair"},{"id":"s-lic-policy-0","topic":"बीमा","question":"क्या NISE COMPORT मेरी LIC पॉलिसी बदल या स्वीकृत कर सकता है?","answer":"नहीं। हम उपलब्ध सेवा के रास्ते पर चलने में मदद कर सकते हैं। पॉलिसी सर्विसिंग, अंडरराइटिंग, क्लेम और आधिकारिक रिकॉर्ड LIC के पास हैं।","serviceTitle":"LIC पॉलिसी सेवा","serviceHref":"/hi/services/lic-policy"},{"id":"s-lic-policy-1","topic":"बीमा","question":"क्या आप बता सकते हैं कि मुझे कौन-सी जीवन बीमा पॉलिसी लेनी चाहिए?","answer":"यह पेज प्रक्रिया में सहायता देता है, वित्तीय सलाह या पॉलिसी की सिफ़ारिश नहीं। उत्पाद की शर्तें LIC या किसी अधिकृत सलाहकार के साथ देखिए।","serviceTitle":"LIC पॉलिसी सेवा","serviceHref":"/hi/services/lic-policy"},{"id":"s-mutual-fund-sip-0","topic":"बैंकिंग व AEPS","question":"क्या NISE COMPORT कोई फ़ंड सुझाएगा या रिटर्न का वादा करेगा?","answer":"नहीं। यह केवल प्रक्रिया में सहायता है। निवेश घट-बढ़ सकता है; रिटर्न की गारंटी नहीं होती। किसी अधिकृत वित्तीय सलाहकार से सलाह लीजिए।","serviceTitle":"SIP और म्यूचुअल फ़ंड जानकारी","serviceHref":"/hi/services/mutual-fund-sip"},{"id":"s-mutual-fund-sip-1","topic":"बैंकिंग व AEPS","question":"क्या मैं अपना OTP या निवेश खाते की जानकारी साझा कर सकता हूँ?","answer":"OTP, पासवर्ड या निवेश खाते की जानकारी कभी स्टाफ़ से साझा न करें। इन्हें केवल अधिकृत प्रदाता की प्रक्रिया में खुद दर्ज करें।","serviceTitle":"SIP और म्यूचुअल फ़ंड जानकारी","serviceHref":"/hi/services/mutual-fund-sip"},{"id":"s-rent-agreement-0","topic":"फ़ॉर्म व व्यवसाय","question":"क्या टाइप किया हुआ समझौता या NOC कानूनी सलाह है?","answer":"नहीं। दस्तावेज़ टाइपिंग और प्रक्रिया सहायता कानूनी सलाह नहीं है। अधिकार, दायित्व या विवाद जुड़े हों तो पक्षों को कानूनी समीक्षा करवानी चाहिए।","serviceTitle":"किरायानामा और NOC फ़ॉर्म","serviceHref":"/hi/services/rent-agreement"},{"id":"s-rent-agreement-1","topic":"फ़ॉर्म व व्यवसाय","question":"क्या आप गारंटी दे सकते हैं कि दस्तावेज़ स्वीकार हो जाएगा?","answer":"नहीं। स्वीकृति प्राप्त करने वाली संस्था और लागू कानूनी या पंजीकरण नियमों पर निर्भर करती है।","serviceTitle":"किरायानामा और NOC फ़ॉर्म","serviceHref":"/hi/services/rent-agreement"},{"id":"s-fssai-license-0","topic":"फ़ॉर्म व व्यवसाय","question":"क्या NISE COMPORT FSSAI लाइसेंस जारी कर सकता है?","answer":"नहीं। हम पात्र आवेदन की प्रक्रिया में सहायता कर सकते हैं। श्रेणी, सत्यापन, स्वीकृति और जारी करना FSSAI और संबंधित प्राधिकरण तय करते हैं।","serviceTitle":"FSSAI फ़ूड लाइसेंस","serviceHref":"/hi/services/fssai-license"},{"id":"s-fssai-license-1","topic":"फ़ॉर्म व व्यवसाय","question":"मुझे FSSAI की कौन-सी श्रेणी चाहिए?","answer":"सही श्रेणी मौजूदा नियमों, व्यवसाय की गतिविधि और पैमाने पर निर्भर करती है। आवेदन से पहले FSSAI के आधिकारिक मार्गदर्शन से पक्का कर लीजिए।","serviceTitle":"FSSAI फ़ूड लाइसेंस","serviceHref":"/hi/services/fssai-license"},{"id":"s-udyam-registration-0","topic":"फ़ॉर्म व व्यवसाय","question":"क्या NISE COMPORT MSME प्रमाण पत्र जारी करता है?","answer":"नहीं। उद्यम पंजीकरण आधिकारिक सरकारी पोर्टल से होता है। हम नेविगेशन और तैयारी में मदद कर सकते हैं; पंजीकरण रिकॉर्ड पोर्टल जारी करता है।","serviceTitle":"उद्यम / MSME रजिस्ट्रेशन","serviceHref":"/hi/services/udyam-registration"},{"id":"s-udyam-registration-1","topic":"फ़ॉर्म व व्यवसाय","question":"क्या आधिकारिक पोर्टल पर उद्यम पंजीकरण मुफ़्त है?","answer":"ताज़ा शर्तों के लिए आधिकारिक उद्यम पोर्टल देखिए। कोई अलग सहायता शुल्क हो तो आगे बढ़ने से पहले बता दिया जाएगा।","serviceTitle":"उद्यम / MSME रजिस्ट्रेशन","serviceHref":"/hi/services/udyam-registration"},{"id":"s-jeevan-pramaan-0","topic":"सरकारी सेवाएँ","question":"क्या पेंशनभोगी का आना ज़रूरी है?","answer":"हाँ। प्रमाणीकरण पेंशनभोगी को स्वयं करना होता है।","serviceTitle":"जीवन प्रमाण (डिजिटल लाइफ़ सर्टिफ़िकेट)","serviceHref":"/hi/services/jeevan-pramaan"},{"id":"s-birth-death-certificate-0","topic":"सरकारी सेवाएँ","question":"21 दिन बाद पंजीकरण हो सकता है?","answer":"हाँ, लेकिन देरी के अनुसार अतिरिक्त दस्तावेज़, शुल्क या आदेश लग सकते हैं। रजिस्ट्रार तय करता है।","serviceTitle":"जन्म और मृत्यु प्रमाण पत्र","serviceHref":"/hi/services/birth-death-certificate"},{"id":"s-land-mutation-0","topic":"सरकारी सेवाएँ","question":"क्या रजिस्ट्री से म्यूटेशन अपने-आप हो जाता है?","answer":"नहीं। रजिस्ट्री हस्तांतरण दर्ज करती है; म्यूटेशन राजस्व रिकॉर्ड अपडेट करता है।","serviceTitle":"दाखिल-खारिज और झारभूमि","serviceHref":"/hi/services/land-mutation"},{"id":"s-aadhaar-pvc-card-0","topic":"सरकारी सेवाएँ","question":"क्या दुकान पर छपा PVC कार्ड भी वैसा ही है?","answer":"नहीं। आधिकारिक आधार PVC कार्ड UIDAI छापता और डाक से भेजता है। कहीं और छपे कार्ड आधिकारिक PVC कार्ड नहीं हैं।","serviceTitle":"आधार PVC कार्ड ऑर्डर","serviceHref":"/hi/services/aadhaar-pvc-card"},{"id":"s-aadhaar-pvc-card-1","topic":"सरकारी सेवाएँ","question":"मेरा पता पुराना है। क्या करूँ?","answer":"पहले पता अपडेट कराइए, फिर PVC कार्ड ऑर्डर कीजिए, क्योंकि कार्ड रिकॉर्ड में दर्ज पते पर जाता है।","serviceTitle":"आधार PVC कार्ड ऑर्डर","serviceHref":"/hi/services/aadhaar-pvc-card"},{"id":"s-bank-account-opening-0","topic":"बैंकिंग व AEPS","question":"क्या NISE COMPORT खाता खोलता है?","answer":"नहीं। साझेदार बैंक खाता खोलता और चलाता है। जहाँ उपलब्ध हो, हम उसके बिज़नेस कॉरेस्पोंडेंट पॉइंट के रूप में प्रक्रिया में मदद करते हैं।","serviceTitle":"बैंक खाता खुलवाना","serviceHref":"/hi/services/bank-account-opening"},{"id":"s-bank-account-opening-1","topic":"बैंकिंग व AEPS","question":"क्या न्यूनतम बैलेंस रखना पड़ता है?","answer":"नियम खाते के प्रकार के अनुसार अलग होते हैं और बैंक तय करता है। आवेदन से पहले हम बैंक की मौजूदा शर्तें समझा देते हैं।","serviceTitle":"बैंक खाता खुलवाना","serviceHref":"/hi/services/bank-account-opening"},{"id":"s-ayushman-card-0","topic":"सरकारी सेवाएँ","question":"आयुष्मान कार्ड किसे मिल सकता है?","answer":"पात्रता सूची वाले परिवारों को, और 70 वर्ष या उससे अधिक उम्र के हर व्यक्ति को, आय चाहे जो हो। शुरू करने से पहले हम आपके लिए सूची जाँच लेते हैं।","serviceTitle":"आयुष्मान कार्ड और आभा","serviceHref":"/hi/services/ayushman-card"},{"id":"s-ayushman-card-1","topic":"सरकारी सेवाएँ","question":"क्या कार्ड उसी दिन मिल सकता है?","answer":"यदि परिवार पहले से पात्र है और सत्यापन ठीक चलता है तो कार्ड अक्सर जल्दी तैयार हो जाता है। कुछ कार्डों को स्वीकृति चाहिए, जिसमें कुछ दिन लग सकते हैं।","serviceTitle":"आयुष्मान कार्ड और आभा","serviceHref":"/hi/services/ayushman-card"},{"id":"s-ration-card-0","topic":"सरकारी सेवाएँ","question":"नया राशन कार्ड बनने में कितना समय लगता है?","answer":"यह विभाग के सत्यापन पर निर्भर करता है। हम आपको पावती संख्या देते हैं और आपके लिए स्थिति देखते रहते हैं।","serviceTitle":"राशन कार्ड आवेदन और सुधार","serviceHref":"/hi/services/ration-card"},{"id":"s-ration-card-1","topic":"सरकारी सेवाएँ","question":"क्या मैं अपने नवजात शिशु का नाम जुड़वा सकता हूँ?","answer":"हाँ। बच्चे का जन्म प्रमाण पत्र, यदि बना हो तो आधार, और मौजूदा राशन कार्ड लाइए।","serviceTitle":"राशन कार्ड आवेदन और सुधार","serviceHref":"/hi/services/ration-card"},{"id":"s-abua-awas-yojana-0","topic":"सरकारी सेवाएँ","question":"क्या NISE COMPORT आवास आवेदन स्वीकृत करता है?","answer":"नहीं। चयन और स्वीकृति झारखंड सरकार करती है। हम आपका आवेदन पूरा तैयार करने में मदद करते हैं।","serviceTitle":"अबुआ आवास योजना","serviceHref":"/hi/services/abua-awas-yojana"},{"id":"s-abua-awas-yojana-1","topic":"सरकारी सेवाएँ","question":"अगर मेरे पास आय प्रमाण पत्र नहीं है तो?","answer":"हम पहले आय प्रमाण पत्र के लिए आवेदन कर सकते हैं। आय का शपथ पत्र और पहचान प्रमाण साथ लाइए।","serviceTitle":"अबुआ आवास योजना","serviceHref":"/hi/services/abua-awas-yojana"},{"id":"s-laptop-repair-0","topic":"हार्डवेयर व PC","question":"मरम्मत के दौरान क्या मेरा डेटा सुरक्षित रहेगा?","answer":"कृपया लैपटॉप देने से पहले अपनी फ़ाइलों का बैकअप ले लें। स्क्रीन या बैटरी बदलने जैसी कई मरम्मतों में डेटा को छुआ नहीं जाता, पर हम हर खराबी के लिए इसकी गारंटी नहीं दे सकते।","serviceTitle":"लैपटॉप मरम्मत","serviceHref":"/hi/services/laptop-repair"},{"id":"s-laptop-repair-1","topic":"हार्डवेयर व PC","question":"क्या आप मेरे अनुमान मंज़ूर करने से पहले काम शुरू कर देते हैं?","answer":"नहीं। हम पहले आपसे काम का दायरा और अनुमान तय करते हैं।","serviceTitle":"लैपटॉप मरम्मत","serviceHref":"/hi/services/laptop-repair"},{"id":"s-laptop-repair-2","topic":"हार्डवेयर व PC","question":"क्या असली पुर्ज़े लगाए जाते हैं?","answer":"यह मॉडल और उपलब्धता पर निर्भर है। पुर्ज़ा लगाने से पहले हम बताते हैं कि कौन-सा पुर्ज़ा प्रस्तावित है।","serviceTitle":"लैपटॉप मरम्मत","serviceHref":"/hi/services/laptop-repair"},{"id":"s-desktop-repair-0","topic":"हार्डवेयर व PC","question":"क्या आप मेरी ज़रूरत के हिसाब से पीसी बना सकते हैं?","answer":"हम आपके बजट और उपयोग (पढ़ाई, दफ़्तर या गेमिंग) पर बात करके कॉन्फ़िगरेशन सुझा सकते हैं। पुर्ज़ों की उपलब्धता और दाम खरीद के समय तय होते हैं।","serviceTitle":"डेस्कटॉप और PC मरम्मत","serviceHref":"/hi/services/desktop-repair"},{"id":"s-desktop-repair-1","topic":"हार्डवेयर व PC","question":"पीसी की मरम्मत में क्या मेरा डेटा सुरक्षित रहेगा?","answer":"कृपया पीसी देने से पहले ज़रूरी फ़ाइलों का बैकअप ले लें। खराब होती ड्राइव के डेटा की गारंटी हम नहीं दे सकते।","serviceTitle":"डेस्कटॉप और PC मरम्मत","serviceHref":"/hi/services/desktop-repair"},{"id":"s-website-creation-0","topic":"प्रिंट व डिजिटल","question":"वेबसाइट का मालिक कौन होगा?","answer":"आप। काम शुरू होने से पहले हम डोमेन और होस्टिंग का मालिकाना हक़ लिखित में आपके साथ पक्का करते हैं।","serviceTitle":"वेबसाइट बनवाएँ","serviceHref":"/hi/services/website-creation"},{"id":"s-website-design-0","topic":"प्रिंट व डिजिटल","question":"क्या आप सर्च रैंकिंग की गारंटी दे सकते हैं?","answer":"नहीं। कोई भी प्रदाता किसी निश्चित रैंकिंग की गारंटी नहीं दे सकता। सर्च में दिखना प्रतिस्पर्धा, उपयोगी सामग्री, तकनीकी गुणवत्ता और व्यवसाय के निरंतर संकेतों पर निर्भर करता है।","serviceTitle":"दुकान के लिए वेबसाइट और डिजिटल सहायता","serviceHref":"/hi/services/website-design"},{"id":"s-photo-studio-0","topic":"प्रिंट व डिजिटल","question":"क्या आप मेरी फ़ोटो या पोस्टर A4, A3 या A2 में प्रिंट कर सकते हैं?","answer":"हाँ। फ़ोटो अपने फ़ोन, पेन ड्राइव या मेमोरी कार्ड में लाइए, साइज़ और प्रतियाँ बताइए; प्रिंट से पहले हम शुल्क बताते हैं। साफ़ नतीजे के लिए फ़ाइल उस साइज़ के लिए पर्याप्त बड़ी होनी चाहिए।","serviceTitle":"फोटो स्टूडियो और पासपोर्ट फोटो","serviceHref":"/hi/services/photo-studio"},{"id":"s-photo-studio-1","topic":"प्रिंट व डिजिटल","question":"क्या मेरी फ़ोटो किसी आवेदन में स्वीकार हो जाएगी?","answer":"हम स्वीकृति की गारंटी नहीं दे सकते। आने से पहले अपने फ़ॉर्म या प्राधिकरण के ताज़ा फ़ोटो नियम देख लीजिए; हम उनसे मिलाने में मदद करेंगे।","serviceTitle":"फोटो स्टूडियो और पासपोर्ट फोटो","serviceHref":"/hi/services/photo-studio"},{"id":"s-photo-studio-2","topic":"प्रिंट व डिजिटल","question":"क्या आप ऑनलाइन फ़ॉर्म के लिए फ़ोटो में मदद करते हैं?","answer":"आप जो नियम बताएँगे, उसके अनुसार हम फ़ोटो खींच और साइज़ कर सकते हैं। आने से पहले शर्तें पक्की कर लीजिए।","serviceTitle":"फोटो स्टूडियो और पासपोर्ट फोटो","serviceHref":"/hi/services/photo-studio"},{"id":"s-printer-repair-0","topic":"हार्डवेयर व PC","question":"क्या आप वारंटी वाला प्रिंटर ठीक कर सकते हैं?","answer":"वारंटी की मरम्मत आमतौर पर निर्माता के सर्विस सेंटर से होती है। मॉडल बताइए; कुछ भी खोलने से पहले हम रास्ता समझा देंगे।","serviceTitle":"प्रिंटर मरम्मत","serviceHref":"/hi/services/printer-repair"},{"id":"s-printer-repair-1","topic":"हार्डवेयर व PC","question":"क्या आप प्रिंटर को Wi-Fi पर सेट करते हैं?","answer":"हाँ, नेटवर्क सेटअप हमारी प्रिंटर पूछताछ का हिस्सा है। पूछते समय मॉडल और अपने नेटवर्क का विवरण बताइए।","serviceTitle":"प्रिंटर मरम्मत","serviceHref":"/hi/services/printer-repair"},{"id":"s-data-recovery-0","topic":"हार्डवेयर व PC","question":"क्या हर खोई फ़ाइल वापस मिल सकती है?","answer":"नहीं। नतीजा कारण और डिवाइस की हालत पर निर्भर करता है, और हम रिकवरी का वादा नहीं कर सकते।","serviceTitle":"डेटा रिकवरी","serviceHref":"/hi/services/data-recovery"},{"id":"s-data-recovery-1","topic":"हार्डवेयर व PC","question":"क्या मुझे ड्राइव इस्तेमाल करते रहना चाहिए?","answer":"नहीं। इस्तेमाल जारी रखने से खोया डेटा ओवरराइट हो सकता है। रुकिए और पहले हमसे संपर्क कीजिए।","serviceTitle":"डेटा रिकवरी","serviceHref":"/hi/services/data-recovery"},{"id":"s-pc-build-0","topic":"हार्डवेयर व PC","question":"क्या खरीदने से पहले दाम बताएँगे?","answer":"हाँ। आपके कुछ भी मंज़ूर करने से पहले हम हर पुर्ज़े का ताज़ा दाम और कुल रकम बताते हैं।","serviceTitle":"कस्टम PC बिल्ड कोटेशन","serviceHref":"/hi/services/pc-build"},{"id":"s-pc-build-1","topic":"हार्डवेयर व PC","question":"क्या कम बजट में पीसी बन सकता है?","answer":"हाँ। अपना बजट बताइए; उसके भीतर सबसे अच्छा प्रदर्शन देने वाला विकल्प हम सुझाएँगे।","serviceTitle":"कस्टम PC बिल्ड कोटेशन","serviceHref":"/hi/services/pc-build"},{"id":"s-hardware-quote-0","topic":"हार्डवेयर व PC","question":"क्या इस पेज पर दाम तय हैं?","answer":"नहीं। दाम अक्सर बदलते हैं, इसलिए खरीदने से पहले हम WhatsApp पर ताज़ा दाम पक्का करते हैं।","serviceTitle":"हार्डवेयर पार्ट्स कोटेशन","serviceHref":"/hi/services/hardware-quote"},{"id":"s-hardware-quote-1","topic":"हार्डवेयर व PC","question":"क्या मैं सिर्फ़ एक चीज़ खरीद सकता हूँ?","answer":"हाँ। एक ही चीज़ ठीक है; अनुरोध वही रहता है।","serviceTitle":"हार्डवेयर पार्ट्स कोटेशन","serviceHref":"/hi/services/hardware-quote"},{"id":"s-software-upgrade-0","topic":"हार्डवेयर व PC","question":"क्या मेरी फ़ाइलें बची रहेंगी?","answer":"हम पहले बैकअप की सलाह देते हैं। पुराने या खराब होते डिवाइस के डेटा की गारंटी हम नहीं दे सकते।","serviceTitle":"सॉफ़्टवेयर अपग्रेड","serviceHref":"/hi/services/software-upgrade"},{"id":"s-hardware-upgrade-0","topic":"हार्डवेयर व PC","question":"क्या हर लैपटॉप में अपग्रेड हो सकता है?","answer":"सभी में नहीं। कुछ लैपटॉप में मेमोरी सोल्डर की होती है। कुछ भी खरीदने से पहले हम आपका मॉडल जाँच लेते हैं।","serviceTitle":"हार्डवेयर अपग्रेड","serviceHref":"/hi/services/hardware-upgrade"},{"id":"s-coreldraw-design-0","topic":"प्रिंट व डिजिटल","question":"क्या आप डिज़ाइन प्रिंट भी कर सकते हैं?","answer":"हाँ। हम इसे अपने डेस्क पर प्रिंट कर सकते हैं या प्रिंट-रेडी फ़ाइलें दे सकते हैं ताकि आप कहीं और प्रिंट करवा सकें।","serviceTitle":"CorelDRAW डिज़ाइन, बैनर व पोस्टर","serviceHref":"/hi/services/coreldraw-design"},{"id":"s-custom-printing-0","topic":"प्रिंट व डिजिटल","question":"आप किन चीज़ों पर प्रिंट कर सकते हैं?","answer":"आपके मन में जो है वह बताइए; हम पक्का करेंगे कि क्या छाप सकते हैं।","serviceTitle":"कस्टम प्रिंटिंग","serviceHref":"/hi/services/custom-printing"},{"id":"s-printing-scanning-0","topic":"प्रिंट व डिजिटल","question":"क्या फ़ाइल अपलोड करनी होगी?","answer":"नहीं। पहले कीमत पूछें, फिर फ़ाइल फ़ोन या पेन ड्राइव में लाएँ, या कीमत तय होने पर WhatsApp पर भेजें।","serviceTitle":"प्रिंटिंग, स्कैनिंग और फ़ोटोकॉपी","serviceHref":"/hi/services/printing-scanning"}],"topics":["हमारे बारे में","हमसे मिलने आना","शुल्क और भुगतान","अनुरोध और ट्रैकिंग","खाता और गोपनीयता","प्रिंटिंग और दस्तावेज़","सरकारी सेवाएँ","बैंकिंग व AEPS","बीमा","छात्र व परीक्षा","फ़ॉर्म व व्यवसाय","हार्डवेयर व PC","प्रिंट व डिजिटल"],"lang":"hi"}]}],"$L15"]}],null,"$L16"]}],"p":"$@17","v":null,"s":"$6"}}]]
