5f:T8c6,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"NISE COMPORT কোথায়?","acceptedAnswer":{"@type":"Answer","text":"দোকান নং 3, গ্রাউন্ড ফ্লোর, সিং বিল্ডিং, হনুমান মন্দির রোড, খরংগাঝাড়, টেলকো, জামশেদপুর, ঝাড়খণ্ড 831004।"}},{"@type":"Question","name":"NISE COMPORT কি সরকারি অফিস?","acceptedAnswer":{"@type":"Answer","text":"না। আমরা একটি স্বাধীন CSC / প্রজ্ঞা কেন্দ্র পরিষেবা কেন্দ্র। আবেদনের চূড়ান্ত সিদ্ধান্ত নেয় সংশ্লিষ্ট সরকারি দপ্তর বা সংস্থা।"}},{"@type":"Question","name":"সরকারি ফি কি আপনাদের পরিষেবা চার্জের মধ্যেই ধরা থাকে?","acceptedAnswer":{"@type":"Answer","text":"না। সরকারি বা পোর্টালের ফি আর আমাদের পরিষেবা চার্জ আলাদা। কাজ শুরু করার আগেই আমরা দুটোই পরিষ্কার করে জানিয়ে দিই।"}},{"@type":"Question","name":"আসার আগে কী করব?","acceptedAnswer":{"@type":"Answer","text":"পরিষেবার পেজে কাগজপত্রের তালিকা দেখে নিন, আর দরকার হলে আগে ফোন বা হোয়াটসঅ্যাপ করে নিন, যাতে একবারেই কাজ শেষ হয়।"}},{"@type":"Question","name":"আমাকে কি আমার OTP বলতে হবে?","acceptedAnswer":{"@type":"Answer","text":"না। নিজের OTP, PIN বা পাসওয়ার্ড কাউকে জানাবেন না। দরকার হলে OTP আপনি নিজেই অফিসিয়াল প্রক্রিয়ায় টাইপ করবেন।"}}]}28:["$","section",null,{"className":"section faq-block","id":"faq","lang":"bn-IN","children":[["$","div",null,{"className":"container faq-block__inner","children":[["$","div",null,{"className":"section-head section-head--left","children":[["$","span",null,{"className":"eyebrow","children":"প্রায়ই জিজ্ঞাসিত প্রশ্ন"}],["$","h2",null,{"children":"আসার আগে জেনে নিন"}]]}],["$","div",null,{"className":"faq-list","children":[["$","details","NISE COMPORT কোথায়?",{"name":"faq-group","open":true,"children":[["$","summary",null,{"children":[["$","span",null,{"children":"NISE COMPORT কোথায়?"}],["$","i",null,{"aria-hidden":"true","children":["$","$L22",null,{"icon":{"name":"plus","size":24,"node":[["path",{"d":"M5 12h14","key":"1ays0h"}],["path",{"d":"M12 5v14","key":"s699le"}]]},"size":18}]}]]}],["$","p",null,{"children":"দোকান