a:[["children",{"s":"__PAGE__","h":160,"d":{"r":["$","$2","c",{"children":[["$","main",null,{"className":"content-page","lang":"bn-IN","children":[["$","$L11",null,{}],["$","section",null,{"className":"content-hero","children":["$","div",null,{"className":"container","children":[[["$","nav",null,{"className":"breadcrumbs","aria-label":"ব্রেডক্রাম্ব","children":["$","ol",null,{"children":[["$","li","/bn",{"children":[["$","$L12",null,{"href":"/bn","children":"হোম"}],["$","$L13",null,{"icon":{"name":"chevron-right","size":24,"node":[["path",{"d":"m9 18 6-6-6-6","key":"mthhwq"}]]},"size":12,"aria-hidden":"true"}]]}],["$","li","/bn/faq",{"children":["$","span",null,{"aria-current":"page","children":"প্রশ্নোত্তর"}]}]]}]}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"হোম\",\"item\":\"https://www.nisecomport.com/bn\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"প্রশ্নোত্তর\",\"item\":\"https://www.nisecomport.com/bn/faq\"}]}"}}]],["$","$L12",null,{"href":"/bn","className":"back-small","children":[["$","$L13",null,{"icon":{"name":"arrow-left","size":24,"node":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]]},"size":14}]," ","হোম"]}],["$","span",null,{"className":"eyebrow eyebrow-muted","children":"ভালো প্রশ্ন, স্পষ্ট উত্তর"}],["$","h1",null,{"children":["প্রায়ই জিজ্ঞাসিত",["$","br",null,{}],["$","em",null,{"children":"প্রশ্ন।"}]]}],["$","p",null,{"children":["যেকোনো প্রশ্ন খুঁজুন, বা কোনও বিষয় বা পরিষেবা বাছুন। আপনারটা পেলেন না? ",["$","$L12",null,{"href":"/bn/contact","children":"সার্ভিস ডেস্ককে জিজ্ঞাসা করুন"}],"."]}]]}]}],["$","section",null,{"className":"container","children":["$","$L14",null,{"faqs":[{"id":"g-0","topic":"আমাদের সম্পর্কে","question":"NISE COMPORT কি সরকারি অফিস?","answer":"না। NISE COMPORT একটি স্বাধীন CSC / প্রজ্ঞা কেন্দ্র পরিষেবা কেন্দ্র যা গ্রাহকদের সরকারি ও ডিজিটাল পরিষেবা ব্যবহারে সাহায্য করে। চূড়ান্ত সিদ্ধান্ত সংশ্লিষ্ট দপ্তর, ব্যাংক বা প্রদানকারীর।"},{"id":"g-1","topic":"আমাদের সম্পর্কে","question":"CSC / প্রজ্ঞা কেন্দ্র কী?","answer":"কমন সার্ভিস সেন্টার (CSC) বা প্রজ্ঞা কেন্দ্র একটি স্থানীয় পরিষেবা কেন্দ্র যা নাগরিকদের বাড়ির কাছেই সরকারি ও ডিজিটাল পরিষেবার জন্য আবেদন করতে সাহায্য করে, যাতে একাধিক অফিসে ঘুরতে না হয়।"},{"id":"g-2","topic":"আমাদের সম্পর্কে","question":"আপনারা কবে থেকে জামশেদপুরের সেবা করছেন?","answer":"আমরা ১৯৯৫ সালে NISE নামে শুরু করেছিলাম এবং বড় হয়ে NISE COMPORT হয়েছি। আমাদের অনেক গ্রাহক বছরের পর বছর ধরে আমাদের কাছে আসছেন।"},{"id":"g-3","topic":"আমাদের সম্পর্কে","question":"আপনারা কী কী পরিষেবা দেন?","answer":"প্যান ও আধারে সাহায্য, ঝাড়খণ্ডের সার্টিফিকেট, ভোটার আইডি, ব্যাংকিং ও AEPS, বিমা, বৃত্তি ও পরীক্ষার ফর্ম, ITR ও ব্যবসার ফর্ম, ওয়েবসাইট তৈরি, ফটো স্টুডিও, প্রিন্টিং ও ফটোকপি, এবং কম্পিউটার মেরামত ও হার্ডওয়্যার। পুরো তালিকা পরিষেবা পেজে দেখুন।"},{"id":"g-4","topic":"আমাদের সম্পর্কে","question":"আমি কি বাংলায় কারও সঙ্গে কথা বলতে পারি?","answer":"হ্যাঁ। আমাদের টিম হিন্দি, বাংলা ও ইংরেজিতে কথা বলে, এবং প্রধান পেজগুলি হিন্দিতে /hi এবং বাংলায় /bn-এ পাওয়া যায়।"},{"id":"g-5","topic":"আমাদের সম্পর্কে","question":"আপনাদের সাইটে দেখানো লোগো ও পরিষেবা কি আপনাদের?","answer":"না। CSC, ডিজিটাল ইন্ডিয়া, প্যান, আধার ও ভোটার আইডির মতো নাম তাদের মালিকদের। আমরা একটি স্বাধীন স্থানীয় সহায়ক যারা আবেদন, জমা ও ট্র্যাকিংয়ে আপনাকে পথ দেখায়।"},{"id":"g-6","topic":"আমাদের সম্পর্কে","question":"আপনাদের টিমে কারা আছেন?","answer":"সার্ভিস ডেস্কের মানুষদের সঙ্গে টিম পেজে পরিচিত হন। কর্মীরা আপনার আবেদনে সাহায্য করেন, কিন্তু অনুমোদনের সিদ্ধান্ত কখনও নেন না।"},{"id":"g-7","topic":"আমাদের কাছে আসা","question":"আপনারা কোথায় অবস্থিত?","answer":"দোকান নং 3, গ্রাউন্ড ফ্লোর, সিং বিল্ডিং, হনুমান মন্দির রোড, খরংগাঝাড়, টেলকো কলোনি, জামশেদপুর, ঝাড়খণ্ড 831004। দিকনির্দেশের জন্য যোগাযোগ পেজ থেকে Google Maps খুলুন।"},{"id":"g-8","topic":"আমাদের কাছে আসা","question":"আপনারা কোন কোন এলাকায় পরিষেবা দেন?","answer":"খরংগাঝাড়, টেলকো, গোবিন্দপুর, বিরসানগর, গোলমুরি, সাকচি, মানগো এবং পুরো জামশেদপুর থেকে গ্রাহকেরা সরাসরি আসেন। অনলাইন অনুরোধ যেকোনো জায়গা থেকে পাঠানো যায়। আমরা কোথায় পরিষেবা দিই সেই পেজ দেখুন।"},{"id":"g-9","topic":"আমাদের কাছে আসা","question":"আপনাদের খোলার সময় কী?","answer":"আমাদের সময় যোগাযোগ পেজে দেখানো আছে এবং সরকারি ছুটির দিনে বদলায়। জরুরি বা পোর্টাল-নির্ভর কাজের জন্য আসার আগে +91 97712 19893-এ কল করুন।"},{"id":"g-10","topic":"আমাদের কাছে আসা","question":"আমার কি অ্যাপয়েন্টমেন্ট লাগবে?","answer":"না। খোলার সময়ে আপনি সরাসরি আসতে পারেন। দীর্ঘ বা বেশি নথির কাজের জন্য আগে অনুরোধ পাঠান বা WhatsApp করুন যাতে আমরা ঠিক জানাতে পারি কী আনতে হবে।"},{"id":"g-11","topic":"আমাদের কাছে আসা","question":"আসার সময় আমি কী নিয়ে আসব?","answer":"আপনার পরিষেবার আসল নথি, যেখানে চাই সেখানে ফটোকপি, এবং OTP-র জন্য আপনার মোবাইল ফোন (OTP কাউকে কখনও জানাবেন না)। প্রতিটি পরিষেবা পেজে নথির তালিকা আছে।"},{"id":"g-12","topic":"আমাদের কাছে আসা","question":"আমার হয়ে কি অন্য কেউ আসতে পারেন?","answer":"অনেক পরিষেবার জন্য হ্যাঁ, যদি তিনি আপনার নথি আনেন। যেসব পরিষেবায় আপনার OTP, বায়োমেট্রিক বা ছবি লাগে (যেমন আধার আপডেট ও প্যানের কিছু ধাপ), সেখানে আপনাকে নিজে আসতে হতে পারে। আগে আমাদের জিজ্ঞাসা করুন।"},{"id":"g-13","topic":"আমাদের কাছে আসা","question":"আমি কি আপনাদের WhatsApp-এ যোগাযোগ করতে পারি?","answer":"হ্যাঁ। +91 97712 19893 বা +91 98355 52756-এ WhatsApp করুন। আপনি প্রশ্ন বা নথির ছবি পাঠাতে পারেন, আমরা পরের ধাপ জানিয়ে দেব।"},{"id":"g-14","topic":"ফি ও পেমেন্ট","question":"সরকারি ফি কি আপনাদের সার্ভিস চার্জের মধ্যে ধরা?","answer":"না। আমরা আমাদের সার্ভিস চার্জ যেকোনো সরকারি, পোর্টাল, ব্যাংক বা বিমা ফি থেকে আলাদা দেখাই। রসিদে আদায় করা চার্জগুলি আলাদাভাবে লেখা থাকে।"},{"id":"g-15","topic":"ফি ও পেমেন্ট","question":"এতে কত খরচ হবে?","answer":"কাজ শুরুর আগে আমরা আমাদের সার্ভিস চার্জ জানিয়ে দিই। প্রিন্টিংয়ের দর মূল্য পেজে আছে; অন্য পরিষেবার চার্জ WhatsApp-এ বা ডেস্কে নিশ্চিত করা হয়।"},{"id":"g-16","topic":"ফি ও পেমেন্ট","question":"আপনারা কি আবেদন অনুমোদনের নিশ্চয়তা দিতে পারেন?","answer":"না। অনুমোদন, প্রক্রিয়ার সময় ও সিদ্ধান্ত সংশ্লিষ্ট সরকারি দপ্তর, কোম্পানি বা পরিষেবা প্রদানকারীর নিয়ন্ত্রণে।"},{"id":"g-17","topic":"ফি ও পেমেন্ট","question":"আমি কীভাবে পেমেন্ট করতে পারি?","answer":"আপনি ডেস্কে নগদ বা UPI-তে পেমেন্ট করতে পারেন। অনলাইন পেমেন্ট যোগ করা হচ্ছে; চালু হলে আপনার অনুরোধে পেমেন্টের নিশ্চিতকরণ হবে ও রসিদ দেওয়া হবে।"},{"id":"g-18","topic":"ফি ও পেমেন্ট","question":"আমি কি রসিদ পাব?","answer":"হ্যাঁ। প্রতিটি পেমেন্টের জন্য রসিদ বা নিশ্চিতকরণ দেওয়া হয়, সঙ্গে পোর্টালের প্রাপ্তিস্বীকারও, যেখানে আছে। দুটিই যত্নে রাখুন।"},{"id":"g-19","topic":"ফি ও পেমেন্ট","question":"আমি কি রিফান্ড পেতে পারি?","answer":"কাজ শুরুর আগে বাতিল করলে, বা আমরা পরিষেবা দিতে না পারলে, সার্ভিস চার্জ ফেরত দেওয়া হয়। সম্পন্ন পরিষেবার চার্জ সাধারণত ফেরতযোগ্য নয়। বিস্তারিত জানতে রিফান্ড ও বাতিলকরণ নীতি দেখুন।"},{"id":"g-20","topic":"ফি ও পেমেন্ট","question":"অফার ও প্রোমো কোড কীভাবে কাজ করে?","answer":"প্রোমো কোড ও ওয়েলকাম কুপন শুধু আমাদের সার্ভিস চার্জে ছাড় দেয়, সরকারি ফি-তে কখনও নয়। আপনার অনুরোধে কোড দিন, বা আজ কী চালু আছে জানতে অফার পেজ দেখুন।"},{"id":"g-21","topic":"ফি ও পেমেন্ট","question":"সংশোধনের জন্য কি আপনারা বাড়তি চার্জ নেন?","answer":"দেওয়া তথ্য বা নথি ভুল বা অসম্পূর্ণ থাকায় সংশোধন লাগলে, আবার ফাইল করতে নতুন সার্ভিস চার্জ লাগতে পারে। ভুলটি আমাদের হলে, আমরা বিনা চার্জে ঠিক করে দিই।"},{"id":"g-22","topic":"অনুরোধ ও ট্র্যাকিং","question":"আমি কীভাবে অনুরোধ ট্র্যাক করতে পারি?","answer":"অনুরোধ ট্র্যাক করুন পেজ ব্যবহার করুন। এটি দেখায় আপনার প্রোফাইলে NISE COMPORT অনুরোধ কীভাবে দেখবেন, এবং প্যান, সার্টিফিকেট ও ভোটার আইডি সরকারি পোর্টালে কোথায় ট্র্যাক করবেন। অবস্থা বদলালে আমরা ইমেলও করি।"},{"id":"g-23","topic":"অনুরোধ ও ট্র্যাকিং","question":"আমি কি অনুরোধ বাতিল করতে পারি?","answer":"হ্যাঁ, যতক্ষণ সেটি জমা আছে, পর্যালোচনায় আছে বা আপনার অপেক্ষায় আছে। প্রোফাইলে অনুরোধটি খুলে “এই অনুরোধ বাতিল করুন” বাছুন। সেই ধাপের পরে ডেস্কে কল বা WhatsApp করুন।"},{"id":"g-24","topic":"অনুরোধ ও ট্র্যাকিং","question":"আমি কীভাবে অনলাইনে অনুরোধ শুরু করব?","answer":"আপনার পরিষেবা বাছুন, নথি আপলোড করুন ও অনুরোধ পাঠান। আপনি ইমেল কোড দিয়ে সাইন ইন করতে পারেন, এবং আপনার তথ্য সংরক্ষিত থাকে যাতে পরের বার আবার লিখতে না হয়।"},{"id":"g-25","topic":"অনুরোধ ও ট্র্যাকিং","question":"আমার অনুরোধে কত সময় লাগবে?","answer":"এটি পরিষেবা এবং সরকার বা প্রদানকারীর উপর নির্ভর করে। অনুরোধ নিশ্চিত করার সময় আমরা সাধারণ সময় জানিয়ে দিই। সরকারি পোর্টালের দেরি আমাদের নিয়ন্ত্রণের বাইরে।"},{"id":"g-26","topic":"অনুরোধ ও ট্র্যাকিং","question":"আমার রেফারেন্স নম্বর হারিয়ে গেছে। এখন কী করব?","answer":"আপনার সব অনুরোধের রেফারেন্স দেখতে প্রোফাইলে সাইন ইন করুন, বা আমাদের আপনার নাম ও আনুমানিক তারিখ জানান, আমরা খুঁজে দেব।"},{"id":"g-27","topic":"অনুরোধ ও ট্র্যাকিং","question":"আমার আবেদন ‘প্রক্রিয়াধীন’ দেখাচ্ছে। এটা কি স্বাভাবিক?","answer":"সাধারণত হ্যাঁ। এর মানে দপ্তর সেটি পেয়েছে। কয়েকদিন পর আবার দেখুন। অনেক বেশি সময় অপরিবর্তিত থাকলে আমাদের সঙ্গে যোগাযোগ করুন; আমরা ফলো-আপে সাহায্য করব।"},{"id":"g-28","topic":"অনুরোধ ও ট্র্যাকিং","question":"আমার কাজ তৈরি হলে কি আপনারা জানাবেন?","answer":"হ্যাঁ। আমরা আপনার অনুরোধের অবস্থা আপডেট করি, ইমেল করি এবং যেখানে সম্ভব WhatsApp-এ মেসেজ পাঠাই। আপনি যেকোনো সময় আপনার প্রোফাইলও দেখতে পারেন।"},{"id":"g-29","topic":"অ্যাকাউন্ট ও গোপনীয়তা","question":"আমার কি অ্যাকাউন্ট লাগবে?","answer":"অ্যাকাউন্ট ছাড়াও আপনি কল, WhatsApp বা সরাসরি আসতে পারেন। অ্যাকাউন্ট থাকলে আপনি অনলাইনে অনুরোধ পাঠাতে, তথ্য সংরক্ষণ করতে, অগ্রগতি ট্র্যাক করতে ও ইতিহাস দেখতে পারেন।"},{"id":"g-30","topic":"অ্যাকাউন্ট ও গোপনীয়তা","question":"আমি ইমেল কোড পাইনি। কী করব?","answer":"স্প্যাম বা প্রোমোশন ফোল্ডার দেখুন, এক মিনিট অপেক্ষা করুন ও “কোড আবার পাঠান” চাপুন। শুধু সর্বশেষ কোডটিই কাজ করে, এবং প্রতিটি কোড ১০ মিনিটে মেয়াদোত্তীর্ণ হয়।"},{"id":"g-31","topic":"অ্যাকাউন্ট ও গোপনীয়তা","question":"আমি পাসওয়ার্ড ভুলে গেছি।","answer":"সাইন-ইন পেজে “পাসওয়ার্ড ভুলে গেছেন?” ব্যবহার করুন। আমরা ৬ অঙ্কের কোড ইমেল করি; নতুন পাসওয়ার্ড দেওয়ার পর নিরাপত্তার জন্য সব ডিভাইস থেকে সাইন-আউট হয়ে যায়।"},{"id":"g-32","topic":"অ্যাকাউন্ট ও গোপনীয়তা","question":"NISE COMPORT আমার নথি কীভাবে ব্যবহার করে?","answer":"শুধু আপনার অনুরোধ সম্পন্ন করতে। ফাইল গোপনে রাখা হয়, আপনি ও অনুমোদিত কর্মীরা দেখতে পান, এবং সংরক্ষণের সময়ের পর মুছে ফেলা হয়। গোপনীয়তা নীতি দেখুন।"},{"id":"g-33","topic":"অ্যাকাউন্ট ও গোপনীয়তা","question":"আপলোড করা নথি কতদিন রাখা হয়?","answer":"সংরক্ষণের সময়ের পর (ডিফল্ট ৩০ দিন, অনুরোধ খোলা থাকলে তবেই বেশি) ফাইল মোছার জন্য নির্ধারিত হয়। আপনার অনুরোধের জন্য দরকার নেই এমন নথি আপলোড করা এড়িয়ে চলুন।"},{"id":"g-34","topic":"অ্যাকাউন্ট ও গোপনীয়তা","question":"আমি কি OTP বা PIN কর্মীদের সঙ্গে শেয়ার করব?","answer":"কখনও না। OTP, PIN ও পাসওয়ার্ড নিজে, শুধু আপনার শুরু করা সরকারি প্রক্রিয়াতেই দিন। আমাদের কর্মীরা কখনও সেগুলি চাইবেন না।"},{"id":"g-35","topic":"অ্যাকাউন্ট ও গোপনীয়তা","question":"আমি কি আমার অ্যাকাউন্ট মুছতে পারি?","answer":"হ্যাঁ। প্রোফাইল → সাইন-ইন ও গোপনীয়তা → অ্যাকাউন্ট মুছুন-এ যান। খোলা অনুরোধ আগে সম্পন্ন বা বাতিল করতে হবে।"},{"id":"g-36","topic":"অ্যাকাউন্ট ও গোপনীয়তা","question":"আমার পেমেন্টের তথ্য কি নিরাপদ?","answer":"আমরা আপনার কার্ড নম্বর, UPI PIN বা নেট-ব্যাংকিং পাসওয়ার্ড কখনও দেখি না বা সংরক্ষণ করি না। অনলাইন পেমেন্ট, চালু হলে, একটি পেমেন্ট পার্টনার ও আপনার ব্যাংক সামলায়।"},{"id":"g-37","topic":"প্রিন্টিং ও নথি","question":"অনলাইন প্রিন্টিং কীভাবে কাজ করে?","answer":"আপনার নথি আপলোড করুন, পেজ ও প্রিন্টের পছন্দ বাছুন, আনুমানিক খরচ দেখুন এবং পিকআপ বা ডেলিভারি বাছুন। প্রিন্টের আগে আমরা ফাইল ও প্রাপ্যতা নিশ্চিত করি।"},{"id":"g-38","topic":"প্রিন্টিং ও নথি","question":"আপনাদের প্রিন্টিংয়ের দর কত?","answer":"সাদা-কালো ১০ পেজ পর্যন্ত পেজপ্রতি ₹৫, ১১–৫০ পেজে ₹৩ এবং ৫০-এর বেশি হলে ₹২; রঙিন পেজপ্রতি ₹১০। বিস্তারিত জানতে মূল্য পেজ দেখুন।"},{"id":"g-39","topic":"প্রিন্টিং ও নথি","question":"কোন ধরনের ফাইল প্রিন্ট করা যায়?","answer":"PDF, Word ও সাধারণ ছবির ফাইল সবচেয়ে ভালো চলে। আপনার ফাইল না খুললে সেটি WhatsApp-এ পাঠান, আমরা সামলে নেব।"},{"id":"g-40","topic":"প্রিন্টিং ও নথি","question":"আপনারা কি স্ক্যান, ফটোকপি ও ল্যামিনেশন করেন?","answer":"হ্যাঁ। আমরা ডেস্কে স্ক্যান, ফটোকপি, প্রিন্ট, ল্যামিনেশন ও স্পাইরাল বাইন্ডিং করি। আজকের দর জিজ্ঞাসা করুন।"},{"id":"g-41","topic":"প্রিন্টিং ও নথি","question":"আমি কি পাসপোর্ট সাইজ ছবি পেতে পারি?","answer":"হ্যাঁ, ডেস্কে। সাইজ ও সংখ্যা জানান (যেমন প্যান, আধার, পরীক্ষা বা ফর্মের জন্য)।"},{"id":"s-pan-card-0","topic":"সরকারি পরিষেবা","question":"একজনের কি দুটো প্যান থাকতে পারে?","answer":"না। প্যান হারিয়ে গেলে নতুন প্যান নয়, রিপ্রিন্টের আবেদন করুন। দুটো প্যান থাকলে একটি সারেন্ডার করতে হয়।","serviceTitle":"প্যান কার্ড আবেদন ও সংশোধন","serviceHref":"/bn/services/pan-card"},{"id":"s-pan-card-1","topic":"সরকারি পরিষেবা","question":"আপনারা কি প্যানের গ্যারান্টি দেন?","answer":"না। আমরা আবেদনে সাহায্য করি; প্যান দেওয়ার সিদ্ধান্ত অনুমোদিত প্যান প্রদানকারী সংস্থা ও আয়কর বিভাগের।","serviceTitle":"প্যান কার্ড আবেদন ও সংশোধন","serviceHref":"/bn/services/pan-card"},{"id":"s-aadhaar-0","topic":"সরকারি পরিষেবা","question":"আধার আপডেটের ফি কত?","answer":"ফি ঠিক করে UIDAI, এবং তা কেন্দ্রে ও রসিদে দেখানো থাকে। বর্তমান তালিকা UIDAI-এর ওয়েবসাইটে দেখুন; বেশি টাকা চাওয়া হলে 1947-এ অভিযোগ জানান।","serviceTitle":"আধার পরিষেবা সহায়তা","serviceHref":"/bn/services/aadhaar"},{"id":"s-aadhaar-1","topic":"সরকারি পরিষেবা","question":"স্টাফকে কি আধারের OTP বলা উচিত?","answer":"না। OTP শুধু আপনি নিজেই অফিসিয়াল প্রক্রিয়ায় টাইপ করবেন।","serviceTitle":"আধার পরিষেবা সহায়তা","serviceHref":"/bn/services/aadhaar"},{"id":"s-income-caste-residence-certificate-0","topic":"সরকারি পরিষেবা","question":"শংসাপত্র কত দিনে পাওয়া যাবে?","answer":"সময় ঠিক করে সংশ্লিষ্ট সার্কেল (অঞ্চল) বা রাজস্ব অফিস। আমরা কোনো নির্দিষ্ট তারিখের প্রতিশ্রুতি দিতে পারি না।","serviceTitle":"আয় সার্টিফিকেট","serviceHref":"/bn/services/income-caste-residence-certificate"},{"id":"s-income-caste-residence-certificate-1","topic":"সরকারি পরিষেবা","question":"আয় আর জাতি শংসাপত্র কি একই আবেদনে হয়?","answer":"না। দুটো আলাদা শংসাপত্র, আর দুটোর কাগজপত্রও আলাদা।","serviceTitle":"আয় সার্টিফিকেট","serviceHref":"/bn/services/income-caste-residence-certificate"},{"id":"s-local-resident-certificate-0","topic":"সরকারি পরিষেবা","question":"এটি আয় বা জাতি সার্টিফিকেট থেকে কীভাবে আলাদা?","answer":"স্থানীয় বাসিন্দা সার্টিফিকেট শুধু জানায় আপনি কোথায় ও কতদিন ধরে থাকেন। এতে আয় বা জাতি থাকে না, তাই স্কুল, আবাসন প্রকল্প ও রেশন কার্ডের কিছু পরিবর্তনে এটি আলাদা করে চাওয়া হয়।","serviceTitle":"স্থানীয় বাসস্থান সার্টিফিকেট","serviceHref":"/bn/services/local-resident-certificate"},{"id":"s-local-resident-certificate-1","topic":"সরকারি পরিষেবা","question":"আমি সম্প্রতি জামশেদপুরে এসেছি, তাহলে?","answer":"কিছু অঞ্চল অফিস নতুন আসা মানুষের কাছে ন্যূনতম বসবাসের সময় বা বাড়তি প্রমাণ চায়। আবেদনের আগে আমরা আপনার অঞ্চলের সর্বশেষ নিয়ম দেখে নিই।","serviceTitle":"স্থানীয় বাসস্থান সার্টিফিকেট","serviceHref":"/bn/services/local-resident-certificate"},{"id":"s-caste-certificate-ebc1-bc2-0","topic":"সরকারি পরিষেবা","question":"EBC-I ও BC-II-এর মধ্যে পার্থক্য কী?","answer":"এগুলি ঝাড়খণ্ডের দুটি আলাদা পিছিয়ে-পড়া শ্রেণি, প্রত্যেকের নিজস্ব সম্প্রদায় তালিকা আছে। শ্রেণি ঠিক হয় আবেদনকারীর জাতি কোন তালিকায় আছে তা দিয়ে, পছন্দে নয়। আবেদনের আগে আমরা সর্বশেষ সরকারি তালিকা দেখি।","serviceTitle":"EBC-I / BC-II (OBC) জাতি সার্টিফিকেট","serviceHref":"/bn/services/caste-certificate-ebc1-bc2"},{"id":"s-caste-certificate-ebc1-bc2-1","topic":"সরকারি পরিষেবা","question":"এই সার্টিফিকেটের কি মেয়াদ শেষ হয়?","answer":"নন-ক্রিমি-লেয়ার সার্টিফিকেটে পরিবারের বর্তমান আয়ও প্রমাণিত হয়, তাই ভর্তি ও চাকরির জন্য প্রায়ই নির্দিষ্ট সময় পরপর (সাধারণত প্রতি বছর) নবীকরণ চাওয়া হয়। যে প্রকল্পে আবেদন করছেন তার শর্ত দেখে নিন।","serviceTitle":"EBC-I / BC-II (OBC) জাতি সার্টিফিকেট","serviceHref":"/bn/services/caste-certificate-ebc1-bc2"},{"id":"s-caste-certificate-sc-0","topic":"সরকারি পরিষেবা","question":"বাবার SC সার্টিফিকেট থাকলে কি আমার নতুন লাগবে?","answer":"অনেক অফিস বাবার সার্টিফিকেট সহায়ক প্রমাণ হিসেবে মানে, কিন্তু চাকরি, ভর্তি বা বৃত্তির জন্য সাধারণত প্রত্যেক আবেদনকারীর নিজের নামে সার্টিফিকেট চাওয়া হয়।","serviceTitle":"SC জাতি সার্টিফিকেট","serviceHref":"/bn/services/caste-certificate-sc"},{"id":"s-caste-certificate-sc-1","topic":"সরকারি পরিষেবা","question":"আমার জাতি অন্য রাজ্যে SC, কিন্তু আমি ঝাড়খণ্ডে থাকি?","answer":"সংবিধান (তফসিলি জাতি) আদেশ অনুযায়ী SC/ST তালিকা রাজ্য-ভিত্তিক। অন্য রাজ্যের সার্টিফিকেট ঝাড়খণ্ডের সুবিধার জন্য প্রায়ই গ্রাহ্য হয় না; আবেদনের আগে ইস্যুকারী কর্তৃপক্ষকে জিজ্ঞাসা করুন।","serviceTitle":"SC জাতি সার্টিফিকেট","serviceHref":"/bn/services/caste-certificate-sc"},{"id":"s-caste-certificate-st-0","topic":"সরকারি পরিষেবা","question":"ST সার্টিফিকেটে SC বা OBC-র চেয়ে বেশি সময় লাগতে পারে কেন?","answer":"ST যাচাইয়ে প্রায়ই পৈতৃক গ্রাম ও সম্প্রদায়ের নথি দেখা হয়, আর কিছু অঞ্চল অফিস স্থানীয় তদন্ত বা গ্রাম প্রধানের নিশ্চয়তা চায়। তাই অন্য শ্রেণির তুলনায় বেশি সময় লাগতে পারে।","serviceTitle":"ST জাতি সার্টিফিকেট","serviceHref":"/bn/services/caste-certificate-st"},{"id":"s-caste-certificate-st-1","topic":"সরকারি পরিষেবা","question":"আমার উপজাতি অন্য রাজ্যে ST। এটি কি ঝাড়খণ্ডে গ্রাহ্য?","answer":"না। ST তালিকা রাজ্য-ভিত্তিক। অন্য রাজ্যের সার্টিফিকেট সাধারণত ঝাড়খণ্ডের সংরক্ষণ সুবিধার জন্য গ্রাহ্য হয় না।","serviceTitle":"ST জাতি সার্টিফিকেট","serviceHref":"/bn/services/caste-certificate-st"},{"id":"s-marriage-registration-certificate-0","topic":"সরকারি পরিষেবা","question":"ঝাড়খণ্ডে কি বিবাহ নিবন্ধন বাধ্যতামূলক?","answer":"নিবন্ধনের জোরালো পরামর্শ দেওয়া হয় এবং পাসপোর্ট, ভিসা, ব্যাংক ও আইনি কাজে প্রায়ই প্রয়োজন হয়, বিয়ে যে রীতিতেই হোক না কেন।","serviceTitle":"বিবাহ নিবন্ধন সার্টিফিকেট","serviceHref":"/bn/services/marriage-registration-certificate"},{"id":"s-marriage-registration-certificate-1","topic":"সরকারি পরিষেবা","question":"বহু বছর আগের বিয়ে কি নিবন্ধন করা যায়?","answer":"হ্যাঁ, দেরিতে নিবন্ধন সাধারণত সম্ভব, তবে দেরির কারণ জানানো হলফনামা বা বাড়তি নথি লাগতে পারে। কী লাগবে তা নিবন্ধন কর্তৃপক্ষ ঠিক করে।","serviceTitle":"বিবাহ নিবন্ধন সার্টিফিকেট","serviceHref":"/bn/services/marriage-registration-certificate"},{"id":"s-voter-id-0","topic":"সরকারি পরিষেবা","question":"আপনারা কি ভোটার কার্ড ইস্যু করেন?","answer":"না। যাচাই ও কার্ড ইস্যু করা নির্বাচন কমিশনের কাজ। আমরা আবেদনে সাহায্য করি।","serviceTitle":"ভোটার আইডি পরিষেবা","serviceHref":"/bn/services/voter-id"},{"id":"s-passport-driving-licence-0","topic":"সরকারি পরিষেবা","question":"আপনারা কি পাসপোর্ট বা লাইসেন্স ইস্যু করেন?","answer":"না। যাচাই, টেস্ট ও ইস্যু করা সংশ্লিষ্ট কর্তৃপক্ষের কাজ।","serviceTitle":"পাসপোর্ট ও ড্রাইভিং লাইসেন্স ফর্ম","serviceHref":"/bn/services/passport-driving-licence"},{"id":"s-aeps-money-transfer-0","topic":"ব্যাংকিং ও AEPS","question":"প্রতারণা হলে কী করব?","answer":"সঙ্গে সঙ্গে নিজের ব্যাঙ্কের সঙ্গে যোগাযোগ করুন। সাইবার প্রতারণার জন্য 1930-এ ফোন করুন বা cybercrime.gov.in-এ অভিযোগ জানান।","serviceTitle":"AEPS ব্যাংকিং ও টাকা পাঠানো","serviceHref":"/bn/services/aeps-money-transfer"},{"id":"s-bike-insurance-0","topic":"বিমা","question":"বিমার কোটেশনই কি চূড়ান্ত প্রিমিয়াম?","answer":"না। চূড়ান্ত প্রিমিয়াম, যোগ্যতা, কভারেজ এবং পলিসি ইস্যু বিমা কোম্পানি ঠিক করে।","serviceTitle":"বাইক / স্কুটার বিমা","serviceHref":"/bn/services/bike-insurance"},{"id":"s-bike-insurance-1","topic":"বিমা","question":"বাইকের জন্য থার্ড-পার্টি বিমা কি বাধ্যতামূলক?","answer":"হ্যাঁ। অন্তত থার্ড-পার্টি কভার ছাড়া চালানো মোটর ভেহিকলস অ্যাক্টে অপরাধ (প্রথমবার ₹২,০০০ জরিমানা এবং/অথবা ৩ মাস পর্যন্ত কারাদণ্ড)।","serviceTitle":"বাইক / স্কুটার বিমা","serviceHref":"/bn/services/bike-insurance"},{"id":"s-car-insurance-0","topic":"বিমা","question":"NISE COMPORT কি নিজে পলিসি ইস্যু করে?","answer":"না। আমরা শুধু অনুসন্ধানে সহায়তা করি। যোগ্যতা, কভারেজ, প্রিমিয়াম ও পলিসি ইস্যু বিমা কোম্পানি ঠিক করে।","serviceTitle":"গাড়ির বিমা ও রিনিউ","serviceHref":"/bn/services/car-insurance"},{"id":"s-car-insurance-1","topic":"বিমা","question":"কমপ্রিহেনসিভ নেব না শুধু থার্ড-পার্টি?","answer":"থার্ড-পার্টি আইনি ন্যূনতম এবং শুধু অন্যের ক্ষতি পূরণ করে। কমপ্রিহেনসিভ আপনার নিজের গাড়িকেও দুর্ঘটনা, চুরি, আগুন ও বন্যা থেকে রক্ষা করে। ১০ বছরের কম পুরোনো বেশিরভাগ গাড়ির জন্য কমপ্রিহেনসিভ নেওয়াই ভালো।","serviceTitle":"গাড়ির বিমা ও রিনিউ","serviceHref":"/bn/services/car-insurance"},{"id":"s-health-life-insurance-0","topic":"বিমা","question":"আপনারা কি সুপারিশ করতে বা ক্লেমের নিশ্চয়তা দিতে পারেন?","answer":"আমরা আবেদনের প্রক্রিয়ায় সাহায্য করতে পারি, কিন্তু পলিসির উপযুক্ততা, আন্ডাররাইটিং ও ক্লেমের সিদ্ধান্ত বিমা কোম্পানির।","serviceTitle":"স্বাস্থ্য, জীবন ও ব্যক্তিগত বিমা","serviceHref":"/bn/services/health-life-insurance"},{"id":"s-scholarship-forms-0","topic":"ছাত্র ও পরীক্ষা","question":"আপনারা কি যোগ্যতা ঠিক করেন?","answer":"না। যোগ্যতা ঠিক করে সংশ্লিষ্ট দপ্তর বা প্রতিষ্ঠান। আমরা বিজ্ঞপ্তি বুঝতে ও ফর্ম পূরণ করতে সাহায্য করি।","serviceTitle":"ছাত্র, বৃত্তি ও ভর্তির ফর্ম","serviceHref":"/bn/services/scholarship-forms"},{"id":"s-exam-forms-0","topic":"ছাত্র ও পরীক্ষা","question":"ফর্মের তথ্যের দায়িত্ব কি আপনাদের?","answer":"তথ্য সঠিক হওয়ার দায়িত্ব আবেদনকারীর, তাই জমা দেওয়ার আগে আপনি নিজে প্রতিটি এন্ট্রি যাচাই করে নেন।","serviceTitle":"পরীক্ষা, নিয়োগ ও অনলাইন ফর্ম","serviceHref":"/bn/services/exam-forms"},{"id":"s-itr-gst-0","topic":"ফর্ম ও ব্যবসা","question":"এটি কি আইনি বা কর পরামর্শ?","answer":"নিয়মিত পোর্টাল সহায়তা যোগ্য কর-পেশাদারের পরামর্শের বিকল্প নয়। জটিল কর বিষয়ে পেশাদারকে দিয়ে পর্যালোচনা করিয়ে নিন।","serviceTitle":"ITR, GST ও ব্যবসার ফর্ম","serviceHref":"/bn/services/itr-gst"},{"id":"s-computer-repair-0","topic":"হার্ডওয়্যার ও PC","question":"সব কম্পিউটার ব্র্যান্ড ও যন্ত্রাংশ কি স্টকে থাকে?","answer":"প্রাপ্যতা বদলায়। সর্বশেষ উত্তরের জন্য মডেল বা প্রয়োজন জানিয়ে টিমের সঙ্গে যোগাযোগ করুন।","serviceTitle":"কম্পিউটার, প্রিন্টার ও CCTV","serviceHref":"/bn/services/computer-repair"},{"id":"s-lic-policy-0","topic":"বিমা","question":"NISE COMPORT কি আমার LIC পলিসি বদলাতে বা অনুমোদন করতে পারে?","answer":"না। আমরা উপলব্ধ পরিষেবার পথে এগোতে সাহায্য করতে পারি। পলিসি সার্ভিসিং, আন্ডাররাইটিং, ক্লেম ও সরকারি রেকর্ড LIC-র হাতে।","serviceTitle":"LIC পলিসি পরিষেবা","serviceHref":"/bn/services/lic-policy"},{"id":"s-lic-policy-1","topic":"বিমা","question":"কোন জীবন বিমা পলিসি কেনা উচিত তা কি আপনারা বলতে পারেন?","answer":"এই পেজ প্রক্রিয়ায় সহায়তা দেয়, আর্থিক পরামর্শ বা পলিসির সুপারিশ নয়। পণ্যের শর্ত LIC বা কোনও অনুমোদিত উপদেষ্টার সঙ্গে দেখে নিন।","serviceTitle":"LIC পলিসি পরিষেবা","serviceHref":"/bn/services/lic-policy"},{"id":"s-mutual-fund-sip-0","topic":"ব্যাংকিং ও AEPS","question":"NISE COMPORT কি কোনও ফান্ডের সুপারিশ বা রিটার্নের প্রতিশ্রুতি দেবে?","answer":"না। এটি শুধু প্রক্রিয়ায় সহায়তা। বিনিয়োগ বাড়তে-কমতে পারে; রিটার্নের নিশ্চয়তা নেই। কোনও অনুমোদিত আর্থিক উপদেষ্টার পরামর্শ নিন।","serviceTitle":"SIP ও মিউচুয়াল ফান্ড তথ্য","serviceHref":"/bn/services/mutual-fund-sip"},{"id":"s-mutual-fund-sip-1","topic":"ব্যাংকিং ও AEPS","question":"আমি কি আমার OTP বা বিনিয়োগ অ্যাকাউন্টের তথ্য শেয়ার করতে পারি?","answer":"OTP, পাসওয়ার্ড বা বিনিয়োগ অ্যাকাউন্টের তথ্য কখনও কর্মীদের সঙ্গে শেয়ার করবেন না। এগুলি শুধু অনুমোদিত প্রদানকারীর প্রক্রিয়ায় নিজে দিন।","serviceTitle":"SIP ও মিউচুয়াল ফান্ড তথ্য","serviceHref":"/bn/services/mutual-fund-sip"},{"id":"s-rent-agreement-0","topic":"ফর্ম ও ব্যবসা","question":"টাইপ করা চুক্তি বা NOC কি আইনি পরামর্শ?","answer":"না। নথি টাইপিং ও প্রক্রিয়া সহায়তা আইনি পরামর্শ নয়। অধিকার, দায় বা বিবাদ জড়িত থাকলে পক্ষগুলির আইনি পর্যালোচনা করানো উচিত।","serviceTitle":"ভাড়ার চুক্তি ও NOC ফর্ম","serviceHref":"/bn/services/rent-agreement"},{"id":"s-rent-agreement-1","topic":"ফর্ম ও ব্যবসা","question":"নথি গৃহীত হবে বলে কি আপনারা নিশ্চয়তা দিতে পারেন?","answer":"না। গ্রহণযোগ্যতা নির্ভর করে গ্রহণকারী প্রতিষ্ঠান এবং প্রযোজ্য আইনি বা নিবন্ধনের নিয়মের উপর।","serviceTitle":"ভাড়ার চুক্তি ও NOC ফর্ম","serviceHref":"/bn/services/rent-agreement"},{"id":"s-fssai-license-0","topic":"ফর্ম ও ব্যবসা","question":"NISE COMPORT কি FSSAI লাইসেন্স ইস্যু করতে পারে?","answer":"না। আমরা যোগ্য আবেদন প্রক্রিয়ায় সহায়তা করতে পারি। শ্রেণি, যাচাই, অনুমোদন ও ইস্যু FSSAI এবং দায়িত্বপ্রাপ্ত কর্তৃপক্ষ ঠিক করে।","serviceTitle":"FSSAI খাদ্য লাইসেন্স","serviceHref":"/bn/services/fssai-license"},{"id":"s-fssai-license-1","topic":"ফর্ম ও ব্যবসা","question":"আমার FSSAI-এর কোন শ্রেণি লাগবে?","answer":"সঠিক শ্রেণি বর্তমান নিয়ম, ব্যবসার কার্যকলাপ ও মাপের উপর নির্ভর করে। আবেদনের আগে FSSAI-এর সরকারি নির্দেশিকা দেখে নিশ্চিত হয়ে নিন।","serviceTitle":"FSSAI খাদ্য লাইসেন্স","serviceHref":"/bn/services/fssai-license"},{"id":"s-udyam-registration-0","topic":"ফর্ম ও ব্যবসা","question":"NISE COMPORT কি MSME সার্টিফিকেট ইস্যু করে?","answer":"না। উদ্যম নিবন্ধন সরকারি পোর্টালের মাধ্যমে হয়। আমরা নেভিগেশন ও প্রস্তুতিতে সাহায্য করতে পারি; নিবন্ধনের রেকর্ড পোর্টাল ইস্যু করে।","serviceTitle":"উদ্যম / MSME রেজিস্ট্রেশন","serviceHref":"/bn/services/udyam-registration"},{"id":"s-udyam-registration-1","topic":"ফর্ম ও ব্যবসা","question":"সরকারি পোর্টালে উদ্যম নিবন্ধন কি বিনামূল্যে?","answer":"সর্বশেষ শর্তের জন্য সরকারি উদ্যম পোর্টাল দেখুন। আলাদা কোনও সহায়তা চার্জ থাকলে এগোনোর আগে জানানো হবে।","serviceTitle":"উদ্যম / MSME রেজিস্ট্রেশন","serviceHref":"/bn/services/udyam-registration"},{"id":"s-jeevan-pramaan-0","topic":"সরকারি পরিষেবা","question":"পেনশনভোগীকে কি নিজে আসতেই হবে?","answer":"হ্যাঁ। অথেন্টিকেশন পেনশনভোগীকে নিজেকেই করতে হয়।","serviceTitle":"জীবন প্রমাণ (ডিজিটাল লাইফ সার্টিফিকেট)","serviceHref":"/bn/services/jeevan-pramaan"},{"id":"s-birth-death-certificate-0","topic":"সরকারি পরিষেবা","question":"21 দিন পরে কি রেজিস্ট্রেশন করা যায়?","answer":"হ্যাঁ, তবে দেরি অনুযায়ী অতিরিক্ত কাগজপত্র, ফি বা আদেশ লাগতে পারে। রেজিস্ট্রার তা ঠিক করেন।","serviceTitle":"জন্ম ও মৃত্যু সার্টিফিকেট","serviceHref":"/bn/services/birth-death-certificate"},{"id":"s-land-mutation-0","topic":"সরকারি পরিষেবা","question":"রেজিস্ট্রি হলেই কি মিউটেশন নিজে থেকে হয়ে যায়?","answer":"না। রেজিস্ট্রিতে হস্তান্তর নথিভুক্ত হয়; মিউটেশনে রাজস্ব রেকর্ড আপডেট হয়।","serviceTitle":"মিউটেশন (দাখিল-খারিজ) ও ঝাড়ভূমি","serviceHref":"/bn/services/land-mutation"},{"id":"s-aadhaar-pvc-card-0","topic":"সরকারি পরিষেবা","question":"দোকানে ছাপানো PVC কার্ড কি একই?","answer":"না। সরকারি আধার PVC কার্ড UIDAI ছাপে ও ডাকে পাঠায়। অন্য কোথাও ছাপানো কার্ড সরকারি PVC কার্ড নয়।","serviceTitle":"আধার PVC কার্ড অর্ডার","serviceHref":"/bn/services/aadhaar-pvc-card"},{"id":"s-aadhaar-pvc-card-1","topic":"সরকারি পরিষেবা","question":"আমার ঠিকানা পুরোনো। কী করব?","answer":"আগে ঠিকানা আপডেট করান, তারপর PVC কার্ড অর্ডার করুন, কারণ কার্ড রেকর্ডে থাকা ঠিকানায় যায়।","serviceTitle":"আধার PVC কার্ড অর্ডার","serviceHref":"/bn/services/aadhaar-pvc-card"},{"id":"s-bank-account-opening-0","topic":"ব্যাংকিং ও AEPS","question":"NISE COMPORT কি অ্যাকাউন্ট খোলে?","answer":"না। সহযোগী ব্যাংক অ্যাকাউন্ট খোলে ও চালায়। যেখানে উপলব্ধ, আমরা তার বিজনেস করেসপন্ডেন্ট পয়েন্ট হিসেবে প্রক্রিয়ায় সাহায্য করি।","serviceTitle":"ব্যাংক অ্যাকাউন্ট খোলা","serviceHref":"/bn/services/bank-account-opening"},{"id":"s-bank-account-opening-1","topic":"ব্যাংকিং ও AEPS","question":"ন্যূনতম ব্যালেন্স কি রাখতে হয়?","answer":"নিয়ম অ্যাকাউন্টের ধরন অনুযায়ী আলাদা এবং ব্যাংক ঠিক করে। আবেদনের আগে আমরা ব্যাংকের বর্তমান শর্ত বুঝিয়ে দিই।","serviceTitle":"ব্যাংক অ্যাকাউন্ট খোলা","serviceHref":"/bn/services/bank-account-opening"},{"id":"s-ayushman-card-0","topic":"সরকারি পরিষেবা","question":"কারা আয়ুষ্মান কার্ড পেতে পারেন?","answer":"যোগ্যতার তালিকাভুক্ত পরিবার, এবং ৭০ বছর বা তার বেশি বয়সী প্রত্যেক ব্যক্তি, আয় যাই হোক। শুরুর আগে আমরা আপনার জন্য তালিকা যাচাই করে নিই।","serviceTitle":"আয়ুষ্মান কার্ড ও আভা","serviceHref":"/bn/services/ayushman-card"},{"id":"s-ayushman-card-1","topic":"সরকারি পরিষেবা","question":"কার্ড কি একই দিনে পাওয়া যায়?","answer":"পরিবার আগে থেকেই যোগ্য হলে এবং যাচাই ঠিকঠাক চললে কার্ড প্রায়ই তাড়াতাড়ি তৈরি হয়ে যায়। কিছু কার্ডের অনুমোদন লাগে, তাতে কয়েকদিন সময় লাগতে পারে।","serviceTitle":"আয়ুষ্মান কার্ড ও আভা","serviceHref":"/bn/services/ayushman-card"},{"id":"s-ration-card-0","topic":"সরকারি পরিষেবা","question":"নতুন রেশন কার্ড হতে কতদিন লাগে?","answer":"এটি বিভাগের যাচাইয়ের উপর নির্ভর করে। আমরা প্রাপ্তিস্বীকার নম্বর দিই এবং আপনার হয়ে অবস্থা দেখে থাকি।","serviceTitle":"রেশন কার্ড আবেদন ও সংশোধন","serviceHref":"/bn/services/ration-card"},{"id":"s-ration-card-1","topic":"সরকারি পরিষেবা","question":"আমার নবজাতক সন্তানের নাম কি যোগ করা যায়?","answer":"হ্যাঁ। শিশুর জন্ম সার্টিফিকেট, আধার হয়ে থাকলে সেটি, এবং বিদ্যমান রেশন কার্ড নিয়ে আসুন।","serviceTitle":"রেশন কার্ড আবেদন ও সংশোধন","serviceHref":"/bn/services/ration-card"},{"id":"s-abua-awas-yojana-0","topic":"সরকারি পরিষেবা","question":"NISE COMPORT কি আবাসন আবেদন অনুমোদন করে?","answer":"না। নির্বাচন ও অনুমোদন ঝাড়খণ্ড সরকার করে। আমরা আপনার আবেদন সম্পূর্ণ করে তুলতে সাহায্য করি।","serviceTitle":"আবুয়া আবাস যোজনা","serviceHref":"/bn/services/abua-awas-yojana"},{"id":"s-abua-awas-yojana-1","topic":"সরকারি পরিষেবা","question":"আমার আয়ের সার্টিফিকেট না থাকলে?","answer":"আমরা আগে আয়ের সার্টিফিকেটের আবেদন করতে পারি। আয়ের হলফনামা ও পরিচয়ের প্রমাণ সঙ্গে আনুন।","serviceTitle":"আবুয়া আবাস যোজনা","serviceHref":"/bn/services/abua-awas-yojana"},{"id":"s-laptop-repair-0","topic":"হার্ডওয়্যার ও PC","question":"মেরামতের সময় কি আমার ডেটা নিরাপদ থাকবে?","answer":"ল্যাপটপ দেওয়ার আগে অনুগ্রহ করে ফাইলের ব্যাকআপ নিয়ে নিন। স্ক্রিন বা ব্যাটারি বদলের মতো অনেক মেরামতে ডেটায় হাত পড়ে না, তবে প্রতিটি ত্রুটির ক্ষেত্রে আমরা তার নিশ্চয়তা দিতে পারি না।","serviceTitle":"ল্যাপটপ মেরামত","serviceHref":"/bn/services/laptop-repair"},{"id":"s-laptop-repair-1","topic":"হার্ডওয়্যার ও PC","question":"আমি আনুমানিক খরচ অনুমোদনের আগেই কি আপনারা কাজ শুরু করেন?","answer":"না। আমরা আগে আপনার সঙ্গে কাজের পরিধি ও আনুমানিক খরচ ঠিক করি।","serviceTitle":"ল্যাপটপ মেরামত","serviceHref":"/bn/services/laptop-repair"},{"id":"s-laptop-repair-2","topic":"হার্ডওয়্যার ও PC","question":"কি আসল যন্ত্রাংশ লাগানো হয়?","answer":"এটি মডেল ও প্রাপ্যতার উপর নির্ভর করে। যন্ত্রাংশ লাগানোর আগে আমরা জানাই কোনটি প্রস্তাব করা হচ্ছে।","serviceTitle":"ল্যাপটপ মেরামত","serviceHref":"/bn/services/laptop-repair"},{"id":"s-desktop-repair-0","topic":"হার্ডওয়্যার ও PC","question":"আপনারা কি আমার প্রয়োজন অনুযায়ী পিসি বানিয়ে দিতে পারেন?","answer":"আপনার বাজেট ও ব্যবহার (পড়াশোনা, অফিস বা গেমিং) নিয়ে কথা বলে আমরা কনফিগারেশন সুপারিশ করতে পারি। যন্ত্রাংশের প্রাপ্যতা ও দাম কেনার সময় নিশ্চিত হয়।","serviceTitle":"ডেস্কটপ ও PC মেরামত","serviceHref":"/bn/services/desktop-repair"},{"id":"s-desktop-repair-1","topic":"হার্ডওয়্যার ও PC","question":"পিসি মেরামতে কি আমার ডেটা নিরাপদ থাকবে?","answer":"পিসি দেওয়ার আগে জরুরি ফাইলের ব্যাকআপ নিয়ে নিন। খারাপ হতে থাকা ড্রাইভের ডেটার নিশ্চয়তা আমরা দিতে পারি না।","serviceTitle":"ডেস্কটপ ও PC মেরামত","serviceHref":"/bn/services/desktop-repair"},{"id":"s-website-creation-0","topic":"প্রিন্ট ও ডিজিটাল","question":"ওয়েবসাইটের মালিক কে হবেন?","answer":"আপনি। কাজ শুরুর আগে আমরা ডোমেন ও হোস্টিংয়ের মালিকানা লিখিতভাবে আপনার সঙ্গে নিশ্চিত করি।","serviceTitle":"ওয়েবসাইট তৈরি","serviceHref":"/bn/services/website-creation"},{"id":"s-website-design-0","topic":"প্রিন্ট ও ডিজিটাল","question":"আপনারা কি সার্চ র‍্যাঙ্কিংয়ের নিশ্চয়তা দিতে পারেন?","answer":"না। কোনও সেবাদাতাই নির্দিষ্ট র‍্যাঙ্কিংয়ের নিশ্চয়তা দিতে পারে না। সার্চে দেখা যাওয়া প্রতিযোগিতা, উপযোগী বিষয়বস্তু, প্রযুক্তিগত মান ও ব্যবসার ধারাবাহিক সংকেতের উপর নির্ভর করে।","serviceTitle":"দোকানের ওয়েবসাইট ও ডিজিটাল সহায়তা","serviceHref":"/bn/services/website-design"},{"id":"s-photo-studio-0","topic":"প্রিন্ট ও ডিজিটাল","question":"আপনারা কি আমার ছবি বা পোস্টার A4, A3 বা A2-তে প্রিন্ট করতে পারেন?","answer":"হ্যাঁ। ছবি আপনার ফোন, পেন ড্রাইভ বা মেমোরি কার্ডে নিয়ে আসুন, সাইজ ও কপির সংখ্যা জানান; প্রিন্টের আগে আমরা চার্জ জানাই। পরিষ্কার ফলের জন্য ফাইলটি ওই সাইজের জন্য যথেষ্ট বড় হতে হবে।","serviceTitle":"ফটো স্টুডিও ও পাসপোর্ট ছবি","serviceHref":"/bn/services/photo-studio"},{"id":"s-photo-studio-1","topic":"প্রিন্ট ও ডিজিটাল","question":"আমার ছবি কি কোনও আবেদনে গ্রহণ করা হবে?","answer":"গ্রহণের নিশ্চয়তা আমরা দিতে পারি না। আসার আগে আপনার ফর্ম বা কর্তৃপক্ষের সর্বশেষ ছবির নিয়ম দেখে নিন; আমরা সেগুলি মেলাতে সাহায্য করব।","serviceTitle":"ফটো স্টুডিও ও পাসপোর্ট ছবি","serviceHref":"/bn/services/photo-studio"},{"id":"s-photo-studio-2","topic":"প্রিন্ট ও ডিজিটাল","question":"অনলাইন ফর্মের জন্য ছবিতে কি সাহায্য করেন?","answer":"আপনি যে নিয়ম জানাবেন সেই অনুযায়ী আমরা ছবি তুলতে ও সাইজ করে দিতে পারি। আসার আগে শর্তগুলি নিশ্চিত করে নিন।","serviceTitle":"ফটো স্টুডিও ও পাসপোর্ট ছবি","serviceHref":"/bn/services/photo-studio"},{"id":"s-printer-repair-0","topic":"হার্ডওয়্যার ও PC","question":"ওয়ারেন্টির মধ্যে থাকা প্রিন্টার কি আপনারা মেরামত করতে পারেন?","answer":"ওয়ারেন্টির মেরামত সাধারণত প্রস্তুতকারকের সার্ভিস সেন্টার থেকে হয়। মডেল জানান; কিছু খোলার আগে আমরা পথটি বুঝিয়ে দেব।","serviceTitle":"প্রিন্টার মেরামত","serviceHref":"/bn/services/printer-repair"},{"id":"s-printer-repair-1","topic":"হার্ডওয়্যার ও PC","question":"আপনারা কি প্রিন্টার Wi-Fi-তে সেট করে দেন?","answer":"হ্যাঁ, নেটওয়ার্ক সেটআপ আমাদের প্রিন্টার অনুসন্ধানের অংশ। জিজ্ঞাসার সময় মডেল ও নেটওয়ার্কের বিবরণ জানান।","serviceTitle":"প্রিন্টার মেরামত","serviceHref":"/bn/services/printer-repair"},{"id":"s-data-recovery-0","topic":"হার্ডওয়্যার ও PC","question":"হারানো প্রতিটি ফাইল কি ফেরত পাওয়া যায়?","answer":"না। ফল নির্ভর করে কারণ ও ডিভাইসের অবস্থার উপর, এবং আমরা রিকভারির প্রতিশ্রুতি দিতে পারি না।","serviceTitle":"ডেটা রিকভারি","serviceHref":"/bn/services/data-recovery"},{"id":"s-data-recovery-1","topic":"হার্ডওয়্যার ও PC","question":"আমি কি ড্রাইভ ব্যবহার চালিয়ে যাব?","answer":"না। ব্যবহার চালিয়ে গেলে হারানো ডেটা ওভাররাইট হয়ে যেতে পারে। থামুন এবং আগে আমাদের সঙ্গে যোগাযোগ করুন।","serviceTitle":"ডেটা রিকভারি","serviceHref":"/bn/services/data-recovery"},{"id":"s-pc-build-0","topic":"হার্ডওয়্যার ও PC","question":"কেনার আগে কি দাম জানাবেন?","answer":"হ্যাঁ। আপনি কিছু অনুমোদনের আগে আমরা প্রতিটি যন্ত্রাংশের সর্বশেষ দাম ও মোট অঙ্ক জানাই।","serviceTitle":"কাস্টম PC বিল্ড কোটেশন","serviceHref":"/bn/services/pc-build"},{"id":"s-pc-build-1","topic":"হার্ডওয়্যার ও PC","question":"কম বাজেটে কি পিসি বানানো যায়?","answer":"হ্যাঁ। আপনার বাজেট জানান; তার মধ্যে সবচেয়ে ভালো পারফরম্যান্স দেয় এমন বিকল্প আমরা সুপারিশ করব।","serviceTitle":"কাস্টম PC বিল্ড কোটেশন","serviceHref":"/bn/services/pc-build"},{"id":"s-hardware-quote-0","topic":"হার্ডওয়্যার ও PC","question":"এই পেজে কি দাম নির্দিষ্ট?","answer":"না। দাম প্রায়ই বদলায়, তাই কেনার আগে আমরা WhatsApp-এ সর্বশেষ দাম নিশ্চিত করি।","serviceTitle":"হার্ডওয়্যার পার্টস কোটেশন","serviceHref":"/bn/services/hardware-quote"},{"id":"s-hardware-quote-1","topic":"হার্ডওয়্যার ও PC","question":"আমি কি শুধু একটি জিনিস কিনতে পারি?","answer":"হ্যাঁ। একটি জিনিসও চলবে; অনুরোধ একই থাকে।","serviceTitle":"হার্ডওয়্যার পার্টস কোটেশন","serviceHref":"/bn/services/hardware-quote"},{"id":"s-software-upgrade-0","topic":"হার্ডওয়্যার ও PC","question":"আমার ফাইল কি থেকে যাবে?","answer":"আমরা আগে ব্যাকআপ নেওয়ার পরামর্শ দিই। পুরোনো বা খারাপ হতে থাকা ডিভাইসের ডেটার নিশ্চয়তা আমরা দিতে পারি না।","serviceTitle":"সফটওয়্যার আপগ্রেড","serviceHref":"/bn/services/software-upgrade"},{"id":"s-hardware-upgrade-0","topic":"হার্ডওয়্যার ও PC","question":"সব ল্যাপটপেই কি আপগ্রেড হয়?","answer":"সবগুলিতে নয়। কিছু ল্যাপটপে মেমোরি সোল্ডার করা থাকে। কিছু কেনার আগে আমরা আপনার মডেল দেখে নিই।","serviceTitle":"হার্ডওয়্যার আপগ্রেড","serviceHref":"/bn/services/hardware-upgrade"},{"id":"s-coreldraw-design-0","topic":"প্রিন্ট ও ডিজিটাল","question":"আপনারা কি ডিজাইনটি প্রিন্টও করে দিতে পারেন?","answer":"হ্যাঁ। আমরা এটি আমাদের ডেস্কে প্রিন্ট করতে পারি বা প্রিন্ট-রেডি ফাইল দিতে পারি যাতে আপনি অন্য কোথাও প্রিন্ট করাতে পারেন।","serviceTitle":"CorelDRAW ডিজাইন, ব্যানার ও পোস্টার","serviceHref":"/bn/services/coreldraw-design"},{"id":"s-custom-printing-0","topic":"প্রিন্ট ও ডিজিটাল","question":"আপনারা কোন কোন জিনিসে প্রিন্ট করতে পারেন?","answer":"আপনার মনে যা আছে তা জানান; আমরা নিশ্চিত করব কী প্রিন্ট করা সম্ভব।","serviceTitle":"কাস্টম প্রিন্টিং","serviceHref":"/bn/services/custom-printing"},{"id":"s-printing-scanning-0","topic":"প্রিন্ট ও ডিজিটাল","question":"ফাইল কি আপলোড করতে হবে?","answer":"না। আগে দাম জিজ্ঞেস করুন, তারপর ফাইল ফোনে বা পেন ড্রাইভে আনুন, অথবা দাম ঠিক হলে WhatsApp-এ পাঠান।","serviceTitle":"প্রিন্টিং, স্ক্যানিং ও ফটোকপি","serviceHref":"/bn/services/printing-scanning"}],"topics":["আমাদের সম্পর্কে","আমাদের কাছে আসা","ফি ও পেমেন্ট","অনুরোধ ও ট্র্যাকিং","অ্যাকাউন্ট ও গোপনীয়তা","প্রিন্টিং ও নথি","সরকারি পরিষেবা","ব্যাংকিং ও AEPS","বিমা","ছাত্র ও পরীক্ষা","ফর্ম ও ব্যবসা","হার্ডওয়্যার ও PC","প্রিন্ট ও ডিজিটাল"],"lang":"bn"}]}],"$L15"]}],null,"$L16"]}],"p":"$@17","v":null,"s":"$6"}}]]
