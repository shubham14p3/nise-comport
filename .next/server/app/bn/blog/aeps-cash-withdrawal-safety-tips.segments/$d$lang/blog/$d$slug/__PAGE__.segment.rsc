18:["$","div",null,{"className":"article-layout","children":[["$","div",null,{"children":[[["$","p","0",{"children":"আধার এনেবলড পেমেন্ট সিস্টেম (AEPS) দিয়ে আপনি আধার নম্বর ও আঙুলের ছাপ ব্যবহার করে ব্যাংকিং করেসপন্ডেন্ট কেন্দ্রে নগদ তুলতে বা ব্যালান্স দেখতে পারেন। ব্যাংক শাখা বা ATM দূরে থাকলে এটি কাজের, তবে সতর্কতা দরকার।"}],["$","p","1",{"children":"প্রমাণীকরণের আগে ঠিক যত টাকা চান সেই অঙ্ক বলুন, তা লেখা হচ্ছে কি না দেখুন এবং স্ক্রিনে ব্যাংকের নাম মিলিয়ে নিন। লেনদেনের পর ছাপা বা SMS রসিদ নিন এবং কাউন্টার ছাড়ার আগে নগদ গুনে নিন।"}]],[["$","section","আপনার বায়োমেট্রিক সুরক্ষিত রাখুন",{"children":[["$","h2",null,{"children":"আপনার বায়োমেট্রিক সুরক্ষিত রাখুন"}],[["$","p","0",{"children":"UIDAI তার সরকারি ওয়েবসাইট বা অ্যাপে আপনাকে আধার বায়োমেট্রিক লক করতে এবং দরকার হলেই আনলক করতে দেয়। অনেকে এগুলি লক করে রাখেন এবং AEPS লেনদেনের ঠিক আগে আনলক করেন।"}]]]}],["$","section","কিছু গোলমাল মনে হলে",{"children":[["$","h2",null,{"children":"কিছু গোলমাল মনে হলে"}],[["$","p","0",{"children":"টাকা কেটে গেলেও না পেলে, বা এমন লেনদেন দেখলে যা আপনি করেননি, রসিদ বা SMS নিয়ে তখনই আপনার ব্যাংকের সঙ্গে যোগাযোগ করুন। জালিয়াতির ক্ষেত্রে জাতীয় সাইবার ক্রাইম হেল্পলাইন 1930-এ ফোন করতে পারেন বা cybercrime.gov.in-এ অভিযোগ জানাতে পারেন।"}]]]}]],["$","h2",null,{"children":"শুরু করার আগে"}],["$","ul",null,{"children":[["$","li","অঙ্ক বলুন এবং তা লেখা হচ্ছে কি না দেখুন",{"children":[["$","$L16",null,{"icon":{"name":"check","size":24,"node":[["path",{"d":"M20 6 9 17l-5-5","key":"1gmf2c"}]]},"size":16}],"অঙ্ক বলুন এবং তা লেখা হচ্ছে কি না দেখুন"]}],["$","li","স্ক্রিনে ব্যাংকের নাম ও অঙ্ক মিলিয়ে নিন",{"children":[["$","$L16",null,{"icon":"$18:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"স্ক্রিনে ব্যাংকের নাম ও অঙ্ক মিলিয়ে নিন"]}],["$","li","রসিদ নিন এবং কাউন্টারেই নগদ গুনে নিন",{"children":[["$","$L16",null,{"icon":"$18:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"রসিদ নিন এবং কাউন্টারেই নগদ গুনে নি