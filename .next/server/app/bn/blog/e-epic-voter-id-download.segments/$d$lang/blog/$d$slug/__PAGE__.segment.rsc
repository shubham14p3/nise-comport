18:["$","div",null,{"className":"article-layout","children":[["$","div",null,{"children":[[["$","p","0",{"children":"e-EPIC হল ইলেক্টরস ফটো আইডেন্টিটি কার্ডের (ভোটার আইডি) ডিজিটাল, ডাউনলোডযোগ্য রূপ। ভারতের নির্বাচন কমিশন ভোটার্স সার্ভিস পোর্টাল ও তার অ্যাপের মাধ্যমে এটি ইস্যু করে।"}],["$","p","1",{"children":"ডাউনলোড করতে আপনি পোর্টালে সাইন ইন করেন, EPIC নম্বর বা ফর্মের রেফারেন্স নম্বর দেন এবং আপনার ভোটার রেকর্ডের সঙ্গে যুক্ত মোবাইল নম্বরে আসা OTP দিয়ে নিশ্চিত করেন। মোবাইল নম্বর লিঙ্ক না থাকলে পোর্টাল আগে যাচাই সম্পূর্ণ করতে বা আপনার তথ্য আপডেট করতে বলতে পারে।"}]],[["$","section","আপনার তথ্য ভুল থাকলে",{"children":[["$","h2",null,{"children":"আপনার তথ্য ভুল থাকলে"}],[["$","p","0",{"children":"তথ্য ঠিক থাকলে তবেই e-EPIC ডাউনলোড করুন। ভুল ঠিক করতে ভোটার্স সার্ভিস পোর্টালের সংশোধন ফর্ম ব্যবহার করুন, তারপর সংশোধন অনুমোদিত হলে e-EPIC ডাউনলোড করুন।"}]]]}]],["$","h2",null,{"children":"শুরু করার আগে"}],["$","ul",null,{"children":[["$","li","EPIC নম্বর বা ফর্মের রেফারেন্স নম্বর তৈরি রাখুন",{"children":[["$","$L16",null,{"icon":{"name":"check","size":24,"node":[["path",{"d":"M20 6 9 17l-5-5","key":"1gmf2c"}]]},"size":16}],"EPIC নম্বর বা ফর্মের রেফারেন্স নম্বর তৈরি রাখুন"]}],["$","li","ভোটার রেকর্ডের সঙ্গে যুক্ত মোবাইল নম্বর ব্যবহার করুন",{"children":[["$","$L16",null,{"icon":"$18:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"ভোটার রেকর্ডের সঙ্গে যুক্ত মোবাইল নম্বর ব্যবহার করুন"]}],["$","li","ডাউনলোডের আগে ভুল সংশোধন করুন",{"children":[["$","$L16",null,{"icon":"$18:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"ডাউনলোডের আগে ভুল সংশোধন করুন"]}],["$","li","শুধু সরকারি পোর্টাল বা অ্যাপ থেকে ডাউনলোড করুন",{"children":[["$","$L16",null,{"icon":"$18:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"শুধু সরকারি পোর্টাল বা অ্যাপ থেকে ডাউনলোড করুন"]}]]}],[["$","h2",null,{"children":"সরকারি উৎস"}],["$","$L29",null,{"variant":"list","links":[{"label":"Voters’ Service Portal (ECI)","href":"https://voters.eci.gov.in/"}],"service":{"slug":"voter-id","title":"Voter ID (EPIC) Application & Correction","documents":["For new registration (Form 6): Aadhaar number (or a declaration if you don't have one), a recent passport-size colour photo on a white background (4.5cm x 3.5cm), age proof (birth certificate, 10th marksheet or similar), current address proof, mobile number for OTP, and the name/relation of a parent or spouse already on the roll if available","For correction/shifting/replacement (Form 8): existing EPIC number, Aadhaar number, proof of the new detail being corrected (address proof for shifting, age/name proof for a correction), and a recent photo","For overseas electors (Form 6A): valid Indian passport, current visa details, proof of the Indian address last ordinarily resided at, and a recent passport-size photo","Disability marking (optional, Form 8): a disability certificate, if you want it recorded"]}}]],["$","p",null,{"className":"article-disclaimer","children":"শর্ত বদলাতে পারে। যোগ্যতা, ফি, প্রক্রিয়া ও চূড়ান্ত ফল সংশ্লিষ্ট সরকারি বিভাগ, বিমা কোম্পানি, প্রতিষ্ঠান বা পরিষেবা প্রদানকারী ঠিক করে। NISE COMPORT একটি স্বাধীন CSC / প্রজ্ঞা কেন্দ্র সেবা কেন্দ্র, সরকারি অফিস নয়।"}]]}],["$","aside",null,{"children":[["$","strong",null,{"children":"এ বিষয়ে সাহায্য লাগবে?"}],["$","p",null,{"children":"খরংগাঝাড়, টেলকো, জামশেদপুরে NISE COMPORT টিমের সঙ্গে কথা বলুন। ফোন করুন +91 97712 19893।"}],["$","$L15",null,{"className":"button button-green","href":"/bn/services/voter-id","children":["ভোটার আইডি পরিষেবা"," ",["$","$L16",null,{"icon":{"name":"arrow-up-right","size":24,"node":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]]},"size":15}]]}],["$","a",null,{"href":"https://wa.me/919771219893?text=*NISE%20COMPORT*%20%C2%B7%20Kharangajhar%2C%20Telco%2C%20Jamshedpur%0AHi%20NISE%20COMPORT%2C%20I%20read%20your%20guide%20%22%E0%A6%A1%E0%A6%BF%E0%A6%9C%E0%A6%BF%E0%A6%9F%E0%A6%BE%E0%