18:["$","div",null,{"className":"article-layout","children":[["$","div",null,{"children":[[["$","p","0",{"children":"বিবাহ সার্টিফিকেট পাসপোর্ট, ভিসা, ব্যাংক ও বিমার নমিনেশন এবং নাম বদলের জন্য গ্রহণযোগ্য প্রমাণ। ঝাড়খণ্ড তার নাগরিক পরিষেবা পোর্টালের মাধ্যমে অনলাইন নিবন্ধন দেয়। সঠিক নথি ও অ্যাপয়েন্টমেন্টের ধাপ প্রযোজ্য বিবাহ আইনের ওপর নির্ভর করে, তাই পোর্টালে নিশ্চিত করুন।"}],["$","p","1",{"children":"শিগগিরই পাসপোর্ট বা ভিসার আবেদন করার পরিকল্পনা থাকলে আগে থেকে প্রস্তুতি নিন, কারণ যাচাইয়ে সময় লাগতে পারে।"}]],[["$","section","সাধারণত যে নথি লাগে",{"children":[["$","h2",null,{"children":"সাধারণত যে নথি লাগে"}],[["$","p","0",{"children":"দুই সঙ্গীর পরিচয় ও ঠিকানার প্রমাণ, বয়সের প্রমাণ যেমন জন্ম সার্টিফিকেট বা স্কুল সার্টিফিকেট, পাসপোর্ট সাইজ ছবি, যেখানে চাওয়া হয় সেখানে বিয়ের নিমন্ত্রণপত্র বা অনুষ্ঠানের অন্য প্রমাণ, এবং সাক্ষীদের তথ্য।"}]]]}],["$","section","প্রক্রিয়া কীভাবে চলে",{"children":[["$","h2",null,{"children":"প্রক্রিয়া কীভাবে চলে"}],[["$","p","0",{"children":"আপনি অনলাইনে আবেদন জমা দেন, নথি আপলোড করেন এবং দেওয়া তারিখে সাক্ষীদের নিয়ে উপস্থিত হতে হতে পারে। যাচাইয়ের পর সার্টিফিকেট ডাউনলোড করা যায়। আমরা ফর্ম, নথির স্ক্যান ও ট্র্যাকিংয়ে সাহায্য করি।"}]]]}]],["$","h2",null,{"children":"শুরু করার আগে"}],["$","ul",null,{"children":[["$","li","দুই সঙ্গীর পরিচয়, ঠিকানা ও বয়সের প্রমাণ জোগাড় করুন",{"children":[["$","$L16",null,{"icon":{"name":"check","size":24,"node":[["path",{"d":"M20 6 9 17l-5-5","key":"1gmf2c"}]]},"size":16}],"দুই সঙ্গীর পরিচয়, ঠিকানা ও বয়সের প্রমাণ জোগাড় করুন"]}],["$","li","পাসপোর্ট সাইজ ছবি ও সাক্ষীর ব্যবস্থা করুন",{"children":[["$","$L16",null,{"icon":"$18:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"পাসপোর্ট সাইজ ছবি ও সাক্ষীর ব্যবস্থা করুন"]}],["$","li","সরকারি পোর্টালে আবেদন জমা দিন",{"children":[["$","$L16",null,{"icon":"$18:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"সরকারি পোর্টালে আবেদন জমা দিন"]}],["$","li","ডাকা হলে যাচাইয়ে উপস্থিত থাকুন",{"children":[["$","$L16",null,{"icon":"$18:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"ডাকা হলে যাচাইয়ে উপস্থিত থাকুন"]}],["$","li","সার্টিফিকেট ডাউনলোড করে প্রিন্ট করুন",{"children":[["$","$L16",null,{"icon":"$18:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"সার্টিফিকেট ডাউনলোড করে প্রিন্ট করুন"]}]]}],[["$","h2",null,{"children":"সরকারি উৎস"}],["$","$L28",null,{"variant":"list","links":[{"label":"JharSewa – Jharkhand citizen services","href":"https://serviceonline.gov.in/jharkhand/"}],"service":{"slug":"marriage-registration-certificate","title":"Marriage Registration Certificate","documents":["Aadhaar card of both husband and wife","Age proof for both (birth certificate, 10th marksheet or similar) — minimum age 21 for the groom and 18 for the bride","Address proof for both spouses","Marriage invitation card or photographs from the marriage ceremony","Affidavit stating the date and place of marriage, and that both parties are unmarried/divorced/widowed as applicable","Recent joint passport-size photograph of the couple","Name, address and ID proof of two witnesses present at the marriage","Mobile number and email for OTP and status updates"]}}]],["$","p",null,{"className":"article-disclaimer","children":"শর্ত বদলাতে পারে। যোগ্যতা, ফি, প্রক্রিয়া ও চূড়ান্ত ফল সংশ্লিষ্ট সরকারি বিভাগ, বিমা কোম্পানি, প্রতিষ্ঠান বা পরিষেবা প্রদানকারী ঠিক করে। NISE COMPORT একটি স্বাধীন CSC / প্রজ্ঞা কেন্দ্র সেবা কেন্দ্র, সরকারি অফিস নয়।"}]]}],["$","aside",null,{"children":[["$","strong",null,{"children":"এ বিষয়ে সাহায্য লাগবে?"}],["$","p",null,{"children":"খরংগাঝাড়, টেলকো, জামশেদপুরে NISE COMPORT টিমের সঙ্গে কথা বলুন। ফোন করুন +91 97712 19893।"}],["$","$L15",null,{"className":"button button-green","href":"/bn/services/marriage-registration-certificate","children":["বিবাহ নিবন্ধন সার্টিফিকেট"," ",["$","$L16",null,{"icon":{"name":"arrow-up-right","size":24,"node":[["path",