18:["$","div",null,{"className":"article-layout","children":[["$","div",null,{"children":[[["$","p","0",{"children":"আগে কাগজপত্র জোগাড় করে নিলে আয়কর রিটার্ন ফাইল করা সহজ হয়। ফর্ম ও শেষ তারিখ আয়কর বিভাগ প্রতি বছর ঠিক করে, তাই ফাইল করার আগে সবসময় সরকারি পোর্টালে বর্তমান নিয়ম দেখুন।"}],["$","p","1",{"children":"বেশিরভাগ নোটিস আসে আপনার রিটার্ন এবং বিভাগের কাছে আগে থেকে থাকা তথ্যের, যেমন সুদের আয় বা TDS-এর অমিল থেকে। ফাইলের আগে আপনার বার্ষিক বিবরণী দেখে নিলে সুবিধা হয়।"}]],[["$","section","যে নথি আনবেন",{"children":[["$","h2",null,{"children":"যে নথি আনবেন"}],[["$","p","0",{"children":"প্যান ও আধার (লিঙ্ক করা), বেতনভোগী হলে ফর্ম 16, ব্যাংক স্টেটমেন্ট ও সুদের সার্টিফিকেট, বিনিয়োগ ও কর ছাড়ের তথ্য, প্রযোজ্য হলে বাড়িভাড়ার রসিদ, এবং ব্যবসার আয়ের জন্য আপনার খাতা বা আয়-ব্যয়ের সারসংক্ষেপ।"}]]]}],["$","section","ফাইল করার আগে",{"children":[["$","h2",null,{"children":"ফাইল করার আগে"}],[["$","p","0",{"children":"আয় ও কাটা করের জন্য আপনার বার্ষিক তথ্য বিবরণী ও ফর্ম 26AS দেখুন। নিশ্চিত করুন আপনার ব্যাংক অ্যাকাউন্ট রিফান্ডের জন্য আগে থেকে যাচাই (প্রি-ভ্যালিডেটেড) করা আছে।"}]]]}],["$","section","ফাইল করার পর",{"children":[["$","h2",null,{"children":"ফাইল করার পর"}],[["$","p","0",{"children":"অনুমোদিত সময়ের মধ্যে রিটার্ন ই-ভেরিফাই করুন (আধার OTP, নেট ব্যাংকিং বা অন্য বিকল্প) এবং প্রাপ্তিস্বীকার সেভ করুন।"}]]]}]],["$","h2",null,{"children":"শুরু করার আগে"}],["$","ul",null,{"children":[["$","li","প্যান ও আধার লিঙ্ক করুন",{"children":[["$","$L16",null,{"icon":{"name":"check","size":24,"node":[["path",{"d":"M20 6 9 17l-5-5","key":"1gmf2c"}]]},"size":16}],"প্যান ও আধার লিঙ্ক করুন"]}],["$","li","ফর্ম 16 ও ব্যাংকের সুদের সার্টিফিকেট জোগাড় করুন",{"children":[["$","$L16",null,{"icon":"$18:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"ফর্ম 16 ও ব্যাংকের সুদের সার্টিফিকেট জোগাড় করুন"]}],["$","li","বার্ষিক তথ্য বিবরণী দেখুন",{"children":[["$","$L16",null,{"icon":"$18:props:children:0:props:children:3:props:children:0:props:children