18:["$","$L2b",null,{"className":"article-cover","src":"/images/service/aadhaar.png","alt":"আধার PVC কার্ড অর্ডারের নির্দেশনা","width":1200,"height":720,"priority":true,"sizes":"(max-width: 900px) 100vw, 800px"}]
19:["$","div",null,{"className":"article-layout","children":[["$","div",null,{"children":[[["$","p","0",{"children":"আধার PVC কার্ড হল আপনার আধারের নিরাপত্তা বৈশিষ্ট্যযুক্ত, মানিব্যাগে রাখার মতো প্লাস্টিক রূপ। সরকারি কার্ড UIDAI থেকে অর্ডার করতে হয়, UIDAI-ই ছাপে এবং আপনার আধার রেকর্ডে থাকা ঠিকানায় ডাকে পাঠায়।"}],["$","p","1",{"children":"UIDAI-এর myAadhaar ওয়েবসাইট থেকে অর্ডার করুন। আধার নম্বর দিন, OTP দিয়ে নিশ্চিত করুন, প্রিভিউ দেখুন, সরকারি পাতায় দেখানো ফি দিন এবং ট্র্যাকিংয়ের জন্য সার্ভিস রিকোয়েস্ট নম্বর (SRN) নিন।"}]],[["$","section","আগে আপনার ঠিকানা দেখুন",{"children":[["$","h2",null,{"children":"আগে আপনার ঠিকানা দেখুন"}],[["$","p","0",{"children":"কার্ড আপনার আধারে থাকা ঠিকানায় পাঠানো হয়। আপনি অন্য জায়গায় চলে গেলে আগে ঠিকানা আপডেট করুন এবং আপডেট সম্পূর্ণ হওয়ার পর PVC কার্ড অর্ডার করুন।"}]]]}],["$","section","সরকারি কার্ড বনাম দোকানের প্রিন্টআউট",{"children":[["$","h2",null,{"children":"সরকারি কার্ড বনাম দোকানের প্রিন্টআউট"}],[["$","p","0",{"children":"ডাউনলোড করা ই-আধার থেকে দোকানে ছাপা প্লাস্টিক কার্ড সরকারি PVC কার্ড নয়। UIDAI থেকে ডাউনলোড করা ই-আধার PDF নিজেই বৈধ; আধার ব্যবহারের জন্য প্লাস্টিক কপি লাগে না।"}]]]}]],["$","h2",null,{"children":"শুরু করার আগে"}],["$","ul",null,{"children":[["$","li","আধারের ঠিকানা হালনাগাদ আছে কি না নিশ্চিত করুন",{"children":[["$","$L16",null,{"icon":{"name":"check","size":24,"node":[["path",{"d":"M20 6 9 17l-5-5","key":"1gmf2c"}]]},"size":16}],"আধারের ঠিকানা হালনাগাদ আছে কি না নিশ্চিত করুন"]}],["$","li","শুধু UIDAI-এর সরকারি ওয়েবসাইটে অর্ডার করুন",{"children":[["$","$L16",null,{"icon":"$19:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"শুধু UIDAI-এর সরকারি ওয়েবসাইটে অর্ডার করুন"]}],["$","li","সরকারি পাতায় দেখানো ফি-ই দিন",{"children":[["$","$L16",null,{"icon":"$19:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"সরকারি পাতায় দেখানো ফি-ই দিন"]}],["$","li","SRN সেভ করুন এবং অর্ডার ও ডাক ট্র্যাক করুন",{"children":[["$","$L