1a:["$","div",null,{"className":"article-layout","children":[["$","div",null,{"children":[[["$","p","0",{"children":"ঝাড়খণ্ডে ড্রাইভিং লাইসেন্সের আবেদন জাতীয় পরিবহন সারথি পোর্টালে অনলাইনে হয়। আপনি লার্নার লাইসেন্স (LL) দিয়ে শুরু করেন, যা নিয়মে দেওয়া শর্তে অনুশীলনের অনুমতি দেয়, এবং পরে স্থায়ী ড্রাইভিং লাইসেন্সের (DL) জন্য আবেদন করেন।"}],["$","p","1",{"children":"সারথিতে আপনি ঝাড়খণ্ড বেছে নেন, আবেদন পূরণ করেন, নথি আপলোড করেন, ফি অনলাইনে দেন এবং যেখানে পোর্টাল সুবিধা দেয় সেখানে লার্নার পরীক্ষা অনলাইনে দেন, বা আপনার জেলা পরিবহন অফিসে স্লট বুক করেন।"}]],[["$","section","লার্নার পরীক্ষার আগে",{"children":[["$","h2",null,{"children":"লার্নার পরীক্ষার আগে"}],[["$","p","0",{"children":"পরীক্ষায় ট্রাফিক চিহ্ন, সড়কের নিয়ম ও নিরাপদ ড্রাইভিং থেকে প্রশ্ন আসে। সারথি অনুশীলনের উপকরণ দেয়। আপনার আবেদন নম্বর ও রসিদ একসঙ্গে রাখুন।"}]]]}],["$","section","স্থায়ী লাইসেন্সে যাওয়া",{"children":[["$","h2",null,{"children":"স্থায়ী লাইসেন্সে যাওয়া"}],[["$","p","0",{"children":"স্থায়ী ড্রাইভিং লাইসেন্সের জন্য সাধারণত লার্নার লাইসেন্সের 30 দিন পূর্ণ হওয়ার পর এবং মেয়াদ শেষ হওয়ার আগে আবেদন করা যায়। সারথিতে ড্রাইভিং টেস্ট বুক করুন এবং পরিবহন অফিসের চাহিদা অনুযায়ী উপযুক্ত যানবাহন নিয়ে যান।"}]]]}]],["$","h2",null,{"children":"শুরু করার আগে"}],["$","ul",null,{"children":[["$","li","সরকারি সারথি পোর্টালে আবেদন করুন এবং ঝাড়খণ্ড বেছে নিন",{"children":[["$","$L16",null,{"icon":{"name":"check","size":24,"node":[["path",{"d":"M20 6 9 17l-5-5","key":"1gmf2c"}]]},"size":16}],"সরকারি সারথি পোর্টালে আবেদন করুন এবং ঝাড়খণ্ড বেছে নিন"]}],["$","li","বয়স ও ঠিকানার প্রমাণ তৈরি রাখুন",{"children":[["$","$L16",null,{"icon":"$1a:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"বয়স ও ঠিকানার প্রমাণ তৈরি রাখুন"]}],["$","li","আবেদন নম্বর ও পেমেন্টের রসিদ সেভ করুন",{"children":[["$","$L16",null,{"icon":"$1a:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"আবেদন নম্বর ও পেমেন্টের রসিদ সেভ করুন"]}],["$","li","3