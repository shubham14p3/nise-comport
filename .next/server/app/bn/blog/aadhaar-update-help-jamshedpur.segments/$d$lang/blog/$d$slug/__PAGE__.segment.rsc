1a:["$","div",null,{"className":"article-layout","children":[["$","div",null,{"children":[[["$","p","0",{"children":"আধার আপডেটের বিকল্প ও শর্ত পরিবর্তনের ধরনের ওপর নির্ভর করে। কিছু অনুরোধ অনলাইনে করা যেতে পারে, আর বায়োমেট্রিক বা অন্য পরিবর্তনের জন্য অনুমোদিত কেন্দ্রে যেতে হয়। রওনা দেওয়ার আগে UIDAI-এর বর্তমান প্রক্রিয়া দেখে নিন, আর আপনার OTP বা পুরো লগইন তথ্য কাউকে দেবেন না।"}],["$","p","1",{"children":"NISE COMPORT সঠিক সরকারি পথ চিনতে ও চেকলিস্ট বানাতে সাহায্য করতে পারে। আমরা আধার রেকর্ড বদলাতে পারি না এবং অনুমোদনের নিশ্চয়তা দিতে পারি না; অনুরোধের প্রক্রিয়া করে সংশ্লিষ্ট কর্তৃপক্ষ। প্রাপ্তিস্বীকার স্লিপ রাখুন, যাতে সরকারি মাধ্যমে অবস্থা দেখতে পারেন।"}]],"$undefined",["$","h2",null,{"children":"শুরু করার আগে"}],["$","ul",null,{"children":[["$","li","ঠিক কোন তথ্য বা আপডেট দরকার তা ঠিক করুন",{"children":[["$","$L16",null,{"icon":{"name":"check","size":24,"node":[["path",{"d":"M20 6 9 17l-5-5","key":"1gmf2c"}]]},"size":16}],"ঠিক কোন তথ্য বা আপডেট দরকার তা ঠিক করুন"]}],["$","li","UIDAI-এর বর্তমান সরকারি নির্দেশ দেখুন",{"children":[["$","$L16",null,{"icon":"$1a:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"UIDAI-এর বর্তমান সরকারি নির্দেশ দেখুন"]}],["$","li","যেখানে দরকার সেখানে সহায়ক নথির আসল কপি আনুন",{"children":[["$","$L16",null,{"icon":"$1a:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"যেখানে দরকার সেখানে সহায়ক নথির আসল কপি আনুন"]}],["$","li","OTP কখনও শেয়ার করবেন না; সরকারি প্রাপ্তিস্বীকার রাখুন",{"children":[["$","$L16",null,{"icon":"$1a:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"OTP কখনও শেয়ার করবেন না; সরকারি প্রাপ্তিস্বীকার রাখুন"]}]]}],[["$","h2",null,{"children":"সরকারি উৎস"}],["$","$L2b",null,{"variant":"list","links":[{"label":"UIDAI – updating data on Aadhaar","href":"https://uidai.gov.in/en/updating-data-on-aadhaar"},{"label":"UIDAI enrolment & update charges (PDF)","href":"https://uidai.gov.in/images/Aa