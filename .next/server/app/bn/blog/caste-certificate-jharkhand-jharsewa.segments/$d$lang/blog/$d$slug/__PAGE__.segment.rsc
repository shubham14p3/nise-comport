18:["$","$L2a",null,{"className":"article-cover","src":"/images/blog/certificate.png","alt":"ঝাড়খণ্ড জাতি সার্টিফিকেট আবেদন চেকলিস্ট","width":1200,"height":720,"priority":true,"sizes":"(max-width: 900px) 100vw, 800px"}]
19:["$","div",null,{"className":"article-layout","children":[["$","div",null,{"children":[[["$","p","0",{"children":"ঝাড়খণ্ডে জাতি সার্টিফিকেটের জন্য রাজ্যের ই-ডিস্ট্রিক্ট পোর্টাল JharSewa-তে অনলাইনে আবেদন করতে হয়, এবং আপনার সার্কেলের (অঞ্চল) রাজস্ব আধিকারিকেরা তা যাচাই করে ইস্যু করেন। শিক্ষা, স্কলারশিপ, চাকরি ও কল্যাণমূলক প্রকল্পে এই সার্টিফিকেট বহুল ব্যবহৃত।"}],["$","p","1",{"children":"যাচাই স্থানীয় স্তরে হয়, তাই আপনার দেওয়া তথ্য আপনার রেকর্ডের সঙ্গে হুবহু মিলতে হবে: আবেদনকারীর নাম, বাবার নাম, ঠিকানা এবং পারিবারিক নথিতে লেখা জাতি। দেরির সবচেয়ে সাধারণ কারণ এই অমিলগুলি।"}]],[["$","section","আবেদনে সাধারণত কী চাওয়া হয়",{"children":[["$","h2",null,{"children":"আবেদনে সাধারণত কী চাওয়া হয়"}],[["$","p","0",{"children":"অনলাইন ফর্মে সাধারণত পরিচয় ও ঠিকানার বিবরণ, পারিবারিক তথ্য, স্ব-ঘোষণা এবং আপনার ক্ষেত্র অনুযায়ী সহায়ক রেকর্ড, যেমন কোনও আত্মীয়ের জাতি সার্টিফিকেট বা জমির রেকর্ড (খতিয়ান) চাওয়া হয়। শুরুর আগে অবশ্যই JharSewa-তে বর্তমান চেকলিস্ট দেখুন, কারণ শর্ত বদলাতে পারে।"}]]]}],["$","section","আবেদনের পর",{"children":[["$","h2",null,{"children":"আবেদনের পর"}],[["$","p","0",{"children":"আবেদন নম্বর লিখে রাখুন। JharSewa-তে তা দিয়ে অবস্থা দেখুন এবং অনুমোদিত হলে সার্টিফিকেট ডাউনলোড করুন। অফিস আরও তথ্য চাইলে দ্রুত উত্তর দিন, নইলে আবেদন বন্ধ হয়ে যেতে পারে।"}]]]}]],["$","h2",null,{"children":"শুরু করার আগে"}],["$","ul",null,{"children":[["$","li","JharSewa-তে বর্তমান চেকলিস্ট দেখুন",{"children":[["$","$L16",null,{"icon":{"name":"check","size":24,"node":[["path",{"d":"M20 6 9 17l-5-5","key":"1gmf2c"}]]},"size":16}],"JharSewa-তে বর্তমান চেকলিস্ট দেখুন"]}],["$","li","সব নথিতে নাম এক রাখুন",{"children":[["$","$L16",null,{"icon":"$19:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"সব নথিতে নাম এক রাখুন"]}],["$","li","সহায়ক পারিবারিক বা জমির রেকর্ড তৈরি রাখুন",{"children":[["$","$L16",null,{"icon":"$19:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"সহায়ক পারিবারিক বা জমির রেকর্ড তৈরি রাখুন"]}],["$","li","আবেদন নম্বর সেভ করুন এবং JharSewa-তে ট্র্যাক করুন",{"children":[["$","$L16",null,{"icon":"$19:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"আবেদন নম্বর সেভ করুন এবং JharSewa-তে ট্র্যাক করুন"]}]]}],[["$","h2",null,{"children":"সরকারি উৎস"}],["$","$L2b",null,{"variant":"list","links":[{"label":"JharSewa (Jharkhand e-District)","href":"https://jharsewa.jharkhand.gov.in/"}],"service":{"slug":"income-caste-residence-certificate","title":"Income Certificate Application Help (Jharkhand)","documents":["Applicant's Aadhaar card","Self-declaration / income affidavit stating annual family income and source (salary, business, agriculture, etc.)","Ration card, if available","Residence proof (voter ID, electricity bill or rent agreement)","Salary slip or employer certificate for salaried applicants; land records (khatiyan/rent receipt) for agricultural income","Bank passbook front page","Recent passport-size photograph","Mobile number for OTP and SMS status updates","Parent's/guardian's name and relation, as asked on the form"]}}]],["$","p",null,{"className":"article-disclaimer","children":"শর্ত বদলাতে পারে। যোগ্যতা, ফি, প্রক্রিয়া ও চূড়ান্ত ফল সংশ্লিষ্ট সরকারি বিভাগ, বিমা কোম্পানি, প্রতিষ্ঠান বা পরিষেবা প্রদানকারী ঠিক করে। NISE COMPORT একটি স্বাধীন CSC / প্রজ্ঞা কেন্দ্র সেবা কেন্দ্র, সরকারি অফিস নয়।"}]]}],["$","aside",null,{"children":[["$","strong",null,{"children":"এ বিষয়ে সাহায্য লাগবে?"}],["$","p",null,{"children":"খরংগাঝাড়, টেলকো, জামশেদপুরে NISE COMPORT টিমের সঙ্গে কথা বলুন। ফোন করুন +91 97712 19893।"}],["$","$L15",null,{"className":"button button-green","href":"/bn/services/income-caste-residence-certificate","children":["আয় সার্টিফিকেট"," ",["$","$L16",null,{"icon":{"name":"arrow-up-right","size":24,"node":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]]},"size":15}]]}],["$","a",null,{"href":"https://wa.me/919771219893?text=*NISE%20COMPORT*%20%C2%B7%