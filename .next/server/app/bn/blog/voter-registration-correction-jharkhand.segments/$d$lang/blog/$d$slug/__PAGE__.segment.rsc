17:["$","$L27",null,{"className":"article-cover","src":"/images/blog/voter.png","alt":"ঝাড়খণ্ডে ভোটার নিবন্ধন ও সংশোধন: পর্যালোচনা চেকলিস্ট","width":1200,"height":720,"priority":true,"sizes":"(max-width: 900px) 100vw, 800px"}]
18:["$","div",null,{"className":"article-layout","children":[["$","div",null,{"children":[[["$","p","0",{"children":"ভোটার পরিষেবায় নানা ধরনের অনুরোধ থাকে, যেমন নতুন নিবন্ধন, সংশোধন বা ঠিকানা বদল। নির্বাচন কমিশনের বর্তমান নির্দেশ অনুযায়ী সঠিক অনুরোধ বেছে নিন। ভুল ফর্ম বাছলে প্রক্রিয়া ধীর হতে পারে।"}],["$","p","1",{"children":"আবেদনকারীর বয়স, ঠিকানা ও সহায়ক নথি সরকারি শর্তের সঙ্গে মিলিয়ে দেখুন। যাচাই এবং ভোটার তালিকার রক্ষণাবেক্ষণ করে নির্বাচন কর্তৃপক্ষ; NISE COMPORT অনলাইন ফর্ম চালাতে ও প্রাপ্তিস্বীকারে সাহায্য করতে পারে। জমা দেওয়ার আগে পূরণ করা তথ্য নিজেও দেখে নিন।"}]],"$undefined",["$","h2",null,{"children":"শুরু করার আগে"}],["$","ul",null,{"children":[["$","li","সঠিক নিবন্ধন বা সংশোধনের অনুরোধ বেছে নিন",{"children":[["$","$L16",null,{"icon":{"name":"check","size":24,"node":[["path",{"d":"M20 6 9 17l-5-5","key":"1gmf2c"}]]},"size":16}],"সঠিক নিবন্ধন বা সংশোধনের অনুরোধ বেছে নিন"]}],["$","li","যোগ্যতা ও ঠিকানার প্রমাণের শর্ত দেখুন",{"children":[["$","$L16",null,{"icon":"$18:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"যোগ্যতা ও ঠিকানার প্রমাণের শর্ত দেখুন"]}],["$","li","জমা দেওয়ার আগে সব এন্ট্রি যাচাই করুন",{"children":[["$","$L16",null,{"icon":"$18:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"জমা দেওয়ার আগে সব এন্ট্রি যাচাই করুন"]}],["$","li","সরকারি ফলো-আপের জন্য রেফারেন্স নম্বর রাখুন",{"children":[["$","$L16",null,{"icon":"$18:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"সরকারি ফলো-আপের জন্য রেফারেন্স নম্বর রাখুন"]}]]}],[["$","h2",null,{"children":"সরকারি উৎস"}],["$","$L28",null,{"variant":"list","links":[{"label":"Voters’ Service Portal (ECI)","href":"https://voters.eci.gov.in/"}],"service":{"slug":"voter-id","title":"Voter ID (EPIC) Application & Correction","documents":["For new registration (Form 6): Aadhaar number (or a declaration if you don't have one), a recent passport-size colour photo on a white background (4.5cm x 3.5cm), age proof (birth certificate, 10th marksheet or similar), current address proof, mobile number for OTP, and the name/relation of a parent or spouse already on the roll if available","For correction/shifting/replacement (Form 8): existing EPIC number, Aadhaar number, proof of the new detail being corrected (address proof for shifting, age/name proof for a correction), and a recent photo","For overseas electors (Form 6A): valid Indian passport, current visa details, proof of the Indian address last ordinarily resided at, and a recent passport-size photo","Disability marking (optional, Form 8): a disability certificate, if you want it recorded"]}}]],["$","p",null,{"className":"article-disclaimer","children":"শর্ত বদলাতে পারে। যোগ্যতা, ফি, প্রক্রিয়া ও চূড়ান্ত ফল সংশ্লিষ্ট সরকারি বিভাগ, বিমা কোম্পানি, প্রতিষ্ঠান বা পরিষেবা প্রদানকারী ঠিক করে। NISE COMPORT একটি স্বাধীন CSC / প্রজ্ঞা কেন্দ্র সেবা কেন্দ্র, সরকারি অফিস নয়।"}]]}],["$","aside",null,{"children":[["$","strong",null,{"children":"এ বিষয়ে সাহায্য লাগবে?"}],["$","p",null,{"children":"খরংগাঝাড়, টেলকো, জামশেদপুরে NISE COMPORT টিমের সঙ্গে কথা বলুন। ফোন করুন +91 97712 19893।"}],["$","$L15",null,{"className":"button button-green","href":"/bn/services/voter-id","children":["ভোটার আইডি পরিষেবা"," ",["$","$L16",null,{"icon":{"name":"arrow-up-right","size":24,"node":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]]},"size":15}]]}],["$","a",null,{"href":"https://wa.me/919771219893?text=*NISE%20COMPORT*%20%C2%B7%20Kharangajhar%2C%20Telco%2C%20Jamshedpur%0AHi%20NISE%20COMPORT%2C%20I%20read%20your%20guide%20%22%E0%A6%9D%E0%A6%BE%E0%A6%A1%E0%A6%BC%E0%A6%96%E0%A6%A3%E0%A7%8D%E0%A6%A1%E0%A7%87%20%E0%A6%AD%E0%A7%8B%E0%A6%9F%E0%A6%BE%E0%A6%B0%20%E0%A6%A8%E0%A6%BF%E0%A6%AC%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A6%A8%20%E0%A6%93%20%E0%A6%B8%E0%A6%82%E0%A6%B6%E0%A7%8B%E0%A6%A7%E0%A6%A8%3A%20%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%B2%E0%A7%8B%E0%A6%9A%E0%A6%A8%E0%A6%BE%