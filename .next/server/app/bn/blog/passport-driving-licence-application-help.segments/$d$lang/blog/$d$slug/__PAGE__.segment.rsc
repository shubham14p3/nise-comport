19:["$","$L2c",null,{"className":"article-cover","src":"/images/blog/passport.png","alt":"পাসপোর্ট ও ড্রাইভিং লাইসেন্সের আবেদন: বুকিংয়ের আগে প্রস্তুতি নিন","width":1200,"height":720,"priority":true,"sizes":"(max-width: 900px) 100vw, 800px"}]
1a:["$","div",null,{"className":"article-layout","children":[["$","div",null,{"children":[[["$","p","0",{"children":"পাসপোর্ট ও ড্রাইভিং লাইসেন্সের অনুরোধ আলাদা আলাদা সরকারি প্রক্রিয়ায় চলে। শর্ত আবেদনের ধরন, রাজ্য, বয়স এবং ইস্যুকারী কর্তৃপক্ষের বর্তমান নিয়ম অনুযায়ী বদলাতে পারে। ফি দেওয়া বা অ্যাপয়েন্টমেন্ট নেওয়ার আগে সরকারি চেকলিস্ট পড়ে নিন।"}],["$","p","1",{"children":"নিশ্চিত করুন আপনার নাম, ঠিকানা ও জন্ম তারিখ সহায়ক রেকর্ডের সঙ্গে মেলে। NISE COMPORT অনলাইন ফর্ম পূরণ ও অ্যাপয়েন্টমেন্টের ধাপ বোঝাতে সাহায্য করতে পারে, কিন্তু অ্যাপয়েন্টমেন্ট, পরীক্ষা, যাচাই ও ইস্যু সংশ্লিষ্ট কর্তৃপক্ষের হাতে।"}]],"$undefined",["$","h2",null,{"children":"শুরু করার আগে"}],["$","ul",null,{"children":[["$","li","আবেদনের ধরন ও বর্তমান সরকারি শর্ত নিশ্চিত করুন",{"children":[["$","$L16",null,{"icon":{"name":"check","size":24,"node":[["path",{"d":"M20 6 9 17l-5-5","key":"1gmf2c"}]]},"size":16}],"আবেদনের ধরন ও বর্তমান সরকারি শর্ত নিশ্চিত করুন"]}],["$","li","সব ব্যক্তিগত তথ্য আসল রেকর্ডের সঙ্গে মিলিয়ে নিন",{"children":[["$","$L16",null,{"icon":"$1a:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"সব ব্যক্তিগত তথ্য আসল রেকর্ডের সঙ্গে মিলিয়ে নিন"]}],["$","li","অ্যাপয়েন্টমেন্ট ও পেমেন্টের জন্য সরকারি পোর্টাল ব্যবহার করুন",{"children":[["$","$L16",null,{"icon":"$1a:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"অ্যাপয়েন্টমেন্ট ও পেমেন্টের জন্য সরকারি পোর্টাল ব্যবহার করুন"]}],["$","li","প্রাপ্তিস্বীকার, অ্যাপয়েন্টমেন্ট ও রসিদের বিবরণ রাখুন",{"children":[["$","$L16",null,{"icon":"$1a:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"প্রাপ্তিস্বীকার, অ্যাপয়েন্টমেন্ট ও রসিদের বিবরণ রাখুন"]}]]}],[["$","h2",null,{"children":"সরকারি উৎস"}],["$","$L2d",null,{"variant":"list","links":[{"label":"Passport Seva","href":"https://www.passportindia.gov.in/"},{"label":"Parivahan Sarathi (licences)","href":"https://sarathi.parivahan.gov.in/"}],"service":{"slug":"pass