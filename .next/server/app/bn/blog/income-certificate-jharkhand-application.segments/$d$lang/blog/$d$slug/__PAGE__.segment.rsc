19:["$","div",null,{"className":"article-layout","children":[["$","div",null,{"children":[[["$","p","0",{"children":"আয়ের সার্টিফিকেটের প্রক্রিয়ায় সংশ্লিষ্ট ঝাড়খণ্ড কর্তৃপক্ষের নির্দিষ্ট করা তথ্য ও প্রমাণ লাগে। শর্ত বদলাতে পারে, তাই আবেদনের আগে বর্তমান তালিকা দেখে নিন। পরিবার ও আয়ের তথ্য সাবধানে গুছিয়ে রাখুন এবং নিশ্চিত করুন সহায়ক রেকর্ড পড়ার মতো পরিষ্কার।"}],["$","p","1",{"children":"সেবা কেন্দ্র ফর্ম চালাতে ও জমা দিতে সাহায্য করতে পারে, কিন্তু যোগ্যতা প্রমাণ করতে বা অনুমোদনের সময়সীমা নিয়ন্ত্রণ করতে পারে না। রেফারেন্স নম্বর রাখুন এবং সরকারি পথে অবস্থা দেখুন।"}]],"$undefined",["$","h2",null,{"children":"শুরু করার আগে"}],["$","ul",null,{"children":[["$","li","দপ্তরের বর্তমান নির্দেশ নিশ্চিত করুন",{"children":[["$","$L16",null,{"icon":{"name":"check","size":24,"node":[["path",{"d":"M20 6 9 17l-5-5","key":"1gmf2c"}]]},"size":16}],"দপ্তরের বর্তমান নির্দেশ নিশ্চিত করুন"]}],["$","li","পরিবার ও আয়ের তথ্য সঠিকভাবে তৈরি রাখুন",{"children":[["$","$L16",null,{"icon":"$19:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"পরিবার ও আয়ের তথ্য সঠিকভাবে তৈরি রাখুন"]}],["$","li","প্রয়োজনীয় ফরম্যাটে পরিষ্কার প্রমাণ আপলোড করুন",{"children":[["$","$L16",null,{"icon":"$19:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"প্রয়োজনীয় ফরম্যাটে পরিষ্কার প্রমাণ আপলোড করুন"]}],["$","li","প্রাপ্তিস্বীকার দিয়ে আবেদনের অবস্থা দেখতে থাকুন",{"children":[["$","$L16",null,{"icon":"$19:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"প্রাপ্তিস্বীকার দিয়ে আবেদনের অবস্থা দেখতে থাকুন"]}]]}],[["$","h2",null,{"children":"সরকারি উৎস"}],["$","$L2a",null,{"variant":"list","links":[{"label":"JharSewa (Jharkhand e-District)","href":"https://jharsewa.jharkhand.gov.in/"}],"service":{"slug":"income-caste-residence-certificate","title":"Income Certificate Application Help (Jharkhand)","documents":["Applicant's Aadhaar card","Self-declaration / income affidavit stating an