19:["$","div",null,{"className":"article-layout","children":[["$","div",null,{"children":[[["$","p","0",{"children":"উদ্যম নিবন্ধন আপনার ব্যবসাকে ক্ষুদ্র, ছোট বা মাঝারি উদ্যোগ হিসেবে স্বীকৃতি দেয়। এটি সরকারি পোর্টালে বিনামূল্যে এবং আপনার আধার ও প্যান ব্যবহার করে। ব্যবসার ঋণ বা ভর্তুকির আবেদনে অনেক ব্যাংক ও প্রকল্প এটি চায়।"}],["$","p","1",{"children":"এটি GST নিবন্ধন বা ট্রেড লাইসেন্সের মতো নয়। সেগুলিও লাগবে কি না তা নির্ভর করে আপনার টার্নওভার, পণ্য বা পরিষেবা এবং স্থানীয় নিয়মের ওপর।"}]],[["$","section","কী লাগবে",{"children":[["$","h2",null,{"children":"কী লাগবে"}],[["$","p","0",{"children":"মালিকের আধার (OTP-র জন্য যুক্ত মোবাইল সহ), প্যান, ব্যবসার নাম ও ঠিকানা, ব্যাংক অ্যাকাউন্টের তথ্য, ব্যবসার ধরন, এবং বিনিয়োগ ও টার্নওভারের আনুমানিক অঙ্ক।"}]]]}],["$","section","কীভাবে কাজ করে",{"children":[["$","h2",null,{"children":"কীভাবে কাজ করে"}],[["$","p","0",{"children":"নিবন্ধন সরকারি উদ্যম পোর্টালে হয়, যা স্থায়ী নম্বর সহ একটি সার্টিফিকেট ইস্যু করে। কোনও সরকারি ফি নেই। আমরা সঠিকভাবে পূরণ করতে ও সার্টিফিকেট ডাউনলোড করতে সাহায্য করি; আমাদের সেবা চার্জ আগে জানানো হয়।"}]]]}],["$","section","পরে",{"children":[["$","h2",null,{"children":"পরে"}],[["$","p","0",{"children":"সার্টিফিকেট রেখে দিন এবং তথ্য বা ব্যবসার কার্যকলাপ বদলালে পোর্টাল হালনাগাদ করুন। ব্যাংকের প্রকল্পে আবেদনের সময় এই নম্বর ব্যবহার করুন।"}]]]}]],["$","h2",null,{"children":"শুরু করার আগে"}],["$","ul",null,{"children":[["$","li","আধার ও প্যান তৈরি রাখুন",{"children":[["$","$L16",null,{"icon":{"name":"check","size":24,"node":[["path",{"d":"M20 6 9 17l-5-5","key":"1gmf2c"}]]},"size":16}],"আধার ও প্যান তৈরি রাখুন"]}],["$","li","ব্যাংক অ্যাকাউন্টের তথ্য রাখুন",{"children":[["$","$L16",null,{"icon":"$19:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"ব্যাংক অ্যাকাউন্টের তথ্য রাখুন"]}],["$","li","আপনার ব্যবসার কার্যকলাপ সঠিকভাবে বর্ণনা করুন",{"children":[["$","$L16",null,{"icon":"$19:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","siz