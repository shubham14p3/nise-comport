1a:["$","div",null,{"className":"article-layout","children":[["$","div",null,{"children":[[["$","p","0",{"children":"মিউটেশন, যাকে দাখিল-খারিজও বলে, বিক্রি, দান, উত্তরাধিকার বা ভাগাভাগির পর ভূমি রাজস্ব রেকর্ডে নতুন মালিকের নাম তোলে। ঝাড়খণ্ডে আবেদন Jharbhoomi পোর্টালে অনলাইনে করা যায় এবং সার্কেল অফিস তা যাচাই করে।"}],["$","p","1",{"children":"শুধু নিবন্ধিত দলিলে রাজস্ব রেকর্ড হালনাগাদ হয় না। মিউটেশন ছাড়া জমির খাজনা দেওয়া, কিছু সার্টিফিকেট পাওয়া বা পরে জমি বিক্রি করা কঠিন হতে পারে।"}]],[["$","section","আবেদনের আগে এগুলি প্রস্তুত রাখুন",{"children":[["$","h2",null,{"children":"আবেদনের আগে এগুলি প্রস্তুত রাখুন"}],[["$","p","0",{"children":"নিবন্ধিত দলিল বা হস্তান্তরের অন্য নথি, প্লটের বিবরণ (মৌজা, খাতা ও প্লট নম্বর), আবেদনকারীর পরিচয়ের প্রমাণ এবং আগের কোনও খাজনার রসিদ। উত্তরাধিকারের ক্ষেত্রে অফিসের চাহিদা অনুযায়ী বৈধ উত্তরাধিকারীদের দেখানো নথি রাখুন।"}]]]}]],["$","h2",null,{"children":"শুরু করার আগে"}],["$","ul",null,{"children":[["$","li","নিবন্ধিত দলিল ও প্লটের বিবরণ তৈরি রাখুন",{"children":[["$","$L16",null,{"icon":{"name":"check","size":24,"node":[["path",{"d":"M20 6 9 17l-5-5","key":"1gmf2c"}]]},"size":16}],"নিবন্ধিত দলিল ও প্লটের বিবরণ তৈরি রাখুন"]}],["$","li","Jharbhoomi-তে অনলাইনে আবেদন করুন এবং কেস নম্বর লিখে রাখুন",{"children":[["$","$L16",null,{"icon":"$1a:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"Jharbhoomi-তে অনলাইনে আবেদন করুন এবং কেস নম্বর লিখে রাখুন"]}],["$","li","সার্কেল অফিসের কোনও নোটিস এলে উত্তর দিন",{"children":[["$","$L16",null,{"icon":"$1a:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"সার্কেল অফিসের কোনও নোটিস এলে উত্তর দিন"]}],["$","li","মিউটেশন অনুমোদিত হলে হালনাগাদ রেকর্ড দেখুন",{"children":[["$","$L16",null,{"icon":"$1a:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"মিউটেশন অনুমোদিত হলে হালনাগাদ রেকর্ড দেখুন"]}]]}],[["$","h2",null,{"children":"সরকারি উৎস"}],["$","$L2c",null,{"variant":"list","l