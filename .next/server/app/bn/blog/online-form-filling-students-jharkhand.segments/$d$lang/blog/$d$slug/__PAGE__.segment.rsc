18:["$","div",null,{"className":"article-layout","children":[["$","div",null,{"children":[[["$","p","0",{"children":"সরকারি বিজ্ঞপ্তি দিয়ে শুরু করুন। তথ্য দেওয়ার আগে আবেদনকারীর শ্রেণি, যোগ্যতা, শেষ তারিখ এবং নথির ফরম্যাট নিশ্চিত করুন। পরিষ্কার চেকলিস্ট থাকলে ছাত্ররা শেষ মুহূর্তের সমস্যা এড়াতে পারে, যেমন নামে অমিল, মেয়াদ-উত্তীর্ণ নথি বা সইয়ের ফাইল না থাকা।"}],["$","p","1",{"children":"জমা দেওয়া তথ্যের সঠিকতার দায় ছাত্র বা অভিভাবকের। NISE COMPORT জামশেদপুরে ফর্ম চালানো ও আপলোড তৈরিতে সাহায্য করতে পারে; যোগ্যতা ঠিক করে এবং চূড়ান্ত সিদ্ধান্ত নেয় প্রতিষ্ঠান বা দপ্তর।"}]],"$undefined",["$","h2",null,{"children":"শুরু করার আগে"}],["$","ul",null,{"children":[["$","li","বর্তমান সরকারি বিজ্ঞপ্তি ও শেষ তারিখ পড়ুন",{"children":[["$","$L16",null,{"icon":{"name":"check","size":24,"node":[["path",{"d":"M20 6 9 17l-5-5","key":"1gmf2c"}]]},"size":16}],"বর্তমান সরকারি বিজ্ঞপ্তি ও শেষ তারিখ পড়ুন"]}],["$","li","বলা ফাইল ফরম্যাটে পরিষ্কার স্ক্যান তৈরি রাখুন",{"children":[["$","$L16",null,{"icon":"$18:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"বলা ফাইল ফরম্যাটে পরিষ্কার স্ক্যান তৈরি রাখুন"]}],["$","li","নাম, স্কুল ও ব্যাংকের বিবরণ মন দিয়ে দেখুন",{"children":[["$","$L16",null,{"icon":"$18:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"নাম, স্কুল ও ব্যাংকের বিবরণ মন দিয়ে দেখুন"]}],["$","li","চূড়ান্ত ফর্ম ও প্রাপ্তিস্বীকার সেভ করুন",{"children":[["$","$L16",null,{"icon":"$18:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"চূড়ান্ত ফর্ম ও প্রাপ্তিস্বীকার সেভ করুন"]}]]}],null,["$","p",null,{"className":"article-disclaimer","children":"শর্ত বদলাতে পারে। যোগ্যতা, ফি, প্রক্রিয়া ও চূড়ান্ত ফল সংশ্লিষ্ট সরকারি বিভাগ, বিমা কোম্পানি, প্রতিষ্ঠান বা পরিষেবা প্রদানকারী ঠিক করে। NISE COMPORT একটি স্বাধীন CSC / প্রজ্ঞা কেন্দ্র সেবা কেন্দ্র, সরকারি অফিস নয়।"}]]}],["$","aside",null,{"children":[["$","strong",null,{"children":"এ বিষয়ে সাহায্য লাগবে?"}]