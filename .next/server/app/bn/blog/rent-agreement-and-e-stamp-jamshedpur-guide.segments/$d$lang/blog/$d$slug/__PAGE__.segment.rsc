18:["$","div",null,{"className":"article-layout","children":[["$","div",null,{"children":[[["$","p","0",{"children":"লিখিত ভাড়ার চুক্তি বাড়িওয়ালা ও ভাড়াটে দুজনকেই সুরক্ষা দেয়। ব্যাংক, গ্যাস সংযোগ ও অনেক অফিস এটি ঠিকানার প্রমাণ হিসেবেও চায়। স্ট্যাম্প শুল্ক ও নিবন্ধনের নিয়ম ভাড়ার অঙ্ক ও মেয়াদের ওপর নির্ভর করে, তাই সই করার আগে নিশ্চিত করুন আপনার চুক্তিতে কী প্রযোজ্য।"}],["$","p","1",{"children":"আমরা স্পষ্ট খসড়া তৈরি ও প্রিন্ট করতে সাহায্য করি, কিন্তু আমরা আইনি সংস্থা নই। বেশি মূল্যের বা দীর্ঘমেয়াদি লিজের জন্য আইনজীবীর পরামর্শ নিন।"}]],[["$","section","এতে কী থাকা উচিত",{"children":[["$","h2",null,{"children":"এতে কী থাকা উচিত"}],[["$","p","0",{"children":"বাড়িওয়ালা ও ভাড়াটের নাম ও ঠিকানা, সম্পত্তির ঠিকানা, ভাড়া ও জামানতের অঙ্ক, মেয়াদ, নোটিস সময়, রক্ষণাবেক্ষণ ও ইউটিলিটি বিল কে দেবে, এবং চুক্তি শেষ করার শর্ত।"}]]]}],["$","section","কী আনবেন",{"children":[["$","h2",null,{"children":"কী আনবেন"}],[["$","p","0",{"children":"দুই পক্ষের পরিচয় ও ঠিকানার প্রমাণ, পাসপোর্ট সাইজ ছবি, সম্পত্তির তথ্য এবং ঠিক হওয়া শর্ত। দুই পক্ষকে এবং কখনও সাক্ষীদেরও সই করতে হয়।"}]]]}]],["$","h2",null,{"children":"শুরু করার আগে"}],["$","ul",null,{"children":[["$","li","ভাড়া, জামানত ও মেয়াদ লিখিতভাবে ঠিক করুন",{"children":[["$","$L16",null,{"icon":{"name":"check","size":24,"node":[["path",{"d":"M20 6 9 17l-5-5","key":"1gmf2c"}]]},"size":16}],"ভাড়া, জামানত ও মেয়াদ লিখিতভাবে ঠিক করুন"]}],["$","li","দুই পক্ষের পরিচয়পত্র ও ছবি আনুন",{"children":[["$","$L16",null,{"icon":"$18:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"দুই পক্ষের পরিচয়পত্র ও ছবি আনুন"]}],["$","li","আপনার ক্ষেত্রে স্ট্যাম্প শুল্ক নিশ্চিত করুন",{"children":[["$","$L16",null,{"icon":"$18:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"আপনার ক্ষেত্রে স্ট্যাম্প শুল্ক নিশ্চিত করুন"]}],["$","li","সই করার আগে প্রতিটি ধারা পড়ুন",{"children":[["$","$L16",null,{"icon":"$18:props:children:0:props:children:3:props:children:0:props:ch