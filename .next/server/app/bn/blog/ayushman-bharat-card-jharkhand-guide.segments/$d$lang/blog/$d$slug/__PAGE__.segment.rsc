18:["$","div",null,{"className":"article-layout","children":[["$","div",null,{"children":[[["$","p","0",{"children":"আয়ুষ্মান ভারত (PM-JAY) যোগ্য পরিবারগুলিকে তালিকাভুক্ত হাসপাতালে চিকিৎসার জন্য স্বাস্থ্য কভার দেয়। যোগ্যতা সরকারি তালিকা ও মানদণ্ড থেকে ঠিক হয়, কোনও বেসরকারি কেন্দ্র থেকে নয়, তাই প্রথম ধাপ সবসময় দেখা আপনি কভারের আওতায় আছেন কি না।"}],["$","p","1",{"children":"আপনার পরিবার যোগ্য হলে সাধারণত আধার দিয়ে e-KYC সম্পূর্ণ করে আয়ুষ্মান কার্ড ডাউনলোড বা সংগ্রহ করা যায়। তালিকায় না থাকলে সরকারি হেল্পলাইন বা স্থানীয় স্বাস্থ্য অফিসে জিজ্ঞাসা করুন আপনার জন্য কী প্রযোজ্য।"}]],[["$","section","যোগ্যতা দেখুন",{"children":[["$","h2",null,{"children":"যোগ্যতা দেখুন"}],[["$","p","0",{"children":"সরকারি সুবিধাভোগী পোর্টাল বা হেল্পলাইনে মোবাইল নম্বর বা রেশন কার্ডের তথ্য দিয়ে খুঁজুন। নাম ‘যোগ’ করাতে কাউকে টাকা দেবেন না; তালিকা কর্তৃপক্ষ রক্ষণাবেক্ষণ করে।"}]]]}],["$","section","নথি ও e-KYC",{"children":[["$","h2",null,{"children":"নথি ও e-KYC"}],[["$","p","0",{"children":"ব্যক্তির আধার, রেশন কার্ড বা পারিবারিক তথ্য, এবং OTP-র জন্য আধারের সঙ্গে যুক্ত মোবাইল নম্বর সঙ্গে রাখুন। OTP শুধু নিজে দিন।"}]]]}],["$","section","কার্ড ব্যবহার",{"children":[["$","h2",null,{"children":"কার্ড ব্যবহার"}],[["$","p","0",{"children":"তালিকাভুক্ত হাসপাতালে যাওয়ার সময় কার্ড বা আধার সঙ্গে নিন এবং আয়ুষ্মান হেল্প ডেস্কের কথা জিজ্ঞাসা করুন। চিকিৎসা ও সীমা প্রকল্পের নিয়ম অনুযায়ী হয়।"}]]]}]],["$","h2",null,{"children":"শুরু করার আগে"}],["$","ul",null,{"children":[["$","li","সরকারি পোর্টালে যোগ্যতা দেখুন",{"children":[["$","$L16",null,{"icon":{"name":"check","size":24,"node":[["path",{"d":"M20 6 9 17l-5-5","key":"1gmf2c"}]]},"size":16}],"সরকারি পোর্টালে যোগ্যতা দেখুন"]}],["$","li","আধার ও যুক্ত মোবাইল সঙ্গে রাখুন",{"children":[["$","$L16",null,{"icon":"$18:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"আধার ও যুক্ত মোবাইল সঙ্গে রাখুন"]}],["$","li","e-KYC নিজে সম্পূর্ণ করুন এবং OTP কখনও শেয়ার করবেন না",{"children":[["$","$L16",null,{"icon":"$1