1a:["$","div",null,{"className":"article-layout","children":[["$","div",null,{"children":[[["$","p","0",{"children":"জন্ম ও মৃত্যু নিবন্ধন আইন অনুযায়ী জন্ম-মৃত্যু স্থানীয় রেজিস্ট্রারের কাছে নিবন্ধন করতে হয়। হাসপাতালে জন্ম হলে হাসপাতাল প্রায়ই নিবন্ধন শুরু করে; বাড়িতে জন্ম হলে পরিবার (তথ্যদাতা) ঘটনাটি রেজিস্ট্রারকে জানায়।"}],["$","p","1",{"children":"ঘটনার 21 দিনের মধ্যে নিবন্ধন সবচেয়ে সহজ পথ। পরে নিবন্ধনও সম্ভব, তবে দেরি কতটা তার ওপর নির্ভর করে সাধারণত অতিরিক্ত নথি, বিলম্ব ফি বা নির্ধারিত কর্তৃপক্ষের আদেশ লাগে।"}]],[["$","section","সংশোধন",{"children":[["$","h2",null,{"children":"সংশোধন"}],[["$","p","0",{"children":"সার্টিফিকেটে নাম বা অন্য কোনও তথ্য ভুল থাকলে রেজিস্ট্রার উপযুক্ত প্রমাণ, যেমন হাসপাতালের রেকর্ড বা স্কুলের নথির ভিত্তিতে তা সংশোধন করতে পারেন। বর্তমান সার্টিফিকেট ও সঠিক তথ্যের প্রমাণ সঙ্গে নিয়ে যান।"}]]]}],["$","section","পরে শিশুর নাম যোগ করা",{"children":[["$","h2",null,{"children":"পরে শিশুর নাম যোগ করা"}],[["$","p","0",{"children":"নিবন্ধনের সময় শিশুর নাম দেওয়া না হলে নিয়মে অনুমোদিত সময়ের মধ্যে সাধারণত পরে তা যোগ করা যায়। বর্তমান প্রক্রিয়া রেজিস্ট্রারের অফিসে জিজ্ঞাসা করুন।"}]]]}]],["$","h2",null,{"children":"শুরু করার আগে"}],["$","ul",null,{"children":[["$","li","সম্ভব হলে 21 দিনের মধ্যে নিবন্ধন করুন",{"children":[["$","$L16",null,{"icon":{"name":"check","size":24,"node":[["path",{"d":"M20 6 9 17l-5-5","key":"1gmf2c"}]]},"size":16}],"সম্ভব হলে 21 দিনের মধ্যে নিবন্ধন করুন"]}],["$","li","হাসপাতালের ডিসচার্জ স্লিপ বা জন্মের অন্য প্রমাণ রাখুন",{"children":[["$","$L16",null,{"icon":"$1a:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"হাসপাতালের ডিসচার্জ স্লিপ বা জন্মের অন্য প্রমাণ রাখুন"]}],["$","li","সংশোধনের জন্য সার্টিফিকেট ও সঠিক প্রমাণ আনুন",{"children":[["$","$L16",null,{"icon":"$1a:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"সংশোধনের জন্য সার্টিফিকেট ও সঠিক প্রমাণ আনুন"]}],["$","li","রেজিস্ট্রারের সঙ্গে ফলো-আপের জন্য প্রাপ্তিস্বীকার সেভ করুন