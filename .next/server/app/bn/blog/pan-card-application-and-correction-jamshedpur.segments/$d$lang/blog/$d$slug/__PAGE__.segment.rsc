1a:["$","div",null,{"className":"article-layout","children":[["$","div",null,{"children":[[["$","p","0",{"children":"আবেদনকারীর নাম, জন্ম তারিখ এবং পরিচয়ের সহায়ক নথি একে অপরের সঙ্গে মিললে প্যানের আবেদন সহজ হয়। খরংগাঝাড়ের সেবা কেন্দ্রে আসার আগে দেখে নিন আপনার নতুন প্যান লাগবে, বর্তমান রেকর্ডে সংশোধন লাগবে, নাকি আবার প্রিন্ট। একই কাজের জন্য দুবার আবেদন করলে অকারণে দেরি হতে পারে।"}],["$","p","1",{"children":"বর্তমান সরকারি আবেদনের পথ ব্যবহার করুন এবং তার নথি, ছবি ও পেমেন্টের নির্দেশ মেনে চলুন। NISE COMPORT ফর্ম পূরণ ও নথি প্রস্তুত করতে সাহায্য করতে পারে; প্রক্রিয়া ও প্যান ইস্যু করে আয়কর দপ্তর বা অনুমোদিত প্যান পরিষেবা। জমা দেওয়ার আগে প্রতিটি তথ্য যাচাই করুন এবং প্রাপ্তিস্বীকার নম্বর যত্নে রাখুন।"}]],"$undefined",["$","h2",null,{"children":"শুরু করার আগে"}],["$","ul",null,{"children":[["$","li","নিশ্চিত করুন এটি নতুন আবেদন, সংশোধন, নাকি আবার প্রিন্ট",{"children":[["$","$L16",null,{"icon":{"name":"check","size":24,"node":[["path",{"d":"M20 6 9 17l-5-5","key":"1gmf2c"}]]},"size":16}],"নিশ্চিত করুন এটি নতুন আবেদন, সংশোধন, নাকি আবার প্রিন্ট"]}],["$","li","নাম ও জন্ম তারিখ সহায়ক নথির সঙ্গে মিলিয়ে নিন",{"children":[["$","$L16",null,{"icon":"$1a:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"নাম ও জন্ম তারিখ সহায়ক নথির সঙ্গে মিলিয়ে নিন"]}],["$","li","বর্তমান সরকারি ফর্মে চাওয়া প্রমাণ সঙ্গে আনুন",{"children":[["$","$L16",null,{"icon":"$1a:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"বর্তমান সরকারি ফর্মে চাওয়া প্রমাণ সঙ্গে আনুন"]}],["$","li","প্রাপ্তিস্বীকার ও সরকারি পেমেন্টের রসিদ রাখুন",{"children":[["$","$L16",null,{"icon":"$1a:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"প্রাপ্তিস্বীকার ও সরকারি পেমেন্টের রসিদ রাখুন"]}]]}],[["$","h2",null,{"children":"সরকারি উৎস"}],["$","$L2c",null,{"variant":"list","links":[{"label":"Protean PAN services","href":"https://onlineservices.proteantech.in/paam/endUserRegisterContact.html"},{"l