18:["$","div",null,{"className":"article-layout","children":[["$","div",null,{"children":[[["$","p","0",{"children":"দুই চাকার পলিসি রিনিউ করার আগে নিবন্ধনের বিবরণ, পলিসির বর্তমান শেষ তারিখ, ক্লেমের ইতিহাস এবং আপনার প্রয়োজনীয় কভার দেখে নিন। বিমা কোম্পানির প্রিমিয়াম, বাদ, অ্যাড-অন ও ক্লেম প্রক্রিয়া তুলনা করুন; সবচেয়ে কম দামের বিকল্পে অন্যটির মতো কভার নাও থাকতে পারে।"}],["$","p","1",{"children":"যেখানে প্রদানকারীর পরিষেবা মেলে, সেখানে NISE COMPORT খোঁজখবর ও আবেদনের ধাপে সাহায্য করতে পারে। যোগ্যতা, প্রিমিয়াম, পলিসির শর্ত ও ক্লেমের সিদ্ধান্ত ঠিক করে বিমা কোম্পানি। পলিসির শর্ত পড়ুন এবং পেমেন্টের রসিদ ও ইস্যু হওয়া নথি রেখে দিন।"}]],"$undefined",["$","h2",null,{"children":"শুরু করার আগে"}],["$","ul",null,{"children":[["$","li","নিবন্ধন ও বর্তমান পলিসির বিবরণ তৈরি রাখুন",{"children":[["$","$L16",null,{"icon":{"name":"check","size":24,"node":[["path",{"d":"M20 6 9 17l-5-5","key":"1gmf2c"}]]},"size":16}],"নিবন্ধন ও বর্তমান পলিসির বিবরণ তৈরি রাখুন"]}],["$","li","কভার, বাদ ও অ্যাড-অন তুলনা করুন",{"children":[["$","$L16",null,{"icon":"$18:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"কভার, বাদ ও অ্যাড-অন তুলনা করুন"]}],["$","li","চূড়ান্ত প্রিমিয়াম সরাসরি বিমা কোম্পানির কাছে নিশ্চিত করুন",{"children":[["$","$L16",null,{"icon":"$18:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"চূড়ান্ত প্রিমিয়াম সরাসরি বিমা কোম্পানির কাছে নিশ্চিত করুন"]}],["$","li","ইস্যু হওয়া পলিসি ও পেমেন্টের রসিদ সেভ করুন",{"children":[["$","$L16",null,{"icon":"$18:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"ইস্যু হওয়া পলিসি ও পেমেন্টের রসিদ সেভ করুন"]}]]}],null,["$","p",null,{"className":"article-disclaimer","children":"শর্ত বদলাতে পারে। যোগ্যতা, ফি, প্রক্রিয়া ও চূড়ান্ত ফল সংশ্লিষ্ট সরকারি বিভাগ, বিমা কোম্পানি, প্রতিষ্ঠান বা পরিষেবা প্রদানকারী ঠিক করে। NISE COMPORT একটি স্বাধীন CSC / প্রজ্ঞা কেন্দ্র সেবা কেন্দ্র, সরকারি অফিস নয়।"}]]}],["$","aside",null,{