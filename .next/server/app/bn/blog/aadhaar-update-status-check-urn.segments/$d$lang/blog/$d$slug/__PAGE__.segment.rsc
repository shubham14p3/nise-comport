17:["$","$L29",null,{"className":"article-cover","src":"/images/service/aadhaar.png","alt":"আধার আপডেটের অবস্থা দেখা","width":1200,"height":720,"priority":true,"sizes":"(max-width: 900px) 100vw, 800px"}]
18:["$","div",null,{"className":"article-layout","children":[["$","div",null,{"children":[[["$","p","0",{"children":"প্রতিটি আধার আপডেট অনুরোধে একটি রেফারেন্স নম্বর থাকে। নথিভুক্তি বা আপডেট কেন্দ্রে আপনি আপডেট রিকোয়েস্ট নম্বর (URN) সহ প্রাপ্তিস্বীকার স্লিপ পান; অনলাইন অনুরোধে স্ক্রিনে সার্ভিস রিকোয়েস্ট নম্বর (SRN) দেখায়। আপডেট সম্পূর্ণ না হওয়া পর্যন্ত এই নম্বর রেখে দিন।"}],["$","p","1",{"children":"অবস্থা দেখতে UIDAI-এর myAadhaar ওয়েবসাইট খুলুন এবং নথিভুক্তি ও আপডেটের অবস্থা দেখার বিকল্প বেছে নিন। URN বা SRN এবং সিকিউরিটি কোড দিন। পাতাটি দেখাবে অনুরোধ চলছে, সম্পূর্ণ হয়েছে নাকি বাতিল হয়েছে।"}]],[["$","section","আপডেট বাতিল হলে",{"children":[["$","h2",null,{"children":"আপডেট বাতিল হলে"}],[["$","p","0",{"children":"বাতিলের কারণ মন দিয়ে পড়ুন। সাধারণ কারণ: চাওয়া পরিবর্তনের সমর্থন না করা নথি, প্রমাণের সঙ্গে না মেলা বানান, বা অস্পষ্ট স্ক্যান। কারণটি ঠিক করে উপযুক্ত নথি দিয়ে নতুন অনুরোধ জমা দিন। জন্ম তারিখের মতো কিছু ক্ষেত্র সীমিত সংখ্যকবারই বদলানো যায়, তাই আগে UIDAI-এর নিয়ম দেখুন।"}]]]}],["$","section","আপডেট সম্পূর্ণ হলে",{"children":[["$","h2",null,{"children":"আপডেট সম্পূর্ণ হলে"}],[["$","p","0",{"children":"UIDAI থেকে আপডেট হওয়া ই-আধার ডাউনলোড করুন বা PVC কার্ড অর্ডার করুন। যেখানে আপনার পুরোনো আধারের তথ্য ব্যবহৃত হয়েছে, যেমন ব্যাংক বা স্কলারশিপ প্রোফাইল, সেখানে নতুন তথ্য আপডেট করুন।"}]]]}]],["$","h2",null,{"children":"শুরু করার আগে"}],["$","ul",null,{"children":[["$","li","প্রাপ্তিস্বীকারে URN (কেন্দ্র) বা SRN (অনলাইন) খুঁজুন",{"children":[["$","$L16",null,{"icon":{"name":"check","size":24,"node":[["path",{"d":"M20 6 9 17l-5-5","key":"1gmf2c"}]]},"size":16}],"প্রাপ্তিস্বীকারে URN (কেন্দ্র) বা SRN (অনলাইন) খুঁজুন"]}],["$","li","UIDAI-এর myAadhaar ওয়েবসাইটে অবস্থা দেখুন",{"children":[["$","$L16",null,{"icon":"$18:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"UIDAI-এর myAadhaar ওয়েবসাইটে অবস্থা দেখুন"]}],["$","li","বাতিল হলে আবার আবেদনের আগে কারণ পড়ুন",{"children":[["$","$L16",null,{"icon":"$18:props:childre