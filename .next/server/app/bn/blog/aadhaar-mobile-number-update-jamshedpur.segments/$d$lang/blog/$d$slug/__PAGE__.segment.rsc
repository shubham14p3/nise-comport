18:["$","$L2a",null,{"className":"article-cover","src":"/images/blog/aadhaar.png","alt":"আধার মোবাইল নম্বর আপডেটের নির্দেশনা","width":1200,"height":720,"priority":true,"sizes":"(max-width: 900px) 100vw, 800px"}]
19:["$","div",null,{"className":"article-layout","children":[["$","div",null,{"children":[[["$","p","0",{"children":"আপনার আধারের সঙ্গে যুক্ত মোবাইল নম্বরে ব্যাংক KYC, ডিজিলকার, প্যান–আধার লিঙ্কিং, স্কলারশিপ পোর্টাল ও আরও অনেক পরিষেবার OTP আসে। নম্বরটি হারালে, বন্ধ হলে বা বদলে গেলে আপডেট না হওয়া পর্যন্ত বেশিরভাগ অনলাইন আধার পরিষেবা আপনার জন্য কাজ করা বন্ধ করে দেয়।"}],["$","p","1",{"children":"বহু বছর মোবাইল নম্বর বদলাতে আধার নথিভুক্তি বা আপডেট কেন্দ্রে যেতে হত, যেখানে বায়োমেট্রিক দিয়ে আপনার পরিচয় নিশ্চিত করা হয়। UIDAI নতুন আধার অ্যাপের মাধ্যমে অনলাইন বিকল্প যোগ করছে, তাই আগে UIDAI-এর সরকারি ওয়েবসাইট বা অ্যাপে দেখুন অনলাইন পথ আপনার জন্য আছে কি না। না থাকলে অনুমোদিত আধার কেন্দ্রে যান।"}]],[["$","section","আধার কেন্দ্রে কী নিয়ে যাবেন",{"children":[["$","h2",null,{"children":"আধার কেন্দ্রে কী নিয়ে যাবেন"}],[["$","p","0",{"children":"আপনার আধার কার্ড বা নম্বর এবং নতুন মোবাইল নম্বর সঙ্গে রাখুন (ফোনটিও সঙ্গে থাকলে ভালো, কারণ নিশ্চিতকরণ SMS আসতে পারে)। শুধু মোবাইল নম্বর বদলাতে সাধারণত সহায়ক নথি লাগে না, কারণ বায়োমেট্রিকেই পরিচয় নিশ্চিত হয়; নাম, জন্ম তারিখ বা ঠিকানা বদলাতে UIDAI-এর গ্রহণযোগ্য তালিকার আসল প্রমাণ নিয়ে যান।"}]]]}],["$","section","সরকারি চার্জ",{"children":[["$","h2",null,{"children":"সরকারি চার্জ"}],[["$","p","0",{"children":"চার্জ ঠিক করে UIDAI এবং তা কেন্দ্রে ও আপনার প্রাপ্তিস্বীকার স্লিপে দেখানো থাকতে হবে। লেখার সময় UIDAI-এর প্রকাশিত তালিকায় আলাদাভাবে করা ডেমোগ্রাফিক আপডেটের (যেমন মোবাইল নম্বর) জন্য ₹75 দেখানো আছে। টাকা দেওয়ার আগে UIDAI-এর সরকারি পাতায় বর্তমান তালিকা দেখুন, আর বেশি টাকা চাইলে UIDAI-কে জানান।"}]]]}],["$","section","আপডেটের পর",{"children":[["$","h2",null,{"children":"আপডেটের পর"}],[["$","p","0",{"children":"আপডেট রিকোয়েস্ট নম্বর (URN) সহ প্রাপ্তিস্বীকার স্লিপ যত্নে রাখুন। তা দিয়ে UIDAI-এর ওয়েবসাইটে অবস্থা দেখুন। আপডেট সম্পূর্ণ হলে OTP-ভিত্তিক কোনও পরিষেবা (যেমন ই-আধার ডাউনলোড) চেষ্টা করে দেখুন নতুন নম্বর কাজ করছে কি না।"}]]]}]],["$","h2",null,{"children":"শুরু করার আগে"}],["$","ul",null,{"children":[["$","li","আগে UIDAI-এর ওয়েবসাইট বা অ্যাপে অনলাইন বিকল্প দেখুন",{"children":[["$","$L16",null,{"icon":{"name":"check","size":24,"node":[["path",{"d":"M20 6 9 17l-5-5","key":"1gmf2c"}]]},"size":16}],"আগে UIDAI-এর ওয়েবসাইট বা অ্যাপে অনলাইন বিকল্প দেখুন"]}],["$","li","আধার ও নতুন মোবাইল নম্বর সঙ্গে নিন",{"children":[["$","$L16",null,{"icon":"$19:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"আধার ও নতুন মোবাইল নম্বর সঙ্গে নিন"]}],["$","li","শুধু UIDAI-এর সরকারি তালিকার চার্জ দিন এবং স্লিপ নিন",{"children":[["$","$L16",null,{"icon":"$19:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"শুধু UIDAI-এর সরকারি তালিকার চার্জ দিন এবং স্লিপ নিন"]}],["$","li","URN সেভ করুন এবং অনলাইনে অবস্থা দেখুন",{"children":[["$","$L16",null,{"icon":"$19:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"URN সেভ করুন এবং অনলাইনে অবস্থা দেখুন"]}],["$","li","আপডেটের পর একটি OTP পরিষেবা পরীক্ষা করুন",{"children":[["$","$L16",null,{"icon":"$19:props:children:0:props:children:3:props:children:0:props:children:0:props:icon","size":16}],"আপডেটের পর একটি OTP পরিষেবা পরীক্ষা করুন"]}]]}],[["$","h2",null,{"children":"সরকারি উৎস"}],["$","$L2b",null,{"variant":"list","links":[{"label":"UIDAI – updating data on Aadhaar","href":"https://uidai.gov.in/en/updating-data-on-aadhaar"},{"label":"UIDAI enrolment & update charges (PDF)","href":"https://uidai.gov.in/images/Aadhaar_Enrolment__and__Update__-__English.pdf"}],"service":{"slug":"aadhaar","title":"Aadhaar Service Guidance","documents":["Aadhaar number or enrolment details only when needed for guidance","Original supporting proof accepted by UIDAI for the requested change"]}}]],["$","p",null,{"className":"article-disclaimer","children":"শর্ত বদলাতে পারে। যোগ্যতা, ফি, প্রক্রিয়া ও চূড়ান্ত ফল সংশ্লিষ্ট সরকারি বিভাগ, বিমা কোম্পানি, প্রতিষ্ঠান বা পরিষেবা প্রদানকারী ঠিক করে। NISE COMPORT একটি স্বাধীন CSC / প্রজ্ঞা কেন্দ্র সেবা কেন্দ্র, সরকারি অফিস নয়।"}]]}],["$","aside",null,{"children":[["$","strong",null,{"children":"এ বিষয়ে সাহায্য লাগবে?"}],["$","p",null,{"children":"খরংগাঝাড়, টেলকো, জামশেদপুরে NISE COMPORT টিমের সঙ্গে কথা বলুন। ফোন করুন +91 97712 19893।"}],"$L2c","$L2d","$L2e"]}]]}]
