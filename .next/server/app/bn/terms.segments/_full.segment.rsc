2b:["$","section","ফ-ন-whatsapp-ও-ইম-ল",{"id":"ফ-ন-whatsapp-ও-ইম-ল","className":"legal-section","children":[["$","h2",null,{"children":[10,". ","ফোন, WhatsApp ও ইমেল"]}],[["$","p","0",{"children":[["$","$1","0",{"children":[false,[["$","$1","0",{"children":"অনুরোধ পাঠিয়ে বা আমাদের নিজের নম্বর দিয়ে আপনি সম্মত হন যে আপনার অনুরোধ, পেমেন্ট ও অ্যাকাউন্ট নিয়ে আমরা ফোন, SMS, WhatsApp ও ইমেলে যোগাযোগ করতে পারি। অফার ও আপডেটের জন্য আমরা আপনার সম্মতি চাই; আপনি WhatsApp-এ STOP লিখতে পারেন বা যেকোনও সময় থামতে বলতে পারেন। সাধারণ প্রশ্নের উত্তরে আমরা WhatsApp-এ একটি স্বয়ংক্রিয় সহায়ক ব্যবহার করতে পারি এবং বাকি বার্তা নিজেদের টিমকে দিই; চ্যাট সংরক্ষিত থাকে যাতে আমাদের কর্মীরা ফলো-আপ করতে পারেন।"}]]]}]]}]]]}]
