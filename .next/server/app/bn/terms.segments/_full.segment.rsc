23:["$","section","আপন-র-অ-য-ক-উন-ট",{"id":"আপন-র-অ-য-ক-উন-ট","className":"legal-section","children":[["$","h2",null,{"children":[2,". ","আপনার অ্যাকাউন্ট"]}],[["$","p","0",{"children":[["$","$1","0",{"children":[false,[["$","$1","0",{"children":"অ্যাকাউন্ট খোলার সময় বা অনুরোধ পাঠানোর সময় আপনাকে সঠিক, সম্পূর্ণ ও হালনাগাদ তথ্য দিতে হবে। আপনার সাইন-ইন তথ্য সুরক্ষিত রাখা এবং আপনার অ্যাকাউন্ট থেকে করা সব কাজের দায়িত্ব আপনার। অন্য কেউ আপনার অ্যাকাউন্ট ব্যবহার করেছে মনে হলে সঙ্গে সঙ্গে আমাদের জানান। অ্যাকাউন্ট খুলতে আপনার বয়স কমপক্ষে ১৮ বছর হতে হবে; বাবা-মা বা অভিভাবক শিশুর হয়ে আমাদের সেবা ব্যবহার করতে পারেন এবং দেওয়া তথ্যের দায়িত্ব নেন।"}]]]}]]}],["$","p","1",{"children":[["$","$1","0",{"children":[false,[["$","$1","0",{"children":"যে অ্যাকাউন্ট মিথ্যা তথ্য দেয়, বেআইনিভাবে ব্যবহৃত হয়, আমাদের কর্মীদের সঙ্গে দুর্ব্যবহার করে বা এই শর্ত ভাঙে, আমরা তা স্থগিত বা বন্ধ করতে পারি।"}]]]}]]}]]]}]
