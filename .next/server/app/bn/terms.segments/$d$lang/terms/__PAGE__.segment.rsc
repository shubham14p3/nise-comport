22:["$","section","অন-ম-দন-সময-স-ম-ও-ত-ত-য-পক-ষ",{"id":"অন-ম-দন-সময-স-ম-ও-ত-ত-য-পক-ষ","className":"legal-section","children":[["$","h2",null,{"children":[7,". ","অনুমোদন, সময়সীমা ও তৃতীয় পক্ষ"]}],[["$","p","0",{"children":[["$","$2","0",{"children":[false,[["$","$2","0",{"children":"অনুমোদন, প্রত্যাখ্যান, প্রক্রিয়ার সময়, ফি ও নিয়ম ঠিক করে সংশ্লিষ্ট দপ্তর, ব্যাংক, বিমা কোম্পানি বা প্রদানকারী, আমরা নই। অনুমোদন, কোনও নির্দিষ্ট তারিখ বা কোনও তৃতীয় পক্ষের পোর্টাল পাওয়ার "}],["$","$2","1",{"children":["$","b",null,{"children":"নিশ্চয়তা আমরা দিতে পারি না"}]}],["$","$2","2",{"children":", যা ধীর, বদলে যাওয়া বা বন্ধ থাকতে পারে। পোর্টাল, কুরিয়ার বা প্রদানকারীর কারণে দেরি, ক্ষতি বা ভুল হলে ফলো-আপে আমরা আপনাকে সাহায্য করব, কিন্তু তাদের কাজের দায় আমাদের নয়।"}]]]}]]}],["$","p","1",{"children":[["$","$2","0",{"children":[false,[["$","$2","0",{"children":"আমাদের ওয়েবসাইট, গাইড ও চ্যাটের তথ্য শুধু সাধারণ দিকনির্দেশ, আইনি, কর, আর্থিক বা বিমা পরামর্শ নয়। সরকারি নিয়ম বদলায়; সবসময় সরকারি সূত্র দেখুন। কোনও শেষ তারিখের ওপর নির্ভর করলে আমাদের আগে জানান।"}]]]}]]}]]]}]
