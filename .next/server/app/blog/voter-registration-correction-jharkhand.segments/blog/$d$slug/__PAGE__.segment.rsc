19:[["$","h2",null,{"children":"Official sources"}],["$","$L29",null,{"variant":"list","links":[{"label":"Voters’ Service Portal (ECI)","href":"https://voters.eci.gov.in/"}],"service":{"slug":"voter-id","title":"Voter ID (EPIC) Application & Correction","documents":["For new registration (Form 6): Aadhaar number (or a declaration if you don't have one), a recent passport-size colour photo on a white background (4.5cm x 3.5cm), age proof (birth certificate, 10th marksheet or similar), current address proof, mobile number for OTP, and the name/relation of a parent or spouse already on the roll if available","For correction/shifting/replacement (Form 8): existing EPIC number, Aadhaar number, proof of the new detail being corrected (address proof for shifting, age/name proof for a correction), and a recent photo","For overseas electors (Form 6A): valid Indian passport, current visa details, proof of the Indian address last ordinarily resided at, and a recent passport-size photo","Disability marking (optional, Form 8): a disability certificate, if you want it recorded"]}}]]
1a:["$","p",null,{"className":"article-disclaimer","children":"Requirements can change. The responsible government department, insurer, institution or service provider decides eligibility, fees, processing and final outcomes. NISE COMPORT is an independent CSC / Pragya Kendra service centre, not a government office."}]
