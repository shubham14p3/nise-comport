16:["$","p","1",{"children":"If your family is eligible, you can usually complete e-KYC with Aadhaar and download or collect your Ayushman card. If you are not on the list, ask the official helpline or your local health office what applies to you."}]
17:["$","section","Check eligibility",{"children":[["$","h2",null,{"children":"Check eligibility"}],[["$","p","0",{"children":"Use the official beneficiary portal or the helpline to search by mobile number or ration card details. Do not pay anyone to ‘add’ your name; the list is maintained by the authorities."}]]]}]
18:["$","section","Documents and e-KYC",{"children":[["$","h2",null,{"children":"Documents and e-KYC"}],[["$","p","0",{"children":"Keep Aadhaar of the person, a ration card or family details, and a mobile number linked to Aadhaar for the OTP. Only enter the OTP yourself."}]]]}]
