16:["$","p","1",{"children":"Registration within 21 days of the event is the simplest route. Later registrations are still possible, but they usually need extra documents, a late fee or an order from the prescribed authority, depending on how long the delay is."}]
17:["$","section","Corrections",{"children":[["$","h2",null,{"children":"Corrections"}],[["$","p","0",{"children":"If a name or other detail on the certificate is wrong, the registrar can correct it on the basis of suitable evidence, such as hospital records or school documents. Carry the existing certificate and the proof of the correct detail."}]]]}]
18:["$","section","Adding the child’s name later",{"children":[["$","h2",null,{"children":"Adding the child’s name later"}],[["$","p","0",{"children":"If the child’s name was not given at registration, it can usually be added later within the time allowed by the rules. Ask the registrar’s office about the current process."}]]]}]
