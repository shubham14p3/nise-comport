16:["$","p","1",{"children":"To check the status, open UIDAI’s myAadhaar website and choose the option to check enrolment and update status. Enter the URN or SRN and the security code. The page shows whether the request is in progress, completed or rejected."}]
17:["$","section","If the update is rejected",{"children":[["$","h2",null,{"children":"If the update is rejected"}],[["$","p","0",{"children":"Read the rejection reason carefully. Common causes are a document that doesn’t support the requested change, a spelling that doesn’t match the proof, or an unclear scan. Correct the cause and submit a fresh request with suitable documents. Some fields, such as date of birth, have limits on how many times they can be changed, so check UIDAI’s rules first."}]]]}]
18:["$","section","If the update is completed",{"children":[["$","h2",null,{"children":"If the update is completed"}],[["$","p","0",{"children":"Download the updated e-Aadhaar from UIDAI or order a PVC card. Update the new details wherever your old Aadhaar details are used, for example your bank or scholarship profile."}]]]}]
