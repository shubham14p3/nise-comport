1b:["$","ul",null,{"children":[["$","li","Check UIDAI’s website or app for an online option first",{"children":[["$","$L14",null,{"icon":{"name":"check","size":24,"node":[["path",{"d":"M20 6 9 17l-5-5","key":"1gmf2c"}]]},"size":16}],"Check UIDAI’s website or app for an online option first"]}],["$","li","Carry your Aadhaar and the new mobile number",{"children":[["$","$L14",null,{"icon":"$1b:props:children:0:props:children:0:props:icon","size":16}],"Carry your Aadhaar and the new mobile number"]}],["$","li","Pay only the charge on UIDAI’s official list and take the slip",{"children":[["$","$L14",null,{"icon":"$1b:props:children:0:props:children:0:props:icon","size":16}],"Pay only the charge on UIDAI’s official list and take the slip"]}],["$","li","Save the URN and check the status online",{"children":[["$","$L14",null,{"icon":"$1b:props:children:0:props:children:0:props:icon","size":16}],"Save the URN and check the status online"]}],["$","li","Test an OTP service after the update",{"children":[["$","$L14",null,{"icon":"$1b:props:children:0:props:children:0:props:icon","size":16}],"Test an OTP service after the update"]}]]}]
