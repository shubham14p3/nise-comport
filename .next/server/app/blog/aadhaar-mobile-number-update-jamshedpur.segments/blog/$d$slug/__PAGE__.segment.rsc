1d:["$","p",null,{"className":"article-disclaimer","children":"Requirements can change. The responsible government department, insurer, institution or service provider decides eligibility, fees, processing and final outcomes. NISE COMPORT is an independent CSC / Pragya Kendra service centre, not a government office."}]
