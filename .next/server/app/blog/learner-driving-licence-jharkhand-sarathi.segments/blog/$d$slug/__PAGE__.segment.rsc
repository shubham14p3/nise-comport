16:["$","p","1",{"children":"On Sarathi you select Jharkhand, fill the application, upload documents, pay the fee online and either take the learner’s test online where the portal offers it or book a slot at your District Transport Office."}]
17:["$","section","Before the learner’s test",{"children":[["$","h2",null,{"children":"Before the learner’s test"}],[["$","p","0",{"children":"The test covers traffic signs, road rules and safe driving. Sarathi provides practice material. Keep your application number and receipts together."}]]]}]
18:["$","section","Moving to a permanent licence",{"children":[["$","h2",null,{"children":"Moving to a permanent licence"}],[["$","p","0",{"children":"A permanent driving licence can generally be applied for after holding the learner’s licence for 30 days and before it expires. Book the driving test on Sarathi and bring a suitable vehicle, as required by the transport office."}]]]}]
