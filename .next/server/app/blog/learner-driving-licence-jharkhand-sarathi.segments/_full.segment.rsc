21:["$","section","Moving to a permanent licence",{"children":[["$","h2",null,{"children":"Moving to a permanent licence"}],[["$","p","0",{"children":"A permanent driving licence can generally be applied for after holding the learner’s licence for 30 days and before it expires. Book the driving test on Sarathi and bring a suitable vehicle, as required by the transport office."}]]]}]
