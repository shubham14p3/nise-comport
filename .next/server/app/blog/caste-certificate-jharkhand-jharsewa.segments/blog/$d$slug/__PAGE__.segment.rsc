16:["$","p","1",{"children":"Because verification is done locally, the details you give must match your records exactly: the applicant’s name, father’s name, address and the caste as recorded in family documents. Mismatches are the most common reason for delays."}]
17:["$","section","What the application commonly asks for",{"children":[["$","h2",null,{"children":"What the application commonly asks for"}],[["$","p","0",{"children":"The online form usually asks for identity and address details, family information, a self-declaration and supporting records such as a relative’s caste certificate or land-record (khatiyan) details, depending on your case. Always check the current checklist on JharSewa before you start, because requirements can change."}]]]}]
18:["$","section","After you apply",{"children":[["$","h2",null,{"children":"After you apply"}],[["$","p","0",{"children":"Note the application number. Use it on JharSewa to check the status and to download the certificate when it is approved. If the office asks for more information, respond quickly to avoid the application being closed."}]]]}]
19:["$","h2",null,{"children":"Before you start"}]
1a:["$","ul",null,{"children":[["$","li","Check the current checklist on JharSewa",{"children":[["$","$L14",null,{"icon":{"name":"check","size":24,"node":[["path",{"d":"M20 6 9 17l-5-5","key":"1gmf2c"}]]},"size":16}],"Check the current checklist on JharSewa"]}],["$","li","Make sure names match across all documents",{"children":[["$","$L14",null,{"icon":"$1a:props:children:0:props:children:0:props:icon","size":16}],"Make sure names match across all documents"]}],["$","li","Keep supporting family or land records ready",{"children":[["$","$L14",null,{"icon":"$1a:props:children:0:props:children:0:props:icon","size":16}],"Keep supporting family or land records ready"]}],["$","li","Save the application number and track it on JharSewa",{"children":[["$","$L14",null,{"icon":"$1a:props:children:0:props:children:0:props:icon","size":16}],"Save the application number and track it on JharSewa"]}]]}]
1b:[["$","h2",null,{"children":"Official sources"}],["$","$L2d",null,{"variant":"list","links":[{"label":"JharSewa (Jharkhand e-District)","href":"https://jharsewa.jharkhand.gov.in/"}],"service":{"slug":"income-caste-residence-certificate","title":"Income Certificate Application Help (Jharkhand)","documents":["Applicant's Aadhaar card","Self-declaration / income affidavit stating annual family income and source (salary, business, agriculture, etc.)","Ration card, if available","Residence proof (voter ID, electricity bill or rent agreement)","Salary slip or employer certificate for salaried applicants; land records (khatiyan/rent receipt) for agricultural income","Bank passbook front page","Recent passport-size photograph","Mobile number for OTP and SMS status updates","Parent's/guardian's name and relation, as asked on the form"]}}]]
1c:["$","p",null,{"className":"article-disclaimer","children":"Requirements can change. The responsible government department, insurer, institution or service provider decides eligibility, fees, processing and final outcomes. NISE COMPORT is an independent CSC / Pragya Kendra service centre, not a government office."}]
