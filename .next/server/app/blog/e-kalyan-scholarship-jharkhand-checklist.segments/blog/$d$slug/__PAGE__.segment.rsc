16:["$","p","1",{"children":"Most rejections come from avoidable problems: expired or mismatched certificates, a bank account that is not Aadhaar-seeded for direct benefit transfer, or a missed institute verification step. Prepare these before the window opens."}]
17:["$","section","Documents students are commonly asked for",{"children":[["$","h2",null,{"children":"Documents students are commonly asked for"}],[["$","p","0",{"children":"Caste certificate, income certificate and residence certificate issued in Jharkhand; Aadhaar; a bank account in the student’s name that can receive DBT payments; the previous year’s marksheet; admission and fee receipts; and a recent photograph. Check the current year’s notice for the exact list."}]]]}]
