16:["$","p","1",{"children":"Most problems come from small mismatches: a spelling that differs between Aadhaar and other papers, a missing family member, or an old address. Fixing these before applying saves weeks."}]
17:["$","section","What to prepare",{"children":[["$","h2",null,{"children":"What to prepare"}],[["$","p","0",{"children":"Aadhaar of every family member, a recent photograph where asked, address proof, a mobile number that works, and for a new member the birth certificate or school record. Bring originals so we can check them against each other."}]]]}]
18:["$","section","Adding, removing or correcting a member",{"children":[["$","h2",null,{"children":"Adding, removing or correcting a member"}],[["$","p","0",{"children":"Each change has its own form or option on the official portal. Tell us exactly what is wrong on the current card (name spelling, age, missing member, wrong address) and we will help you choose the correct option and prepare matching documents."}]]]}]
19:["$","section","After you apply",{"children":[["$","h2",null,{"children":"After you apply"}],[["$","p","0",{"children":"Keep the application or acknowledgement number. Verification can involve a local officer, so keep your phone reachable. Track the status on the official portal, or ask us to help you check."}]]]}]
