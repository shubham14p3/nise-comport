15:["$","section","who-we-are-and-what-we-do",{"id":"who-we-are-and-what-we-do","className":"legal-section","children":[["$","h2",null,{"children":[1,". ","Who we are and what we do"]}],[["$","p","0",{"children":[["$","$2","0",{"children":[false,[["$","$2","0",{"children":"NISE COMPORT is an "}],["$","$2","1",{"children":["$","b",null,{"children":"independent CSC / Pragya Kendra service centre"}]}],["$","$2","2",{"children":" in Kharangajhar, Telco, Jamshedpur, Jharkhand. We help individuals and small businesses with online forms and applications, documents, certificates, banking and payment assistance (including AEPS and bill payments), insurance paperwork, printing, scanning and photo services, and computer and IT hardware, repair and accessories."}]]]}]]}],["$","p","1",{"children":[["$","$2","0",{"children":[false,[["$","$2","0",{"children":["$","b",null,{"children":"We are not a government department, bank, insurer, court, election office or any other authority."}]}],["$","$2","1",{"children":" Names such as CSC, Pragya Kendra, Digital India, Aadhaar, PAN, DigiLocker, Voter ID, Udyam or Passport belong to their owners. We use them only to describe the services we help customers use. We act as a facilitator between you and the relevant authority, portal or provider."}]]]}]]}]]]}]
16:["$","section","your-account",{"id":"your-account","className":"legal-section","children":[["$","h2",null,{"children":[2,". ","Your account"]}],[["$","p","0",{"children":[["$","$2","0",{"children":[false,[["$","$2","0",{"children":"You must give true, complete and current details when you create an account or send a request. You are responsible for keeping your sign-in details safe and for everything done through your account. Tell us at once if you think someone else has used it. You must be at least 18 years old to create an account; a parent or guardian may use our services on behalf of a child and takes responsibility for the information given."}]]]}]]}],["$","p","1",{"children":[["$","$2","0",{"children":[false,[["$","$2","0",{"children":"We may suspend or close an account that gives false information, is used unlawfully, abuses our staff or breaks these terms."}]]]}]]}]]]}]
17:["$","section","requests-and-how-we-work",{"id":"requests-and-how-we-work","className":"legal-section","children":[["$","h2",null,{"children":[3,". ","Requests and how we work"]}],[["$","p","0",{"children":[["$","$2","0",{"children":[false,[["$","$2","0",{"children":"Sending a request is not a promise that we will accept it. We first check your details and documents. Where we need more information we will contact you by call, WhatsApp or email. Our service charge, any government or third-party fee, and any courier or printing cost are communicated to you where we can before work starts. Work begins once the charge is agreed and, where we ask for it, paid."}]]]}]]}],["$","p","1",{"children":[["$","$2","0",{"children":[false,[["$","$2","0",{"children":"We prepare and submit what you ask for using the details and documents you give us. You authorise us to enter that information on the relevant portal, to talk to the authority, insurer or bank on your behalf where the process allows, and to collect documents for the purpose of your request only."}]]]}]]}]]]}]
18:["$","section","your-responsibilities",{"id":"your-responsibilities","className":"legal-section","children":[["$","h2",null,{"children":[4,". ","Your responsibilities"]}],[["$","ul","0",{"children":[["$","li","0",{"children":["$","span",null,{"children":[["$","$2","0",{"children":"Provide complete and accurate information and valid, genuine documents that belong to you or that you are allowed to share."}]]}]}],["$","li","1",{"children":["$","span",null,{"children":[["$","$2","0",{"children":"Check the details in every form, draft or preview before we submit. Once submitted, many portals do not allow edits, and corrections may take extra time and cost."}]]}]}],["$","li","2",{"children":["$","span",null,{"children":[["$","$2","0",{"children":"Keep any acknowledgement, application number, receipt or password issued to you."}]]}]}],["$","li","3",{"children":["$","span",null,{"children":[["$","$2","0",{"children":"Respond quickly when we ask for more information. A request that waits for you for a long time may be closed."}]]}]}],["$","li","4",{"children":["$","span",null,{"children":[["$","$2","0",{"children":"Never share OTPs, UPI PINs, card details or passwords with anyone. We will never ask for your UPI PIN or card number. We may ask you to enter an OTP yourself, or to read out one that you received for the official process you asked us to complete, only when that process requires it."}]]}]}]]}]]]}]
19:["$","section","fees-and-charges",{"id":"fees-and-charges","className":"legal-section","children":[["$","h2",null,{"children":[5,". ","Fees and charges"]}],[["$","p","0",{"children":[["$","$2","0",{"children":[false,[["$","$2","0",{"children":"Our "}],["$","$2","1",{"children":["$","b",null,{"children":"service charge"}]}],["$","$2","2",{"children":" is separate from "}],["$","$2","3",{"children":["$","b",null,{"children":"government, portal, bank, insurer, courier, printing and other third-party fees"}]}],["$","$2","4",{"children":". We show them separately wherever we can. Charges on our "}],["$","$L10","5",{"href":"/pricing","children":"Pricing"}],["$","$2","6",{"children":" page are typical amounts; the exact charge for your request is confirmed to you first. If we have not published a price for a service, we will quote it after checking your case."}]]]}]]}],["$","p","1",{"children":[["$","$2","0",{"children":[false,[["$","$2","0",{"children":"Offers, promo codes, coupons and wallet credit reduce "}],["$","$2","1",{"children":["$","b",null,{"children":"our service charge only"}]}],["$","$2","2",{"children":", never government or third-party fees, and are subject to the terms shown with each offer. We may end or change an offer at any time, but not for a request already accepted on those terms."}]]]}]]}],["$","p","2",{"children":[["$","$2","0",{"children":[false,[["$","$2","0",{"children":"We do not charge GST separately unless we are registered for it and tell you so in writing."}]]]}]]}]]]}]
1a:["$","section","payments",{"id":"payments","className":"legal-section","children":[["$","h2",null,{"children":[6,". ","Payments"]}],[["$","p","0",{"children":[["$","$2","0",{"children":[false,[["$","$2","0",{"children":"You can pay at our desk in cash or UPI, by the free UPI QR on your request’s payment page, or, where available, through an online payment partner such as Razorpay or Cashfree. These partners are licensed payment providers; your card, UPI PIN and bank login details are handled only by them and your bank and are never seen or stored by us."}]]]}]]}],["$","ul","1",{"children":[["$","li","0",{"children":["$","span",null,{"children":[["$","$2","0",{"children":["$","b",null,{"children":"UPI QR:"}]}],["$","$2","1",{"children":" there is no extra charge. Because we confirm each payment manually against our bank record, it can take some time. Entering a wrong or reused reference number may delay confirmation."}]]}]}],["$","li","1",{"children":["$","span",null,{"children":[["$","$2","0",{"children":["$","b",null,{"children":"Online payment:"}]}],["$","$2","1",{"children":" a payment-processing fee, shown before you pay, is added to cover the gateway’s charges. Instant confirmation is provided by the payment partner, not by us."}]]}]}],["$","li","2",{"children":["$","span",null,{"children":[["$","$2","0",{"children":"A request moves to the next step only after the payment is confirmed. A payment is final when it is shown as received on your request."}]]}]}],["$","li","3",{"children":["$","span",null,{"children":[["$","$2","0",{"children":"If money has left your account but your payment shows as pending or failed, wait 24 hours (banks often reverse failed payments on their own), and then raise a ticket from your payment page. We will check with the payment provider."}]]}]}]]}],["$","p","2",{"children":[["$","$2","0",{"children":[false,[["$","$2","0",{"children":"Refunds and cancellations are covered in our "}],["$","$L10","1",{"href":"/refund-policy","children":"Refund & Cancellation Policy"}],["$","$2","2",{"children":"."}]]]}]]}]]]}]
1b:["$","section","approvals-timelines-and-third-parties",{"id":"approvals-timelines-and-third-parties","className":"legal-section","children":[["$","h2",null,{"children":[7,". ","Approvals, timelines and third parties"]}],[["$","p","0",{"children":[["$","$2","0",{"children":[false,[["$","$2","0",{"children":"Approvals, rejections, processing times, fees and rules are decided by the relevant department, bank, insurer or provider, not by us. We "}],["$","$2","1",{"children":["$","b",null,{"children":"cannot guarantee"}]}],["$","$2","2",{"children":" approval, a particular date or the availability of any third-party portal, which may be slow, changed or unavailable. Where a portal, courier or provider causes a delay, loss or error, we will help you follow it up but we are not responsible for their acts."}]]]}]]}],["$","p","1",{"children":[["$","$2","0",{"children":[false,[["$","$2","0",{"children":"Information on our website, guides and chat is general guidance only and is not legal, tax, financial or insurance advice. Official rules change; always check the official source. Where you rely on a deadline, tell us early."}]]]}]]}]]]}]
1c:["$","section","services-with-extra-conditions",{"id":"services-with-extra-conditions","className":"legal-section","children":[["$","h2",null,{"children":[8,". ","Services with extra conditions"]}],[["$","h3","0",{"children":"Banking, AEPS and bill payments"}],["$","p","1",{"children":[["$","$2","0",{"children":[false,[["$","$2","0",{"children":"Cash and transfer services are provided through the banking partners and rules applicable to our centre. Transaction limits, charges, failures and reversals follow those partners’ and the banks’ rules. Keep your slip. A failed transaction that debited your account is normally reversed by the bank within the period set by banking rules."}]]]}]]}],["$","h3","2",{"children":"Insurance"}],["$","p","3",{"children":[["$","$2","0",{"children":[false,[["$","$2","0",{"children":"Policies are issued by insurers; we help with comparison, forms, documents and renewals. Premiums, cover, exclusions, claims and renewals are decided by the insurer. Please read the policy wording. Disclose every relevant fact truthfully; wrong information can lead to a rejected claim."}]]]}]]}],["$","h3","4",{"children":"Printing, scanning and photos"}],["$","p","5",{"children":[["$","$2","0",{"children":[false,[["$","$2","0",{"children":"Print estimates depend on your selections and may change after we check the file. Please check spelling and layout in proofs before printing. Work done as you approved cannot be refunded, but we will reprint or refund an order with a fault that is ours. Files you upload are kept only as described in the "}],["$","$L10","1",{"href":"/privacy","children":"Privacy Policy"}],["$","$2","2",{"children":"."}]]]}]]}],["$","h3","6",{"children":"Computers, IT products and repair"}],["$","p","7",{"children":[["$","$2","0",{"children":[false,[["$","$2","0",{"children":"Diagnosis, parts and repair charges are quoted before work. Products carry the manufacturer’s warranty, if any, and are subject to its terms. Please "}],["$","$2","1",{"children":["$","b",null,{"children":"back up your data"}]}],["$","$2","2",{"children":" before giving a device for repair; we are not responsible for data loss except as the law requires. Please collect repaired devices within 30 days of our “ready” message; after that we may charge reasonable storage and cannot be responsible for the device."}]]]}]]}]]]}]
1d:["$","section","acceptable-use",{"id":"acceptable-use","className":"legal-section","children":[["$","h2",null,{"children":[9,". ","Acceptable use"]}],[["$","p","0",{"children":[["$","$2","0",{"children":[false,[["$","$2","0",{"children":"You must not: give false or forged documents or identity; use our services for anything unlawful, including money laundering, impersonation or cheating a government scheme; upload documents of another person without their permission; harass or threaten our staff; misuse promo codes, offers or the wallet; try to break, scrape, overload or test the security of our website; or send spam through our channels. We may refuse or stop a request, and may report suspected unlawful activity to the authorities as the law requires."}]]]}]]}]]]}]
1e:["$","section","calls-whatsapp-and-email",{"id":"calls-whatsapp-and-email","className":"legal-section","children":[["$","h2",null,{"children":[10,". ","Calls, WhatsApp and email"]}],[["$","p","0",{"children":[["$","$2","0",{"children":[false,[["$","$2","0",{"children":"By sending a request or giving us your number, you agree that we may contact you by call, SMS, WhatsApp and email about your request, payments and account. For offers and updates we ask for your consent; you can reply STOP on WhatsApp or tell us to stop at any time. We may use an automated assistant on WhatsApp to answer common questions and pass other messages to our team; chats are saved so our staff can follow up."}]]]}]]}]]]}]
