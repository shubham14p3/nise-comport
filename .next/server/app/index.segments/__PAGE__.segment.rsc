5f:T5a7,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Where is NISE COMPORT in Jamshedpur?","acceptedAnswer":{"@type":"Answer","text":"Ground Floor, Singh Building, Shop No-3, Hanuman Mandir Road, Kharangajhar, Telco Colony, Jamshedpur, Jharkhand 831004. Tap “Get directions” to open the route in Google Maps."}},{"@type":"Question","name":"Is NISE COMPORT a government office?","acceptedAnswer":{"@type":"Answer","text":"No. NISE COMPORT is an independent CSC / Pragya Kendra service centre. We help you use official and partner services; the relevant department, bank or provider makes the final decision."}},{"@type":"Question","name":"Are government fees included in your charge?","acceptedAnswer":{"@type":"Answer","text":"No. Official or third-party fees are separate from our service charge. We explain both before any work starts and give you a receipt."}},{"@type":"Question","name":"Can I track my request online?","acceptedAnswer":{"@type":"Answer","text":"Yes. Create a free account, send a request in four quick steps and follow its status and reference number in your account. We also update you by email, phone or WhatsApp."}},{"@type":"Question","name":"Do you help in Hindi and Bengali?","acceptedAnswer":{"@type":"Answer","text":"Yes. The website works in English, हिन्दी and বাংলা, and our team is happy to help you in the language you’re comfortable with."}}]}19:["$","section",null,{"className":"section faq-block","id":"faq","children":[["$","div",null,{"className":"container faq-block__inner","children":[["$","div",null,{"className":"section-head section-head--left","children":[["$","span",null,{"className":"eyebrow","children":"GOOD TO KNOW"}],["$","h2",null,{"children":"Questions people ask before visiting"}]]}],["$","div",null,{"className":"faq-list","children":[["$","details","Where is NISE COMPORT in Jamshedpur?",{"name":"faq-group","open":true,"children":[["$","summary",null,{"children":[["$","span",null,{"children